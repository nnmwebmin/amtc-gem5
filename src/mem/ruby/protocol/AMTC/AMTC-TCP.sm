 * Copyright (c) 2011-2015 Advanced Micro Devices, Inc.
 * Copyright (c) 2026 Narayana Murty N. (AMTC Protocol Override)
 * All rights reserved.
 *
 * Heterogeneous Sector Token Coherence (AMTC) - GPU TCP (L1 Data Cache)
 * V10.3: strict 2-sector replacement + correct GPU coalescer callbacks
 */


machine(MachineType:TCP, "GPU TCP (L1 Data Cache)")
 : VIPERCoalescer* coalescer; // Retained for python config binding, unused in logic
   Sequencer* sequencer;
   bool use_seq_not_coal;
   CacheMemory * L1cache;
   bool WB; /*is this cache Writeback?*/
   bool disableL1; /* bypass L1 cache? */
   int TCC_select_num_bits;
   Cycles issue_latency := 40;  // time to send data down to TCC
   Cycles l2_hit_latency := 18;

  MessageBuffer * requestFromTCP, network="To", virtual_network="1", vnet_type="request";
  MessageBuffer * responseFromTCP, network="To", virtual_network="3", vnet_type="response";
  MessageBuffer * unblockFromCore, network="To", virtual_network="5", vnet_type="unblock";

  MessageBuffer * probeToTCP, network="From", virtual_network="1", vnet_type="request";
  MessageBuffer * responseToTCP, network="From", virtual_network="3", vnet_type="response";
  MessageBuffer * mandatoryQueue;


{
  state_declaration(State, desc="TCP Cache States", default="TCP_State_I") {
    I, AccessPermission:Invalid,   desc="Invalid";
    V, AccessPermission:Read_Only, desc="Valid";
    A, AccessPermission:Invalid,   desc="Waiting on Atomic";
    F, AccessPermission:Invalid,   desc="Flushing; Waiting for Ack";
  }

  enumeration(Event, desc="TCP Events") {
    // Core initiated
    Load,            desc="Load hit in the requested AMTC sector(s)";
    LoadMiss,        desc="Load miss in one or more requested AMTC sectors";
    Store,           desc="Store to L1 (L1 is dirty)";
    StoreThrough,    desc="Store through an existing requested sector";
    StoreNoAlloc,    desc="Store/atomic write-through without TCP allocation";

    // Disabled Stage 2.1 paths
    // LoadBypassEvict, desc="Bypass L1 on a load.";
    Atomic,          desc="GPU atomic request";
    AtomicData,      desc="Atomic result returned from TCC";
    // Flush,           desc="Flush if dirty(wbL1 for Store Release)";
    // Evict,           desc="Evict if clean(invL1 for Load Acquire)";

    // Mem sys initiated
    Repl,            desc="Replacing block from cache for response-side allocation";
    Local_Repl,      desc="Replacement request from local TCP/Sequencer cache walk";
    InvL2,           desc="Invalidate to L2";

    // AMTC Network Responses
    Data_Shared,     desc="Data response from network (DATA_SHARED/DATA_OWNER)";
    Ack,             desc="Control Ack from network (Writeback/Invalidate completion)";
    StaleOwnerAck,   desc="Zero-token ACK_OWNER from stale owner path";

    // Disable L1 cache
    Bypass,          desc="Bypass the entire L1 cache";

    // CPU broadcasts
    CPU_GETS,        desc="A CPU requested read access (GETS)";
    CPU_GETX,        desc="A CPU requested write access (GETX)";
  }

  enumeration(RequestType, desc="To communicate stats from transitions to recordStats") {
    DataArrayRead,    desc="Read the data array";
    DataArrayWrite,   desc="Write the data array";
    TagArrayRead,     desc="Read the tag array";
    TagArrayWrite,    desc="Write the tag array";
    TagArrayFlash,    desc="Flash clear the tag array";
  }

  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,           desc="cache state";
    bool Dirty,                 desc="Is the data dirty (diff than memory)?";
    DataBlock DataBlk,          desc="data for the block";
    bool FromL2, default="false", desc="block just moved from L2";
    WriteMask writeMask,        desc="written bytes masks";

    // STRICT 2-SECTOR TOKENS (No aggregate tokens)
    int ValidSectors, default="0", desc="Bitmask for valid sectors (1=S0, 2=S1)";
    int TokensSec0, default="0", desc="Tokens held for sector 0";
    int TokensSec1, default="0", desc="Tokens held for sector 1";

    // Safety Tripwires
    int retry_count, default="0", desc="Livelock tracking";
  }

  structure(TBE, desc="...") {
    State TBEState,    desc="Transient state";
    DataBlock DataBlk, desc="data for the block, required for concurrent writebacks";
    bool Dirty,        desc="Is the data dirty (different than memory)?";
    int NumPendingMsgs,desc="Number of acks/data messages that this processor is waiting for";
    bool Shared,       desc="Victim hit by shared probe";
    bool isGLCSet,     desc="Bypass L1 Cache";
    bool isSLCSet,     desc="Bypass L1 and L2 Cache";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  TBETable TBEs, template="<TCP_TBE>", constructor="m_number_of_TBEs";
  int TCC_select_low_bit, default="m_ruby_system->getBlockSizeBits()";
  int WTcnt, default="0";
  int Fcnt, default="0";
  bool inFlush, default="false";

  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);
  void wakeUpAllBuffers(Addr a);
  Cycles curCycle();

  // Internal functions
  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  Entry getCacheEntry(Addr address), return_by_pointer="yes" {
    Entry cache_entry := static_cast(Entry, "pointer", L1cache.lookup(address));
    return cache_entry;
  }


// ----------------------------------------------------------------------
  // AMTC mask helpers for the trimmed prototype.
  // Physical Ruby block: 64B. Logical AMTC sectors: 2 x 32B.
  // sector_id 0 -> mask 1 (bytes 0..31), sector_id 1 -> mask 2
  // (bytes 32..63), full-line mask -> 3.
  // Keep field names unchanged so L2/Directory can still compile while the
  // L1 implementation avoids 4-sector metadata overhead.
  // ----------------------------------------------------------------------

  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    // Accept old full-line defaults such as 15 from untrimmed controllers, but
    // collapse them to the two valid 32B sectors used by this L1.
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }




  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    // 64B Ruby line, 2 x 32B sectors.
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

    int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

    int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }


  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  // Calculate the exact sector set touched by a GPU memory request.
  // LineAddress is 64-byte aligned, so it must never be used by itself to
  // infer the 32-byte sector.  PhysicalAddress and Size carry that detail.
  int amtc_getRequiredSectorMask(Addr line_addr, Addr phys_addr, int size) {
    int offset := getOffset(phys_addr);
    int end_byte := offset + size - 1;
    int mask := 0;

    if (offset < 32) {
      mask := mask + 1;
    }
    if (end_byte >= 32) {
      mask := mask + 2;
    }

    // Defensive fallback for malformed zero-sized requests.
    if (mask == 0) {
      mask := amtc_fullMask();
    }
    return amtc_sanitizeMask(mask);
  }

  // Retained only for inputs that are known to contain the byte address.
  // Do not call this helper with RubyRequest.LineAddress.
  int getSector(Addr addr) {
    return amtc_sectorFromAddr(addr);
  }

  int amtc_singleSectorMaskFromId(int sid) {
    if (sid == 1) { return 2; }
    else { return 1; }
  }


  int amtc_payloadTokenMask(int t0, int t1) {
    int mask := 0;
    if (t0 > 0) { mask := mask + 1; }
    if (t1 > 0) { mask := mask + 2; }
    return mask;
  }

  void amtc_assertTokenBounds(int tokens) {
    assert(tokens >= 0);
    assert(tokens <= (max_tokens() / 2));
  }

  int sumAllTokens(Entry cache_entry) {
    return cache_entry.TokensSec0 + cache_entry.TokensSec1;
  }

  DataBlock getDataBlock(Addr addr), return_by_ref="yes" {
    TBE tbe := TBEs.lookup(addr);
    if(is_valid(tbe)) { return tbe.DataBlk; }
    else { return getCacheEntry(addr).DataBlk; }
  }

  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    if (is_valid(tbe)) { return tbe.TBEState; }
    else if (is_valid(cache_entry)) { return cache_entry.CacheState; }
    return State:I;
  }

  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    if (is_valid(tbe)) { tbe.TBEState := state; }
    if (is_valid(cache_entry)) { cache_entry.CacheState := state; }
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs.lookup(addr);
    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(tbe)) { testAndRead(addr, tbe.DataBlk, pkt); }
    else if (is_valid(cache_entry)) { testAndRead(addr, cache_entry.DataBlk, pkt); }
    else { functionalMemoryRead(pkt); }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    TBE tbe := TBEs.lookup(addr);
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes + testAndWrite(addr, tbe.DataBlk, pkt);
    }
    num_functional_writes := num_functional_writes + functionalMemoryWrite(pkt);
    return num_functional_writes;
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs.lookup(addr);
    if(is_valid(tbe)) { return TCP_State_to_permission(tbe.TBEState); }
    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) { return TCP_State_to_permission(cache_entry.CacheState); }
    return AccessPermission:NotPresent;
  }

  bool isValid(Addr addr) {
      AccessPermission perm := getAccessPermission(addr);
      if (perm == AccessPermission:NotPresent ||
          perm == AccessPermission:Invalid ||
          perm == AccessPermission:Busy) {
          return false;
      } else {
          return true;
      }
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(TCP_State_to_permission(state));
    }
  }

  void recordRequestType(RequestType request_type, Addr addr) {
    if (request_type == RequestType:DataArrayRead) { L1cache.recordRequestType(CacheRequestType:DataArrayRead, addr); }
    else if (request_type == RequestType:DataArrayWrite) { L1cache.recordRequestType(CacheRequestType:DataArrayWrite, addr); }
    else if (request_type == RequestType:TagArrayRead) { L1cache.recordRequestType(CacheRequestType:TagArrayRead, addr); }
    else if (request_type == RequestType:TagArrayFlash) { L1cache.recordRequestType(CacheRequestType:TagArrayRead, addr); }
    else if (request_type == RequestType:TagArrayWrite) { L1cache.recordRequestType(CacheRequestType:TagArrayWrite, addr); }
  }

  bool checkResourceAvailable(RequestType request_type, Addr addr) {
    if (request_type == RequestType:DataArrayRead) { return L1cache.checkResourceAvailable(CacheResourceType:DataArray, addr); }
    else if (request_type == RequestType:DataArrayWrite) { return L1cache.checkResourceAvailable(CacheResourceType:DataArray, addr); }
    else if (request_type == RequestType:TagArrayRead) { return L1cache.checkResourceAvailable(CacheResourceType:TagArray, addr); }
    else if (request_type == RequestType:TagArrayWrite) { return L1cache.checkResourceAvailable(CacheResourceType:TagArray, addr); }
    else if (request_type == RequestType:TagArrayFlash) { return L1cache.checkResourceAvailable(CacheResourceType:TagArray, addr); }
    else { error("Invalid RequestType type"); return true; }
  }



  // ==========================================================
  // Out Ports
  // ==========================================================
  out_port(requestNetwork_out, RequestMsg, requestFromTCP);
  out_port(responseNetwork_out, ResponseMsg, responseFromTCP);

  // ==========================================================
  // In Ports
  // ==========================================================
  in_port(responseToTCP_in, ResponseMsg, responseToTCP) {
    if (responseToTCP_in.isReady(clockEdge())) {
      peek(responseToTCP_in, ResponseMsg, block_on="addr") {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs.lookup(in_msg.addr);
        DPRINTF(RubySlicc, "In responseToTCP_in with %s\n", in_msg);

        if (in_msg.Type == CoherenceResponseType:DATA_SHARED ||
            in_msg.Type == CoherenceResponseType:DATA_OWNER) {

          // Atomic responses use the same AMTC data response type, but the
          // pending TCP TBE is in State:A.  Complete them with
          // coalescer.atomicCallback() instead of the normal read/fill path.
          if (getState(tbe, cache_entry, in_msg.addr) == State:A) {
            DPRINTF(RubySlicc,
                    "AMTC_TCP_ATOMIC_DATA_IN addr=%#x type=%s sender=%s\n",
                    in_msg.addr, in_msg.Type, in_msg.Sender);
            trigger(Event:AtomicData, in_msg.addr, cache_entry, tbe);

          } else if (disableL1 || in_msg.isGLCSet || in_msg.isSLCSet) {
              trigger(Event:Bypass, in_msg.addr, cache_entry, tbe);
          } else {
            if (is_valid(cache_entry) || L1cache.cacheAvail(in_msg.addr)) {
              trigger(Event:Data_Shared, in_msg.addr, cache_entry, tbe);
            } else {
              Addr victim := L1cache.cacheProbe(in_msg.addr);
              trigger(Event:Repl, victim, getCacheEntry(victim), TBEs.lookup(victim));
            }
          }
        } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER &&
                   in_msg.TokensSec0 == 0 &&
                   in_msg.TokensSec1 == 0 &&
                   in_msg.valid_sector_mask == 0 &&
                   in_msg.token_sector_mask == 0) {
            DPRINTF(RubySlicc,
                    "AMTC_TCP_STALE_OWNER_ACK_IN addr=%#x sender=%s mask=%d ",
                    in_msg.addr, in_msg.Sender, in_msg.requested_sector_mask);
            trigger(Event:StaleOwnerAck, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:ACK) {
            trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
        } else {
          error("Unexpected Response Message to Core");
        }
      }
    }
  }

  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...") {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest, block_on="LineAddress") {
        Entry cache_entry := getCacheEntry(in_msg.LineAddress);
        TBE tbe := TBEs.lookup(in_msg.LineAddress);

        // 1. FLUSH & No-Addr Requests
        if (in_msg.Type == RubyRequestType:hasNoAddr || in_msg.Type == RubyRequestType:FLUSH) {
          // Unblock the frontend which owns this request.  VIPERCoalescer's
          // AMTC-msg signature is readCallback(Addr, MachineType, DataBlock,
          // bool), where the final bool records hit/external-hit status.
          if (use_seq_not_coal) {
            sequencer.readCallback(in_msg.LineAddress, cache_entry.DataBlk,
                                   true, MachineType:L1Cache);
          } else {
            coalescer.readCallback(in_msg.LineAddress, MachineType:L1Cache,
                                   cache_entry.DataBlk, true);
          }
          mandatoryQueue_in.dequeue(clockEdge());
        }
        // 2. Standard Loads.  A TCP line in V is a hit only when every
        // requested 32-byte sector is locally valid.
        else if (in_msg.Type == RubyRequestType:LD) {
          int needed_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                        in_msg.PhysicalAddress,
                                                        in_msg.Size);
          int local_valid_mask := 0;
          if (is_valid(cache_entry)) {
            local_valid_mask := cache_entry.ValidSectors;
          }
          DPRINTF(RubySlicc,
                  "AMTC_TCP_MANDATORY_MASK line=%#x phys=%#x size=%d mask=%d type=%s valid=%d\n",
                  in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                  needed_mask, in_msg.Type, local_valid_mask);

          if (is_valid(cache_entry) &&
              getState(tbe, cache_entry, in_msg.LineAddress) == State:V &&
              amtc_maskContainsAll(cache_entry.ValidSectors, needed_mask)) {
            trigger(Event:Load, in_msg.LineAddress, cache_entry, tbe);
          } else {
            trigger(Event:LoadMiss, in_msg.LineAddress, cache_entry, tbe);
          }
        }
        // 3a. GPU atomics that require the real atomic protocol path.
        // ATOMIC_RETURN must return the pre-RMW value to GPUCoalescer, so do
        // not collapse it into the store/write-through path.
        else if (in_msg.Type == RubyRequestType:ATOMIC_RETURN ||
                 in_msg.Type == RubyRequestType:ATOMIC_NO_RETURN) {
          DPRINTF(RubySlicc,
                  "AMTC_TCP_ATOMIC_IN line=%#x phys=%#x size=%d type=%s seq=%llu\n",
                  in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                  in_msg.Type, in_msg.instSeqNum);
          trigger(Event:Atomic, in_msg.LineAddress, cache_entry, tbe);
        }
        // 3b. Stores and legacy RubyRequestType:ATOMIC.  Keep the existing
        // write-through behavior for the generic ATOMIC case to avoid
        // regressing earlier AMTC functional tests.
        else if (in_msg.Type == RubyRequestType:ST ||
                 in_msg.Type == RubyRequestType:ATOMIC) {
          int needed_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                        in_msg.PhysicalAddress,
                                                        in_msg.Size);
          int local_valid_mask := 0;
          if (is_valid(cache_entry)) {
            local_valid_mask := cache_entry.ValidSectors;
          }
          DPRINTF(RubySlicc,
                  "AMTC_TCP_MANDATORY_MASK line=%#x phys=%#x size=%d mask=%d type=%s valid=%d\n",
                  in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                  needed_mask, in_msg.Type, local_valid_mask);

          if (is_valid(cache_entry) &&
              getState(tbe, cache_entry, in_msg.LineAddress) == State:V &&
              amtc_maskContainsAll(cache_entry.ValidSectors, needed_mask)) {
            trigger(Event:StoreThrough, in_msg.LineAddress, cache_entry, tbe);
          } else {
            trigger(Event:StoreNoAlloc, in_msg.LineAddress, cache_entry, tbe);
          }
        }
        // 4. Replacements & Invalidations
        else if (in_msg.Type == RubyRequestType:REPLACEMENT) {
          // Kernel-launch INV_L1 MemSyncReq reaches TCP as a replacement-style
          // local invalidate.  It must complete with sequencer.invL1Callback(),
          // mirroring AMTC-SQC's Evict path, otherwise GPUDispatcher waits
          // forever with outstandingInvs > 0.
          DPRINTF(RubySlicc,
                  "AMTC_TCP_MANDATORY_REPLACEMENT_INV addr=%#x type=%s state=%s\n",
                  in_msg.LineAddress, in_msg.Type, getState(tbe, cache_entry, in_msg.LineAddress));
          trigger(Event:Local_Repl, in_msg.LineAddress, cache_entry, tbe);
        } else if (in_msg.Type == RubyRequestType:InvL2) {
          trigger(Event:InvL2, in_msg.LineAddress, cache_entry, tbe);
        }
        // 5. Catch-All Safety Net
        else {
          DPRINTF(RubySlicc, "Dropping unsupported mandatory request %s\n", in_msg.Type);
          if (use_seq_not_coal) {
            sequencer.readCallback(in_msg.LineAddress, cache_entry.DataBlk,
                                   true, MachineType:L1Cache);
          } else {
            coalescer.readCallback(in_msg.LineAddress, MachineType:L1Cache,
                                   cache_entry.DataBlk, true);
          }
          mandatoryQueue_in.dequeue(clockEdge());
        }
      }
    }
  }

  in_port(requestNetwork_in, RequestMsg, probeToTCP, desc="Listen for CPU GETS/GETX") {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg, block_on="addr") {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs.lookup(in_msg.addr);

        if (in_msg.Type == CoherenceRequestType:GETX) {
          trigger(Event:CPU_GETX, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          trigger(Event:CPU_GETS, in_msg.addr, cache_entry, tbe);
        } else {
          requestNetwork_in.dequeue(clockEdge());
        }
      }
    }
  }

  // ==========================================================
  // Actions
  // ==========================================================

  // Invalidate exactly the sectors touched by the current mandatory
  // request.  The write-through action must run first so selected tokens and
  // data reach TCC before local ownership is cleared.
  action(ysm_invalidateMandatorySectors, "ysm",
         desc="invalidate sectors selected by mandatory PhysicalAddress/Size") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                  in_msg.PhysicalAddress,
                                                  in_msg.Size);
      if (is_valid(cache_entry)) {
        if (amtc_maskHasSector(req_mask, 0)) {
          cache_entry.TokensSec0 := 0;
        }
        if (amtc_maskHasSector(req_mask, 1)) {
          cache_entry.TokensSec1 := 0;
        }

        cache_entry.ValidSectors :=
            amtc_subtractMask(cache_entry.ValidSectors, req_mask);

        // TCP stores are write-through.  No modified data remains pending
        // after wt_writeThrough/wtna_writeThroughNoAlloc has enqueued it.
        cache_entry.Dirty := false;
        cache_entry.writeMask.clear();

        DPRINTF(RubySlicc,
                "AMTC_TCP_INVALIDATE_MANDATORY addr=%#x mask=%d remain=%d t0=%d t1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1);

        if (cache_entry.ValidSectors == 0) {
          assert(cache_entry.TokensSec0 == 0);
          assert(cache_entry.TokensSec1 == 0);
          L1cache.deallocate(address);
          unset_cache_entry();
        }
      }
    }
  }

  // Response-side and local cache-walk replacements reclaim a complete 64B
  // TCP allocation.  TCP data stores are write-through, so eviction only has
  // to return the exact sector-token payload before the tag is deallocated.
  action(rv_returnVictimTokensToTCC, "rvt",
         desc="return all TCP victim tokens to TCC before replacement") {
    if (is_valid(cache_entry)) {
      int token_mask := amtc_payloadTokenMask(cache_entry.TokensSec0,
                                               cache_entry.TokensSec1);
      if (token_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, issue_latency) {
          out_msg.addr := address;
          out_msg.sector_id := amtc_primarySectorFromMask(token_mask);
          out_msg.Sender := machineID;
          out_msg.Destination.add(mapAddressToRange(address, MachineType:TCC,
                                  TCC_select_low_bit, TCC_select_num_bits));
          out_msg.Type := CoherenceResponseType:WB_TOKENS;
          out_msg.MessageSize := MessageSizeType:Writeback_Control;
          out_msg.sector_mask := token_mask;
          out_msg.requested_sector_mask := token_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := token_mask;
          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := false;
          out_msg.isGLCSet := false;
          out_msg.isSLCSet := false;
        }
      }

      DPRINTF(RubySlicc,
              "AMTC_TCP_REPL_RETURN_TOKENS addr=%#x state=%s valid=%d mask=%d t0=%d t1=%d dirty=%d\n",
              address, getState(tbe, cache_entry, address),
              cache_entry.ValidSectors, token_mask,
              cache_entry.TokensSec0, cache_entry.TokensSec1,
              cache_entry.Dirty);

      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
    }
  }

  action(rv_deallocateVictim, "rvd",
         desc="deallocate complete TCP victim after token return") {
    if (is_valid(cache_entry)) {
      assert(cache_entry.TokensSec0 == 0);
      assert(cache_entry.TokensSec1 == 0);

      DPRINTF(RubySlicc,
              "AMTC_TCP_REPL_RECLAIM_WHOLE_LINE addr=%#x state=%s valid=%d\n",
              address, getState(tbe, cache_entry, address),
              cache_entry.ValidSectors);

      cache_entry.ValidSectors := 0;
      cache_entry.Dirty := false;
      cache_entry.writeMask.clear();
      L1cache.deallocate(address);
      unset_cache_entry();

      DPRINTF(RubySlicc,
              "AMTC_TCP_REPL_RECLAIM_DONE addr=%#x\n", address);
    } else {
      DPRINTF(RubySlicc,
              "AMTC_TCP_REPL_NO_LIVE_ENTRY addr=%#x state=%s\n",
              address, getState(tbe, cache_entry, address));
    }
  }

  action(ys_invalidateSector, "ys", desc="invalidate only requested sector") {
    if (is_valid(cache_entry)) {
      int sector := getSector(address);

      if (sector == 0) {
          cache_entry.TokensSec0 := 0;
          // Equivalent to: cache_entry.ValidSectors & 2;
          if (cache_entry.ValidSectors == 1) {
              cache_entry.ValidSectors := 0;
          } else if (cache_entry.ValidSectors == 3) {
              cache_entry.ValidSectors := 2;
          }
      } else {
          cache_entry.TokensSec1 := 0;
          // Equivalent to: cache_entry.ValidSectors & 1;
          if (cache_entry.ValidSectors == 2) {
              cache_entry.ValidSectors := 0;
          } else if (cache_entry.ValidSectors == 3) {
              cache_entry.ValidSectors := 1;
          }
      }

      // If both sectors are now invalid, destroy the line
      if (cache_entry.ValidSectors == 0) {
          cache_entry.writeMask.clear();
          L1cache.deallocate(address);
          unset_cache_entry();
      }
    } else {
      DPRINTF(RubySlicc,
              "AMTC_TCP_INVALIDATE_DROP_NO_CACHE_ENTRY addr=%#x state=%s\n",
              address,
              getState(tbe, cache_entry, address));
    }
  }

  action(rdi_replDropInvalid, "rdi", desc="drop replacement for already-invalid TCP line") {
    DPRINTF(RubySlicc,
            "AMTC_TCP_REPL_DROP_INVALID addr=%#x state=%s\n",
            address,
            getState(tbe, cache_entry, address));
  }

  action(n_issueRdBlk, "n", desc="Issue AMTC GETS for exact request sectors") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                  in_msg.PhysicalAddress,
                                                  in_msg.Size);
      enqueue(requestNetwork_out, RequestMsg, issue_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(in_msg.LineAddress,
                                MachineType:TCC, TCC_select_low_bit,
                                TCC_select_num_bits));
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.requested_sector_mask := req_mask;
        out_msg.sector_mask := req_mask;
        out_msg.is_gpu := true;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;

        DPRINTF(RubySlicc,
                "AMTC_TCP_GETS_OUT line=%#x phys=%#x size=%d mask=%d sid=%d\n",
                in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                req_mask, out_msg.sector_id);
      }
    }
  }

  action(at_atomicThrough, "at", desc="send GPU atomic request to AMTC TCC") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                  in_msg.PhysicalAddress,
                                                  in_msg.Size);

      enqueue(requestNetwork_out, RequestMsg, issue_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(in_msg.LineAddress,
                                MachineType:TCC, TCC_select_low_bit,
                                TCC_select_num_bits));
        out_msg.MessageSize := MessageSizeType:Data;

        if (in_msg.Type == RubyRequestType:ATOMIC_RETURN) {
          out_msg.Type := CoherenceRequestType:AtomicReturn;
        } else {
          assert(in_msg.Type == RubyRequestType:ATOMIC_NO_RETURN);
          out_msg.Type := CoherenceRequestType:AtomicNoReturn;
        }

        // Preserve the Ruby atomic operation descriptor.  TCC will consume
        // this mask with DataBlock::atomicPartial().
        out_msg.writeMask.clear();
        out_msg.writeMask.orMask(in_msg.writeMask);
        out_msg.instSeqNum := in_msg.instSeqNum;

        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.is_gpu := true;
        out_msg.is_atomic := true;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;

        DPRINTF(RubySlicc,
                "AMTC_TCP_ATOMIC_OUT line=%#x phys=%#x type=%s seq=%llu mask=%d sid=%d\n",
                in_msg.LineAddress, in_msg.PhysicalAddress, out_msg.Type,
                in_msg.instSeqNum, req_mask, out_msg.sector_id);
      }
    }
  }

  action(rb_bypassDone, "rb", desc="bypass L1 of read access") {
    peek(responseToTCP_in, ResponseMsg) {
      DataBlock tmp:= in_msg.DataBlk;
      if (use_seq_not_coal) {
        sequencer.readCallback(address, tmp, false, MachineType:L1Cache);
      } else {
        coalescer.readCallback(address, MachineType:L1Cache, tmp, false);
      }
      DPRINTF(RubySlicc,
              "AMTC_TCP_READ_CALLBACK_BYPASS addr=%#x use_seq=%d\n",
              address, use_seq_not_coal);
      if(is_valid(cache_entry)) { unset_cache_entry(); }
    }
  }

  action(rb_bypassDoneValidReclaim, "rbvr",
         desc="Complete bypass response while preserving valid TCP entry for token reclaim") {
    peek(responseToTCP_in, ResponseMsg) {
      DataBlock tmp := in_msg.DataBlk;

      DPRINTF(RubySlicc,
              "AMTC_TCP_BYPASS_VALID_RECLAIM_V85H addr=%#x state=%s valid=%d t0=%d t1=%d glc=%d slc=%d\n",
              address, getState(tbe, cache_entry, address),
              cache_entry.ValidSectors,
              cache_entry.TokensSec0,
              cache_entry.TokensSec1,
              in_msg.isGLCSet,
              in_msg.isSLCSet);

      if (use_seq_not_coal) {
        sequencer.readCallback(address, tmp, false, MachineType:L1Cache);
      } else {
        coalescer.readCallback(address, MachineType:L1Cache, tmp, false);
      }

      DPRINTF(RubySlicc,
              "AMTC_TCP_BYPASS_COALESCER_CALLBACK_V85I addr=%#x use_seq=%d\\n",
              address, use_seq_not_coal);
    }
  }



  action(wtna_writeThroughNoAlloc, "wtna",
         desc="write through exact request sectors without TCP allocation") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                  in_msg.PhysicalAddress,
                                                  in_msg.Size);
      enqueue(responseNetwork_out, ResponseMsg, issue_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.Sender := machineID;
        out_msg.DataBlk.copyPartial(in_msg.WTData, in_msg.writeMask);
        out_msg.Destination.add(mapAddressToRange(in_msg.LineAddress,
                                MachineType:TCC, TCC_select_low_bit,
                                TCC_select_num_bits));
        out_msg.MessageSize := MessageSizeType:Data;
        out_msg.Type := CoherenceResponseType:WB_SHARED_DATA;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := 0;
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.Dirty := false;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;

        DPRINTF(RubySlicc,
                "AMTC_TCP_WTNA_WB_SHARED_DATA line=%#x phys=%#x size=%d mask=%d glc=%d slc=%d\n",
                in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                req_mask, in_msg.isGLCSet, in_msg.isSLCSet);
      }
    }
  }

  action(wt_writeThrough, "wt",
         desc="write through cached request sectors and return selected tokens") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                  in_msg.PhysicalAddress,
                                                  in_msg.Size);
      int send_t0 := 0;
      int send_t1 := 0;
      if (amtc_maskHasSector(req_mask, 0)) {
        send_t0 := cache_entry.TokensSec0;
      }
      if (amtc_maskHasSector(req_mask, 1)) {
        send_t1 := cache_entry.TokensSec1;
      }

      WTcnt := WTcnt + 1;
      enqueue(responseNetwork_out, ResponseMsg, issue_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.Sender := machineID;
        assert(is_valid(cache_entry));
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Destination.add(mapAddressToRange(in_msg.LineAddress,
                                MachineType:TCC, TCC_select_low_bit,
                                TCC_select_num_bits));
        out_msg.MessageSize := MessageSizeType:Data;
        out_msg.Type := CoherenceResponseType:WB_SHARED_DATA;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := amtc_payloadTokenMask(send_t0, send_t1);
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.Dirty := false;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;

        DPRINTF(RubySlicc,
                "AMTC_TCP_WT_WB_SHARED_DATA line=%#x phys=%#x size=%d mask=%d t0=%d t1=%d\n",
                in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size,
                req_mask, send_t0, send_t1);
      }
    }
  }

  action(a_allocate, "a", desc="allocate and initialize TCP block") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L1cache.allocate(address, new Entry));
      cache_entry.CacheState := State:I;
      cache_entry.Dirty := false;
      cache_entry.FromL2 := false;
      cache_entry.ValidSectors := 0;
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
      cache_entry.retry_count := 0;
      cache_entry.writeMask.clear();
    }
  }

  action(t_allocateTBE, "t", desc="allocate TBE Entry") {
    check_allocate(TBEs);
    TBEs.allocate(address);
    set_tbe(TBEs.lookup(address));
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest) {
        tbe.isGLCSet := in_msg.isGLCSet;
        tbe.isSLCSet := in_msg.isSLCSet;
      }
    }
  }

  action(d_deallocateTBE, "d", desc="Deallocate TBE") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(p_popMandatoryQueue, "pm", desc="Pop Mandatory Queue") { mandatoryQueue_in.dequeue(clockEdge()); }
  action(pr_popResponseQueue, "pr", desc="Pop Response Queue") { responseToTCP_in.dequeue(clockEdge()); }
  action(st_stallAndWaitRequest, "st", desc="Stall and wait on the address") { stall_and_wait(mandatoryQueue_in, address); }

  action(l_loadDoneHit, "ldh", desc="local load done (hits in TCP)") {
    assert(is_valid(cache_entry));
    if (use_seq_not_coal) {
      sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L1Cache);
    } else {
      coalescer.readCallback(address, MachineType:L1Cache,
                             cache_entry.DataBlk, true);
    }
    DPRINTF(RubySlicc,
            "AMTC_TCP_READ_CALLBACK_HIT addr=%#x use_seq=%d\n",
            address, use_seq_not_coal);
  }

  action(l_loadDoneMiss, "ldm", desc="local load done (misses in TCP)") {
    assert(is_valid(cache_entry));
    if (use_seq_not_coal) {
      sequencer.readCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);
    } else {
      coalescer.readCallback(address, MachineType:L1Cache,
                             cache_entry.DataBlk, false);
    }
    DPRINTF(RubySlicc,
            "AMTC_TCP_READ_CALLBACK_MISS addr=%#x use_seq=%d\n",
            address, use_seq_not_coal);
  }

  action(ad_atomicDone, "ad", desc="complete GPU atomic using returned TCC DataBlock") {
    peek(responseToTCP_in, ResponseMsg) {
      assert(!use_seq_not_coal);
      coalescer.atomicCallback(address, MachineType:L1Cache, in_msg.DataBlk);
      DPRINTF(RubySlicc,
              "AMTC_TCP_ATOMIC_CALLBACK addr=%#x sender=%s\n",
              address, in_msg.Sender);
    }
  }

  action(s_storeDoneHit, "sdh", desc="local store done (hits in TCP)") {
    assert(is_valid(cache_entry));
    if (use_seq_not_coal) {
      sequencer.writeCallback(address, cache_entry.DataBlk, true,
                              MachineType:L1Cache);
    } else {
      coalescer.writeCallback(address, MachineType:L1Cache,
                              cache_entry.DataBlk);
    }
    DPRINTF(RubySlicc,
            "AMTC_TCP_WRITE_CALLBACK_HIT addr=%#x use_seq=%d\n",
            address, use_seq_not_coal);
    cache_entry.Dirty := true;
  }

  action(sna_storeDoneMissNoAlloc, "sna", desc="local store done (misses in TCP)") {
    peek(mandatoryQueue_in, RubyRequest) {
      DataBlock tmp := in_msg.WTData;
      if (use_seq_not_coal) {
        sequencer.writeCallback(address, tmp, false, MachineType:L1Cache);
      } else {
        coalescer.writeCallback(address, MachineType:L1Cache, tmp);
      }
      DPRINTF(RubySlicc,
              "AMTC_TCP_WRITE_CALLBACK_MISS addr=%#x use_seq=%d\n",
              address, use_seq_not_coal);
    }
  }

  action(il2_invL2, "il2", desc="Invalidate address in L2") {
    enqueue(requestNetwork_out, RequestMsg, issue_latency) {
      out_msg.addr := address;
      out_msg.sector_id := getSector(address);
      out_msg.Requestor := machineID;
      out_msg.Destination.add(mapAddressToRange(address,MachineType:TCC,
                              TCC_select_low_bit, TCC_select_num_bits));
      out_msg.MessageSize := MessageSizeType:Request_Control;
      out_msg.sector_mask := amtc_singleSectorMaskFromId(out_msg.sector_id);
      out_msg.requested_sector_mask := out_msg.sector_mask;
      out_msg.is_gpu := true;
      peek(mandatoryQueue_in, RubyRequest) {
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;
      }
    }
  }

  action(ack_implicitDone, "ack", desc="Implicit completion for AMTC phase 1") {}

  action(inv_invDone, "inv", desc="complete kernel launch INV_L1 / local replacement invalidate") {
    DPRINTF(RubySlicc,
            "AMTC_TCP_KERNEL_INV_DONE addr=%#x state=%s\n",
            address, getState(tbe, cache_entry, address));
    sequencer.invL1Callback();
  }

  action(dw_dirtyWrite, "dw", desc="update write mask"){
    peek(mandatoryQueue_in, RubyRequest) {
      cache_entry.DataBlk.copyPartial(in_msg.WTData,in_msg.writeMask);
      cache_entry.writeMask.orMask(in_msg.writeMask);
    }
  }

  action(w_writeCache, "w", desc="write data to cache") {
    peek(responseToTCP_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      DataBlock tmp := in_msg.DataBlk;
      tmp.copyPartial(cache_entry.DataBlk, cache_entry.writeMask);
      cache_entry.DataBlk := tmp;
    }
  }

  action(mru_updateMRU, "mru", desc="Touch block for replacement policy") { L1cache.setMRU(address); }

  action(tk_initTcpTokensOnFill, "tk", desc="Initialize exact TCP tokens from response") {
    peek(responseToTCP_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // 1. Exact Quantitative Copy (No Invention)
      cache_entry.TokensSec0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      // 2. Strict Bounds Checking
      amtc_assertTokenBounds(cache_entry.TokensSec0);
      amtc_assertTokenBounds(cache_entry.TokensSec1);
      assert(sumAllTokens(cache_entry) <= max_tokens());

      // 3. Update Qualitative Local 2-Bit Mask (1 = S0, 2 = S1) without bitwise operators.
      // Data validity follows valid_sector_mask; token counts are quantitative.
      if (in_msg.valid_sector_mask == 1 || in_msg.valid_sector_mask == 3) {
          if (cache_entry.ValidSectors == 0) {
              cache_entry.ValidSectors := 1;
          } else if (cache_entry.ValidSectors == 2) {
              cache_entry.ValidSectors := 3;
          }
      }
      if (in_msg.valid_sector_mask == 2 || in_msg.valid_sector_mask == 3) {
          if (cache_entry.ValidSectors == 0) {
              cache_entry.ValidSectors := 2;
          } else if (cache_entry.ValidSectors == 1) {
              cache_entry.ValidSectors := 3;
          }
      }

      // Check Sector 0: Is invalid if mask is currently 0 or 2
      if (in_msg.TokensSec0 > 0) {
          if (cache_entry.ValidSectors == 0) {
              cache_entry.ValidSectors := 1;
          } else if (cache_entry.ValidSectors == 2) {
              cache_entry.ValidSectors := 3;
          }
      }

      // Check Sector 1: Is invalid if mask is currently 0 or 1
      if (in_msg.TokensSec1 > 0) {
          if (cache_entry.ValidSectors == 0) {
              cache_entry.ValidSectors := 2;
          } else if (cache_entry.ValidSectors == 1) {
              cache_entry.ValidSectors := 3;
          }
      }
    }
  }

  action(y_yieldTokensToCPU, "y", desc="Yield requested sector tokens and data") {
    peek(requestNetwork_in, RequestMsg) {
      int req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                         in_msg.sector_id);
      if (req_mask == 0) { req_mask := amtc_fullMask(); }

      int send_t0 := 0;
      int send_t1 := 0;

      if (is_valid(cache_entry)) {
        if (amtc_maskHasSector(req_mask, 0)) { send_t0 := cache_entry.TokensSec0; }
        if (amtc_maskHasSector(req_mask, 1)) { send_t1 := cache_entry.TokensSec1; }
      }

      if (send_t0 > 0 || send_t1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, 1) {
          out_msg.addr := address;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.valid_sector_mask := req_mask;
          out_msg.token_sector_mask := amtc_payloadTokenMask(send_t0, send_t1);
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          if ((amtc_maskHasSector(req_mask, 0) && send_t0 == (max_tokens() / 2)) ||
              (amtc_maskHasSector(req_mask, 1) && send_t1 == (max_tokens() / 2))) {
            out_msg.Type := CoherenceResponseType:DATA_OWNER;
          } else {
            out_msg.Type := CoherenceResponseType:DATA_SHARED;
          }
          out_msg.MessageSize := MessageSizeType:Response_Data;
        }

        if (amtc_maskHasSector(req_mask, 0)) { cache_entry.TokensSec0 := 0; }
        if (amtc_maskHasSector(req_mask, 1)) { cache_entry.TokensSec1 := 0; }

        cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, req_mask);
        if (cache_entry.ValidSectors == 0) {
          cache_entry.writeMask.clear();
          L1cache.deallocate(address);
          unset_cache_entry();
        }

        assert(sumAllTokens(cache_entry) <= max_tokens());
        DPRINTF(RubySlicc,
                "AMTC_TCP_YIELD_DATA addr=%#x req=%s mask=%d t0=%d t1=%d\n",
                address, in_msg.Requestor, req_mask, send_t0, send_t1);
      } else {
        enqueue(responseNetwork_out, ResponseMsg, 1) {
          out_msg.addr := address;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := 0;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.Dirty := false;
          out_msg.TokensSec0 := 0;
          out_msg.TokensSec1 := 0;
          out_msg.Type := CoherenceResponseType:ACK_OWNER;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }

        DPRINTF(RubySlicc,
                "AMTC_TCP_STALE_OWNER_ACK_OUT addr=%#x req=%s mask=%d state=%s\n",
                address, in_msg.Requestor, req_mask,
                getState(tbe, cache_entry, address));
      }
    }
  }

  action(q_popRequestQueue, "qrq", desc="Pop the incoming CPU request queue") { requestNetwork_in.dequeue(clockEdge()); }
  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss"){ L1cache.profileDemandMiss(); }
  action(uu_profileDataHit, "\udh", desc="Profile the demand hit"){ L1cache.profileDemandHit(); }

  action(zz_traceTokens, "zz", desc="Trace token state to protocol_trace.out") {
    if (is_valid(cache_entry)) {
      DPRINTF(RubySlicc, "TCP TRACE addr=%#x State=%s S0=%d S1=%d ValidMask=%d\n",
              address,
              getState(tbe, cache_entry, address),
              cache_entry.TokensSec0,
              cache_entry.TokensSec1,
              cache_entry.ValidSectors);
    } else {
      DPRINTF(RubySlicc, "TCP TRACE addr=%#x State=%s (Not Present/Null Entry)\n",
              address,
              getState(tbe, cache_entry, address));
    }
  }

  action(wada_wakeUpAllDependentsAddr, "wada", desc="Wake up any requests waiting for this address") {
    wakeUpAllBuffers(address);
  }

  action(inv_invDoneIfPending, "invp",
        desc="Complete local TCP invalidate only if sequencer has pending cache-walk invalidate") {
    DPRINTF(RubySlicc,
            "AMTC_TCP_KERNEL_INV_DONE_IF_PENDING addr=%#x\n",
            address);

    sequencer.invL1CallbackIfPending();
  }


  // ==========================================================
  // Transitions
  // ==========================================================

  transition(I, Load) {TagArrayRead} {
    n_issueRdBlk;
    uu_profileDataMiss;
    p_popMandatoryQueue;
  }

  transition({I, V}, LoadMiss) {TagArrayRead} {
    n_issueRdBlk;
    uu_profileDataMiss;
    p_popMandatoryQueue;
  }

  transition(V, Load) {TagArrayRead, DataArrayRead} {
    l_loadDoneHit;
    mru_updateMRU;
    uu_profileDataHit;
    p_popMandatoryQueue;
  }

  transition({I, V}, Atomic, A) {TagArrayRead} {
    t_allocateTBE;
    at_atomicThrough;
    p_popMandatoryQueue;
  }

  transition(A, AtomicData, I) {
    ad_atomicDone;
    d_deallocateTBE;
    pr_popResponseQueue;
  }

  transition(I, StoreThrough) {TagArrayRead, TagArrayWrite, DataArrayWrite} {
    sna_storeDoneMissNoAlloc;
    uu_profileDataMiss;
    wtna_writeThroughNoAlloc;
    p_popMandatoryQueue;
  }

  transition(I, StoreNoAlloc) {TagArrayRead, DataArrayWrite} {
    sna_storeDoneMissNoAlloc;
    uu_profileDataMiss;
    wtna_writeThroughNoAlloc;
    p_popMandatoryQueue;
  }

  transition(V, StoreNoAlloc) {TagArrayRead, TagArrayWrite, DataArrayWrite} {
    sna_storeDoneMissNoAlloc;
    uu_profileDataMiss;
    wtna_writeThroughNoAlloc;
    ysm_invalidateMandatorySectors;
    p_popMandatoryQueue;
  }

  transition(V, StoreThrough) {TagArrayRead, TagArrayWrite, DataArrayWrite} {
    dw_dirtyWrite;
    s_storeDoneHit;
    uu_profileDataHit;
    wt_writeThrough;
    ysm_invalidateMandatorySectors;
    p_popMandatoryQueue;
  }

  transition(I, Data_Shared, V) {TagArrayRead, TagArrayWrite, DataArrayRead, DataArrayWrite} {
    a_allocate;
    w_writeCache;
    tk_initTcpTokensOnFill;
    l_loadDoneMiss;
    pr_popResponseQueue;
    zz_traceTokens;
  }

  transition(I, Bypass) {
    rb_bypassDone;
    pr_popResponseQueue;
  }

  /*
   * V85H: Bypass is response classification, not proof that the TCP tag is
   * absent.  If a TCP copy is V, complete this bypassed request from the
   * returned data, then reclaim the old TCP line exactly like replacement:
   * return every real token to TCC before deallocation.
   */
  transition(V, Bypass, I) {TagArrayRead, TagArrayWrite} {
    rb_bypassDoneValidReclaim;
    rv_returnVictimTokensToTCC;
    rv_deallocateVictim;
    pr_popResponseQueue;
  }


  // A sector miss can return while another sector of the same 64B line is
  // already valid.  Merge the response, absorb its exact tokens, and complete
  // the original load rather than silently dropping the response.
  transition(V, Data_Shared, V) {TagArrayRead, TagArrayWrite, DataArrayRead, DataArrayWrite} {
    w_writeCache;
    tk_initTcpTokensOnFill;
    l_loadDoneMiss;
    mru_updateMRU;
    pr_popResponseQueue;
    zz_traceTokens;
  }

  // Reclaim the complete victim allocation.  The input that selected Repl
  // remains queued and retries after the tag has been freed.
  transition(I, Repl, I) {TagArrayRead, TagArrayWrite} {
    rv_returnVictimTokensToTCC;
    rv_deallocateVictim;
  }

  transition(V, Repl, I) {TagArrayRead, TagArrayWrite} {
    rv_returnVictimTokensToTCC;
    rv_deallocateVictim;
  }

  // Local cache-walk invalidation also returns ownership before removing the
  // complete TCP line, then consumes the mandatory request and completes the
  // pending dispatcher invalidate.
  transition(I, Local_Repl, I) {TagArrayRead, TagArrayWrite} {
    rv_returnVictimTokensToTCC;
    rv_deallocateVictim;
    inv_invDoneIfPending;
    p_popMandatoryQueue;
  }

  transition(V, Local_Repl, I) {TagArrayRead, TagArrayWrite} {
    rv_returnVictimTokensToTCC;
    rv_deallocateVictim;
    inv_invDoneIfPending;
    p_popMandatoryQueue;
  }

  transition(I, InvL2) {
    il2_invL2;
    p_popMandatoryQueue;
  }

  transition(V, InvL2, I) {
    ys_invalidateSector;
    il2_invL2;
    p_popMandatoryQueue;
  }

  transition({V, I}, Ack) {
    ack_implicitDone;
    pr_popResponseQueue;
  }

  transition({V, I}, StaleOwnerAck) {
    ack_implicitDone;
    pr_popResponseQueue;
  }

  transition(V, CPU_GETX, I) {TagArrayWrite, DataArrayWrite} {
    // y_yieldTokensToCPU already clears exactly the requested sectors and
    // deallocates the line when no valid sector remains.
    y_yieldTokensToCPU;
    q_popRequestQueue;
    zz_traceTokens;
  }

  transition(V, CPU_GETS, V) {
    y_yieldTokensToCPU;
    q_popRequestQueue;
  }

  transition(I, {CPU_GETS, CPU_GETX}) {
    q_popRequestQueue;
  }

}
