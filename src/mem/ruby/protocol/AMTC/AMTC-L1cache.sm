machine(MachineType:L1Cache, "Token protocol")
 : Sequencer * sequencer;
   CacheMemory * L1Icache;
   CacheMemory * L1Dcache;
   int l2_select_num_bits;
   int N_tokens;

   Cycles l1_request_latency := 2;
   Cycles l1_response_latency := 2;
   int retry_threshold := 1;
   Cycles fixed_timeout_latency := 100;
   Cycles reissue_wakeup_latency := 10;
   Cycles use_timeout_latency := 50;

   bool dynamic_timeout_enabled := "True";
   bool no_mig_atomic := "True";
   bool send_evictions;

   // Message Queues
   // From this node's L1 cache TO the network

   // a local L1 -> this L2 bank
   MessageBuffer * responseFromL1Cache, network="To", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentFromL1Cache, network="To", virtual_network="3",
        vnet_type="persistent";
   // a local L1 -> this L2 bank, currently ordered with directory forwarded requests
   MessageBuffer * requestFromL1Cache, network="To", virtual_network="1",
        vnet_type="request";

   // To this node's L1 cache FROM the network

   // a L2 bank -> this L1
   MessageBuffer * responseToL1Cache, network="From", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentToL1Cache, network="From", virtual_network="3",
        vnet_type="persistent";
   // a L2 bank -> this L1
   MessageBuffer * requestToL1Cache, network="From", virtual_network="1",
        vnet_type="request";

   MessageBuffer * mandatoryQueue;
{
  // STATES
  state_declaration(State, desc="Cache states", default="L1Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, "NP", desc="Not Present";
    I, AccessPermission:Invalid, "I", desc="Idle";
    S, AccessPermission:Read_Only, "S", desc="Shared";
    O, AccessPermission:Read_Only, "O", desc="Owned";
    M, AccessPermission:Read_Only, "M", desc="Modified (dirty)";
    MM, AccessPermission:Read_Write, "MM", desc="Modified (dirty and locally modified)";
    M_W, AccessPermission:Read_Only, "M_W", desc="Modified (dirty), waiting";
    MM_W, AccessPermission:Read_Write, "MM_W", desc="Modified (dirty and locally modified), waiting";

    // Transient States
    IM, AccessPermission:Busy, "IM", desc="Issued GetX";
    SM, AccessPermission:Read_Only, "SM", desc="Issued GetX, we still have an old copy of the line";
    OM, AccessPermission:Read_Only, "OM", desc="Issued GetX, received data";
    IS, AccessPermission:Busy, "IS", desc="Issued GetS";

    // Locked states
    I_L, AccessPermission:Busy, "I_L", desc="Invalid, Locked";
    S_L, AccessPermission:Busy, "S_L", desc="Shared, Locked";
    IM_L, AccessPermission:Busy, "IM_L", desc="Invalid, Locked, trying to go to Modified";
    SM_L, AccessPermission:Busy, "SM_L", desc="Shared, Locked, trying to go to Modified";
    IS_L, AccessPermission:Busy, "IS_L", desc="Invalid, Locked, trying to go to Shared";

    // ADD THESE MISSING TRANSIENT STATES:
    S_IM, AccessPermission:Busy, "S_IM",desc="Shared, waiting for tokens/data to upgrade to Modified";


    // Transient States for Sector Misses
    S_IS, AccessPermission:Busy, "S_IS", desc="Shared, waiting for sector GETS";
    O_IS, AccessPermission:Busy, "O_IS", desc="Owned, waiting for sector GETS";
    M_IS, AccessPermission:Busy, "M_IS", desc="Modified, waiting for sector GETS";
    M_IM, AccessPermission:Busy, "M_IM", desc="Modified, waiting for sector GETX";

    // Explicit Read Transients
    IS_WAIT_ALL, AccessPermission:Busy, "IS_W_ALL", desc="Waiting for data and tokens";
    IS_WAIT_DATA, AccessPermission:Busy, "IS_W_D", desc="Have tokens, waiting for data";
    IS_WAIT_TOKENS, AccessPermission:Busy, "IS_W_T", desc="Have data, waiting for tokens";

    // Explicit Write Transients
    IM_WAIT_PARTIAL, AccessPermission:Busy, "IM_W_P", desc="Waiting for initial data/tokens for Write";
    IM_WAIT_EXCL, AccessPermission:Busy, "IM_W_E", desc="Have data, waiting for remaining tokens (512)";

  }

  // EVENTS
  enumeration(Event, desc="Cache events") {
    Load,            desc="Load request from the processor";
    Ifetch,          desc="I-fetch request from the processor";
    Store,           desc="Store request from the processor";
    Atomic,          desc="Atomic request from the processor";
    L1_Replacement,  desc="L1 Replacement";

    // Responses
    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_No_Token,           desc="Received data-only shared response with no token for requested sector";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Data_All_Tokens,   desc="Received a data message, we are now the owner, we now have all the tokens";
    Ack,                     desc="Received an ack message";

    // Requests
    Transient_GETX,  desc="A GetX from another processor";
    Transient_Local_GETX,  desc="A GetX from another processor";
    Transient_GETS,  desc="A GetS from another processor";
    Transient_GETS_Owner_Pull, desc="Directory DMA-read data-only owner pull";
    Transient_Local_GETS,  desc="A GetS from another processor";
    Transient_GETS_Last_Token,  desc="A GetS from another processor";
    Transient_Local_GETS_Last_Token,  desc="A GetS from another processor";

    // Lock/Unlock for distributed
    Persistent_GETX,     desc="Another processor has priority to read/write";
    Persistent_GETS,     desc="Another processor has priority to read";
    Persistent_GETS_Last_Token, desc="Another processor has priority to read, no more tokens";
    Own_Lock_or_Unlock,  desc="This processor now has priority";

    // Triggers
    Request_Timeout,         desc="Timeout";
    Request_Timeout_Owner,   desc="Timeout when we already hold the tokens";
    Use_TimeoutStarverX,             desc="Timeout";
    Use_TimeoutStarverS,             desc="Timeout";
    Use_TimeoutNoStarvers,             desc="Timeout";
    Use_TimeoutNoStarvers_NoMig,     desc="Timeout Don't Migrate";

    Load_Sector_Miss,  desc="Load request for a missing sector";
    Store_Sector_Miss, desc="Store/Atomic request for a missing sector";
    Completion_Shared, desc="Received shaed data complete message";
    Check_Completion, desc="Internal trigger to re-evaluate state";

    // ADD THESE PHASE 2 EVENTS:
    Ack_Owner,              desc="Received an owner ack message (no data)";
    Stale_Owner_Ack,        desc="Zero-token owner ACK in read wait; request owner-pull data fallback";
    Stale_Owner_Write_Ack,  desc="Zero-token owner ACK in write wait; ignore and let GETX retry";
    Ack_All_Tokens,         desc="Received token-only ack with all requested tokens";
    Load_Hit,   desc="Load hits locally";
    Load_Miss,  desc="Load misses locally";
    Store_Hit,  desc="Store hits locally";
    Store_Miss, desc="Store misses locally";

  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    DataBlock DataBlk,       desc="data for the block";

    // AMTC per-sector metadata for a 64B Ruby line split into 2 x 32B sectors.
    // These fields are metadata-only in the first CPU-only baseline; the
    // original line-token behavior remains authoritative until mask-native
    // transitions are enabled.
    int ValidSectors, default="0", desc="AMTC valid-sector mask; default full line";
    int DirtySectors, default="0", desc="AMTC dirty-sector mask";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";
  }



  // TBE fields
  structure(TBE, desc="...") {
    Addr addr,                      desc="Physical address for this TBE";
    State TBEState,                       desc="Transient state";
    int IssueCount,      default="0",     desc="The number of times we've issued a request for this line.";
    Addr PC,                           desc="Program counter of request";

    bool WentPersistent, default="false",  desc="Request went persistent";
    bool ExternalResponse, default="false", desc="Response came from an external controller";
    bool IsAtomic, default="false",       desc="Request was an atomic request";

    // AMTC TBE sector tracking. Defaults preserve full-line MOESI_CMP_token
    // behavior. Later CPU-sector work should narrow RequestedSectorMask to
    // one or more 32B sectors.
    int RequestedSectorMask, default="3", desc="AMTC requested sector mask";
    int ReceivedSectorMask, default="0", desc="AMTC sectors with data received";
    int TokenReadySectorMask, default="0", desc="AMTC sectors with token condition satisfied";
    int InstalledSectorMask, default="0", desc="AMTC sectors installed in cache";
    int RespondedSectorMask, default="0", desc="AMTC sectors responded upward";
    int LastSectorID, default="0", desc="AMTC primary sector id";
    bool HasOutstandingRequest, default="false", desc="AMTC live request pending";
    bool CallbackIssued, default="false", desc="AMTC sequencer callback issued";

    // Reserved GPU-ready fields. They are intentionally unused in the CPU-only
    // bring-up, but keep AMTC messages/TBEs compatible with future VIPER TCP/TCC.
    bool FromGPU, default="false", desc="Future GPU-originated request";
    bool IsSyncRequest, default="false", desc="Future coherent sync/fence/signal request";
    bool IsBypassRequest, default="false", desc="Future GPU bypass request";
    bool IsAtomicRequest, default="false", desc="Future atomic request";
    bool IsSignalRequest, default="false", desc="Future HSA signal/doorbell request";
    int CURequestor, default="0", desc="Future GPU CU id";
    int Wfid, default="0", desc="Future GPU wavefront id";
    int InstSeqNum, default="0", desc="Future GPU instruction sequence number";

    AccessType TypeOfAccess,
                desc="Type of request (used for profiling)";
    Cycles IssueTime,                       desc="Time the request was issued";
    RubyAccessMode AccessMode,    desc="user/supervisor access type";
    PrefetchBit Prefetch,         desc="Is this a prefetch request";

    int TargetMask,        desc="The original mask the CPU requested";
    int CompletedMask,     desc="The mask of sectors we have successfully written";
    DataBlock PendingData, desc="Temporary buffer to hold CPU data while waiting";

    Cycles LastIssueTime, default="Cycles(0)", desc="Time the most recent request/reissue was sent";
    bool ForwardProgressFlag, default="false", desc="True if a partial packet arrived in the current timeout window";
    int NoProgressTimeouts, default="0", desc="Consecutive full timeout windows without any forward progress";
    bool InitialRequestIssued, default="false", desc="Strict single-request guard for passive L1 convergence";
    bool OwnerPullIssued, default="false", desc="AMTC request/retry was sent as owner-pull data-only recovery";
    bool SharedReady, default="false", desc="Centralized completion: shared readiness satisfied";
    bool ExclusiveReady, default="false", desc="Centralized completion: exclusive readiness satisfied";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  structure(PersistentTable, external="yes") {
    void persistentRequestLock(Addr, MachineID, AccessType);
    void persistentRequestUnlock(Addr, MachineID);
    bool okToIssueStarving(Addr, MachineID);
    MachineID findSmallest(Addr);
    AccessType typeOfSmallest(Addr);
    void markEntries(Addr);
    bool isLocked(Addr);
    int countStarvingForAddress(Addr);
    int countReadStarvingForAddress(Addr);
  }

  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);
  Cycles curCycle();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  TBETable L1_TBEs, template="<L1Cache_TBE>", constructor="m_number_of_TBEs";

  bool starving, default="false";
  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  PersistentTable persistentTable;
  TimerTable useTimerTable;
  TimerTable reissueTimerTable;

  int outstandingRequests, default="0";
  int outstandingPersistentRequests, default="0";

  // Constant that provides hysteresis for calculated the estimated average
  int averageLatencyHysteresis, default="(8)";
  // Keep the default hysteresis at 8, but avoid bitwise shift operators
  // in SLICC-generated code. 500 * 256 = 128000.
  Cycles averageLatencyCounter,
        default="(Cycles(128000))";

  Cycles averageLatencyEstimate() {
    // No bitwise operators and no Cycles(...) constructor inside SLICC code.
    // SLICC lowers Cycles(...) in method bodies to an unknown helper name
    // such as Cycles_Cycles, so use the already-typed protocol parameter.
    // For AMTC bring-up we keep the timeout estimate fixed and conservative.
    Cycles estimated_average := fixed_timeout_latency;
    DPRINTF(RubySlicc, "%d\n", estimated_average);
    return estimated_average;
  }

  void updateAverageLatencyEstimate(Cycles latency) {
    // Keep this hook for profiling, but do not update averageLatencyCounter
    // during bring-up.  This avoids Cycles/integer conversion issues in
    // generated C++ and keeps the reissue timeout deterministic.
    DPRINTF(RubySlicc, "%d\n", latency);
  }

  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    if(is_valid(L1Dcache_entry)) {
      return L1Dcache_entry;
    }

    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  Entry getL1DCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    return L1Dcache_entry;
  }

  Entry getL1ICacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  // ----------------------------------------------------------------------
  // AMTC mask helpers for the trimmed prototype.
  // Physical Ruby block: 64B. Logical AMTC sectors: 2 x 32B.
  // sector_id 0 -> mask 1 (bytes 0..31), sector_id 1 -> mask 2
  // (bytes 32..63), full-line mask -> 3.
  // Keep field names unchanged so L2/Directory can still compile while the
  // L1 implementation avoids 4-sector metadata overhead.
  // ----------------------------------------------------------------------

  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_calculateNeededMask(int offset, int size) {
    if (size == 0) { return 0; }
    int end_offset := offset + size - 1;
    int mask := 0;
    if (offset < 32) { mask := mask + 1; }
    if ((offset < 64) && (end_offset >= 32)) { mask := mask + 2; }
    return mask;
  }

  int amtc_sanitizeMask(int mask) {
    // Accept old full-line defaults such as 15 from untrimmed controllers, but
    // collapse them to the two valid 32B sectors used by this L1.
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    // 64B Ruby line, 2 x 32B sectors.
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  // Audit78: sectors with all per-sector tokens are exclusive/writeable.
  // Dirty data may exist in owner/read-only states with partial tokens, but
  // MM/MM_W must not claim read-write permission for a dirty sector unless
  // the full token set for that sector is locally present.
  int amtc_exclusiveTokenMask(Entry cache_entry) {
    int result := 0;
    int tokens_per_sector := max_tokens() / 2;

    if (cache_entry.TokensSec0 == tokens_per_sector) {
      result := amtc_unionMasks(result, 1);
    }
    if (cache_entry.TokensSec1 == tokens_per_sector) {
      result := amtc_unionMasks(result, 2);
    }

    return result;
  }

  int amtc_nonExclusiveDirtyMask(Entry cache_entry) {
    int result := 0;
    int excl_mask := amtc_exclusiveTokenMask(cache_entry);

    if (amtc_maskHasSector(cache_entry.DirtySectors, 0) &&
        !amtc_maskHasSector(excl_mask, 0)) {
      result := amtc_unionMasks(result, 1);
    }
    if (amtc_maskHasSector(cache_entry.DirtySectors, 1) &&
        !amtc_maskHasSector(excl_mask, 1)) {
      result := amtc_unionMasks(result, 2);
    }

    return result;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);

    if (active == 0) {
      // No data payload! Just a network header.
      return MessageSizeType:Response_Control;
    }
    else if (active == 1) {
      // Half-line payload
      return MessageSizeType:Response_Sector2_Data;
    }

    // Full-line payload (active == 2)
    return MessageSizeType:Response_Data;
  }

  bool amtc_isSectorAvailable(int valid_mask, Addr addr) {
    int req_sid := amtc_sectorFromAddr(addr);
    return amtc_maskHasSector(valid_mask, req_sid);
  }

  int getTokens(Entry cache_entry, int mask) {
    if (is_valid(cache_entry)) {
      int total := 0;
      if (amtc_maskHasSector(mask, 0)) {
        total := total + cache_entry.TokensSec0;
      }
      if (amtc_maskHasSector(mask, 1)) {
        total := total + cache_entry.TokensSec1;
      }
      return total;
    }
    return 0;
  }

  // -------------------------------------------------------------------------
  // Calculate which sectors a CPU memory request actually touches.
  // Sector 0 = Bytes 0 to 31. Sector 1 = Bytes 32 to 63.
  // -------------------------------------------------------------------------
  int amtc_getRequiredSectorMask(Addr line_addr, Addr phys_addr, int size) {
    int offset := getOffset(phys_addr);
    int end_byte := offset + size - 1;
    int mask := 0;

    // Does the request start before byte 32? It needs Sector 0.
    if (offset < 32) {
      mask := mask + 1;
    }

    // Does the request end at or after byte 32? It needs Sector 1.
    if (end_byte >= 32) {
      mask := mask + 2;
    }

    // Failsafe: If something goes weird with size=0, request the whole line.
    if (mask == 0) {
      mask := 3;
    }

    return mask;
  }

  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else {
      if (persistentTable.isLocked(addr) &&
          (persistentTable.findSmallest(addr) != machineID)) {
        return State:I_L;
      } else {
        return State:NP;
      }
    }
  }


  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    assert((L1Dcache.isTagPresent(addr) && L1Icache.isTagPresent(addr)) == false);

    // =========================================================
    // TBE State Management
    // =========================================================
    if (is_valid(tbe)) {
      // Passive completion can transition to a stable cache state in
      // the same transition that deallocates/unsets the TBE.  The
      // generated controller still passes the pre-action TBE into
      // setState(), so stable next states must not assert here.
      // Only transient states are stored in tbe.TBEState.
      if (state != State:I &&
          state != State:S &&
          state != State:O &&
          state != State:MM &&
          state != State:M) {
        tbe.TBEState := state;
      }
    }

    // =========================================================
    // Cache Entry State & Phase 2 Token Math
    // =========================================================
    if (is_valid(cache_entry)) {

      // Basic sanity checks: No sector can have negative tokens
      assert(cache_entry.TokensSec0 >= 0);
      assert(cache_entry.TokensSec1 >= 0);

      // V85S-r8 fundamental data-authority invariant:
      // dirty sector => authoritative bytes are resident and valid.
      assert(amtc_intersectMasks(cache_entry.DirtySectors,
                                 cache_entry.ValidSectors) ==
             cache_entry.DirtySectors);

      // In AMTC, the whole line's max_tokens() is divided equally among sectors
      int tokens_per_sector := max_tokens() / 2;

      // ---------------------------------------------------------
      // Invalid / Locked / NP States
      // ---------------------------------------------------------
      if ((state == State:I_L) ||
          (state == State:IM_L) ||
          (state == State:IS_L) ||
          (state == State:NP)) {
        // Make sure we have absolutely no tokens
        assert(cache_entry.TokensSec0 == 0);
        assert(cache_entry.TokensSec1 == 0);

      } else if ((state == State:S_L) ||
                 (state == State:SM_L)) {
        // Shared-locked: must have at least one token for any valid sector
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 >= 1);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 >= 1);
        }
      }

      // ---------------------------------------------------------
      // Modified-like States (M, MM, M_W, MM_W)
      // ---------------------------------------------------------
      if (state == State:MM || state == State:M || state == State:MM_W || state == State:M_W) {
        // We must have at least one valid sector to be in a Modified/Owner state.
        assert(cache_entry.ValidSectors != 0);
        DPRINTF(RubySlicc, "State=%d Valid=%x T0=%d T1=%d\n",
        state, cache_entry.ValidSectors,
        cache_entry.TokensSec0,
        cache_entry.TokensSec1);

        int excl_mask := amtc_exclusiveTokenMask(cache_entry);
        int non_excl_dirty := amtc_nonExclusiveDirtyMask(cache_entry);

        DPRINTF(RubySlicc,
                "AMTC_L1_STATE_CHECK addr=%#x state=%d valid=%x dirty=%x excl=%x T0=%d T1=%d\n",
                addr, state, cache_entry.ValidSectors, cache_entry.DirtySectors,
                excl_mask, cache_entry.TokensSec0, cache_entry.TokensSec1);

        // Audit78b:
        // The setState() argument is generated as a const reference in C++, so
        // never rewrite `state` here.  For MM/MM_W, dirty sectors without full
        // tokens are stale/premature metadata.  Clamp those dirty bits before
        // the existing MM/MM_W dirty-token assertions run.  M/M_W remain
        // dirty-owner/read-only states and may carry partial-token dirty data.
        if ((state == State:MM || state == State:MM_W) &&
            non_excl_dirty != 0) {
          int old_dirty := cache_entry.DirtySectors;
          cache_entry.DirtySectors :=
              amtc_intersectMasks(cache_entry.DirtySectors, excl_mask);

          if (cache_entry.DirtySectors == 0) {
            cache_entry.Dirty := false;
          }

          DPRINTF(RubySlicc,
                  "AMTC_L1_AUDIT78B_CLAMP_MM_DIRTY_PARTIAL addr=%#x state=%d old_dirty=%x new_dirty=%x nonexcl=%x valid=%x T0=%d T1=%d excl=%x\n",
                  addr, state, old_dirty, cache_entry.DirtySectors,
                  non_excl_dirty, cache_entry.ValidSectors,
                  cache_entry.TokensSec0, cache_entry.TokensSec1, excl_mask);
        }

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
          if ((state == State:MM || state == State:MM_W) &&
              amtc_maskHasSector(cache_entry.DirtySectors, 0)) {
            assert(cache_entry.TokensSec0 == tokens_per_sector);
          }
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
          if ((state == State:MM || state == State:MM_W) &&
              amtc_maskHasSector(cache_entry.DirtySectors, 1)) {
            assert(cache_entry.TokensSec1 == tokens_per_sector);
          }
        }
    }

      // ---------------------------------------------------------
      // Stable Shared State (S)
      // ---------------------------------------------------------
      // Audit81: SM is a TBE/transient upgrade state.  It may be entered while
      // token/data accumulation is still incomplete, so it must not be checked
      // with stable S invariants here.  getState() will report the TBE state
      // while the TBE is alive, and cache_entry.CacheState is not updated for
      // SM below.
      if (state == State:S) {
        assert(cache_entry.ValidSectors != 0);

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      // ---------------------------------------------------------
      // Stable Owned State (O)
      // ---------------------------------------------------------
      // Audit81: OM is a TBE/transient owner-to-modified upgrade state.  During
      // that phase, one sector may be valid while its token count is temporarily
      // zero until ACK/DATA_OWNER responses are accumulated.  Enforce owner
      // token invariants only for stable O.
      if (state == State:O) {
        assert(cache_entry.ValidSectors != 0);

        // Owner must hold tokens for its valid sectors
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      // Audit72: keep TBE-only transient states out of cache_entry.CacheState.
      // getState() already returns tbe.TBEState while the TBE is alive.
      // Mirroring states such as M_IM/IM_WAIT_* into the cache entry lets a
      // late DATA_SHARED/DATA_OWNER arrive after TBE deallocation, be routed as
      // a transient with tbe invalid, and trip acc_accumulateResponse.
      bool amtc_state_is_tbe_transient :=
          state == State:IM ||
          state == State:SM ||
          state == State:OM ||
          state == State:IS ||
          state == State:S_IM ||
          state == State:S_IS ||
          state == State:O_IS ||
          state == State:M_IS ||
          state == State:M_IM ||
          state == State:IS_WAIT_ALL ||
          state == State:IS_WAIT_DATA ||
          state == State:IS_WAIT_TOKENS ||
          state == State:IM_WAIT_PARTIAL ||
          state == State:IM_WAIT_EXCL;

      if (!amtc_state_is_tbe_transient) {
        cache_entry.CacheState := state;
      }
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := L1_TBEs[addr];
    if(is_valid(tbe)) {
      return L1Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L1Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L1Cache_State_to_permission(state));
    }
  }

  Event mandatory_request_type_to_event(RubyRequestType type) {
    // AMTC CPU-runtime request mapping.  Locked RMW requests are generated by
    // the HSA/runtime synchronization path; do not let them fall into the
    // generic error/catch-all path.  The read half behaves as a Load and the
    // write half behaves as a Store/GETX upgrade.
    if (type == RubyRequestType:LD ||
        type == RubyRequestType:Locked_RMW_Read) {
      return Event:Load;
    } else if (type == RubyRequestType:IFETCH) {
      return Event:Ifetch;
    } else if (type == RubyRequestType:ST ||
               type == RubyRequestType:Locked_RMW_Write) {
      return Event:Store;
    } else if (type == RubyRequestType:ATOMIC) {
      if (no_mig_atomic) {
        return Event:Atomic;
      } else {
        return Event:Store;
      }
    } else {
      error("AMTC L1 invalid/unhandled RubyRequestType in mandatory_request_type_to_event");
    }
  }

  AccessType cache_request_type_to_access_type(RubyRequestType type) {
    if ((type == RubyRequestType:LD) ||
        (type == RubyRequestType:IFETCH) ||
        (type == RubyRequestType:Locked_RMW_Read)) {
      return AccessType:Read;
    } else if ((type == RubyRequestType:ST) ||
               (type == RubyRequestType:ATOMIC) ||
               (type == RubyRequestType:Locked_RMW_Write)) {
      return AccessType:Write;
    } else {
      error("AMTC L1 invalid/unhandled RubyRequestType in cache_request_type_to_access_type");
    }
  }

  // NOTE: direct local hits should not call this function
  bool isExternalHit(Addr addr, MachineID sender) {
    if (machineIDToMachineType(sender) == MachineType:L1Cache) {
      return true;
    } else if (machineIDToMachineType(sender) == MachineType:L2Cache) {

      if (sender == mapAddressToRange(addr, MachineType:L2Cache,
                      l2_select_low_bit, l2_select_num_bits, intToID(0))) {
        return false;
      } else {
        return  true;
      }
    }

    return true;
  }

  bool okToIssueStarving(Addr addr, MachineID machineID) {
    return persistentTable.okToIssueStarving(addr, machineID);
  }

  void markPersistentEntries(Addr addr) {
    persistentTable.markEntries(addr);
  }

  void setExternalResponse(TBE tbe) {
    assert(is_valid(tbe));
    tbe.ExternalResponse := true;
  }

  bool IsAtomic(TBE tbe) {
    assert(is_valid(tbe));
    return tbe.IsAtomic;
  }

  // ** OUT_PORTS **
  out_port(persistentNetwork_out, PersistentMsg, persistentFromL1Cache);
  out_port(requestNetwork_out, RequestMsg, requestFromL1Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL1Cache);
  out_port(requestRecycle_out, RequestMsg, requestToL1Cache);

  // ** IN_PORTS **

  // Use Timer
  in_port(useTimerTable_in, Addr, useTimerTable, rank=5) {
    if (useTimerTable_in.isReady(clockEdge())) {
      Addr readyAddress := useTimerTable.nextAddress();
      TBE tbe := L1_TBEs.lookup(readyAddress);

      if (persistentTable.isLocked(readyAddress) &&
          (persistentTable.findSmallest(readyAddress) != machineID)) {
        if (persistentTable.typeOfSmallest(readyAddress) == AccessType:Write) {
          trigger(Event:Use_TimeoutStarverX, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutStarverS, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      } else {
        if (no_mig_atomic && IsAtomic(tbe)) {
          trigger(Event:Use_TimeoutNoStarvers_NoMig, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutNoStarvers, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      }
    }
  }

  // Reissue Timer
  // Reissue Timer
  in_port(reissueTimerTable_in, Addr, reissueTimerTable, rank=4) {
    Tick current_time := clockEdge();
    if (reissueTimerTable_in.isReady(current_time)) {
      Addr addr := reissueTimerTable.nextAddress();
      Entry cache_entry := getCacheEntry(addr);
      TBE tbe := L1_TBEs.lookup(addr);

      // Passive L1: all timeouts use the guarded resend path.
      // Owner convergence is delegated to L2/TCC; L1 never issues owner pulls.
      trigger(Event:Request_Timeout, addr, cache_entry, tbe);
    }
  }

  // Persistent Network
  in_port(persistentNetwork_in, PersistentMsg, persistentToL1Cache, rank=3) {
    if (persistentNetwork_in.isReady(clockEdge())) {
      peek(persistentNetwork_in, PersistentMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        // Apply the lockdown or unlockdown message to the table
        if (in_msg.Type == PersistentRequestType:GETX_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Write);
        } else if (in_msg.Type == PersistentRequestType:GETS_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Read);
        } else if (in_msg.Type == PersistentRequestType:DEACTIVATE_PERSISTENT) {
          persistentTable.persistentRequestUnlock(in_msg.addr, in_msg.Requestor);
        } else {
          error("Unexpected message");
        }

        // React to the message based on the current state of the table
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (persistentTable.isLocked(in_msg.addr)) {
          if (persistentTable.findSmallest(in_msg.addr) == machineID) {
            // Our Own Lock - this processor is highest priority
            trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                    cache_entry, tbe);
          } else {
            if (persistentTable.typeOfSmallest(in_msg.addr) == AccessType:Read) {
              if (getTokens(cache_entry, amtc_fullMask()) == 1 ||
                  getTokens(cache_entry, amtc_fullMask()) == (max_tokens() / 2) + 1) {
                trigger(Event:Persistent_GETS_Last_Token, in_msg.addr,
                        cache_entry, tbe);
              } else {
                trigger(Event:Persistent_GETS, in_msg.addr,
                        cache_entry, tbe);
              }
            } else {
              trigger(Event:Persistent_GETX, in_msg.addr,
                      cache_entry, tbe);
            }
          }
        } else {
          // Unlock case - no entries in the table
          trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                  cache_entry, tbe);
        }
      }
    }
  }

  // Response Network
  in_port(responseNetwork_in, ResponseMsg, responseToL1Cache, rank=2) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        // =====================================================================
        // 1. LATENCY PROFILING (Standard gem5 bookkeeping)
        // =====================================================================
        if ( machineIDToMachineType(in_msg.Sender) == MachineType:L2Cache ) {
          if (in_msg.Sender == mapAddressToRange(in_msg.addr,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0))) {
            // came from an off-chip L2 cache
            if (is_valid(tbe)) {
               // L1_TBEs[in_msg.addr].ExternalResponse := true;
               // profile_offchipL2_response(in_msg.addr);
            }
          } else {
               // profile_onchipL2_response(in_msg.addr );
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:Directory ) {
          if (is_valid(tbe)) {
            setExternalResponse(tbe);
            // profile_memory_response( in_msg.addr);
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
          // Local/Off-chip L1 profiling can go here
        } else {
          error("unexpected SenderMachine");
        }

        // =====================================================================
        // 2. PASSIVE ACCUMULATION EVENT ROUTING
        // =====================================================================
        // L1 does not pre-classify partial-vs-complete or compute owners here.
        // The transition actions accumulate masks/tokens and run the centralized
        // completion check. ACKs may update token metadata only.
        if (in_msg.Type == CoherenceResponseType:ACK ||
            in_msg.Type == CoherenceResponseType:ACK_OWNER) {
            bool ack_has_all_requested_tokens := false;
            bool data_already_ready := false;
            if (is_valid(tbe)) {
                int tokens_per_sector := max_tokens() / 2;
                ack_has_all_requested_tokens := true;

                if (amtc_maskHasSector(tbe.RequestedSectorMask, 0) &&
                    (cache_entry.TokensSec0 + in_msg.TokensSec0) < tokens_per_sector) {
                    ack_has_all_requested_tokens := false;
                }
                if (amtc_maskHasSector(tbe.RequestedSectorMask, 1) &&
                    (cache_entry.TokensSec1 + in_msg.TokensSec1) < tokens_per_sector) {
                    ack_has_all_requested_tokens := false;
                }

                // A control ACK may carry token metadata and sometimes a
                // valid_sector_mask hint, but it does NOT carry bytes.  Only
                // classify it as Ack_All_Tokens when the data path has already
                // installed all requested sectors.  Otherwise the transition
                // target MM/M would run setState() with no valid data and trip
                // the modified-state invariant.
                data_already_ready :=
                    amtc_maskContainsAll(tbe.ReceivedSectorMask,
                                         tbe.RequestedSectorMask) ||
                    amtc_maskContainsAll(cache_entry.ValidSectors,
                                         tbe.RequestedSectorMask);
            }

            bool stale_owner_read_ack := false;
            if (is_valid(tbe) &&
                in_msg.Type == CoherenceResponseType:ACK_OWNER &&
                tbe.TypeOfAccess == AccessType:Read &&
                (tbe.TBEState == State:IS_WAIT_ALL ||
                 tbe.TBEState == State:IS_WAIT_DATA ||
                 tbe.TBEState == State:IS_WAIT_TOKENS) &&
                in_msg.TokensSec0 == 0 &&
                in_msg.TokensSec1 == 0 &&
                !data_already_ready) {
                // A zero-token ACK_OWNER during a read wait means the Directory
                // forwarded to a stale owner/sharer that had already dropped the
                // line.  Plain accumulation cannot complete the read, and repeated
                // ACK_OWNER(0) messages can keep the TBE alive until Sequencer
                // deadlock.  Route to an explicit owner-pull data fallback.
                stale_owner_read_ack := true;
            }

            bool stale_owner_write_ack := false;
            if (in_msg.Type == CoherenceResponseType:ACK_OWNER &&
                in_msg.TokensSec0 == 0 &&
                in_msg.TokensSec1 == 0 &&
                in_msg.valid_sector_mask == 0 &&
                in_msg.token_sector_mask == 0) {
                // Audit69: A zero-token ACK_OWNER is stale only if the *current*
                // line is in a write-convergence transient.  Audit68 was too
                // broad: it classified every invalid-TBE zero ACK as
                // Stale_Owner_Write_Ack, including late ACKs arriving after the
                // line had already returned to stable M/MM.  That caused invalid
                // transitions such as MM + Stale_Owner_Write_Ack.
                if (is_valid(tbe) &&
                    (tbe.TBEState == State:IM_WAIT_PARTIAL ||
                     tbe.TBEState == State:IM_WAIT_EXCL ||
                     tbe.TBEState == State:S_IM ||
                     tbe.TBEState == State:M_IM ||
                     tbe.TBEState == State:IM ||
                     tbe.TBEState == State:SM ||
                     tbe.TBEState == State:OM)) {
                    stale_owner_write_ack := true;
                } else if (is_valid(cache_entry) &&
                           (cache_entry.CacheState == State:IM_WAIT_PARTIAL ||
                            cache_entry.CacheState == State:IM_WAIT_EXCL ||
                            cache_entry.CacheState == State:S_IM ||
                            cache_entry.CacheState == State:M_IM ||
                            cache_entry.CacheState == State:IM ||
                            cache_entry.CacheState == State:SM ||
                            cache_entry.CacheState == State:OM)) {
                    // Covers the observed case where the generated transition
                    // state is a write wait but the TBE pointer has already been
                    // cleared.  Do not classify stable M/MM/S/O lines here.
                    stale_owner_write_ack := true;
                }
            }

            if (ack_has_all_requested_tokens && data_already_ready) {
                // V85S: a control ACK can complete only when requested bytes
                // are already resident.  Tokens alone never create data.
                trigger(Event:Ack_All_Tokens, in_msg.addr, cache_entry, tbe);
            } else if (stale_owner_read_ack) {
                trigger(Event:Stale_Owner_Ack, in_msg.addr, cache_entry, tbe);
            } else if (stale_owner_write_ack) {
                trigger(Event:Stale_Owner_Write_Ack, in_msg.addr, cache_entry, tbe);
            } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER) {
                trigger(Event:Ack_Owner, in_msg.addr, cache_entry, tbe);
            } else {
                trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
            }
        } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
                   in_msg.Type == CoherenceResponseType:DATA_SHARED) {
            // Normalize full-token data responses into Data_All_Tokens.
            // Some lower levels encode exclusive completion as DATA_OWNER/DATA_SHARED
            // plus per-sector token counts rather than a separate response type.
            bool has_all_requested_tokens := false;
            if (is_valid(tbe)) {
                int tokens_per_sector := max_tokens() / 2;
                has_all_requested_tokens := true;

                // Data may arrive after an earlier token-only ACK from L2.
                // Classify as Data_All_Tokens when the accumulated cache-entry
                // tokens plus this response satisfy the requested sectors, not
                // only when this DATA response itself carries all tokens.
                if (amtc_maskHasSector(tbe.RequestedSectorMask, 0) &&
                    (cache_entry.TokensSec0 + in_msg.TokensSec0) < tokens_per_sector) {
                    has_all_requested_tokens := false;
                }
                if (amtc_maskHasSector(tbe.RequestedSectorMask, 1) &&
                    (cache_entry.TokensSec1 + in_msg.TokensSec1) < tokens_per_sector) {
                    has_all_requested_tokens := false;
                }
            }

            bool data_only_read_bypass := false;
            if (is_valid(tbe) &&
                in_msg.Type == CoherenceResponseType:DATA_SHARED &&
                tbe.TypeOfAccess == AccessType:Read &&
                (tbe.TBEState == State:IS_WAIT_ALL ||
                 tbe.TBEState == State:IS_WAIT_DATA ||
                 tbe.TBEState == State:IS_WAIT_TOKENS)) {
                bool has_any_requested_token := false;
                if (amtc_maskHasSector(tbe.RequestedSectorMask, 0) &&
                    in_msg.TokensSec0 > 0) {
                    has_any_requested_token := true;
                }
                if (amtc_maskHasSector(tbe.RequestedSectorMask, 1) &&
                    in_msg.TokensSec1 > 0) {
                    has_any_requested_token := true;
                }
                if (!has_any_requested_token) {
                    data_only_read_bypass := true;
                    DPRINTF(RubySlicc,
                            "AMTC_L1_ROUTE_DATA_ONLY_READ_BYPASS addr=%#x req=%x valid=%x tokmask=%x T0=%d T1=%d\n",
                            in_msg.addr, tbe.RequestedSectorMask,
                            in_msg.valid_sector_mask, in_msg.token_sector_mask,
                            in_msg.TokensSec0, in_msg.TokensSec1);
                }
            }

            if (data_only_read_bypass) {
                trigger(Event:Data_No_Token, in_msg.addr, cache_entry, tbe);
            } else if (has_all_requested_tokens) {
                trigger(Event:Data_All_Tokens, in_msg.addr, cache_entry, tbe);
            } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
                trigger(Event:Data_Owner, in_msg.addr, cache_entry, tbe);
            } else {
                trigger(Event:Data_Shared, in_msg.addr, cache_entry, tbe);
            }
        } else {
            error("Unexpected message type received in L1 response network");
        }
      }
    }
  }

  // Request Network
  in_port(requestNetwork_in, RequestMsg, requestToL1Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceRequestType:GETX) {
          if (in_msg.isLocal) {
            trigger(Event:Transient_Local_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
          else {
            trigger(Event:Transient_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          // V85S-r12: Directory DMA-read owner pulls are observational reads.
          // They must return bytes without donating tokens or changing the
          // local coherence state.  Classify them before normal GETS/last-token
          // logic, which intentionally transfers physical tokens.
          if (in_msg.is_owner_pull &&
              machineIDToMachineType(in_msg.Requestor) == MachineType:Directory) {
            trigger(Event:Transient_GETS_Owner_Pull, in_msg.addr,
                    cache_entry, tbe);
          } else {
          // V85S-r8: "last token" is a per-requested-sector property.
          // The old full-line total test (1 or 513) misses cases such as
          // requested sector=1 token while the other sector holds 511 tokens.
          int req_mask := in_msg.requested_sector_mask;
          if (req_mask == 0) { req_mask := in_msg.sector_mask; }
          if (req_mask == 0) { req_mask := amtc_fullMask(); }
          req_mask := amtc_sanitizeMask(req_mask);

          bool requested_last_token := false;
          if (amtc_maskHasSector(req_mask, 0) &&
              getTokens(cache_entry, 1) == 1) {
            requested_last_token := true;
          }
          if (amtc_maskHasSector(req_mask, 1) &&
              getTokens(cache_entry, 2) == 1) {
            requested_last_token := true;
          }

          DPRINTF(RubySlicc,
                  "AMTC_L1_GETS_LAST_TOKEN_CLASSIFY_V85S_R8 addr=%#x req=%x T0=%d T1=%d last=%d\n",
                  in_msg.addr, req_mask,
                  getTokens(cache_entry, 1), getTokens(cache_entry, 2),
                  requested_last_token);

          if (requested_last_token) {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
          }
          else {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
          }
          } // !Directory owner-pull GETS
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  // Mandatory Queue
  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...", rank=0) {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest, block_on="LineAddress") {

        TBE tbe := L1_TBEs[in_msg.LineAddress];
        //int req_offset := getOffset(in_msg.PhysicalAddress);

        // Use the function you defined for mask calculation
        // THE FIX
        int needed_mask := amtc_getRequiredSectorMask(in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size);

        // ===================================================================
        // 1. INSTRUCTION FETCH
        // ===================================================================
        if (in_msg.Type == RubyRequestType:IFETCH) {
          Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
          if (is_valid(L1Icache_entry)) {
            bool has_data := (amtc_intersectMasks(L1Icache_entry.ValidSectors, needed_mask) == needed_mask);
            bool has_tokens := true;
            if (amtc_maskHasSector(needed_mask, 0) && L1Icache_entry.TokensSec0 == 0) { has_tokens := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Icache_entry.TokensSec1 == 0) { has_tokens := false; }


            if (!has_data || !has_tokens) {
              trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            }
          } else {
            Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
            if (is_valid(L1Dcache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Dcache_entry, tbe); }
            if (L1Icache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              Addr victim := L1Icache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1ICacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 2. DATA LOADS & READS
        // ===================================================================
        else if (in_msg.Type == RubyRequestType:LD || in_msg.Type == RubyRequestType:Locked_RMW_Read) {
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            bool has_data := (amtc_intersectMasks(L1Dcache_entry.ValidSectors, needed_mask) == needed_mask);
            bool has_tokens := true;
            if (amtc_maskHasSector(needed_mask, 0) && L1Dcache_entry.TokensSec0 == 0) { has_tokens := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Dcache_entry.TokensSec1 == 0) { has_tokens := false; }


            if (!has_data || !has_tokens) {
                trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
                trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            }
          } else {
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Icache_entry, tbe); }
            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
              Addr victim := L1Dcache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1DCacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 3. STORES & ATOMICS
        // ===================================================================
        else if (in_msg.Type == RubyRequestType:ST || in_msg.Type == RubyRequestType:ATOMIC || in_msg.Type == RubyRequestType:Locked_RMW_Write) {
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            bool has_write_permission := true;
            bool has_store_data :=
                (amtc_intersectMasks(L1Dcache_entry.ValidSectors,
                                     needed_mask) == needed_mask);
            int tokens_per_sector := max_tokens() / 2;

            if (amtc_maskHasSector(needed_mask, 0) && L1Dcache_entry.TokensSec0 < tokens_per_sector) { has_write_permission := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Dcache_entry.TokensSec1 < tokens_per_sector) { has_write_permission := false; }

            // V85S-r9: exclusive tokens are permission, not data.  A partial
            // store/RFO must not hit locally unless the old bytes for every
            // requested sector are actually resident.  If ownership is already
            // complete but data is missing, route through Store_Sector_Miss;
            // r7's data-only owner-pull obtains the authoritative bytes.
            if (!has_write_permission || !has_store_data) {
                if (has_write_permission && !has_store_data) {
                  DPRINTF(RubySlicc,
                          "AMTC_L1_STORE_FULL_OWNER_DATA_MISS_V85S_R9 addr=%#x mask=%x valid=%x T0=%d T1=%d\n",
                          in_msg.LineAddress, needed_mask,
                          L1Dcache_entry.ValidSectors,
                          L1Dcache_entry.TokensSec0,
                          L1Dcache_entry.TokensSec1);
                }
                trigger(Event:Store_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
                trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            }
          } else {
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Icache_entry, tbe); }
            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
              Addr victim := L1Dcache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1DCacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 4. EXPLICIT UNKNOWN/FLUSH DIAGNOSTIC
        // ===================================================================
        else {
          // Do not silently consume Flush/fence-like or unknown requests.  If
          // the HSA runtime sends a request type AMTC does not model yet, make
          // it visible immediately instead of letting the CPU spin forever.
          DPRINTF(RubySlicc,
                  "AMTC_L1_UNHANDLED_MANDATORY addr=%#x line=%#x size=%d\n",
                  in_msg.PhysicalAddress, in_msg.LineAddress, in_msg.Size);
          error("AMTC L1 unhandled mandatory RubyRequestType; add an explicit transition/completion callback");
        }
      }
    }
  }

  // ACTIONS
action(a_issueReadRequest, "a", desc="Issue GETS") {
      assert(is_valid(tbe));

      // STRICT SINGLE-REQUEST RULE: send exactly one initial GETS per TBE.
      if (tbe.InitialRequestIssued) {
        DPRINTF(RubySlicc,
                "AMTC_L1_REJECT_DUP_GETS addr=%#x mask=%d issue=%d\n",
                address, tbe.RequestedSectorMask, tbe.IssueCount);
      } else {
        outstandingRequests := outstandingRequests + 1;

        // Track whether this request is a Directory data-only owner pull.
        bool issue_owner_pull := false;
        if (is_valid(cache_entry) &&
            (cache_entry.CacheState == State:O ||
             cache_entry.CacheState == State:M ||
             cache_entry.CacheState == State:MM ||
             cache_entry.CacheState == State:M_W ||
             cache_entry.CacheState == State:MM_W)) {
          issue_owner_pull := true;
        }

        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          // AMTC audit88: CPU L1 requests must use L1 -> L2 -> Directory only.
          // Do not also send the original L1 GETS/GETX directly to Directory;
          // that creates duplicate Directory transactions for one CPU miss.
          out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                    l2_select_low_bit,
                                                    l2_select_num_bits,
                                                    intToID(0)));
          out_msg.RetryNum := 0;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // AMTC owner-pull read: if this L1 is already the line owner,
          // Directory will return data-only rather than forwarding back.
          out_msg.is_owner_pull := issue_owner_pull;
        }

        if (issue_owner_pull) {
          tbe.OwnerPullIssued := true;
        }

        tbe.InitialRequestIssued := true;
        tbe.HasOutstandingRequest := true;
        tbe.IssueCount := 1;
        tbe.LastIssueTime := curCycle();
        tbe.ForwardProgressFlag := false;
        tbe.NoProgressTimeouts := 0;

        if (reissueTimerTable.isSet(address)) {
          reissueTimerTable.unset(address);
        }
        reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
      }
  }

  action(b_issueWriteRequest, "b", desc="Issue GETX") {
      assert(is_valid(tbe));

      // STRICT SINGLE-REQUEST RULE: send exactly one initial GETX per TBE.
      if (tbe.InitialRequestIssued) {
        DPRINTF(RubySlicc,
                "AMTC_L1_REJECT_DUP_GETX addr=%#x mask=%d issue=%d\n",
                address, tbe.RequestedSectorMask, tbe.IssueCount);
      } else {
        outstandingRequests := outstandingRequests + 1;

        // Track whether this request is a Directory data-only owner pull.
        bool issue_owner_pull := false;
        if (is_valid(cache_entry) &&
            (cache_entry.CacheState == State:M ||
             cache_entry.CacheState == State:MM ||
             cache_entry.CacheState == State:M_W ||
             cache_entry.CacheState == State:MM_W)) {
          issue_owner_pull := true;
        }

        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;
          // AMTC audit88: CPU L1 requests must use L1 -> L2 -> Directory only.
          // Do not also send the original L1 GETS/GETX directly to Directory;
          // that creates duplicate Directory transactions for one CPU miss.
          out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                    l2_select_low_bit,
                                                    l2_select_num_bits,
                                                    intToID(0)));
          out_msg.RetryNum := 0;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // V29 CPU full-line GETX token-credit metadata.  L2 widens all
          // CPU L1 GETX requests to a full-line PendingReqMask, so the credit
          // sent by L1 must describe all tokens it is parking for the line, not
          // only the store sector in tbe.RequestedSectorMask.  Otherwise L2
          // sees e.g. reqmask=3, T0=511/T1=511, held0=1/held1=0 and waits for
          // a timeout even though the requester already owns the missing token.
          out_msg.requester_held_tokens_sec0 := 0;
          out_msg.requester_held_tokens_sec1 := 0;
          if (is_valid(cache_entry)) {
            if (cache_entry.TokensSec0 > 0) {
              out_msg.requester_held_tokens_sec0 := cache_entry.TokensSec0;
            }
            if (cache_entry.TokensSec1 > 0) {
              out_msg.requester_held_tokens_sec1 := cache_entry.TokensSec1;
            }
          }

          // AMTC owner-pull write: if this L1 is already the line owner,
          // Directory returns data-only for the missing sector.
          out_msg.is_owner_pull := issue_owner_pull;
        }

        if (issue_owner_pull) {
          tbe.OwnerPullIssued := true;
        }

        tbe.InitialRequestIssued := true;
        tbe.HasOutstandingRequest := true;
        tbe.IssueCount := 1;
        tbe.LastIssueTime := curCycle();
        tbe.ForwardProgressFlag := false;
        tbe.NoProgressTimeouts := 0;

        if (reissueTimerTable.isSet(address)) {
          reissueTimerTable.unset(address);
        }
        reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
      }
  }

  action(b_issueUpgradeRequest, "bU", desc="Issue an upgrade request (tokens only)") {
    peek(mandatoryQueue_in, RubyRequest) {
      // Enqueue the request to the network
      // (Note: Replace 'issue_latency' with whatever your standard latency variable is, e.g., 'l1_request_latency')
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        // AMTC audit88: route CPU L1 upgrade through L2 only.
        // L2 remains the CPU-side gateway to Directory.
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                  l2_select_low_bit,
                                                  l2_select_num_bits,
                                                  intToID(0)));

        // Control message only, no data payload
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;

        // AMTC Specifics: Request tokens for the specific sector the CPU wants to write
        out_msg.sector_mask := amtc_singleSectorMaskFromAddr(address);
        out_msg.requested_sector_mask := amtc_singleSectorMaskFromAddr(address);
        out_msg.requester_held_tokens_sec0 := 0;
        out_msg.requester_held_tokens_sec1 := 0;
        if (is_valid(cache_entry)) {
          if (amtc_maskHasSector(out_msg.requested_sector_mask, 0)) {
            out_msg.requester_held_tokens_sec0 := cache_entry.TokensSec0;
          }
          if (amtc_maskHasSector(out_msg.requested_sector_mask, 1)) {
            out_msg.requester_held_tokens_sec1 := cache_entry.TokensSec1;
          }
        }
      }
    }
  }

  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.TokensSec0 := in_msg.TokensSec0;
        out_msg.TokensSec1 := in_msg.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := in_msg.Dirty;
        //Preserve the AMTC sector masks so the Directory knows what it is receiving
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.token_sector_mask := in_msg.token_sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
      }
    }
  }

  action(c_ownedReplacement, "c", desc="Issue writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));

      // STRICT ISOLATION: Only write back sectors we actually modified!
      // This prevents overwriting the L2 with our stale clean data.
      int wb_mask := cache_entry.DirtySectors;

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.token_sector_mask := amtc_fullMask(); // Send all tokens back
      out_msg.requested_sector_mask := wb_mask;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;

      // If we didn't dirty anything, DO NOT send a data payload.
      if (wb_mask == 0) {
        out_msg.Dirty := false;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.valid_sector_mask := 0;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      } else {
        out_msg.Dirty := true;
        out_msg.Type := CoherenceResponseType:WB_OWNED;
        out_msg.valid_sector_mask := wb_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
      }
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(cc_sharedReplacement, "\c", desc="Issue shared writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));

        // Shared evictions never carry physical data.
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(tr_tokenReplacement, "tr", desc="Issue token writeback") {
    assert(is_valid(cache_entry));
    // CRITICAL FIX: Check the actual sector tokens!
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;

        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) { wb_mask := amtc_fullMask(); }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
      }
    }
    // CRITICAL FIX: Zero out the actual sector tokens!
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }


  action(d_sendDataWithToken, "d", desc="Send data and a token from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.valid_sector_mask := cache_entry.ValidSectors;
        out_msg.Dirty := false;

        // Safely delegate exactly 1 token for requested sectors
        if (amtc_maskHasSector(in_msg.requested_sector_mask, 0) && cache_entry.TokensSec0 > 1) {
            out_msg.TokensSec0 := 1;
            cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
        } else {
            out_msg.TokensSec0 := 0;
        }

        if (amtc_maskHasSector(in_msg.requested_sector_mask, 1) && cache_entry.TokensSec1 > 1) {
            out_msg.TokensSec1 := 1;
            cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
        } else {
            out_msg.TokensSec1 := 0;
        }

        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          out_msg.MessageSize := MessageSizeType:Response_Data;
        }
      }
    }
  }

  action(d_sendDataWithNTokenIfAvail, "\dd", desc="Send data and N tokens from cache to requestor") {
    assert(is_valid(cache_entry));
    int tokens_per_sector := max_tokens() / 2;
    int owner_limit := N_tokens + tokens_per_sector;

    peek(requestNetwork_in, RequestMsg) {
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      int send_t0 := 0;
      int send_t1 := 0;

      // Evaluate Sector 0
      if (amtc_maskHasSector(send_mask, 0)) {
        if (cache_entry.TokensSec0 > owner_limit) {
            send_t0 := N_tokens;
        } else if (cache_entry.TokensSec0 > 1) {
            send_t0 := 1;
        }
      }

      // Evaluate Sector 1
      if (amtc_maskHasSector(send_mask, 1)) {
        if (cache_entry.TokensSec1 > owner_limit) {
            send_t1 := N_tokens;
        } else if (cache_entry.TokensSec1 > 1) {
            send_t1 := 1;
        }
      }

      // If we have any tokens to give, send the payload
      if (send_t0 > 0 || send_t1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          if (amtc_maskHasSector(send_mask, 0)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32); }
          if (amtc_maskHasSector(send_mask, 1)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32); }

          out_msg.valid_sector_mask := send_mask;
          out_msg.Dirty := false;

          if (in_msg.isLocal) {
            out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
          } else {
            out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
          }
        }

        // Deduct tokens
        cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
        cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;

        // Downgrade ValidSectors if we lost our Owner status for that sector
        if (cache_entry.TokensSec0 < tokens_per_sector) {
            cache_entry.ValidSectors := amtc_clearSector(cache_entry.ValidSectors, 0);
        }
        if (cache_entry.TokensSec1 < tokens_per_sector) {
            cache_entry.ValidSectors := amtc_clearSector(cache_entry.ValidSectors, 1);
        }
      }
    }
  }

  // V85S-r12: coherent DMA reads are data-only observations.  A Directory
  // owner-pull must never consume a token or downgrade/invalidate the L1.
  action(dop_sendDataOnlyOwnerPullV85S12, "dop12",
         desc="Return requested owner bytes to Directory without moving tokens") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := in_msg.sector_mask; }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      req_mask := amtc_sanitizeMask(req_mask);

      assert(amtc_intersectMasks(cache_entry.DirtySectors,
                                 cache_entry.ValidSectors) ==
             cache_entry.DirtySectors);

      int send_valid_mask :=
          amtc_intersectMasks(cache_entry.ValidSectors, req_mask);

      if (amtc_maskContainsAll(send_valid_mask, req_mask)) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := 0;
          out_msg.TokensSec1 := 0;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := 0;
          out_msg.valid_sector_mask := req_mask;
          out_msg.merged_resp := false;
          if (amtc_maskHasSector(req_mask, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(req_mask, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
          }
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        }
        DPRINTF(RubySlicc,
                "AMTC_L1_DMA_READ_OWNER_PULL_DATA_V85S_R12 addr=%#x req=%d valid=%d dirty=%d T0=%d T1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                cache_entry.DirtySectors, cache_entry.TokensSec0,
                cache_entry.TokensSec1);
      } else {
        // Partial/missing bytes cannot safely be reconstructed from memory when
        // another requested sector may be dirty.  Return only a zero-token NACK;
        // Directory waits for another local holder rather than fabricating tokens.
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := 0;
          out_msg.TokensSec1 := 0;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := 0;
          out_msg.valid_sector_mask := 0;
          out_msg.merged_resp := false;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
        DPRINTF(RubySlicc,
                "AMTC_L1_DMA_READ_OWNER_PULL_NO_DATA_V85S_R12 addr=%#x req=%d valid=%d dirty=%d T0=%d T1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                cache_entry.DirtySectors, cache_entry.TokensSec0,
                cache_entry.TokensSec1);
      }
    }
  }

  action(doa_sendOwnerPullAckNoDataV85S12, "doa12",
         desc="Return zero-token owner-pull ACK from non-holder L1") {
    peek(requestNetwork_in, RequestMsg) {
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := in_msg.sector_mask; }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      req_mask := amtc_sanitizeMask(req_mask);
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.Dirty := false;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.token_sector_mask := 0;
        out_msg.valid_sector_mask := 0;
        out_msg.merged_resp := false;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens with AMTC sector metadata") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := in_msg.sector_mask; }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      req_mask := amtc_sanitizeMask(req_mask);

      int send_token_mask := 0;
      if (cache_entry.TokensSec0 > 0) { send_token_mask := amtc_unionMasks(send_token_mask, 1); }
      if (cache_entry.TokensSec1 > 0) { send_token_mask := amtc_unionMasks(send_token_mask, 2); }

      // V85S-r8: this action transfers ALL local tokens and invalidates the
      // donor, so it must also transfer every resident valid sector, not only
      // the currently requested sector.  Otherwise dirty bytes in an
      // unrequested sector can be discarded when the donor is invalidated.
      int requested_valid_mask :=
          amtc_intersectMasks(cache_entry.ValidSectors, req_mask);
      int send_valid_mask := cache_entry.ValidSectors;

      // Dirty metadata is proof that authoritative bytes exist locally.
      // Never allow a dirty sector to become metadata-only.
      assert(amtc_intersectMasks(cache_entry.DirtySectors,
                                 cache_entry.ValidSectors) ==
             cache_entry.DirtySectors);

      /*
       * V85S-r7: a token-only owner donation may leave the new owner with
       * exact ownership but no old bytes for a partial store.  The only safe
       * fallback is a data-only memory fetch, and that is legal only when the
       * requested missing sector is clean.  If DirtySectors says otherwise,
       * the authoritative bytes have been lost and we must fail here rather
       * than silently consume stale memory.
       */
      if (amtc_maskHasSector(req_mask, 0) &&
          !amtc_maskHasSector(requested_valid_mask, 0)) {
        assert(!amtc_maskHasSector(cache_entry.DirtySectors, 0));
      }
      if (amtc_maskHasSector(req_mask, 1) &&
          !amtc_maskHasSector(requested_valid_mask, 1)) {
        assert(!amtc_maskHasSector(cache_entry.DirtySectors, 1));
      }

      // V85S-r1: token ownership never proves that bytes are valid.
      // Donate only sectors whose ValidSectors bits are physically present.
      // A token-only donation is legal; the requester must obtain missing bytes
      // from another real data source before completing a read/partial store.
      if (send_valid_mask == 0) {
        // Only fall back to current valid sectors when the forwarded request
        // failed to carry a precise sector mask.  Do not satisfy a precise
        // sector request using unrelated-sector bytes.
        if (in_msg.requested_sector_mask == 0 && in_msg.sector_mask == 0) {
          send_valid_mask := cache_entry.ValidSectors;
        }
      }

      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        // Forwarded GETX/GETS donation from an S/O/M holder must carry usable
        // sector metadata.  Without token_sector_mask/requested_sector_mask,
        // the requester may receive a data packet but not account the donated
        // token, then wait forever in SM/IM_WAIT_PARTIAL.
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.token_sector_mask := send_token_mask;
        out_msg.valid_sector_mask := send_valid_mask;
        out_msg.merged_resp := false;
        out_msg.Dirty := false;

        if (amtc_maskHasSector(send_valid_mask, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(send_valid_mask, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_valid_mask);
        }
      }

      DPRINTF(RubySlicc,
              "AMTC_L1_DONATE_ALLTOK_SCOPE_V85S_R8 addr=%#x req=%d reqvalid=%d sendvalid=%d tokmask=%d dirty=%d\n",
              address, req_mask, requested_valid_mask, send_valid_mask,
              send_token_mask, cache_entry.DirtySectors);
      DPRINTF(RubySlicc,
              "AMTC_L1_DONATE_ALLTOK_META addr=%#x req=%d valid=%d tokmask=%d t0=%d t1=%d dirtymask=%d state=%s\n",
              address, req_mask, send_valid_mask, send_token_mask,
              cache_entry.TokensSec0, cache_entry.TokensSec1,
              cache_entry.DirtySectors, cache_entry.CacheState);
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
    cache_entry.ValidSectors := 0;
    cache_entry.DirtySectors := 0;
    cache_entry.Dirty := false;
  }

  action(d1_sendDataWithOneToken, "d1", desc="Send requested-sector data and exactly 1 token with AMTC sector metadata") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := in_msg.sector_mask; }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      req_mask := amtc_sanitizeMask(req_mask);

      // Audit57: never satisfy a forwarded sector GETS with bytes from a
      // different sector.  Directory may be line-granular and forward a GETS
      // to a stale owner.  If this L1 does not have the requested sector bytes,
      // return ACK_OWNER(0) so the requester can issue the read owner-pull
      // fallback to Directory/memory.  Sending ValidSectors as a fallback here
      // caused sector-1 reads to receive sector-0 data and remain stuck.
      int send_valid_mask := amtc_intersectMasks(cache_entry.ValidSectors, req_mask);

      if (send_valid_mask == 0) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := 0;
          out_msg.TokensSec1 := 0;
          out_msg.Dirty := false;
          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := 0;
          out_msg.valid_sector_mask := 0;
          out_msg.merged_resp := false;
        }

        DPRINTF(RubySlicc,
                "AMTC_L1_DONATE_MISS_STALE_ACK addr=%#x req=%d valid=%d T0=%d T1=%d requester=%s\n",
                address, req_mask, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1,
                in_msg.Requestor);
      } else {
        int send_t0 := 0;
        int send_t1 := 0;
        int send_token_mask := 0;
        if (amtc_maskHasSector(send_valid_mask, 0) && cache_entry.TokensSec0 > 0) {
          send_t0 := 1;
          send_token_mask := amtc_unionMasks(send_token_mask, 1);
        }
        if (amtc_maskHasSector(send_valid_mask, 1) && cache_entry.TokensSec1 > 0) {
          send_t1 := 1;
          send_token_mask := amtc_unionMasks(send_token_mask, 2);
        }

        // V85S-r8: the non-last-token path must never donate the final
        // requested-sector token.  If this fires, request classification is
        // wrong; silently clearing validity would lose dirty-data authority.
        if (send_t0 > 0) { assert(cache_entry.TokensSec0 > 1); }
        if (send_t1 > 0) { assert(cache_entry.TokensSec1 > 1); }

        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := send_token_mask;
          out_msg.valid_sector_mask := send_valid_mask;
          out_msg.merged_resp := false;
          out_msg.Dirty := false;

          if (amtc_maskHasSector(send_valid_mask, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(send_valid_mask, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
          }

          if (in_msg.isLocal) {
            out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
          } else {
            out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_valid_mask);
          }
        }

        // Audit57: decrement only the tokens actually sent, not every token
        // held by the line.  The previous unconditional decrement could drop a
        // sector token that was not part of the forwarded request.
        if (send_t0 > 0) { cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0; }
        if (send_t1 > 0) { cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1; }

        if (cache_entry.TokensSec0 == 0) {
          cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 1);
        }
        if (cache_entry.TokensSec1 == 0) {
          cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 2);
        }

        DPRINTF(RubySlicc,
                "AMTC_L1_DONATE_1TOK_META addr=%#x req=%d valid=%d tokmask=%d t0=%d t1=%d\n",
                address, req_mask, send_valid_mask, send_token_mask, send_t0, send_t1);
      }
    }
  }

  action(e_sendAckWithCollectedTokens, "e", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // Evaluate our sectored token pools directly
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;

        // This is an ACK action. We yield the tokens as a control message.
        out_msg.Type := CoherenceResponseType:ACK;

        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Control;

        // AMTC Metadata: Dynamically flag which sectors these tokens belong to
        int t_mask := 0;
        if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
        if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

        out_msg.token_sector_mask := t_mask;
        out_msg.valid_sector_mask := 0; // ACKs never carry valid data
      }
    }

    // Safely zero out local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

action(ee_sendDataWithAllTokens, "\e", desc="Send data and all tokens from cache to starver") {
    assert(is_valid(cache_entry));
    assert(cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0);

    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(persistentTable.findSmallest(address));

      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;

      out_msg.valid_sector_mask := cache_entry.ValidSectors;
      out_msg.token_sector_mask := cache_entry.ValidSectors;
      out_msg.Dirty := cache_entry.Dirty;

      // Dynamic message sizing based on how many sectors are valid
      out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
    }

    // Safely zero out the sector token pools
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(f_sendAckWithAllButNorOneTokens, "f", desc="Send ack with all our tokens but one to starver.") {
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;

    // Evaluate Sector 0: If we have > 1 token, keep 1 and send the rest.
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
    }
    // Evaluate Sector 1: If we have > 1 token, keep 1 and send the rest.
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
    }

    if (send_t0 > 0 || send_t1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK; // ACKs never carry data
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := MessageSizeType:Response_Control;

        // AMTC Metadata: Flag which sectors these tokens belong to
        int t_mask := 0;
        if (send_t0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
        if (send_t1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

        out_msg.token_sector_mask := t_mask;
        out_msg.valid_sector_mask := 0;
      }
    }
  }

  action(ff_sendDataWithAllButNorOneTokens, "\f", desc="Send data and out tokens but one to starver") {
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }
    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    if (send_t0 > 0 || send_t1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(persistentTable.findSmallest(address));

          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          // Sector-Aware Data Copy: Only send the bytes we are yielding
          if (amtc_maskHasSector(send_mask, 0)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32); }
          if (amtc_maskHasSector(send_mask, 1)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32); }

          out_msg.valid_sector_mask := send_mask;
          out_msg.token_sector_mask := send_mask;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
      }
    }
  }

  action(fo_sendDataWithOwnerToken, "fo", desc="Send data and owner tokens") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;

        out_msg.valid_sector_mask := cache_entry.ValidSectors;
        out_msg.token_sector_mask := cache_entry.ValidSectors;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
    cache_entry.DirtySectors := 0;
    cache_entry.Dirty := false;
  }

  action(g_bounceResponseToStarver, "g", desc="Redirect response to starving processor") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        // CRITICAL FIX: Combine incoming tokens with our local tokens!
        if (is_valid(cache_entry)) {
            out_msg.TokensSec0 := in_msg.TokensSec0 + cache_entry.TokensSec0;
            out_msg.TokensSec1 := in_msg.TokensSec1 + cache_entry.TokensSec1;
        } else {
            out_msg.TokensSec0 := in_msg.TokensSec0;
            out_msg.TokensSec1 := in_msg.TokensSec1;
        }

        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.token_sector_mask := in_msg.token_sector_mask;
        out_msg.Dirty := in_msg.Dirty;
        out_msg.MessageSize := in_msg.MessageSize;
      }
    }

    // Safely zero out our local tokens since we just yielded them all
    if (is_valid(cache_entry)) {
        cache_entry.TokensSec0 := 0;
        cache_entry.TokensSec1 := 0;
        cache_entry.DirtySectors := 0;
        cache_entry.Dirty := false;
    }
  }

  action(h_load_hit, "hd", desc="CPU load hit") {
    // Always assert validity first!
    assert(is_valid(cache_entry));

    L1Dcache.setMRU(cache_entry);

    // Unconditional callback
    sequencer.readCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);
  }

  action(amtc_selfOwnerSectorMissHit, "soh",
         desc="Repair stale ValidSectors in modified owner and satisfy pending read/ifetch") {
    assert(is_valid(cache_entry));

    peek(mandatoryQueue_in, RubyRequest) {
      int needed_mask := amtc_getRequiredSectorMask(in_msg.LineAddress,
                                                   in_msg.PhysicalAddress,
                                                   in_msg.Size);

      cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors,
                                                  needed_mask);

      DPRINTF(RubySlicc,
              "AMTC_L1_SELF_OWNER_SECTOR_MISS_HIT addr=%#x mask=%x valid=%x state=%d T0=%d T1=%d\n",
              address, needed_mask, cache_entry.ValidSectors,
              cache_entry.CacheState, cache_entry.TokensSec0,
              cache_entry.TokensSec1);

      if (in_msg.Type == RubyRequestType:IFETCH) {
        if (L1Icache.isTagPresent(address)) {
          L1Icache.setMRU(address);
        }
      } else {
        if (L1Dcache.isTagPresent(address)) {
          L1Dcache.setMRU(address);
        }
      }

      sequencer.readCallback(address, cache_entry.DataBlk, false,
                             MachineType:L1Cache);
    }
  }

 action(h_ifetch_hit, "hi", desc="CPU ifetch hit") {
    assert(is_valid(cache_entry));

    L1Icache.setMRU(cache_entry);

    // Unconditional callback. We trust the in_port only fired Ifetch
    // because the specific sector the CPU wants is actually here.
    sequencer.readCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);

    // AMTC: do not issue untracked background GETS from a hit path.
    // Earlier versions repeatedly issued background sector fetches without a
    // TBE/completion context.  Those packets can race with real misses and
    // confuse Directory/L2 ownership.  Sector fills are now strictly demand
    // driven by Load_Sector_Miss/Ifetch miss paths.
    if (cache_entry.ValidSectors != amtc_fullMask()) {
        DPRINTF(RubySlicc,
                "AMTC_L1_PARTIAL_IFETCH_HIT_NO_BG addr=%#x valid=%x\n",
                address, cache_entry.ValidSectors);
    }
  }

  action(hh_store_hit, "\\h", desc="CPU store hit") {
    assert(is_valid(cache_entry));
    L1Dcache.setMRU(cache_entry);

    // Look directly into the CPU queue to get the unstripped physical address.
    peek(mandatoryQueue_in, RubyRequest) {
      int req_offset := getOffset(in_msg.PhysicalAddress);
      int store_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);
      store_mask := amtc_sanitizeMask(store_mask);

      int store_excl_mask := amtc_exclusiveTokenMask(cache_entry);
      int store_valid_mask := amtc_intersectMasks(cache_entry.ValidSectors,
                                                  store_mask);
      int store_owned_mask := amtc_intersectMasks(store_excl_mask,
                                                  store_mask);

      // V85S-r9: a store hit is legal only with both authoritative old bytes
      // and exact exclusive ownership for every touched sector.  Do not issue
      // the CPU callback and then clamp metadata; fail at the producer if the
      // mandatory classifier ever routes an invalid hit here.
      assert(store_valid_mask == store_mask);
      assert(store_owned_mask == store_mask);

      sequencer.writeCallback(address, cache_entry.DataBlk, false,
                              MachineType:L1Cache);
      cache_entry.Dirty := true;
      cache_entry.DirtySectors :=
          amtc_unionMasks(cache_entry.DirtySectors, store_mask);

      DPRINTF(RubySlicc,
              "AMTC_L1_STORE_HIT_DATA_OWNED_V85S_R9 addr=%#x mask=%x valid=%x dirty=%x excl=%x T0=%d T1=%d\n",
              address, store_mask, cache_entry.ValidSectors,
              cache_entry.DirtySectors, store_excl_mask,
              cache_entry.TokensSec0, cache_entry.TokensSec1);
    }
  }



  action(x_external_load_hit, "x", desc="External load completion") {
    peek(responseNetwork_in, ResponseMsg) {
      if (L1Icache.isTagPresent(address)) {
        L1Icache.setMRU(address);
      }
      if (L1Dcache.isTagPresent(address)) {
        L1Dcache.setMRU(address);
      }
      sequencer.readCallback(address, cache_entry.DataBlk, true, machineIDToMachineType(in_msg.Sender));
    }
  }

  action(xx_external_store_hit, "\\x", desc="External store completion (sector-aware)") {
    assert(is_valid(cache_entry));

    peek(responseNetwork_in, ResponseMsg) {
      // IMPORTANT: `address` is the line address in SLICC transitions, so
      // amtc_isSectorAvailable(cache_entry.ValidSectors, address) checks
      // sector 0 for every line.  For a sector-1 Store_Sector_Miss, that
      // suppresses the writeCallback even after DATA_OWNER installed sector 1,
      // leaving the Sequencer request stuck in m_readRequestTable/m_write table
      // until deadlock.  Use the TBE requested mask instead.
      bool requested_store_bytes_ready := true;
      int store_mask := amtc_fullMask();

      if (is_valid(tbe)) {
        store_mask := amtc_sanitizeMask(tbe.RequestedSectorMask);
        requested_store_bytes_ready :=
          amtc_maskContainsAll(cache_entry.ValidSectors, store_mask);
      }

      if (requested_store_bytes_ready) {
        if (L1Icache.isTagPresent(address)) {
          L1Icache.setMRU(address);
        }
        if (L1Dcache.isTagPresent(address)) {
          L1Dcache.setMRU(address);
        }

        DPRINTF(RubySlicc,
                "AMTC_L1_EXTERNAL_STORE_CALLBACK addr=%#x mask=%x valid=%x T0=%d T1=%d\n",
                address, store_mask, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1);

        sequencer.writeCallback(address, cache_entry.DataBlk, true,
                                machineIDToMachineType(in_msg.Sender));

        int ext_store_excl_mask := amtc_exclusiveTokenMask(cache_entry);
        int ext_store_valid_owned_mask :=
            amtc_intersectMasks(cache_entry.ValidSectors, ext_store_excl_mask);
        int ext_store_dirty_mask :=
            amtc_intersectMasks(store_mask, ext_store_valid_owned_mask);

        assert(ext_store_dirty_mask == store_mask);

        if (ext_store_dirty_mask != 0) {
          cache_entry.Dirty := true;
          cache_entry.DirtySectors :=
            amtc_unionMasks(cache_entry.DirtySectors, ext_store_dirty_mask);
        }
      } else {
        DPRINTF(RubySlicc,
                "AMTC_L1_EXTERNAL_STORE_WAIT addr=%#x mask=%x valid=%x T0=%d T1=%d\n",
                address, store_mask, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1);
      }
    }
  }


  action(initTBERequestTracking, "irt", desc="Initialize AMTC sector tracking") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_offset := getOffset(in_msg.PhysicalAddress);
      int req_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);
      if (req_mask == 0) {
        req_mask := amtc_maskFromSector(amtc_sectorFromAddr(in_msg.PhysicalAddress));
      }
      req_mask := amtc_sanitizeMask(req_mask);
      int req_sid := amtc_primarySectorFromMask(req_mask);

      // V26: Preserve the real CPU access sector separately from the
      // protocol request mask.  L2 may return/install a full-line owner
      // response for performance, but DirtySectors must track only the
      // sector(s) actually written by this CPU operation.
      tbe.TargetMask := req_mask;
      tbe.CompletedMask := 0;

      tbe.RequestedSectorMask := req_mask;
      // Warm sector upgrades already have the data bytes locally; only tokens
      // may be missing. Seed the received mask from existing valid sectors so
      // a token-only ACK can satisfy centralized completion.
      if (is_valid(cache_entry)) {
        tbe.ReceivedSectorMask := amtc_intersectMasks(cache_entry.ValidSectors, req_mask);
      } else {
        tbe.ReceivedSectorMask := 0;
      }
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := req_sid;
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.OwnerPullIssued := false;
      tbe.FromGPU := false;

      DPRINTF(RubySlicc,
        "AMTC_L1_TBE_INIT addr=%#x line=%#x sid=%d mask=%d\n",
        in_msg.LineAddress, address, req_sid, req_mask);
    }
  }

action(i_allocateTBE, "i", desc="Allocate TBE") {
    check_allocate(L1_TBEs);
    L1_TBEs.allocate(address);
    set_tbe(L1_TBEs[address]);
    tbe.IssueCount := 0;

    peek(mandatoryQueue_in, RubyRequest) {
      tbe.PC := in_msg.ProgramCounter;
      tbe.TypeOfAccess := cache_request_type_to_access_type(in_msg.Type);
      if (in_msg.Type == RubyRequestType:ATOMIC ||
          in_msg.Type == RubyRequestType:Locked_RMW_Write) {
        tbe.IsAtomic := true;
      }
      tbe.Prefetch := in_msg.Prefetch;
      tbe.AccessMode := in_msg.AccessMode;

      // =========================================================
      // AMTC MIXED-MODE FETCH LOGIC
      // =========================================================
      int req_mask := amtc_fullMask();

      tbe.TargetMask := req_mask;
      tbe.CompletedMask := 0;
      tbe.RequestedSectorMask := req_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := 0; // Default to 0 for full line
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.FromGPU := false;
      tbe.InitialRequestIssued := false;
      tbe.OwnerPullIssued := false;
      tbe.SharedReady := false;
      tbe.ExclusiveReady := false;
      tbe.IsSyncRequest := false;
      tbe.IsBypassRequest := false;
      tbe.IsAtomicRequest := tbe.IsAtomic;
      tbe.IsSignalRequest := false;
      tbe.CURequestor := 0;
      tbe.Wfid := 0;
      tbe.InstSeqNum := 0;
      tbe.IssueTime := curCycle();

    }
  }

  action(ta_traceStalledAddress, "ta", desc="Trace Stalled Address") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
  }

  action(j_setReissueTimer, "ja", desc="Arm/re-arm the AMTC reissue timer") {
    assert(is_valid(tbe));

    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }

    reissueTimerTable.set(address,
                          clockEdge() + cyclesToTicks(fixed_timeout_latency));

    DPRINTF(RubySlicc,
            "AMTC_L1_REISSUE_TIMER_ARM addr=%#x issue=%d timeout=%d\n",
            address, tbe.IssueCount, fixed_timeout_latency);
  }

  action(j_unsetReissueTimer, "j", desc="Unset reissue timer.") {
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
  }

  action(j_rearmReissueTimerIfPending, "jr", desc="Re-arm AMTC reissue timer only if request remains pending after completion check") {
    if (is_valid(tbe) && !tbe.CallbackIssued) {
      if (reissueTimerTable.isSet(address)) {
        reissueTimerTable.unset(address);
      }

      reissueTimerTable.set(address,
                            clockEdge() + cyclesToTicks(fixed_timeout_latency));
    }
  }

  action(jj_unsetUseTimer, "\j", desc="Unset use timer.") {
    if (useTimerTable.isSet(address)) {
      useTimerTable.unset(address);
    }
  }

  action(k_popMandatoryQueue, "k", desc="Pop mandatory queue.") {
    mandatoryQueue_in.dequeue(clockEdge());
  }

  action(l_popPersistentQueue, "l", desc="Pop persistent queue.") {
    persistentNetwork_in.dequeue(clockEdge());
  }

  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(n_popResponseQueue, "n", desc="Pop response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(o_scheduleUseTimeout, "o", desc="Schedule a use timeout.") {
    useTimerTable.set(
        address, clockEdge() + cyclesToTicks(use_timeout_latency));
  }

  action(p_informL2AboutTokenLoss, "p", desc="Inform L2 about loss of all tokens") {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
       out_msg.addr := address;
       out_msg.Type := CoherenceResponseType:INV;
       out_msg.TokensSec0 := 0;
out_msg.TokensSec1 := 0;
       out_msg.Sender := machineID;

       out_msg.Destination.add(mapAddressToRange(address,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0)));
       out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(q_updateTokensFromResponse, "q", desc="Strict additive token update based on response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int tokens_per_sector := max_tokens() / 2;
      int new_t0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      int new_t1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      // V85S: every response token is a physical token transfer.  Never clamp
      // an over-count; an over-count is a protocol-conservation violation.
      assert(new_t0 >= 0);
      assert(new_t1 >= 0);
      assert(new_t0 <= tokens_per_sector);
      assert(new_t1 <= tokens_per_sector);

      cache_entry.TokensSec0 := new_t0;
      cache_entry.TokensSec1 := new_t1;

      if (in_msg.Dirty) {
        int resp_dirty_mask := amtc_intersectMasks(in_msg.valid_sector_mask,
                                                   cache_entry.ValidSectors);
        if (resp_dirty_mask == 0) {
          resp_dirty_mask := in_msg.valid_sector_mask;
        }
        cache_entry.Dirty := true;
        cache_entry.DirtySectors :=
          amtc_unionMasks(cache_entry.DirtySectors, resp_dirty_mask);
      }

      DPRINTF(RubySlicc,
              "AMTC_L1_TOKEN_ADD_V85S addr=%#x type=%s in0=%d in1=%d t0=%d t1=%d\n",
              address, in_msg.Type, in_msg.TokensSec0, in_msg.TokensSec1,
              cache_entry.TokensSec0, cache_entry.TokensSec1);
    }
  }

  action(amtc_completeIfAlreadyOwnsSector, "aco",
       desc="Complete upgrade if sector tokens are already locally owned") {
    if (is_valid(cache_entry)) {

      // CRITICAL FIX: We no longer care about the monolithic cache_entry.Tokens.
      // We only care if we have 512 tokens for the specifically requested sector(s).

      int tokens_per_sector := max_tokens() / 2;
      int upgrade_mask := cache_entry.ValidSectors;

      if (is_valid(tbe)) {
          upgrade_mask := amtc_intersectMasks(cache_entry.ValidSectors, tbe.RequestedSectorMask);

          if (amtc_maskHasSector(tbe.RequestedSectorMask, 0)) {
              assert(cache_entry.TokensSec0 == tokens_per_sector);
          }
          if (amtc_maskHasSector(tbe.RequestedSectorMask, 1)) {
              assert(cache_entry.TokensSec1 == tokens_per_sector);
          }
      } else {
          // If there is no TBE, we gracefully fall back to checking the whole line.
          if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
              assert(cache_entry.TokensSec0 == tokens_per_sector);
          }
          if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
              assert(cache_entry.TokensSec1 == tokens_per_sector);
          }
      }

      DPRINTF(RubySlicc,
        "AMTC_L1_COMPLETE_OWNED_SECTOR addr=%#x valid=%d upgrading_mask=%d\n",
        address, cache_entry.ValidSectors, upgrade_mask);

      // Upgrade the specific sector to Dirty.  Keep the mask limited to
      // sectors that are still exclusive at the time of completion.
      int upgrade_dirty_mask := amtc_intersectMasks(upgrade_mask,
                                                    amtc_exclusiveTokenMask(cache_entry));
      cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors,
                                                  upgrade_dirty_mask);
      if (upgrade_dirty_mask != 0) {
        cache_entry.Dirty := true;
      }
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {

    assert(is_valid(tbe));
    if (tbe.WentPersistent) {
      // assert(starving);
      outstandingRequests := outstandingRequests - 1;
      enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := PersistentRequestType:DEACTIVATE_PERSISTENT;
        out_msg.Requestor := machineID;
        out_msg.Destination.broadcast(MachineType:L1Cache);

        //
        // Currently the configuration system limits the system to only one
        // chip.  Therefore, if we assume one shared L2 cache, then only one
        // pertinent L2 cache exist.
        //
        //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));

        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Persistent_Control;
      }
      starving := false;
    }

    // Update average latency
    if (tbe.IssueCount <= 1) {
      if (tbe.ExternalResponse) {
        updateAverageLatencyEstimate(curCycle() - tbe.IssueTime);
      }
    }

    // Profile
    //if (tbe.WentPersistent) {
    //  profile_token_retry(address, tbe.TypeOfAccess, 2);
    //}
    //else {
    //  profile_token_retry(address, tbe.TypeOfAccess, 1);
    //}

    //profile_token_retry(address, tbe.TypeOfAccess, tbe.IssueCount);
    L1_TBEs.deallocate(address);
    unset_tbe();
  }


  // AMTC audit55:
  // If a forwarded GETS reaches this L1 while the line is NP/I, the Directory/L2
  // had stale sharer/owner information.  Silently popping the snoop loses the
  // only response expected by the requester, which can leave the requester
  // blocked in the Sequencer.  Send an explicit zero-token owner ACK so the
  // requester observes progress and can continue retry/owner-pull policy.
  action(nso_sendStaleOwnerAck, "nso", desc="Send zero-token stale-owner ACK for NP/I forwarded GETS") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.Dirty := false;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := in_msg.sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := 0;
        out_msg.merged_resp := false;
      }
      DPRINTF(RubySlicc,
              "AMTC_L1_STALE_OWNER_ACK addr=%#x req=%s mask=%d requester=%s\n",
              address, in_msg.Type, in_msg.requested_sector_mask, in_msg.Requestor);
    }
  }

  action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // Evaluate if we hold tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;

          // We are yielding stray tokens. This is strictly a control message.
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // Even though it's an ACK, we pass the block along just in case
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.MessageSize := MessageSizeType:Response_Control;

          // AMTC Metadata: Flag exactly which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry valid payload bytes
        }
      }
    }

    // Safely zero out our local tokens since we just yielded them all
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := 0;
      if (in_msg.Type == CoherenceResponseType:DATA_SHARED ||
          in_msg.Type == CoherenceResponseType:DATA_OWNER) {
          copy_mask := in_msg.valid_sector_mask;
      }

      int dirty_update_mask := copy_mask;
      if (is_valid(tbe) &&
          tbe.TypeOfAccess == AccessType:Write) {
        // V26: For CPU GETX/RFO, keep all returned bytes valid in L1.
        // The earlier V24 write-side intersection reintroduced partial
        // cache lines after L2 sent a full-line owner response, causing
        // later Store_Sector_Miss/Load_Sector_Miss events.
        //
        // Do NOT mark the whole returned line dirty: only the original CPU
        // write sector(s), saved in TargetMask, should become dirty.
        dirty_update_mask := amtc_intersectMasks(copy_mask, tbe.TargetMask);
        if (dirty_update_mask == 0) {
          dirty_update_mask := amtc_intersectMasks(copy_mask, tbe.RequestedSectorMask);
        }
      }

      // ===================================================================
      // CRITICAL FIX: The Refined "Late Data" Shield
      // Only drop the data if we hold ALL tokens AND we already have the valid bytes!
      // ===================================================================
      int tokens_per_sector := max_tokens() / 2;

      if (amtc_maskHasSector(copy_mask, 0) &&
          cache_entry.TokensSec0 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          copy_mask := amtc_clearSector(copy_mask, 0); // Drop stale Sec 0
      }

      if (amtc_maskHasSector(copy_mask, 1) &&
          cache_entry.TokensSec1 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          copy_mask := amtc_clearSector(copy_mask, 1); // Drop stale Sec 1
      }

      if (copy_mask != 0) {
          if (amtc_maskHasSector(copy_mask, 0)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }

          if (amtc_maskHasSector(copy_mask, 1)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors,
                                                        dirty_update_mask);
          }
      }
    }
  }

  action(gg_deallocateL1CacheBlock, "\g", desc="Deallocate cache block.  Sets the cache to invalid, allowing a replacement in parallel with a fetch.") {
    assert(getTokens(cache_entry, amtc_fullMask()) == 0);
    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    } else {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(gg_deallocateDataNoTokenBypassBlock, "gnt",
         desc="AMTC: safely drop a data-only/no-token read-bypass fill") {
    /*
     * DATA_SHARED with valid data but zero tokens is used as a read-bypass
     * completion.  The CPU sequencer has already been satisfied by
     * x_external_load_hit(), but this line must not remain in stable S because
     * it owns no token.  Do not use gg_deallocateL1CacheBlock() here: that
     * action is for normal protocol deallocations and asserts token cleanliness.
     * A bypass fill may have stale per-sector metadata from the just allocated
     * cache entry or from a recycled entry.  Clear all AMTC metadata first and
     * deallocate only if a tag is actually present.
     */
    if (is_valid(cache_entry)) {
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
      cache_entry.ValidSectors := 0;
      cache_entry.DirtySectors := 0;
      cache_entry.Dirty := false;
    }

    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    }
    if (L1Icache.isTagPresent(address)) {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(ii_allocateL1DCacheBlock, "\i", desc="Set L1 D-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Dcache.allocate(address, new Entry));
    }
  }

  action(pp_allocateL1ICacheBlock, "\p", desc="Set L1 I-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Icache.allocate(address, new Entry));
    }
  }

  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
    if (send_evictions) {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
      sequencer.evictionCallback(address);
    }
  }

  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
    L1Icache.profileDemandMiss();
  }

  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
    L1Icache.profileDemandHit();
  }

  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
    L1Dcache.profileDemandMiss();
  }

  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
    L1Dcache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      //assert(cache_entry.DataBlk == in_msg.DataBlk);
    }
  }

  action(zz_stallAndWaitMandatoryQueue, "\z", desc="Send the head of the mandatory queue to the back of the queue.") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
    stall_and_wait(mandatoryQueue_in, address);
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  action(ka_wakeUpAllDependents, "ka", desc="wake-up all dependents") {
    wakeUpAllBuffers();
  }

action(amtc_markValidSectorsFromResponse, "mvs", desc="Mark valid sectors from response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // Only process masks from actual data-carrying messages
      if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
          in_msg.Type == CoherenceResponseType:DATA_SHARED) {

          int update_mask := amtc_sanitizeMask(in_msg.valid_sector_mask);

          // Data installation is cache-wide, not request-wide.  A DATA response
          // can legally carry a full DataBlk and valid_sector_mask=3 even when
          // the original request only needed one sector.  Keep completion strict
          // in acc_accumulateResponse by intersecting ReceivedSectorMask with
          // tbe.RequestedSectorMask, but mark every data-carrying sector valid
          // in the cache entry so later sector accesses do not self-deadlock
          // by asking Directory for bytes already installed locally.

          // If the network gave us the data, mark it valid in the SRAM immediately!
          // The transient state will protect the CPU from reading it until tokens arrive.
          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, update_mask);

          if(is_valid(tbe)) {
            DPRINTF(RubySlicc,
                  "AMTC_L1_MARK_DATA_VALID addr=%#x update=%x valid=%x req=%x\n",
                  address, update_mask, cache_entry.ValidSectors,
                  tbe.RequestedSectorMask );
          } else {
            DPRINTF(RubySlicc,
                  "AMTC_L1_MARK_DATA_VALID addr=%#x update=%x valid=%x req=%x\n",
                  address, update_mask, cache_entry.ValidSectors,
                  0 );
          }
      }
    }
  }

  action(amtc_recomputeValidFromTokens, "rv", desc="Clear validity when a sector loses its last token") {
    // V85S: token ownership is permission, not proof that bytes were installed.
    // This helper may invalidate data after token donation, but must never set a
    // ValidSectors bit solely because a token exists.
    if (cache_entry.TokensSec0 == 0) {
      // V85S-r8: dropping local validity is legal only for clean bytes.
      assert(!amtc_maskHasSector(cache_entry.DirtySectors, 0));
      cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 1);
    }
    if (cache_entry.TokensSec1 == 0) {
      assert(!amtc_maskHasSector(cache_entry.DirtySectors, 1));
      cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 2);
    }
  }
  // Legacy L1 owner-read request action removed: owner convergence belongs to L2/TCC.
  // Legacy immediate missing-sector pull removed: L1 is passive.

  action(acc_accumulateResponse, "acc", desc="Strictly accumulate incoming partial data and physical tokens") {
    peek(responseNetwork_in, ResponseMsg) {
      // Late responses are allowed after completion, but they must not mutate a
      // new/stable transaction after the original TBE has retired.
      if (!is_valid(tbe)) {
        DPRINTF(RubySlicc,
                "AMTC_L1_ACC_DROP_LATE_RESPONSE_NO_TBE addr=%#x valid=%x token=%x T0=%d T1=%d cache_valid=%d\n",
                address, in_msg.valid_sector_mask, in_msg.token_sector_mask,
                in_msg.TokensSec0, in_msg.TokensSec1, is_valid(cache_entry));
      } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER &&
                 in_msg.TokensSec0 == 0 &&
                 in_msg.TokensSec1 == 0 &&
                 in_msg.valid_sector_mask == 0 &&
                 in_msg.token_sector_mask == 0) {
        DPRINTF(RubySlicc,
                "AMTC_L1_ACC_IGNORE_ZERO_OWNER_ACK addr=%#x tbe_valid=%d cache_valid=%d\n",
                address, is_valid(tbe), is_valid(cache_entry));
      } else {
        assert(is_valid(tbe));
        assert(is_valid(cache_entry));

        int incoming_valid_mask := 0;
        if (in_msg.Type == CoherenceResponseType:DATA_SHARED ||
            in_msg.Type == CoherenceResponseType:DATA_OWNER) {
          incoming_valid_mask :=
              amtc_intersectMasks(in_msg.valid_sector_mask,
                                  tbe.RequestedSectorMask);
        }

        tbe.ReceivedSectorMask :=
            amtc_unionMasks(tbe.ReceivedSectorMask, incoming_valid_mask);

        if (incoming_valid_mask != 0 ||
            in_msg.TokensSec0 != 0 ||
            in_msg.TokensSec1 != 0) {
          tbe.ForwardProgressFlag := true;
        }

        int tokens_per_sector := max_tokens() / 2;
        int new_t0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
        int new_t1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

        // V85S: no saturation and no 511->512 repair.  The only legal write
        // completion is exact accumulation of physical tokens.
        assert(new_t0 >= 0);
        assert(new_t1 >= 0);
        assert(new_t0 <= tokens_per_sector);
        assert(new_t1 <= tokens_per_sector);

        cache_entry.TokensSec0 := new_t0;
        cache_entry.TokensSec1 := new_t1;

        DPRINTF(RubySlicc,
                "AMTC_L1_ACC_TOKEN_ADD_V85S addr=%#x type=%s req=%x in0=%d in1=%d t0=%d t1=%d recv=%x\n",
                address, in_msg.Type, tbe.RequestedSectorMask,
                in_msg.TokensSec0, in_msg.TokensSec1,
                cache_entry.TokensSec0, cache_entry.TokensSec1,
                tbe.ReceivedSectorMask);
      }
    }
  }



action(ck_checkCompletion, "ck",
       desc="Evaluate convergence status and wake CPU only after convergence") {

    // AMTC safety fix:
    // Do not access tbe after L1_TBEs.deallocate()/unset_tbe().  Earlier
    // versions completed a read, deallocated the TBE, and then continued into
    // the write-completion test using tbe.TypeOfAccess, which can segfault in
    // generated C++.
    if (is_valid(tbe) && is_valid(cache_entry)) {

        bool data_ready :=
            amtc_maskContainsAll(
                tbe.ReceivedSectorMask,
                tbe.RequestedSectorMask);

        bool shared_ready := true;
        bool exclusive_ready := true;

        int req_tokens := max_tokens() / 2;

        if (amtc_maskHasSector(tbe.RequestedSectorMask, 0)) {
            if (cache_entry.TokensSec0 == 0) {
                shared_ready := false;
            }
            if (cache_entry.TokensSec0 < req_tokens) {
                exclusive_ready := false;
            }
        }

        if (amtc_maskHasSector(tbe.RequestedSectorMask, 1)) {
            if (cache_entry.TokensSec1 == 0) {
                shared_ready := false;
            }
            if (cache_entry.TokensSec1 < req_tokens) {
                exclusive_ready := false;
            }
        }

        // Snapshot all TBE-derived decisions before any completion path can
        // deallocate the TBE.  Do not read tbe again after L1_TBEs.deallocate().
        bool is_read := (tbe.TypeOfAccess == AccessType:Read);
        bool is_write := (tbe.TypeOfAccess == AccessType:Write);
        bool already_called_back := tbe.CallbackIssued;
        int req_mask_snapshot := tbe.RequestedSectorMask;
        int recv_mask_snapshot := tbe.ReceivedSectorMask;

        bool read_can_complete := data_ready && shared_ready && is_read;

        // V85S-r9: ownership is permission, not a substitute for old bytes.
        // CPU stores in this workload may be sub-sector/partial, so completion
        // requires authoritative data for every requested sector as well as
        // exact ownership.  When ownership converges first, r7 requests a
        // data-only owner pull instead of fabricating validity here.
        bool write_can_complete :=
            data_ready && exclusive_ready && is_write;
        bool did_complete := false;

        tbe.SharedReady := false;
        tbe.ExclusiveReady := false;

        if (read_can_complete) {

            tbe.SharedReady := true;

            if (!already_called_back) {
                tbe.CallbackIssued := true;
                cache_entry.CacheState := State:S;

                if (reissueTimerTable.isSet(address)) {
                    reissueTimerTable.unset(address);
                }

                if (L1Icache.isTagPresent(address)) {
                    L1Icache.setMRU(address);
                }
                if (L1Dcache.isTagPresent(address)) {
                    L1Dcache.setMRU(address);
                }
                DPRINTF(RubySlicc,
                        "AMTC_L1_CK_READ_COMPLETE addr=%#x req=%x recv=%x valid=%x t0=%d t1=%d\n",
                        address, req_mask_snapshot, recv_mask_snapshot,
                        cache_entry.ValidSectors, cache_entry.TokensSec0, cache_entry.TokensSec1);
                sequencer.readCallback(address, cache_entry.DataBlk, false,
                                       MachineType:L1Cache);

                L1_TBEs.deallocate(address);
                unset_tbe();
                did_complete := true;
            }
        }

        // Important: use write_can_complete computed before possible TBE
        // deallocation above.  Do not touch tbe in this branch if the read path
        // already completed and freed it.
        if (!did_complete && write_can_complete) {

            tbe.ExclusiveReady := true;

            if (!already_called_back) {
                tbe.CallbackIssued := true;

                // data_ready above proves that the requested bytes were either
                // already resident or installed by a real response.  Never set
                // ValidSectors from token ownership in the completion path.
                assert(amtc_maskContainsAll(cache_entry.ValidSectors,
                                            req_mask_snapshot));

                cache_entry.CacheState := State:MM;
                int ck_excl_mask := amtc_exclusiveTokenMask(cache_entry);
                int write_dirty_req_mask := req_mask_snapshot;
                if (tbe.TargetMask != 0) {
                    write_dirty_req_mask := tbe.TargetMask;
                }

                int ck_valid_owned_mask :=
                    amtc_intersectMasks(cache_entry.ValidSectors, ck_excl_mask);
                int ck_dirty_mask :=
                    amtc_intersectMasks(write_dirty_req_mask,
                                        ck_valid_owned_mask);

                // The actual CPU write target must be both valid and exclusive
                // before the callback can make it dirty.
                assert(ck_dirty_mask == write_dirty_req_mask);

                if (ck_dirty_mask != 0) {
                    cache_entry.Dirty := true;
                    cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors,
                                                                ck_dirty_mask);
                }

                if (reissueTimerTable.isSet(address)) {
                    reissueTimerTable.unset(address);
                }

                if (L1Icache.isTagPresent(address)) {
                    L1Icache.setMRU(address);
                }
                if (L1Dcache.isTagPresent(address)) {
                    L1Dcache.setMRU(address);
                }
                DPRINTF(RubySlicc,
                        "AMTC_L1_CK_WRITE_COMPLETE addr=%#x req=%x recv=%x valid=%x dirty=%x t0=%d t1=%d\n",
                        address, req_mask_snapshot, recv_mask_snapshot,
                        cache_entry.ValidSectors, cache_entry.DirtySectors,
                        cache_entry.TokensSec0, cache_entry.TokensSec1);
                sequencer.writeCallback(address, cache_entry.DataBlk, false,
                                        MachineType:L1Cache);

                L1_TBEs.deallocate(address);
                unset_tbe();
            }
        }

        if (!did_complete && !read_can_complete && !write_can_complete) {
            DPRINTF(RubySlicc,
                    "AMTC_L1_CK_WAIT addr=%#x access=%d req=%x recv=%x valid=%x dirty=%x shared=%d excl=%d data=%d t0=%d t1=%d owner_pull=%d\n",
                    address, tbe.TypeOfAccess, req_mask_snapshot,
                    recv_mask_snapshot, cache_entry.ValidSectors,
                    cache_entry.DirtySectors, shared_ready,
                    exclusive_ready, data_ready,
                    cache_entry.TokensSec0, cache_entry.TokensSec1,
                    tbe.OwnerPullIssued);
        }
    } else {
        DPRINTF(RubySlicc,
                "AMTC_L1_CK_SKIP_INVALID_CONTEXT addr=%#x tbe_valid=%d entry_valid=%d\n",
                address, is_valid(tbe), is_valid(cache_entry));
    }
}

action(swo_ignoreStaleOwnerWriteAck, "swo", desc="Ignore zero-token stale owner ACK for write wait") {
    int cur_t0 := 0;
    int cur_t1 := 0;
    int req_mask := 0;
    int issue_count := -1;
    int recv_mask := 0;

    if (is_valid(cache_entry)) {
        cur_t0 := cache_entry.TokensSec0;
        cur_t1 := cache_entry.TokensSec1;
    }

    if (is_valid(tbe)) {
        req_mask := tbe.RequestedSectorMask;
        issue_count := tbe.IssueCount;
        recv_mask := tbe.ReceivedSectorMask;
    }

    DPRINTF(RubySlicc,
            "AMTC_L1_STALE_OWNER_WRITE_ACK addr=%#x tbe_valid=%d mask=%d issue=%d recv=%d T0=%d T1=%d\n",
            address, is_valid(tbe), req_mask, issue_count,
            recv_mask, cur_t0, cur_t1);

    // No data and no tokens arrived, so this is not forward progress.
    // If a valid write TBE still exists, do not merely wait for the normal
    // timeout.  The zero-token ACK_OWNER already proves the Directory's owner
    // metadata is stale, so immediately send a high-RetryNum GETX to trigger
    // Directory's CPU_GETX_Stale_Self repair path.  If the TBE is gone, this is
    // a late response; just drop it.
    if (is_valid(tbe)) {
        int stale_retry := tbe.IssueCount;
        if (stale_retry < 32) {
            stale_retry := 32;
        } else {
            stale_retry := stale_retry + 1;
        }

        DPRINTF(RubySlicc,
                "AMTC_L1_STALE_OWNER_FORCE_GETX_RETRY addr=%#x mask=%d retry=%d access=%d\n",
                address, tbe.RequestedSectorMask, stale_retry, tbe.TypeOfAccess);

        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Type := CoherenceRequestType:GETX;
            out_msg.Requestor := machineID;
            // AMTC audit88: retry through L2 only; L2 forwards to Directory.
            out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                       l2_select_low_bit,
                                                       l2_select_num_bits,
                                                       intToID(0)));
            out_msg.RetryNum := stale_retry;
            out_msg.MessageSize := MessageSizeType:Request_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
            out_msg.sector_id := tbe.LastSectorID;
            out_msg.sector_mask := tbe.RequestedSectorMask;
            out_msg.requested_sector_mask := tbe.RequestedSectorMask;
            out_msg.is_gpu := false;
            out_msg.is_sync := false;
            out_msg.is_bypass := false;
            out_msg.is_atomic := tbe.IsAtomic;
            out_msg.is_signal := false;
            out_msg.merged_req := false;
            out_msg.is_owner_pull := false;
            out_msg.isGLCSet := false;
            out_msg.isSLCSet := false;
        }

        tbe.IssueCount := stale_retry + 1;
        tbe.LastIssueTime := curCycle();
        tbe.ForwardProgressFlag := false;
        tbe.NoProgressTimeouts := 0;
        tbe.HasOutstandingRequest := true;

        if (reissueTimerTable.isSet(address)) {
            reissueTimerTable.unset(address);
        }
        reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
    }
}

// Audit72 old-conversion note: the force-GETX retry action was removed.
// ck_checkCompletion now completes CPU writes once exclusive tokens arrive;
// the wait-state timeout/reissue path remains the only retry mechanism.

action(r_issueReadOwnerPullFallback, "rop", desc="Resend GETS as owner-pull after stale owner ACK") {
    assert(is_valid(tbe));

    DPRINTF(RubySlicc,
            "AMTC_L1_STALE_OWNER_PULL_READ addr=%#x mask=%d issue=%d recv=%d valid=%d T0=%d T1=%d\n",
            address, tbe.RequestedSectorMask, tbe.IssueCount,
            tbe.ReceivedSectorMask,
            cache_entry.ValidSectors,
            cache_entry.TokensSec0,
            cache_entry.TokensSec1);

    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        // AMTC audit88: owner-pull fallback also goes through L2 only.
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                   l2_select_low_bit,
                                                   l2_select_num_bits,
                                                   intToID(0)));
        out_msg.RetryNum := tbe.IssueCount;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Prefetch := tbe.Prefetch;
        out_msg.AccessMode := tbe.AccessMode;
        out_msg.sector_id := tbe.LastSectorID;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.requested_sector_mask := tbe.RequestedSectorMask;
        out_msg.is_gpu := false;
        out_msg.is_sync := false;
        out_msg.is_bypass := false;
        out_msg.is_atomic := tbe.IsAtomic;
        out_msg.is_signal := false;
        out_msg.merged_req := false;
        out_msg.is_owner_pull := true;
    }

    tbe.OwnerPullIssued := true;
    tbe.IssueCount := tbe.IssueCount + 1;
    tbe.LastIssueTime := curCycle();
    tbe.NoProgressTimeouts := 0;
    tbe.ForwardProgressFlag := false;

    if (reissueTimerTable.isSet(address)) {
        reissueTimerTable.unset(address);
    }
    reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
}

action(t_handleStrictTimeout, "t_to", desc="Guarded passive timeout resend") {
    assert(is_valid(tbe));

    bool full_timeout_fired :=
        (curCycle() - tbe.LastIssueTime) >= fixed_timeout_latency;

    if (full_timeout_fired) {
        if (tbe.ForwardProgressFlag) {
            // Progress was observed in this timeout window. Do not resend.
            // Reset the window and keep waiting for L2/TCC convergence.
            tbe.NoProgressTimeouts := 0;
            tbe.ForwardProgressFlag := false;
        } else {
            tbe.NoProgressTimeouts := tbe.NoProgressTimeouts + 1;
        }
    }

    bool no_forward_progress := (tbe.ForwardProgressFlag == false);

    // retry_threshold is the user-visible retry BUDGET (--l1-retries), not
    // the number of silent timeout windows to wait before the first retry.
    // With --l1-retries=1000000, using it as the no-progress threshold makes
    // SM/S_IM wait forever and Sequencer reports deadlock before L1 ever
    // resends.  Resend after one no-progress window, but still honor the
    // retry budget with IssueCount.
    bool retry_threshold_reached := (tbe.NoProgressTimeouts >= 1);
    bool retry_budget_available := (tbe.IssueCount < retry_threshold);

    DPRINTF(RubySlicc,
            "AMTC_L1_TIMEOUT addr=%#x type=%d mask=%d issue=%d no_progress=%d progress=%d retry_ok=%d\n",
            address, tbe.TypeOfAccess, tbe.RequestedSectorMask,
            tbe.IssueCount, tbe.NoProgressTimeouts,
            tbe.ForwardProgressFlag, retry_budget_available);

    if (full_timeout_fired && no_forward_progress && retry_threshold_reached && retry_budget_available) {
        DPRINTF(RubySlicc,
                "AMTC_L1_GUARDED_RESEND_FORCE addr=%#x mask=%d issue=%d\n",
                address, tbe.RequestedSectorMask, tbe.IssueCount);

        // Resend the EXACT ORIGINAL request only after multiple no-progress
        // timeout windows. This preserves passive L1 behavior: no missing-mask
        // recomputation, no owner pull, no sector rediscovery.
        bool resend_from_self_owner := false;
        if (is_valid(cache_entry)) {
          if (cache_entry.CacheState == State:M ||
              cache_entry.CacheState == State:MM ||
              cache_entry.CacheState == State:M_W ||
              cache_entry.CacheState == State:MM_W ||
              cache_entry.CacheState == State:M_IS ||
              cache_entry.CacheState == State:M_IM ||
              tbe.TBEState == State:M_IS ||
              tbe.TBEState == State:M_IM ||
              ((tbe.TypeOfAccess == AccessType:Read) &&
               (cache_entry.CacheState == State:O ||
                tbe.TBEState == State:O_IS ||
                tbe.TBEState == State:S_IS))) {
            resend_from_self_owner := true;
          }
        }

        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Requestor := machineID;
            if (tbe.TypeOfAccess == AccessType:Read) {
                out_msg.Type := CoherenceRequestType:GETS;
            } else {
                out_msg.Type := CoherenceRequestType:GETX;
            }
            // AMTC audit88: retry through L2 only; L2 forwards to Directory.
            out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                                                       l2_select_low_bit,
                                                       l2_select_num_bits,
                                                       intToID(0)));
            out_msg.RetryNum := tbe.IssueCount;
            out_msg.MessageSize := MessageSizeType:Request_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
            out_msg.sector_id := tbe.LastSectorID;
            out_msg.sector_mask := tbe.RequestedSectorMask;
            out_msg.requested_sector_mask := tbe.RequestedSectorMask;
            out_msg.is_gpu := false;
            out_msg.is_sync := false;
            out_msg.is_bypass := false;
            out_msg.is_atomic := tbe.IsAtomic;
            out_msg.is_signal := false;
            out_msg.merged_req := false;

            // audit53: owner_pull must mean "I already own the tokens; I only
            // need the missing bytes/data".  Do NOT set owner_pull for normal
            // S/SM/S_IM/IM_WAIT_PARTIAL write upgrades: those still require
            // tokens from L2/Directory/other L1s.
            out_msg.is_owner_pull := resend_from_self_owner;
        }

        if (resend_from_self_owner) {
          tbe.OwnerPullIssued := true;
        }

        tbe.IssueCount := tbe.IssueCount + 1;
        tbe.LastIssueTime := curCycle();
        tbe.NoProgressTimeouts := 0;
        tbe.ForwardProgressFlag := false;
    }

    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
    reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
  }

  action(absorbStaleSharedDataInWriteTransient, "assdw",
        desc="Absorb stale zero-token DATA_SHARED while waiting for ownership") {
    peek(responseNetwork_in, ResponseMsg) {
      DPRINTF(RubySlicc,
              "AMTC_L1_ABSORB_STALE_DATA_SHARED_WRITE_WAIT addr=%#x valid=%d req=%d resp_valid=%d tokmask=%d t0=%d t1=%d\n",
              address,
              cache_entry.ValidSectors,
              tbe.RequestedSectorMask,
              in_msg.valid_sector_mask,
              in_msg.token_sector_mask,
              in_msg.TokensSec0,
              in_msg.TokensSec1);
    }
  }

  //*****************************************************
  // TRANSITIONS
  //*****************************************************

 // =====================================================================
  // SECTION 1: TRANSIENT STATE STALLS (THE PIPELINE SHIELD)
  // Purpose: Block CPU mandatory queue requests while waiting for network.
  // =====================================================================

// =====================================================================
  // SECTION 1: TRANSIENT STATE STALLS (THE PIPELINE SHIELD)
  // Purpose: Block CPU mandatory queue requests while waiting for network.
  // =====================================================================

  // 1A. DATA-STARVED TRANSIENTS (Waiting for physical bytes)
  // These states have nothing. Stall EVERY CPU request.
  transition({IM, IS, IM_L, IS_L, S_IS, O_IS, M_IS, M_IM, S_IM},
             {Load, Ifetch, Store, Atomic, Load_Sector_Miss, Store_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1B. TOKEN-STARVED TRANSIENTS (Waiting for write permissions)
  // These states HAVE data. They will successfully hit on Load/Ifetch.
  // We only stall Stores, Atomics, Sector Misses, and Evictions.
  //
  // AMTC fix: SM/OM are real outstanding GETX transients with a TBE.
  // If another Store/sector event arrives while the mandatory queue is stalled,
  // do not just park it forever.  Re-arm/kick the guarded timeout path so the
  // original GETX can be resent if no token/data response arrives.  This is
  // the l1_cntrl1 issue_time deadlock: SM + Store only executed
  // zz_stallAndWaitMandatoryQueue and no progress event followed before the
  // Sequencer deadlock detector fired.
  // AMTC fix: SM/OM can also exist as cache-entry states without a live TBE
  // after earlier completion/downgrade paths.  A new Store in that state must
  // start its own GETX transaction.  Calling t_handleStrictTimeout here is
  // unsafe because that action asserts is_valid(tbe).
  transition({SM, OM}, {Store, Atomic, Store_Sector_Miss}) {
    i_allocateTBE;
    initTBERequestTracking;
    b_issueWriteRequest;
    j_setReissueTimer;
    k_popMandatoryQueue;
  }

  transition({SM, OM}, {Load_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  transition({S_L, SM_L},
             {Store, Atomic, Store_Sector_Miss, Load_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1C. TIMEOUT-WAITING TRANSIENTS (Migratory / Lockout)
  // These states have Data AND Tokens. They hit locally on Load/Store/Atomic.
  // We ONLY stall them if they trigger a sector miss or are evicted.
  transition({M_W, MM_W},
             {Load_Sector_Miss, Store_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }


  // Passive AMTC transients: a second CPU request for the same line must not
  // create a new GETS/GETX. Hold it until the convergence response moves the
  // line back to a stable state.
  transition({IS_WAIT_DATA, IS_WAIT_TOKENS, IS_WAIT_ALL, IM_WAIT_PARTIAL, IM_WAIT_EXCL},
             {Load, Ifetch, Store, Atomic, Load_Sector_Miss, Store_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1D. NETWORK SNOOP STALLS

  // AMTC closure: Directory may forward an owner probe to this L1 while this
  // same line is already waiting for data/tokens.  The transient requester is
  // not a valid owner and cannot safely donate data/tokens.  Reply with a
  // zero-token stale-owner ACK and pop the forwarded request.  This prevents
  // invalid transitions such as IS_WAIT_ALL + Transient_GETX and lets the
  // L2/Directory owner-pull repair continue instead of aborting.
  transition({IS_WAIT_DATA, IS_WAIT_TOKENS, IS_WAIT_ALL, IM_WAIT_PARTIAL, IM_WAIT_EXCL},
             {Transient_GETX, Transient_Local_GETX,
              Transient_GETS, Transient_Local_GETS,
              Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    nso_sendStaleOwnerAck;
    m_popRequestQueue;
  }

  transition({S_IS, O_IS, M_IS, M_IM, S_IM, OM, IM, SM, I_L, IM_L, IS_L, S_L, SM_L, M_W, MM_W},
             {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    m_popRequestQueue;
  }

  transition(IS, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // =====================================================================
  // SECTION 2: ALLOCATION & EVICTION (THE CACHE LIFECYCLE)
  // Purpose: Moving from Not Present (NP) to active, or Active to Idle (I).
  // =====================================================================

  // Allocation from NP (Requires cache block allocation)
  //transition(NP, Load, IS)            { ii_allocateL1DCacheBlock; i_allocateTBE; a_issueReadRequest; uu_profileDataMiss; j_setReissueTimer; }
  //transition(NP, Ifetch, IS)          { pp_allocateL1ICacheBlock; i_allocateTBE; a_issueReadRequest; uu_profileInstMiss; j_setReissueTimer; }
  //transition(NP, {Store, Atomic}, IM) { ii_allocateL1DCacheBlock; i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; j_setReissueTimer; }

  // Allocation from Idle (Block already exists, just needs TBE)
  //transition(I, Load, IS)             { i_allocateTBE; a_issueReadRequest; uu_profileDataMiss; }
  //transition(I, Ifetch, IS)           { i_allocateTBE; a_issueReadRequest; uu_profileInstMiss; }

  // AMTC audit49:
  // A forwarded GETS/GETS_LAST_TOKEN can invalidate an S line while a local
  // mandatory request for another sector of the same line is already queued.
  // The event classifier may therefore deliver Load_Sector_Miss/Store_Sector_Miss
  // while the cache-entry state is already I. Treat these as ordinary misses
  // against an already-allocated entry instead of raising an invalid transition.
  transition(I, Load_Sector_Miss, IS_WAIT_ALL) {
    i_allocateTBE;
    initTBERequestTracking;
    a_issueReadRequest;
    j_setReissueTimer;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(I, Store_Sector_Miss, IM_WAIT_PARTIAL) {
    i_allocateTBE;
    initTBERequestTracking;
    b_issueWriteRequest;
    j_setReissueTimer;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // Evictions
  transition(I, L1_Replacement)       { ta_traceStalledAddress; tr_tokenReplacement; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }
  transition(S, L1_Replacement, I)    { ta_traceStalledAddress; cc_sharedReplacement; forward_eviction_to_cpu; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }
  transition({O, M, MM}, L1_Replacement, I) { ta_traceStalledAddress; c_ownedReplacement; forward_eviction_to_cpu; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }

  // =====================================================================
  // SECTION 2B: BASE STATE SNOOP DROPS & BOUNCES
  // Purpose: Safely ignore network requests for cache lines we don't hold.
  // =====================================================================

  // 1. Snoops and stray responses to NP (Not Present)
  // audit55: a stale forwarded GETS to NP must not be silently dropped.
  // Send a zero-token ACK_OWNER so the requester observes a response instead
  // of waiting forever for a cache that no longer holds the line.
  transition(NP, {Transient_GETS, Transient_Local_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    nso_sendStaleOwnerAck;
    m_popRequestQueue;
  }
  transition(NP, {Transient_GETX, Transient_Local_GETX}) {
    m_popRequestQueue;
  }
  transition(NP, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    l_popPersistentQueue;
  }

  transition(NP, {Ack, Ack_Owner, Ack_All_Tokens, Data_All_Tokens, Data_Shared, Data_Owner}){
    bb_bounceResponse;
    n_popResponseQueue;
  }

  // 2. Snoops to I (Idle - Block allocated but no tokens/data)
  // audit55: same stale-owner safety for allocated-but-invalid I entries.
  transition(I, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    nso_sendStaleOwnerAck;
    m_popRequestQueue;
  }
  transition(I, {Transient_GETX, Transient_Local_GETX}) {
    t_sendAckWithCollectedTokens; // I might have collected stray tokens, send them back
    m_popRequestQueue;
  }
  transition(I, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  // =====================================================================
  // SECTION 3: STABLE STATE HITS (ZERO-LATENCY ACCESS)
  // Purpose: Fast-path execution when we already have the required sectors.
  // =====================================================================

  transition({S, SM, S_L, SM_L, O, OM, M, M_W, MM, MM_W}, Load) {
    h_load_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  transition({S, SM, S_L, SM_L, O, OM, M, M_W, MM, MM_W}, Ifetch) {
    h_ifetch_hit; uu_profileInstHit; k_popMandatoryQueue;
  }

  transition({MM, MM_W, M, M_W}, Store) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  transition({MM, MM_W, M_W}, Atomic) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  // Edge case: Atomic in M upgrades line to MM
  transition(M, Atomic, MM) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }


  // =====================================================================
  // SECTION 4: HETEROGENEOUS SECTOR MISSES (THE AMTC CORE)
  // Purpose: Triggering upgrades when touching invalid/unowned sectors.
  // =====================================================================

  // Load Sector Misses (Fetch missing data bytes)
  transition(S, Load_Sector_Miss, S_IS)       { i_allocateTBE; initTBERequestTracking; a_issueReadRequest; j_setReissueTimer; k_popMandatoryQueue; }
  transition(O, Load_Sector_Miss, O_IS)       { i_allocateTBE; initTBERequestTracking; a_issueReadRequest; uu_profileDataMiss; k_popMandatoryQueue; }
  // If M/MM hits a sector miss, do not blindly repair locally.
  // The previous local-repair path marked a sector valid even when that
  // sector had zero tokens, causing setState(MM) to assert.  Fetch missing
  // data through the normal read-miss transient; self-owner/token-only cases
  // are handled by the M_IS response routing logic.
  transition({M, MM}, Load_Sector_Miss, M_IS) {
    i_allocateTBE;
    initTBERequestTracking;
    a_issueReadRequest;
    j_setReissueTimer;
    k_popMandatoryQueue;
  }

  // Store Sector Misses (Fetch tokens/data for upgrade)
  transition(S, Store_Sector_Miss, S_IM)      { i_allocateTBE; initTBERequestTracking; b_issueWriteRequest; j_setReissueTimer; k_popMandatoryQueue; }
  transition(O, Store_Sector_Miss, M_IM)      {
    i_allocateTBE;
    initTBERequestTracking;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }
  transition({M, MM}, Store_Sector_Miss, M_IM){ i_allocateTBE; initTBERequestTracking; b_issueWriteRequest; j_setReissueTimer; k_popMandatoryQueue; }

  // Whole line upgrades from read-only states
  //transition(S, {Store, Atomic}, SM)          { i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; }
  //transition(O, {Store, Atomic}, OM)          { i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; }


  // =====================================================================
  // SECTION 5: RESPONSE ABSORPTION (DECOUPLED DATA & TOKENS)
  // Purpose: Safely accumulating partial responses until a complete hit.
  // =====================================================================

  // 5A. Safe Absorption in Stable States (Duplicate network packets)
  transition({I, S, O}, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }
  // audit64:
  // Stable-state DATA can be a late duplicate/data-only owner-pull response.
  // It may carry a full valid_sector_mask but zero/no tokens for one sector.
  // Stable S/O invariants require every valid sector to have at least one
  // token, so after absorbing DATA in a stable state, drop tokenless valid
  // sectors before setState() re-checks the invariant.
  transition({I, S, O}, {Data_Shared, Data_Owner}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    amtc_recomputeValidFromTokens;
    n_popResponseQueue;
  }

 // =====================================================================
  // SECTION 5B: Safe Absorption in Transient States (Building the puzzle)
  // =====================================================================

  // 1A. Generic Safe Token Absorption for standard transient read states.
  // S_IS + ACK_OWNER is a stale-owner read loop case: Directory is in CE and
  // forwards the read to a supposed owner, but the requester only receives a
  // zero-token owner ACK.  Convert this read-only miss to owner-pull so the
  // Directory/memory data path supplies the missing sector bytes.
  transition({S_IS, M_IS}, Ack) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  transition(M_IS, Ack_Owner) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  transition(S_IS, Ack_Owner) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    r_issueReadOwnerPullFallback;
    n_popResponseQueue;
  }

  transition(O_IS, Ack) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // O_IS is a read-side self-owner missing-data state.  A zero-token
  // ACK_OWNER from Directory means the directory believes this same L1 is the
  // CPU owner, so another normal GETS will loop forever.  Retry as GETS with
  // is_owner_pull=1 to force the Directory data-only/memory path.
  transition(O_IS, Ack_Owner) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    r_issueReadOwnerPullFallback;
    n_popResponseQueue;
  }

  // V85S: token ownership never proves that the requested bytes are present.
  // If a modified-owner read has all tokens but still lacks data, keep the
  // transaction transient and fetch the backing bytes through owner-pull.
  transition(M_IS, Ack_All_Tokens) {
    q_updateTokensFromResponse;
    r_issueReadOwnerPullFallback;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  // Token-only ACK can complete a warm S->M sector upgrade. The directory may
  // return all requested tokens as ACK without data when L1 already has bytes.
  transition(S_IM, {Ack, Ack_Owner}) {
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  transition(S_IM, Ack_All_Tokens, MM) {
    acc_accumulateResponse;
    ck_checkCompletion;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }


  // Token-only ACK can complete a warm M/MM -> MM sector upgrade.
  // L2 may return the missing sector tokens as ACK without data when L1
  // already has the bytes for that sector. Treat it like S_IM: accumulate,
  // run centralized completion, and let ck_checkCompletion issue exactly one
  // write callback/deallocate the TBE when ready.
  transition(M_IM, {Ack, Ack_Owner}) {
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  transition(M_IM, Ack_All_Tokens, MM) {
    acc_accumulateResponse;
    ck_checkCompletion;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // 1B. IM state safely absorbs normal Acks (e.g. from invalidations)
  transition(IM, Ack) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // 1C. CRITICAL FIX: IM state receives an Ack_Owner from the Directory.
  // The Directory refused to send data, so we MUST explicitly ask for it!
  transition(IM, Ack_Owner) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    // We have the tokens, but we still need the physical bytes!
    n_popResponseQueue;
  }

  transition({SM, OM}, {Ack, Ack_Owner}) {
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }


  // AMTC GPU command sharing fix:
  // A store/RFO can enter legacy SM/OM after data arrives before the final
  // token grant. If the later ACK carries all requested tokens, complete the
  // upgrade and leave the token-starved transient; otherwise the GPU-side
  // mandatory queue can remain stalled in SM forever.
  transition(SM, Ack_All_Tokens, MM) {
    acc_accumulateResponse;
    ck_checkCompletion;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(OM, Ack_All_Tokens, MM) {
    acc_accumulateResponse;
    ck_checkCompletion;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // Audit73: OM can receive a data-only owner-pull/memory response while a
  // write convergence is already holding data and waiting for the remaining
  // tokens.  Audit72 had ACK absorption for OM, but no OM+DATA_SHARED/DATA_OWNER
  // transition, so Directory's CE_W_DataOnly response crashed as an invalid
  // transition.  Absorb the bytes into the outstanding TBE, re-check centralized
  // completion, and stay in OM unless ck_checkCompletion completes/deallocates
  // the TBE.
  transition(OM, {Data_Shared, Data_Owner}) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // 2. Safe Partial Data Absorption
  // O_IS is a read-side self-owner missing-data state.  Directory owner-pull
  // may return DATA_SHARED with zero tokens, which the event classifier can
  // normalize to Data_All_Tokens because this L1 already owns all line tokens.
  // Any data-bearing response for the requested sector completes the read and
  // returns to O; do not leave it in O_IS and do not force stable S.
  transition(O_IS, {Data_Shared, Data_Owner, Data_All_Tokens}, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IM, {Data_Shared, Data_Owner}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;

    n_popResponseQueue;
  }

  transition(SM, Data_Shared) {
    absorbStaleSharedDataInWriteTransient;
    n_popResponseQueue;
  }

  transition(SM, Data_Owner) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  // ===================================================================
  // AMTC ACCUMULATION: Handle fragmented data arrivals during a Read
  // ===================================================================
  transition(IS, {Data_Shared, Data_Owner}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;

    // We got some data, but we are still missing sectors required for the Load!
    // Forcefully pull the missing physical bytes from the Directory.

    n_popResponseQueue;
  }

  // 3. CRITICAL FIX: The "Split Response" Advance
  // If full Data arrives BEFORE Tokens during a write miss, advance to the Upgrade states!
  // Passive exclusive convergence: DATA_OWNER/DATA_SHARED may carry the
  // requested sector bytes and enough tokens to complete the pending GETX.
  // Do not advance to legacy SM/OM without running centralized completion;
  // otherwise the Sequencer request remains outstanding until deadlock.
  transition(S_IM, Data_Owner, S_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(M_IM, Data_Owner, M_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(S_IM, Data_Shared, S_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  transition(M_IM, Data_Shared, M_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
  }

  // 5C. Mathematical Perfection (Waking the CPU!)
  transition(S_IS, {Data_Shared, Data_All_Tokens}, S) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    // Audit50: stable S must not retain valid sectors with zero tokens.
    amtc_recomputeValidFromTokens;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }
  transition(S_IS, Data_Owner, O) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents;
  }

  transition(S_IM, Data_All_Tokens, S_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(M_IM, {Data_All_Tokens}, M_IM) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }
  transition(M_IS, {Data_Shared, Data_Owner, Data_All_Tokens}, M) {
    u_writeDataToCache;
    amtc_markValidSectorsFromResponse;
    q_updateTokensFromResponse;
    x_external_load_hit;
    // Data-only owner-pull responses are allowed to satisfy the CPU read,
    // but sectors with zero tokens cannot remain cache-valid in stable M/MM.
    // Drop any tokenless valid sector before setState(M) runs.
    amtc_recomputeValidFromTokens;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // =====================================================================
  // SECTION 5D: STANDARD CACHE LINE COMPLETIONS
  // Purpose: Waking the CPU for standard full-line fetches and upgrades.
  // =====================================================================

  // IS Completions (Reads from Idle/NP)
  //transition(IS, Data_Shared, S) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  //transition(IS, Data_Owner, O) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(IS, Data_All_Tokens, M_W) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // IM Completions (Writes from Idle/NP)
  //transition(IM, Data_Shared, SM) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  //transition(IM, Data_Owner, M) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; j_unsetReissueTimer; s_deallocateTBE; n_popResponseQueue; kd_wakeUpDependents; }
  transition(IM, Data_All_Tokens, M_W) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; }

  // SM Completions (Upgrades from Shared)
  //transition(SM, Data_Shared) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  //transition(SM, Data_Owner, OM) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(SM, Data_All_Tokens, MM_W) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // OM Completions (Upgrades from Owned)
  //transition(OM, Data_Shared) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  //transition(OM, {Data_Owner, Data_Owner}) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(OM, Data_All_Tokens, MM_W) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // =====================================================================
  // SECTION 6: STARVATION & TIMEOUTS (THE PERSISTENT NETWORK)
  // Purpose: Ensuring forward progress when tokens are highly contested.
  // =====================================================================

  // 1. Passive timeout for Read Requests (Missing Data)
  // Do NOT call a_issueReadRequest here.  The strict single-request guard in
  // a_issueReadRequest rejects duplicate GETS, so M_IS/S_IS/O_IS can wait
  // forever after a zero-token ACK_OWNER from the Directory.  Use the same
  // guarded timeout resend path as the newer WAIT states: it resends the
  // original GETS only after a no-progress timeout window and re-arms the
  // timer while waiting for owner/L2/Directory convergence.
  transition({IS, S_IS, O_IS, M_IS}, Request_Timeout) {
    t_handleStrictTimeout;
  }

  // 2. Passive timeout for Write & Upgrade Requests (Missing Data or Tokens)
  // Do NOT call b_issueWriteRequest here.  In the passive refactor, b_issueWriteRequest
  // enforces the strict single-request rule and rejects duplicates without re-arming
  // convergence.  Legacy SM/OM/S_IM/M_IM can therefore become a black-hole after
  // the first timeout.  Use the guarded timeout handler instead: it resends the
  // exact original GETX only after repeated no-progress windows and always rearms
  // the timer while waiting for L2/TCC/Directory convergence.
  transition({IM, S_IM, M_IM, SM, OM}, Request_Timeout) {
    t_handleStrictTimeout;
  }

  // Owner timeout absorbed: L1 never performs owner convergence.
  transition({IS_WAIT_DATA, IS_WAIT_TOKENS, IS_WAIT_ALL, IM_WAIT_PARTIAL, IM_WAIT_EXCL}, Request_Timeout_Owner){
    j_unsetReissueTimer;
    t_handleStrictTimeout;
  }

  // 3. Ignore stray timeouts in stable and timeout-wait states
  transition({M, MM, M_W, MM_W}, Request_Timeout) {
    j_unsetReissueTimer;
  }

  // Lockdowns & Exits
  transition({NP, I, S, O, M, MM, M_W, MM_W, IM, SM, OM, IS, S_IS, O_IS, M_IS, M_IM, S_IM}, Own_Lock_or_Unlock) {
    l_popPersistentQueue;
  }

  // =====================================================================
  // SECTION 6B: MIGRATORY TIMEOUTS & SETTLING
  // Purpose: Resolving M_W and MM_W once their guaranteed "Use" window expires.
  // =====================================================================

  // 1. Nobody is starving. The cache gets to keep the line! Settle into stable Modified.
  transition(M_W, {Use_TimeoutNoStarvers, Use_TimeoutNoStarvers_NoMig}, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(MM_W, Use_TimeoutNoStarvers, MM) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(MM_W, Use_TimeoutNoStarvers_NoMig, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  // 2. Someone is starving for Shared. Yield tokens/data down to S_L.
  transition(M_W, Use_TimeoutStarverS, S_L) {
    s_deallocateTBE;
    ff_sendDataWithAllButNorOneTokens;
    jj_unsetUseTimer;
  }

  // 3. Someone is starving for Exclusive. Yield everything.
  transition(M_W, Use_TimeoutStarverX, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;
  }

  // Migratory Optimization: If in MM_W, even a Shared starver takes everything.
  transition(MM_W, {Use_TimeoutStarverX, Use_TimeoutStarverS}, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;
  }
  // =====================================================================
  // STALE RESPONSE ABSORPTION IN STABLE STATES
  // =====================================================================

  // CRITICAL FIX: Added M_W and MM_W to absorb late token-only packets
  // Also added Ack_Owner variants to catch Directory owner-pull replies

  transition({M, MM, M_W, MM_W}, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // CRITICAL FIX: Added M_W and MM_W to absorb late data packets
  // If a late owner-pull/memory DATA response arrives after the active TBE has
  // already completed, it may carry bytes but zero tokens.  Stable M/MM cannot
  // retain tokenless valid sectors, so absorb the data and then recompute the
  // valid-sector bitmap from the current token ownership before setState()
  // re-checks the M/MM invariants.
  transition({M, MM, M_W, MM_W}, {Data_Shared, Data_Owner, Data_All_Tokens}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    amtc_recomputeValidFromTokens;
    n_popResponseQueue;
  }

  // V85S-r12: Directory/DMA owner-pull is observational.  Stable holders
  // return real bytes with zero tokens and retain their exact state/ownership.
  transition({S, O, M, MM}, Transient_GETS_Owner_Pull) {
    dop_sendDataOnlyOwnerPullV85S12;
    m_popRequestQueue;
  }

  // Non-holders participate in the L2 fanout with a zero-token ACK.  Directory
  // drains these while waiting for a real data holder; ACK(0) is never evidence
  // that all physical tokens have returned to Directory.
  transition({NP, I}, Transient_GETS_Owner_Pull) {
    doa_sendOwnerPullAckNoDataV85S12;
    m_popRequestQueue;
  }

  // =====================================================================
  // SHARED (S) SNOOP HANDLERS
  // =====================================================================

  // Another cache wants to read the line (GETS). We only have shared access,
  // so we cannot provide the data or tokens. We just ignore the snoop.
  // AMTC audit48:
  // A stable S sharer may be selected by Directory forwarding during CPU/GPU
  // sharing.  If it merely pops Transient_GETS, the requester can wait forever
  // after Directory sends only ACK_OWNER(0).  Donate our available shared
  // data/tokens and invalidate this local copy.  This is conservative for
  // performance, but preserves liveness and token conservation.
  transition(S, {Transient_Local_GETS, Transient_GETS}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  // audit51:
  // A forwarded GETX can target a stable S holder during a sector upgrade.
  // If S silently ignores/pops GETX, the requester waits in SM/S_IM while
  // Directory CE returns only ACK_OWNER(0). Donate the shared data/token(s)
  // and invalidate, just like the GETS liveness fallback.
  transition(S, {Transient_Local_GETX, Transient_GETX}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  // =====================================================================
  // MODIFIED (M) SNOOP HANDLERS
  // =====================================================================

  // Another cache wants to read our modified line (GETS).
  // We must downgrade to Owned (O), send the data, and give them 1 token.
  transition(M, {Transient_Local_GETS,Transient_GETS}, O) {
    // 1. Send the dirty data and 1 token to the requestor
    d1_sendDataWithOneToken; // Sends data + 1 token, keeps 511.

    // 3. Remove the snoop message from the queue
    m_popRequestQueue;
  }

  // AMTC FIX: MM is also a modified/owner state. A forwarded GETS
  // can arrive while this L1 holds full migratory ownership. Treat it
  // like M: provide data + one token and downgrade to O. Without this,
  // MM + Transient_GETS is an invalid transition.
  transition(MM, {Transient_Local_GETS, Transient_GETS}, O) {
    d1_sendDataWithOneToken;
    m_popRequestQueue;
  }


  transition(O, {Transient_Local_GETX, Transient_GETX}, I) {
    // Send the dirty data and every token we have left in our ledger
    dd_sendDataWithAllTokens;

    // Remove the snoop message from the queue
    m_popRequestQueue;
  }

  // =====================================================================
  // OWNED (O) READ SNOOP HANDLERS
  // =====================================================================

  // Another cache wants to read our Owned line.
  // We send the dirty data and exactly 1 token. We REMAIN in the O state.
  transition(O, {Transient_Local_GETS, Transient_GETS}) {
    // This is the action we built earlier! It sends the data,
    // sends 1 token, and subtracts 1 token from our local ledger.
    d1_sendDataWithOneToken;

    // Remove the message from the queue
    m_popRequestQueue;
  }

  // AMTC closure fix:
  // A Directory forwarded GETS can arrive while this L1 is in stable O and
  // token accounting classifies the request as a Last_Token snoop.  Previously
  // only S/M/MM had Transient_GETS_Last_Token handlers, so O +
  // Transient_GETS_Last_Token aborted even though O is the normal dirty owner
  // state that must answer a forwarded GETS.
  //
  // Conservative closure behavior: donate all remaining data/tokens to the
  // forwarded requester and invalidate this local copy.  This preserves
  // liveness and avoids keeping an O line with no token after the last-token
  // transfer.  No bitwise operations are used.
  transition(O, {Transient_Local_GETS_Last_Token,
                 Transient_GETS_Last_Token}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  transition(M, {Transient_Local_GETX, Transient_GETX}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  // AMTC FIX: forwarded GETX against MM must yield all data/tokens.
  transition(MM, {Transient_Local_GETX, Transient_GETX}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }
  // =====================================================================
  // MODIFIED (M) "LAST TOKEN" SNOOP HANDLER
  // =====================================================================
  // AMTC FIX audit47: forwarded GETS_LAST_TOKEN can be non-local too.
  // During CPU/GPU memory sharing, Directory may forward a remote GETS to the
  // current CPU owner while this L1 is stable M. Treat both local and remote
  // last-token snoops identically: supply dirty data plus all remaining tokens
  // and invalidate locally.
  transition(M, {Transient_Local_GETS_Last_Token, Transient_GETS_Last_Token}, I) {
    // Send the dirty data and EVERY token we have
    dd_sendDataWithAllTokens;

    // Remove the snoop message from the queue
    m_popRequestQueue;
  }

  // AMTC FIX: same last-token safety for MM. This is rare for MM,
  // but keeps forwarded GETS_LAST_TOKEN from becoming an invalid transition
  // if token accounting makes MM appear as the last holder.
  transition(MM, {Transient_Local_GETS_Last_Token, Transient_GETS_Last_Token}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  // =====================================================================
  // SHARED (S) LAST TOKEN HANDLER
  // =====================================================================

  // Another cache needs the final token we are holding.
  // We send our token(s) via an Ack and move to Invalid.
  transition(S, {Transient_Local_GETS_Last_Token, Transient_GETS_Last_Token}, I) {
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  // =====================================================================
  // TRANSIENT STATE SNOOP HANDLERS (Passive L1)
  // =====================================================================

  // Passive L1 must not invoke the removed request-queue stall helper here.
  // Transient snoops are handled by coordinator-side convergence or remain queued
  // by normal in_port/transition availability; no L1 recursive owner pull or
  // explicit request-queue stall action is performed.

  // Handling generic partials and ACKs in transient states
  //transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, {Data_Shared, Ack}) {
  //    u_writeDataToCache;       // Write physical bytes if any
  //    acc_accumulateResponse;   // Accumulate tokens and ReceivedSectorMask
  //    ck_checkCompletion;       // Check if we are done
  //    n_popResponseQueue;       // Clear message
  //}

  // Successful completion jumps
  //transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Completion_Shared, S) {
  //    x_external_load_hit;      // Wake CPU
  //    s_deallocateTBE;
  //    j_unsetReissueTimer;
  //}


  // =====================================================================
  // AMTC PASSIVE ACCUMULATION-BASED CONVERGENCE MODEL
  // L1 is a passive endpoint. L2/TCC owns sector/token/owner convergence.
  // =====================================================================

  transition({NP, I}, Load, IS_WAIT_ALL) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    // AMTC: CPU data loads do not need to force full-line convergence.
    // Track only the sector containing the requested byte range.  This avoids
    // deadlock when L2 has the needed sector valid (for example valid=2) but
    // a stale/narrow ValidSectors field prevents a full mask=3 response.
    initTBERequestTracking;
    a_issueReadRequest;
    k_popMandatoryQueue;
  }

  transition({NP, I}, Ifetch, IS_WAIT_ALL) {
    pp_allocateL1ICacheBlock;
    i_allocateTBE;
    // AMTC: I-fetch should request only the sector containing the
    // fetched instruction bytes.  Requesting full mask=3 can deadlock
    // when L2 has only the required sector valid and suppresses partial
    // full-line responses.
    initTBERequestTracking;
    a_issueReadRequest;
    k_popMandatoryQueue;
  }

  transition({NP, I}, {Store, Atomic}, IM_WAIT_PARTIAL) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    // AMTC: initialize per-request sector tracking before issuing GETX.
    // Without this, a sector-1 store can fall back to full-line mask=3
    // and wait forever for unrelated sectors/tokens.
    initTBERequestTracking;
    b_issueWriteRequest;
    j_setReissueTimer;
    k_popMandatoryQueue;
  }

  transition({S, O}, {Store, Atomic}, IM_WAIT_PARTIAL) {
    i_allocateTBE;
    // AMTC: preserve the CPU store's actual sector mask for upgrades.
    initTBERequestTracking;
    b_issueWriteRequest;
    j_setReissueTimer;
    k_popMandatoryQueue;
  }

  // Passive read convergence responses. These transitions must leave the
  // transient state once ck_checkCompletion has issued the Sequencer callback;
  // otherwise a dependent/replayed Ifetch/Load can arrive while the line is
  // still marked IS_WAIT_ALL and cause an invalid transition.
  // Directory may be unable to lend a shared token in CS after many
  // shared copies.  For a CPU read from NP/I wait states, a DATA_SHARED
  // response with zero requested tokens is still enough to satisfy the
  // Sequencer, but it must NOT leave a stable S cache entry because S
  // requires at least one token for every valid sector.  Complete the read
  // as an uncached/bypass response and deallocate the just-allocated block.
  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Data_No_Token, I) {
    u_writeDataToCache;
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
    gg_deallocateDataNoTokenBypassBlock;
  }

  // Audit82: Read-wait DATA responses must not force a stable target state.
  // ck_checkCompletion is the only place that decides whether the CPU read has
  // enough data + at least one requested-sector token.  If a DATA_OWNER carries
  // data for a sector but zero tokens for that sector, forcing the transition to
  // stable O leaves ValidSectors set with TokensSecX == 0 and trips the stable
  // owner invariant.  Stay in the wait state; ck will set stable S and remove
  // the TBE on success, otherwise the reissue timer will retry.
  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Data_Shared, IS_WAIT_ALL) {
    u_writeDataToCache;
    amtc_markValidSectorsFromResponse;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Data_Owner, IS_WAIT_ALL) {
    u_writeDataToCache;
    amtc_markValidSectorsFromResponse;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Data_All_Tokens, IS_WAIT_ALL) {
    u_writeDataToCache;
    amtc_markValidSectorsFromResponse;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IM_WAIT_PARTIAL, IM_WAIT_EXCL}, Data_All_Tokens, IM_WAIT_PARTIAL) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    j_rearmReissueTimerIfPending;
    // Audit72: no extra forced GETX retry; ck_checkCompletion owns write completion.
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IM_WAIT_PARTIAL, IM_WAIT_EXCL}, {Data_Shared, Data_Owner}) {
    u_writeDataToCache;
    acc_accumulateResponse;
    ck_checkCompletion;
    // Audit72: no extra forced GETX retry; ck_checkCompletion owns write completion.
    n_popResponseQueue;
  }

  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Stale_Owner_Ack) {
    acc_accumulateResponse;
    r_issueReadOwnerPullFallback;
    n_popResponseQueue;
  }

  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, {Ack, Ack_Owner}) {
    acc_accumulateResponse;
    ck_checkCompletion;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IM_WAIT_PARTIAL, IM_WAIT_EXCL}, Stale_Owner_Write_Ack) {
    swo_ignoreStaleOwnerWriteAck;
    n_popResponseQueue;
  }

  transition({S_IM, M_IM, IM, SM, OM}, Stale_Owner_Write_Ack) {
    swo_ignoreStaleOwnerWriteAck;
    n_popResponseQueue;
  }

  // Audit69 safety net: if a stale zero-token ACK is delivered after the line
  // has already completed and returned to a stable state, drop it.  This avoids
  // re-entering the TBE path for late responses while preserving the stable line.
  transition({NP, I, S, O, M, MM, M_W, MM_W}, Stale_Owner_Write_Ack) {
    swo_ignoreStaleOwnerWriteAck;
    n_popResponseQueue;
  }

  transition({IM_WAIT_PARTIAL, IM_WAIT_EXCL}, {Ack, Ack_Owner}) {
    acc_accumulateResponse;
    ck_checkCompletion;
    // Audit72: no extra forced GETX retry; ck_checkCompletion owns write completion.
    n_popResponseQueue;
  }

  transition({IM_WAIT_PARTIAL, IM_WAIT_EXCL}, Ack_All_Tokens, MM) {
    acc_accumulateResponse;
    ck_checkCompletion;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS}, Completion_Shared, S) {
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    kd_wakeUpDependents;
  }


  transition({IS_WAIT_ALL, IS_WAIT_DATA, IS_WAIT_TOKENS, IM_WAIT_PARTIAL, IM_WAIT_EXCL}, Request_Timeout) {
    t_handleStrictTimeout;
  }

  // L2/TCC owner convergence responsibilities: owner pulls, token gathering,
  // sharer tracking, sector gathering, escalation and ownership-tree management.
  // L1 may only observe progress and resend its original request through the
  // guarded timeout path above.

//  transition(IS, L1_GETS) {
//    maybeForwardNonDuplicateGetsWhileIS;
//    o_popL1RequestQueue;
//  }

}
