  action(p_informL2AboutTokenLoss, "p", desc="Inform L2 about loss of all tokens") {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
       out_msg.addr := address;
       out_msg.Type := CoherenceResponseType:INV;
       out_msg.TokensSec0 := 0;
out_msg.TokensSec1 := 0;
       out_msg.Sender := machineID;

       out_msg.Destination.add(mapAddressToRange(address,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0)));
       out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(q_updateTokensFromResponse, "q", desc="Update token count based on response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
//      int tokens_per_sector := max_tokens() / 2;

      // --- 1. Update tokens ---
      cache_entry.TokensSec0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      // --- 2. Dirty handling (fine as is) ---
      if (in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }

      // --- 3. CRITICAL: Recompute ValidSectors from tokens ---
//      int new_valid := 0;
//
//      if (cache_entry.TokensSec0 == tokens_per_sector) {
//          new_valid := amtc_unionMasks(new_valid, 1);
//      }
//
//      if (cache_entry.TokensSec1 == tokens_per_sector) {
//          new_valid := amtc_unionMasks(new_valid, 2);
//      }
//      cache_entry.ValidSectors := new_valid;
    }
  }

  action(amtc_completeIfAlreadyOwnsSector, "aco",
       desc="Complete upgrade if sector tokens are already locally owned") {
    if (is_valid(cache_entry)) {

      // CRITICAL FIX: We no longer care about the monolithic cache_entry.Tokens.
      // We only care if we have 512 tokens for the specifically requested sector(s).

      int tokens_per_sector := max_tokens() / 2;
      int upgrade_mask := cache_entry.ValidSectors;

      if (is_valid(tbe)) {
          upgrade_mask := amtc_intersectMasks(cache_entry.ValidSectors, tbe.RequestedSectorMask);

          if (amtc_maskHasSector(tbe.RequestedSectorMask, 0)) {
              assert(cache_entry.TokensSec0 == tokens_per_sector);
          }
          if (amtc_maskHasSector(tbe.RequestedSectorMask, 1)) {
              assert(cache_entry.TokensSec1 == tokens_per_sector);
          }
      } else {
          // If there is no TBE, we gracefully fall back to checking the whole line.
          if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
              assert(cache_entry.TokensSec0 == tokens_per_sector);
          }
          if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
              assert(cache_entry.TokensSec1 == tokens_per_sector);
          }
      }

      DPRINTF(RubySlicc,
        "AMTC_L1_COMPLETE_OWNED_SECTOR addr=%#x valid=%d upgrading_mask=%d\n",
        address, cache_entry.ValidSectors, upgrade_mask);

      // Upgrade the specific sector to Dirty!
      cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, upgrade_mask);
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {

    assert(is_valid(tbe));
    if (tbe.WentPersistent) {
      // assert(starving);
      outstandingRequests := outstandingRequests - 1;
      enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := PersistentRequestType:DEACTIVATE_PERSISTENT;
        out_msg.Requestor := machineID;
        out_msg.Destination.broadcast(MachineType:L1Cache);

        //
        // Currently the configuration system limits the system to only one
        // chip.  Therefore, if we assume one shared L2 cache, then only one
        // pertinent L2 cache exist.
        //
        //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));

        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Persistent_Control;
      }
      starving := false;
    }

    // Update average latency
    if (tbe.IssueCount <= 1) {
      if (tbe.ExternalResponse) {
        updateAverageLatencyEstimate(curCycle() - tbe.IssueTime);
      }
    }

    // Profile
    //if (tbe.WentPersistent) {
    //  profile_token_retry(address, tbe.TypeOfAccess, 2);
    //}
    //else {
    //  profile_token_retry(address, tbe.TypeOfAccess, 1);
    //}

    //profile_token_retry(address, tbe.TypeOfAccess, tbe.IssueCount);
    L1_TBEs.deallocate(address);
    unset_tbe();
  }

  action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // Evaluate if we hold tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;

          // We are yielding stray tokens. This is strictly a control message.
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // Even though it's an ACK, we pass the block along just in case
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.MessageSize := MessageSizeType:Response_Control;

          // AMTC Metadata: Flag exactly which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry valid payload bytes
        }
      }
    }

    // Safely zero out our local tokens since we just yielded them all
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := 0;
      if (in_msg.Type == CoherenceResponseType:DATA_SHARED ||
          in_msg.Type == CoherenceResponseType:DATA_OWNER) {
          copy_mask := in_msg.valid_sector_mask;
      }

      if (is_valid(tbe)) {
        copy_mask := amtc_intersectMasks(copy_mask, tbe.RequestedSectorMask);
      }

      // ===================================================================
      // CRITICAL FIX: The Refined "Late Data" Shield
      // Only drop the data if we hold ALL tokens AND we already have the valid bytes!
      // ===================================================================
      int tokens_per_sector := max_tokens() / 2;

      if (amtc_maskHasSector(copy_mask, 0) &&
          cache_entry.TokensSec0 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          copy_mask := amtc_clearSector(copy_mask, 0); // Drop stale Sec 0
      }

      if (amtc_maskHasSector(copy_mask, 1) &&
          cache_entry.TokensSec1 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          copy_mask := amtc_clearSector(copy_mask, 1); // Drop stale Sec 1
      }

      if (copy_mask != 0) {
          if (amtc_maskHasSector(copy_mask, 0)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }

          if (amtc_maskHasSector(copy_mask, 1)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, copy_mask);
          }
      }
    }
  }

  action(gg_deallocateL1CacheBlock, "\g", desc="Deallocate cache block.  Sets the cache to invalid, allowing a replacement in parallel with a fetch.") {
    assert(getTokens(cache_entry, amtc_fullMask()) == 0);
    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    } else {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(ii_allocateL1DCacheBlock, "\i", desc="Set L1 D-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Dcache.allocate(address, new Entry));
    }
  }

  action(pp_allocateL1ICacheBlock, "\p", desc="Set L1 I-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Icache.allocate(address, new Entry));
    }
  }

  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
    if (send_evictions) {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
      sequencer.evictionCallback(address);
    }
  }

  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
    L1Icache.profileDemandMiss();
  }

  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
    L1Icache.profileDemandHit();
  }

  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
    L1Dcache.profileDemandMiss();
  }

  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
    L1Dcache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      //assert(cache_entry.DataBlk == in_msg.DataBlk);
    }
  }

  action(zz_stallAndWaitMandatoryQueue, "\z", desc="Send the head of the mandatory queue to the back of the queue.") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
    stall_and_wait(mandatoryQueue_in, address);
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  action(ka_wakeUpAllDependents, "ka", desc="wake-up all dependents") {
    wakeUpAllBuffers();
  }

action(amtc_markValidSectorsFromResponse, "mvs", desc="Mark valid sectors from response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // Only process masks from actual data-carrying messages
      if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
          in_msg.Type == CoherenceResponseType:DATA_SHARED) {

          int update_mask := amtc_sanitizeMask(in_msg.valid_sector_mask);

          if (is_valid(tbe)) {
            update_mask := amtc_intersectMasks(update_mask, tbe.RequestedSectorMask);
          }

          // If the network gave us the data, mark it valid in the SRAM immediately!
          // The transient state will protect the CPU from reading it until tokens arrive.
          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, update_mask);
      }
    }
  }

  action(amtc_recomputeValidFromTokens, "rv", desc="Recompute valid sectors from tokens") {
  int new_valid := 0;

  // Tokens > 0 means we have at least Shared permission, so the data is valid!
  if (cache_entry.TokensSec0 > 0) {
    new_valid := amtc_unionMasks(new_valid, 1);
  }
  if (cache_entry.TokensSec1 > 0) {
    new_valid := amtc_unionMasks(new_valid, 2);
  }

  cache_entry.ValidSectors := new_valid;
}


  action(ao_issueOwnerReadRequest, "ao", desc="Issue a GETS request as the Owner") {
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:GETS;
      out_msg.Requestor := machineID;
      out_msg.Destination.broadcast(MachineType:L1Cache);
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

      int req_mask := tbe.RequestedSectorMask;
      out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
      out_msg.sector_mask := req_mask;
      out_msg.requested_sector_mask := req_mask;


      out_msg.MessageSize := MessageSizeType:Broadcast_Control;

      // CRITICAL UPGRADE: Tell the Directory we already own the line
      out_msg.is_owner_pull := true;
    }
  }

  // =============================================================================
  // PERFORMANCE ACCELERATOR: IMMEDIATE MISSING SECTOR PULL
  // =============================================================================
  action(a_issueImmediateMissingReadRequest, "aim", desc="Instantly request missing sectors") {
      assert(is_valid(tbe));

      // Calculate exactly which sectors are STILL missing from our cache entry
      int missing_mask := tbe.RequestedSectorMask;
      if (is_valid(cache_entry)) {
          missing_mask := amtc_subtractMask(tbe.RequestedSectorMask, cache_entry.ValidSectors);
      }

      // If there is nothing missing, we don't need to do anything
      if (missing_mask != 0) {
          // ENQUEUE 1: Send to L2/Directory immediately
          enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceRequestType:GETS;
              out_msg.Requestor := machineID;
              out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
              out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

              out_msg.RetryNum := tbe.IssueCount;
              out_msg.MessageSize := MessageSizeType:Reissue_Control;
              out_msg.Prefetch := tbe.Prefetch;
              out_msg.AccessMode := tbe.AccessMode;

              // Only ask for the specific sectors we don't have yet
              out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
              out_msg.sector_mask := missing_mask;
              out_msg.requested_sector_mask := missing_mask;

              out_msg.is_gpu := false;
              out_msg.is_sync := false;
              out_msg.is_bypass := false;
              out_msg.is_atomic := tbe.IsAtomic;
              out_msg.is_signal := false;
              out_msg.merged_req := false;

              // If we already hold half the tokens, this MUST be an owner pull
              if (getTokens(cache_entry, amtc_fullMask()) >= (max_tokens() / 2)) {
                  out_msg.is_owner_pull := true;
              } else {
                  out_msg.is_owner_pull := false;
              }
          }

          // ENQUEUE 2: Broadcast to Local L1s
          enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceRequestType:GETS;
              out_msg.Requestor := machineID;
              out_msg.Destination.broadcast(MachineType:L1Cache);
              out_msg.Destination.remove(machineID);

              out_msg.RetryNum := tbe.IssueCount;
              out_msg.isLocal := true;
              out_msg.MessageSize := MessageSizeType:Broadcast_Control;
              out_msg.Prefetch := tbe.Prefetch;
              out_msg.AccessMode := tbe.AccessMode;

              out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
              out_msg.sector_mask := missing_mask;
              out_msg.requested_sector_mask := missing_mask;

              out_msg.is_gpu := false;
              out_msg.is_sync := false;
              out_msg.is_bypass := false;
              out_msg.is_atomic := tbe.IsAtomic;
              out_msg.is_signal := false;
              out_msg.merged_req := false;

              if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
                  out_msg.is_owner_pull := true;
              } else {
                  out_msg.is_owner_pull := false;
              }
          }

          tbe.IssueCount := tbe.IssueCount + 1;

          // Refresh the timer so we don't time out while waiting for this new request
	  // CRITICAL FIX: You MUST unset the timer before setting it again!
	    if (reissueTimerTable.isSet(address)) {
		reissueTimerTable.unset(address);
	    }

          if (dynamic_timeout_enabled) {
            reissueTimerTable.set(address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
          } else {
            reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
          }
      }
  }

  action(amtc_computeMissingMask, "cm", desc="Compute missing sectors") {
    assert(is_valid(tbe));
    peek(mandatoryQueue_in, RubyRequest) {
        int req_offset := getOffset(in_msg.PhysicalAddress);
        int needed_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);

        // COLD MISS: We have no valid data. Fetch the entire line from Memory.
        if (!is_valid(cache_entry) || cache_entry.ValidSectors == 0) {
            tbe.RequestedSectorMask := amtc_fullMask();
        }
        // WARM MISS: We have some data, just fetch the missing pieces/tokens.
        else {
            if (in_msg.Type == RubyRequestType:ST || in_msg.Type == RubyRequestType:ATOMIC || in_msg.Type == RubyRequestType:Locked_RMW_Write) {
                int missing_upgrade := 0;
                int tokens_per_sector := max_tokens() / 2;

                if (amtc_maskHasSector(needed_mask, 0) && cache_entry.TokensSec0 < tokens_per_sector) {
                    missing_upgrade := amtc_unionMasks(missing_upgrade, 1);
                }
                if (amtc_maskHasSector(needed_mask, 1) && cache_entry.TokensSec1 < tokens_per_sector) {
                    missing_upgrade := amtc_unionMasks(missing_upgrade, 2);
                }
                tbe.RequestedSectorMask := missing_upgrade;
            } else {
                tbe.RequestedSectorMask := amtc_subtractMask(needed_mask, cache_entry.ValidSectors);
            }
        }

        if (tbe.RequestedSectorMask == 0) { tbe.RequestedSectorMask := needed_mask; }
    }
  }

  action(z_stallAndWaitMandatoryQueue, "z", desc="Stall and wait the mandatory queue") {
    // This tells the queue to stop evaluating this address until we explicitly wake it up later
    stall_and_wait(mandatoryQueue_in, address);
  }
  action(amtc_updateStateFromSectors, "as",
       desc="Resolve state based on sector ownership") {

  bool sec0 := amtc_maskHasSector(cache_entry.ValidSectors, 0);
  bool sec1 := amtc_maskHasSector(cache_entry.ValidSectors, 1);

  if (sec0 && sec1) {
    // full line
    cache_entry.CacheState := State:M;
  } else {
    // partial ownership
    cache_entry.CacheState := State:O;
  }
}
  int amtc_getSector(Addr a) {
    return (addressToInt(a) / 32) % 2;
  }

bool amtc_isHit(Entry cache_entry, Addr addr) {
  int sid := amtc_getSector(addr);

  return is_valid(cache_entry) &&
         amtc_maskHasSector(cache_entry.ValidSectors, sid);
}


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

 // =====================================================================
  // SECTION 1: TRANSIENT STATE STALLS (THE PIPELINE SHIELD)
  // Purpose: Block CPU mandatory queue requests while waiting for network.
  // =====================================================================

// =====================================================================
  // SECTION 1: TRANSIENT STATE STALLS (THE PIPELINE SHIELD)
  // Purpose: Block CPU mandatory queue requests while waiting for network.
  // =====================================================================

  // 1A. DATA-STARVED TRANSIENTS (Waiting for physical bytes)
  // These states have nothing. Stall EVERY CPU request.
  transition({IM, IS, IM_L, IS_L, S_IS, O_IS, M_IS, M_IM, S_IM},
             {Load, Ifetch, Store, Atomic, Load_Sector_Miss, Store_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1B. TOKEN-STARVED TRANSIENTS (Waiting for write permissions)
  // These states HAVE data. They will successfully hit on Load/Ifetch.
  // We only stall Stores, Atomics, Sector Misses, and Evictions.
  transition({SM, OM, S_L, SM_L},
             {Store, Atomic, Store_Sector_Miss, Load_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1C. TIMEOUT-WAITING TRANSIENTS (Migratory / Lockout)
  // These states have Data AND Tokens. They hit locally on Load/Store/Atomic.
  // We ONLY stall them if they trigger a sector miss or are evicted.
  transition({M_W, MM_W},
             {Load_Sector_Miss, Store_Sector_Miss, L1_Replacement}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // 1D. NETWORK SNOOP STALLS
  transition({S_IS, O_IS, M_IS, M_IM, S_IM, OM, IM, SM, I_L, IM_L, IS_L, S_L, SM_L, M_W, MM_W},
             {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    m_popRequestQueue;
  }

  transition(IS, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // =====================================================================
  // SECTION 2: ALLOCATION & EVICTION (THE CACHE LIFECYCLE)
  // Purpose: Moving from Not Present (NP) to active, or Active to Idle (I).
  // =====================================================================

  // Allocation from NP (Requires cache block allocation)
  transition(NP, Load, IS)            { ii_allocateL1DCacheBlock; i_allocateTBE; a_issueReadRequest; uu_profileDataMiss; j_setReissueTimer; }
  transition(NP, Ifetch, IS)          { pp_allocateL1ICacheBlock; i_allocateTBE; a_issueReadRequest; uu_profileInstMiss; j_setReissueTimer; }
  transition(NP, {Store, Atomic}, IM) { ii_allocateL1DCacheBlock; i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; j_setReissueTimer; }

  // Allocation from Idle (Block already exists, just needs TBE)
  transition(I, Load, IS)             { i_allocateTBE; a_issueReadRequest; uu_profileDataMiss; }
  transition(I, Ifetch, IS)           { i_allocateTBE; a_issueReadRequest; uu_profileInstMiss; }
  transition(I, {Store, Atomic}, IM)  { i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; }

  // Evictions
  transition(I, L1_Replacement)       { ta_traceStalledAddress; tr_tokenReplacement; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }
  transition(S, L1_Replacement, I)    { ta_traceStalledAddress; cc_sharedReplacement; forward_eviction_to_cpu; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }
  transition({O, M, MM}, L1_Replacement, I) { ta_traceStalledAddress; c_ownedReplacement; forward_eviction_to_cpu; gg_deallocateL1CacheBlock; ka_wakeUpAllDependents; }

  // =====================================================================
  // SECTION 2B: BASE STATE SNOOP DROPS & BOUNCES
  // Purpose: Safely ignore network requests for cache lines we don't hold.
  // =====================================================================

  // 1. Snoops and stray responses to NP (Not Present)
  transition(NP, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    m_popRequestQueue;
  }
  transition(NP, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    l_popPersistentQueue;
  }

  transition(NP, {Ack, Ack_Owner, Ack_All_Tokens, Ack_Owner_All_Tokens, Data_Shared, Data_Owner, Data_All_Tokens, Data_Shared_Partial, Data_Owner_Partial}){
    bb_bounceResponse;
    n_popResponseQueue;
  }

  // 2. Snoops to I (Idle - Block allocated but no tokens/data)
  transition(I, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    m_popRequestQueue;
  }
  transition(I, {Transient_GETX, Transient_Local_GETX}) {
    t_sendAckWithCollectedTokens; // I might have collected stray tokens, send them back
    m_popRequestQueue;
  }
  transition(I, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  // =====================================================================
  // SECTION 3: STABLE STATE HITS (ZERO-LATENCY ACCESS)
  // Purpose: Fast-path execution when we already have the required sectors.
  // =====================================================================

  transition({S, SM, S_L, SM_L, O, OM, M, M_W, MM, MM_W}, Load) {
    h_load_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  transition({S, SM, S_L, SM_L, O, OM, M, M_W, MM, MM_W}, Ifetch) {
    h_ifetch_hit; uu_profileInstHit; k_popMandatoryQueue;
  }

  transition({MM, MM_W, M, M_W}, Store) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  transition({MM, MM_W, M_W}, Atomic) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }

  // Edge case: Atomic in M upgrades line to MM
  transition(M, Atomic, MM) {
    hh_store_hit; uu_profileDataHit; k_popMandatoryQueue;
  }


  // =====================================================================
  // SECTION 4: HETEROGENEOUS SECTOR MISSES (THE AMTC CORE)
  // Purpose: Triggering upgrades when touching invalid/unowned sectors.
  // =====================================================================

  // Load Sector Misses (Fetch missing data bytes)
  transition(S, Load_Sector_Miss, S_IS)       { i_allocateTBE; amtc_computeMissingMask; a_issueReadRequest; j_setReissueTimer; }
  transition(O, Load_Sector_Miss, O_IS)       { i_allocateTBE; ao_issueOwnerReadRequest; uu_profileDataMiss; k_popMandatoryQueue; }
  transition({M, MM}, Load_Sector_Miss, M_IS) { i_allocateTBE; amtc_computeMissingMask; a_issueReadRequest; j_setReissueTimer; }

  // Store Sector Misses (Fetch tokens/data for upgrade)
  transition(S, Store_Sector_Miss, S_IM)      { i_allocateTBE; amtc_computeMissingMask; b_issueWriteRequest; j_setReissueTimer; }
  transition(O, Store_Sector_Miss, M_IM)      {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    zz_stallAndWaitMandatoryQueue;
  }
  transition({M, MM}, Store_Sector_Miss, M_IM){ i_allocateTBE; amtc_computeMissingMask; b_issueWriteRequest; j_setReissueTimer; }

  // Whole line upgrades from read-only states
  transition(S, {Store, Atomic}, SM)          { i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; }
  transition(O, {Store, Atomic}, OM)          { i_allocateTBE; b_issueWriteRequest; uu_profileDataMiss; }


  // =====================================================================
  // SECTION 5: RESPONSE ABSORPTION (DECOUPLED DATA & TOKENS)
  // Purpose: Safely accumulating partial responses until a complete hit.
  // =====================================================================

  // 5A. Safe Absorption in Stable States (Duplicate network packets)
  transition({I, S, O}, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }
  transition({I, S, O}, {Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

 // =====================================================================
  // SECTION 5B: Safe Absorption in Transient States (Building the puzzle)
  // =====================================================================

  // 1A. Generic Safe Token Absorption for standard transient states
  transition({S_IS, O_IS, M_IS, M_IM, S_IM}, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // 1B. IM state safely absorbs normal Acks (e.g. from invalidations)
  transition(IM, Ack) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // 1C. CRITICAL FIX: IM state receives an Ack_Owner from the Directory.
  // The Directory refused to send data, so we MUST explicitly ask for it!
  transition(IM, Ack_Owner) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    // We have the tokens, but we still need the physical bytes!
    //a_issueImmediateMissingReadRequest;
    n_popResponseQueue;
  }

  transition({SM, OM}, {Ack, Ack_Owner}) {
    q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // 2. Safe Partial Data Absorption
  transition({S_IS, O_IS, M_IS, M_IM, S_IM }, {Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  transition({IM, SM}, {Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;

    a_issueImmediateMissingReadRequest;
    n_popResponseQueue;
  }

  // ===================================================================
  // AMTC ACCUMULATION: Handle fragmented data arrivals during a Read
  // ===================================================================
  transition(IS, {Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;

    // We got some data, but we are still missing sectors required for the Load!
    // Forcefully pull the missing physical bytes from the Directory.
    a_issueImmediateMissingReadRequest;

    n_popResponseQueue;
  }

  // 3. CRITICAL FIX: The "Split Response" Advance
  // If full Data arrives BEFORE Tokens during a write miss, advance to the Upgrade states!
  transition(S_IM, {Data_Shared, Data_Owner}, SM) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  transition(M_IM, {Data_Shared, Data_Owner}, OM) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue;
  }

  // 5C. Mathematical Perfection (Waking the CPU!)
  transition(S_IS, {Data_Shared, Data_All_Tokens}, S) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }
  transition(S_IS, Data_Owner, O) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents;
  }

  transition(S_IM, Data_All_Tokens, M) {
    u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents;
  }

  transition(M_IM, {Data_All_Tokens}, MM) {
    u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; xx_external_store_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents;
  }
  transition(M_IS, {Data_Shared, Data_Owner, Data_All_Tokens}, M) {
    u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents;
  }

  // =====================================================================
  // SECTION 5D: STANDARD CACHE LINE COMPLETIONS
  // Purpose: Waking the CPU for standard full-line fetches and upgrades.
  // =====================================================================

  // IS Completions (Reads from Idle/NP)
  transition(IS, Data_Shared, S) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(IS, Data_Owner, O) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(IS, Data_All_Tokens, M_W) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; x_external_load_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // IM Completions (Writes from Idle/NP)
  transition(IM, Data_Shared, SM) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(IM, Data_Owner, M) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; j_unsetReissueTimer; s_deallocateTBE; n_popResponseQueue; kd_wakeUpDependents; }
  transition(IM, Data_All_Tokens, M_W) { u_writeDataToCache; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; amtc_updateStateFromSectors; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; }

  // SM Completions (Upgrades from Shared)
  transition(SM, Data_Shared) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(SM, Data_Owner, OM) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(SM, Data_All_Tokens, MM_W) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // OM Completions (Upgrades from Owned)
  transition(OM, Data_Shared) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(OM, {Data_Owner, Data_Owner_Partial}) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; n_popResponseQueue; }
  transition(OM, Data_All_Tokens, MM_W) { w_assertIncomingDataAndCacheDataMatch; q_updateTokensFromResponse; amtc_markValidSectorsFromResponse; xx_external_store_hit; o_scheduleUseTimeout; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }

  // =====================================================================
  // SECTION 6: STARVATION & TIMEOUTS (THE PERSISTENT NETWORK)
  // Purpose: Ensuring forward progress when tokens are highly contested.
  // =====================================================================

  // 1. Reissue Read Requests (Missing Data)
  transition({IS, S_IS, O_IS, M_IS}, Request_Timeout) {
    j_unsetReissueTimer;
    a_issueReadRequest;
    //j_setReissueTimer;
  }

  // 2. Reissue Write & Upgrade Requests (Missing Data or Tokens)
  transition({IM, S_IM, M_IM, SM, OM}, Request_Timeout) {
    j_unsetReissueTimer;
    b_issueWriteRequest;
    //j_setReissueTimer;
  }

  // 2B. CRITICAL FIX: Reissue Owner Pulls (We have tokens, but missed the data!)
  transition({IM, SM, OM, IS, S_IS, O_IS, M_IS}, Request_Timeout_Owner){
    j_unsetReissueTimer;

    // This action explicitly calculates the missing mask and forces
    // a GETS request with is_owner_pull = true!
    a_issueImmediateMissingReadRequest;
  }

  // 3. Ignore stray timeouts in stable and timeout-wait states
  transition({M, MM, M_W, MM_W}, Request_Timeout) {
    j_unsetReissueTimer;
  }

  // Lockdowns & Exits
  transition({NP, I, S, O, M, MM, M_W, MM_W, IM, SM, OM, IS, S_IS, O_IS, M_IS, M_IM, S_IM}, Own_Lock_or_Unlock) {
    l_popPersistentQueue;
  }

  // =====================================================================
  // SECTION 6B: MIGRATORY TIMEOUTS & SETTLING
  // Purpose: Resolving M_W and MM_W once their guaranteed "Use" window expires.
  // =====================================================================

  // 1. Nobody is starving. The cache gets to keep the line! Settle into stable Modified.
  transition(M_W, {Use_TimeoutNoStarvers, Use_TimeoutNoStarvers_NoMig}, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(MM_W, Use_TimeoutNoStarvers, MM) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(MM_W, Use_TimeoutNoStarvers_NoMig, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  // 2. Someone is starving for Shared. Yield tokens/data down to S_L.
  transition(M_W, Use_TimeoutStarverS, S_L) {
    s_deallocateTBE;
    ff_sendDataWithAllButNorOneTokens;
    jj_unsetUseTimer;
  }

  // 3. Someone is starving for Exclusive. Yield everything.
  transition(M_W, Use_TimeoutStarverX, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;
  }

  // Migratory Optimization: If in MM_W, even a Shared starver takes everything.
  transition(MM_W, {Use_TimeoutStarverX, Use_TimeoutStarverS}, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;
  }
  // =====================================================================
  // STALE RESPONSE ABSORPTION IN STABLE STATES
  // =====================================================================

  // CRITICAL FIX: Added M_W and MM_W to absorb late token-only packets
  // Also added Ack_Owner variants to catch Directory owner-pull replies
  transition({M, MM, M_W, MM_W}, {Ack, Ack_All_Tokens, Ack_Owner, Ack_Owner_All_Tokens}) {
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // CRITICAL FIX: Added M_W and MM_W to absorb late data packets
  transition({M, MM, M_W, MM_W}, {Data_Shared, Data_Owner, Data_All_Tokens, Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }


}
