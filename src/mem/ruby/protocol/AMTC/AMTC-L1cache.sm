machine(MachineType:L1Cache, "Token protocol")
 : Sequencer * sequencer;
   CacheMemory * L1Icache;
   CacheMemory * L1Dcache;
   int l2_select_num_bits;
   int N_tokens;

   Cycles l1_request_latency := 2;
   Cycles l1_response_latency := 2;
   int retry_threshold := 1;
   Cycles fixed_timeout_latency := 100;
   Cycles reissue_wakeup_latency := 10;
   Cycles use_timeout_latency := 50;

   bool dynamic_timeout_enabled := "True";
   bool no_mig_atomic := "True";
   bool send_evictions;

   // Message Queues
   // From this node's L1 cache TO the network

   // a local L1 -> this L2 bank
   MessageBuffer * responseFromL1Cache, network="To", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentFromL1Cache, network="To", virtual_network="3",
        vnet_type="persistent";
   // a local L1 -> this L2 bank, currently ordered with directory forwarded requests
   MessageBuffer * requestFromL1Cache, network="To", virtual_network="1",
        vnet_type="request";

   // To this node's L1 cache FROM the network

   // a L2 bank -> this L1
   MessageBuffer * responseToL1Cache, network="From", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentToL1Cache, network="From", virtual_network="3",
        vnet_type="persistent";
   // a L2 bank -> this L1
   MessageBuffer * requestToL1Cache, network="From", virtual_network="1",
        vnet_type="request";

   MessageBuffer * mandatoryQueue;
{
  // STATES
  state_declaration(State, desc="Cache states", default="L1Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, "NP", desc="Not Present";
    I, AccessPermission:Invalid, "I", desc="Idle";
    S, AccessPermission:Read_Only, "S", desc="Shared";
    O, AccessPermission:Read_Only, "O", desc="Owned";
    M, AccessPermission:Read_Only, "M", desc="Modified (dirty)";
    MM, AccessPermission:Read_Write, "MM", desc="Modified (dirty and locally modified)";
    M_W, AccessPermission:Read_Only, "M^W", desc="Modified (dirty), waiting";
    MM_W, AccessPermission:Read_Write, "MM^W", desc="Modified (dirty and locally modified), waiting";

    // Transient States
    IM, AccessPermission:Busy, "IM", desc="Issued GetX";
    SM, AccessPermission:Read_Only, "SM", desc="Issued GetX, we still have an old copy of the line";
    OM, AccessPermission:Read_Only, "OM", desc="Issued GetX, received data";
    IS, AccessPermission:Busy, "IS", desc="Issued GetS";

    // Locked states
    I_L, AccessPermission:Busy, "I^L", desc="Invalid, Locked";
    S_L, AccessPermission:Busy, "S^L", desc="Shared, Locked";
    IM_L, AccessPermission:Busy, "IM^L", desc="Invalid, Locked, trying to go to Modified";
    SM_L, AccessPermission:Busy, "SM^L", desc="Shared, Locked, trying to go to Modified";
    IS_L, AccessPermission:Busy, "IS^L", desc="Invalid, Locked, trying to go to Shared";

    // ADD THESE MISSING TRANSIENT STATES:
    S_IM, AccessPermission:Busy, "S^IM",desc="Shared, waiting for tokens/data to upgrade to Modified";


    // Transient States for Sector Misses
    S_IS, AccessPermission:Busy, "S_IS", desc="Shared, waiting for sector GETS";
    O_IS, AccessPermission:Busy, "O_IS", desc="Owned, waiting for sector GETS";
    M_IS, AccessPermission:Busy, "M_IS", desc="Modified, waiting for sector GETS";
    M_IM, AccessPermission:Busy, "M_IM", desc="Modified, waiting for sector GETX";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {
    Load,            desc="Load request from the processor";
    Ifetch,          desc="I-fetch request from the processor";
    Store,           desc="Store request from the processor";
    Atomic,          desc="Atomic request from the processor";
    L1_Replacement,  desc="L1 Replacement";

    // Responses
    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Data_All_Tokens,   desc="Received a data message, we are now the owner, we now have all the tokens";
    Ack,                     desc="Received an ack message";
    Ack_All_Tokens,          desc="Received an ack message, we now have all the tokens";

    // Requests
    Transient_GETX,  desc="A GetX from another processor";
    Transient_Local_GETX,  desc="A GetX from another processor";
    Transient_GETS,  desc="A GetS from another processor";
    Transient_Local_GETS,  desc="A GetS from another processor";
    Transient_GETS_Last_Token,  desc="A GetS from another processor";
    Transient_Local_GETS_Last_Token,  desc="A GetS from another processor";

    // Lock/Unlock for distributed
    Persistent_GETX,     desc="Another processor has priority to read/write";
    Persistent_GETS,     desc="Another processor has priority to read";
    Persistent_GETS_Last_Token, desc="Another processor has priority to read, no more tokens";
    Own_Lock_or_Unlock,  desc="This processor now has priority";

    // Triggers
    Request_Timeout,         desc="Timeout";
    Request_Timeout_Owner,   desc="Timeout when we already hold the tokens";
    Use_TimeoutStarverX,             desc="Timeout";
    Use_TimeoutStarverS,             desc="Timeout";
    Use_TimeoutNoStarvers,             desc="Timeout";
    Use_TimeoutNoStarvers_NoMig,     desc="Timeout Don't Migrate";

    Load_Sector_Miss,  desc="Load request for a missing sector";
    Store_Sector_Miss, desc="Store/Atomic request for a missing sector";
    Data_Shared_Partial, desc="A partial Data_Shared arrived";
    Data_Owner_Partial, desc="A partial Data_Owner arrived";

    // ADD THESE PHASE 2 EVENTS:
    Ack_Owner,              desc="Received an owner ack message (no data)";
    Ack_Owner_All_Tokens,   desc="Received an owner ack, we now have all tokens";
    Load_Hit,   desc="Load hits locally";
    Load_Miss,  desc="Load misses locally";
    Store_Hit,  desc="Store hits locally";
    Store_Miss, desc="Store misses locally";

  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    //int Tokens,              desc="The number of tokens we're holding for the line";
    DataBlock DataBlk,       desc="data for the block";

    // AMTC per-sector metadata for a 64B Ruby line split into 2 x 32B sectors.
    // These fields are metadata-only in the first CPU-only baseline; the
    // original line-token behavior remains authoritative until mask-native
    // transitions are enabled.
    int ValidSectors, default="0", desc="AMTC valid-sector mask; default full line";
    int DirtySectors, default="0", desc="AMTC dirty-sector mask";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";
      }



  // TBE fields
  structure(TBE, desc="...") {
    Addr addr,                      desc="Physical address for this TBE";
    State TBEState,                       desc="Transient state";
    int IssueCount,      default="0",     desc="The number of times we've issued a request for this line.";
    Addr PC,                           desc="Program counter of request";

    bool WentPersistent, default="false",  desc="Request went persistent";
    bool ExternalResponse, default="false", desc="Response came from an external controller";
    bool IsAtomic, default="false",       desc="Request was an atomic request";

    // AMTC TBE sector tracking. Defaults preserve full-line MOESI_CMP_token
    // behavior. Later CPU-sector work should narrow RequestedSectorMask to
    // one or more 32B sectors.
    int RequestedSectorMask, default="3", desc="AMTC requested sector mask";
    int ReceivedSectorMask, default="0", desc="AMTC sectors with data received";
    int TokenReadySectorMask, default="0", desc="AMTC sectors with token condition satisfied";
    int InstalledSectorMask, default="0", desc="AMTC sectors installed in cache";
    int RespondedSectorMask, default="0", desc="AMTC sectors responded upward";
    int LastSectorID, default="0", desc="AMTC primary sector id";
    bool HasOutstandingRequest, default="false", desc="AMTC live request pending";
    bool CallbackIssued, default="false", desc="AMTC sequencer callback issued";

    // Reserved GPU-ready fields. They are intentionally unused in the CPU-only
    // bring-up, but keep AMTC messages/TBEs compatible with future VIPER TCP/TCC.
    bool FromGPU, default="false", desc="Future GPU-originated request";
    bool IsSyncRequest, default="false", desc="Future coherent sync/fence/signal request";
    bool IsBypassRequest, default="false", desc="Future GPU bypass request";
    bool IsAtomicRequest, default="false", desc="Future atomic request";
    bool IsSignalRequest, default="false", desc="Future HSA signal/doorbell request";
    int CURequestor, default="0", desc="Future GPU CU id";
    int Wfid, default="0", desc="Future GPU wavefront id";
    int InstSeqNum, default="0", desc="Future GPU instruction sequence number";

    AccessType TypeOfAccess,
                desc="Type of request (used for profiling)";
    Cycles IssueTime,                       desc="Time the request was issued";
    RubyAccessMode AccessMode,    desc="user/supervisor access type";
    PrefetchBit Prefetch,         desc="Is this a prefetch request";

    int TargetMask,        desc="The original mask the CPU requested";
    int CompletedMask,     desc="The mask of sectors we have successfully written";
    DataBlock PendingData, desc="Temporary buffer to hold CPU data while waiting";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  structure(PersistentTable, external="yes") {
    void persistentRequestLock(Addr, MachineID, AccessType);
    void persistentRequestUnlock(Addr, MachineID);
    bool okToIssueStarving(Addr, MachineID);
    MachineID findSmallest(Addr);
    AccessType typeOfSmallest(Addr);
    void markEntries(Addr);
    bool isLocked(Addr);
    int countStarvingForAddress(Addr);
    int countReadStarvingForAddress(Addr);
  }

  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);
  Cycles curCycle();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  TBETable L1_TBEs, template="<L1Cache_TBE>", constructor="m_number_of_TBEs";

  bool starving, default="false";
  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  PersistentTable persistentTable;
  TimerTable useTimerTable;
  TimerTable reissueTimerTable;

  int outstandingRequests, default="0";
  int outstandingPersistentRequests, default="0";

  // Constant that provides hysteresis for calculated the estimated average
  int averageLatencyHysteresis, default="(8)";
  Cycles averageLatencyCounter,
        default="(Cycles(500) << (*m_averageLatencyHysteresis_ptr))";

  Cycles averageLatencyEstimate() {
    DPRINTF(RubySlicc, "%d\n",
            (averageLatencyCounter >> averageLatencyHysteresis));
    return averageLatencyCounter >> averageLatencyHysteresis;
  }

  void updateAverageLatencyEstimate(Cycles latency) {
    DPRINTF(RubySlicc, "%d\n", latency);

    // By subtracting the current average and then adding the most
    // recent sample, we calculate an estimate of the recent average.
    // If we simply used a running sum and divided by the total number
    // of entries, the estimate of the average would adapt very slowly
    // after the execution has run for a long time.
    // averageLatencyCounter := averageLatencyCounter - averageLatencyEstimate() + latency;

    averageLatencyCounter := averageLatencyCounter - averageLatencyEstimate() + latency;
  }

  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    if(is_valid(L1Dcache_entry)) {
      return L1Dcache_entry;
    }

    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  Entry getL1DCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    return L1Dcache_entry;
  }

  Entry getL1ICacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  // ----------------------------------------------------------------------
  // AMTC mask helpers for the trimmed prototype.
  // Physical Ruby block: 64B. Logical AMTC sectors: 2 x 32B.
  // sector_id 0 -> mask 1 (bytes 0..31), sector_id 1 -> mask 2
  // (bytes 32..63), full-line mask -> 3.
  // Keep field names unchanged so L2/Directory can still compile while the
  // L1 implementation avoids 4-sector metadata overhead.
  // ----------------------------------------------------------------------

  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_calculateNeededMask(int offset, int size) {
    if (size == 0) { return 0; }
    int end_offset := offset + size - 1;
    int mask := 0;
    if (offset < 32) { mask := mask + 1; }
    if ((offset < 64) && (end_offset >= 32)) { mask := mask + 2; }
    return mask;
  }

  int amtc_sanitizeMask(int mask) {
    // Accept old full-line defaults such as 15 from untrimmed controllers, but
    // collapse them to the two valid 32B sectors used by this L1.
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    // 64B Ruby line, 2 x 32B sectors.
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);

    if (active == 0) {
      // No data payload! Just a network header.
      return MessageSizeType:Response_Control;
    }
    else if (active == 1) {
      // Half-line payload
      return MessageSizeType:Response_Sector2_Data;
    }

    // Full-line payload (active == 2)
    return MessageSizeType:Response_Data;
  }

  bool amtc_isSectorAvailable(int valid_mask, Addr addr) {
    int req_sid := amtc_sectorFromAddr(addr);
    return amtc_maskHasSector(valid_mask, req_sid);
  }

  int getTokens(Entry cache_entry, int mask) {
    if (is_valid(cache_entry)) {
      int total := 0;
      if (amtc_maskHasSector(mask, 0)) {
        total := total + cache_entry.TokensSec0;
      }
      if (amtc_maskHasSector(mask, 1)) {
        total := total + cache_entry.TokensSec1;
      }
      return total;
    }
    return 0;
  }

  // -------------------------------------------------------------------------
  // Calculate which sectors a CPU memory request actually touches.
  // Sector 0 = Bytes 0 to 31. Sector 1 = Bytes 32 to 63.
  // -------------------------------------------------------------------------
  int amtc_getRequiredSectorMask(Addr line_addr, Addr phys_addr, int size) {
    int offset := getOffset(phys_addr);
    int end_byte := offset + size - 1;
    int mask := 0;

    // Does the request start before byte 32? It needs Sector 0.
    if (offset < 32) {
      mask := mask + 1;
    }

    // Does the request end at or after byte 32? It needs Sector 1.
    if (end_byte >= 32) {
      mask := mask + 2;
    }

    // Failsafe: If something goes weird with size=0, request the whole line.
    if (mask == 0) {
      mask := 3;
    }

    return mask;
  }

  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else {
      if (persistentTable.isLocked(addr) &&
          (persistentTable.findSmallest(addr) != machineID)) {
        return State:I_L;
      } else {
        return State:NP;
      }
    }
  }


  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    assert((L1Dcache.isTagPresent(addr) && L1Icache.isTagPresent(addr)) == false);

    // =========================================================
    // TBE State Management (Unchanged)
    // =========================================================
    if (is_valid(tbe)) {
      assert(state != State:I);
      assert(state != State:S);
      assert(state != State:O);
      assert(state != State:MM);
      assert(state != State:M);
      tbe.TBEState := state;
    }

    if (is_valid(tbe)) {
      if (state != State:M && state != State:MM && state != State:O) {
        tbe.TBEState := state;
      }
    }

    // =========================================================
    // Cache Entry State & Phase 2 Token Math
    // =========================================================
    if (is_valid(cache_entry)) {

      // Basic sanity checks: No sector can have negative tokens
      assert(cache_entry.TokensSec0 >= 0);
      assert(cache_entry.TokensSec1 >= 0);

      // In AMTC, the whole line's max_tokens() is divided equally among sectors
      int tokens_per_sector := max_tokens() / 2;

      // ---------------------------------------------------------
      // Invalid / Locked / NP States
      // ---------------------------------------------------------
      if ((state == State:I_L) ||
          (state == State:IM_L) ||
          (state == State:IS_L) ||
          (state == State:NP)) {
        // Make sure we have absolutely no tokens
        assert(cache_entry.TokensSec0 == 0);
        assert(cache_entry.TokensSec1 == 0);

      } else if ((state == State:S_L) ||
                 (state == State:SM_L)) {
        // Shared-locked: must have at least one token for any valid sector
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 >= 1);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 >= 1);
        }
      }

      // ---------------------------------------------------------
      // Modified-like States (M, MM, M_W, MM_W)
      // ---------------------------------------------------------
      if (state == State:MM || state == State:M || state == State:MM_W || state == State:M_W) {
        // We must have at least one valid sector to be in a Modified state
        assert(cache_entry.ValidSectors != 0);
        DPRINTF(RubySlicc, "State=%d Valid=%x T0=%d T1=%d\n",
        state, cache_entry.ValidSectors,
        cache_entry.TokensSec0,
        cache_entry.TokensSec1);

        // If we hold 512 tokens for a sector, we are Modified for that sector.
        // If we hold < 512, it is a Shared/Invalid sector and should not crash a partial Modified state.

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
            // Only assert if we actually intended to be modified for Sector 0
            assert(cache_entry.TokensSec0 > 0);
            if (amtc_maskHasSector(cache_entry.DirtySectors, 0)) {
                assert(cache_entry.TokensSec0 == tokens_per_sector);
            }
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
             // Only assert if we actually intended to be modified for Sector 1
             assert(cache_entry.TokensSec1 > 0);
            if (amtc_maskHasSector(cache_entry.DirtySectors, 1)){
                assert(cache_entry.TokensSec1 == tokens_per_sector);
            }
        }
    }

      // ---------------------------------------------------------
      // Shared-like States (S, SM)
      // ---------------------------------------------------------
      if (state == State:S || state == State:SM) {
        assert(cache_entry.ValidSectors != 0);

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      // ---------------------------------------------------------
      // Owned-like States (O, OM)
      // ---------------------------------------------------------
      if (state == State:O || state == State:OM) {
        assert(cache_entry.ValidSectors != 0);

        // Owner must hold tokens for its valid sectors
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := L1_TBEs[addr];
    if(is_valid(tbe)) {
      return L1Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L1Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L1Cache_State_to_permission(state));
    }
  }

  Event mandatory_request_type_to_event(RubyRequestType type) {
    if (type == RubyRequestType:LD) {
      return Event:Load;
    } else if (type == RubyRequestType:IFETCH) {
      return Event:Ifetch;
    } else if (type == RubyRequestType:ST) {
      return Event:Store;
    } else if (type == RubyRequestType:ATOMIC) {
      if (no_mig_atomic) {
        return Event:Atomic;
      } else {
        return Event:Store;
      }
    } else {
      error("Invalid RubyRequestType");
    }
  }

  AccessType cache_request_type_to_access_type(RubyRequestType type) {
    if ((type == RubyRequestType:LD) || (type == RubyRequestType:IFETCH)) {
      return AccessType:Read;
    } else if ((type == RubyRequestType:ST) || (type == RubyRequestType:ATOMIC)) {
      return AccessType:Write;
    } else {
      error("Invalid RubyRequestType");
    }
  }

  // NOTE: direct local hits should not call this function
  bool isExternalHit(Addr addr, MachineID sender) {
    if (machineIDToMachineType(sender) == MachineType:L1Cache) {
      return true;
    } else if (machineIDToMachineType(sender) == MachineType:L2Cache) {

      if (sender == mapAddressToRange(addr, MachineType:L2Cache,
                      l2_select_low_bit, l2_select_num_bits, intToID(0))) {
        return false;
      } else {
        return  true;
      }
    }

    return true;
  }

  bool okToIssueStarving(Addr addr, MachineID machineID) {
    return persistentTable.okToIssueStarving(addr, machineID);
  }

  void markPersistentEntries(Addr addr) {
    persistentTable.markEntries(addr);
  }

  void setExternalResponse(TBE tbe) {
    assert(is_valid(tbe));
    tbe.ExternalResponse := true;
  }

  bool IsAtomic(TBE tbe) {
    assert(is_valid(tbe));
    return tbe.IsAtomic;
  }

  // ** OUT_PORTS **
  out_port(persistentNetwork_out, PersistentMsg, persistentFromL1Cache);
  out_port(requestNetwork_out, RequestMsg, requestFromL1Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL1Cache);
  out_port(requestRecycle_out, RequestMsg, requestToL1Cache);

  // ** IN_PORTS **

  // Use Timer
  in_port(useTimerTable_in, Addr, useTimerTable, rank=5) {
    if (useTimerTable_in.isReady(clockEdge())) {
      Addr readyAddress := useTimerTable.nextAddress();
      TBE tbe := L1_TBEs.lookup(readyAddress);

      if (persistentTable.isLocked(readyAddress) &&
          (persistentTable.findSmallest(readyAddress) != machineID)) {
        if (persistentTable.typeOfSmallest(readyAddress) == AccessType:Write) {
          trigger(Event:Use_TimeoutStarverX, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutStarverS, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      } else {
        if (no_mig_atomic && IsAtomic(tbe)) {
          trigger(Event:Use_TimeoutNoStarvers_NoMig, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutNoStarvers, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      }
    }
  }

  // Reissue Timer
  // Reissue Timer
  in_port(reissueTimerTable_in, Addr, reissueTimerTable, rank=4) {
    Tick current_time := clockEdge();
    if (reissueTimerTable_in.isReady(current_time)) {
      Addr addr := reissueTimerTable.nextAddress();
      Entry cache_entry := getCacheEntry(addr);
      TBE tbe := L1_TBEs.lookup(addr);

      // CRITICAL FIX: Evaluate tokens BEFORE triggering the state machine!
      if (is_valid(cache_entry) && (getTokens(cache_entry, amtc_fullMask()) >= (max_tokens() / 2))) {
          // We have the tokens! Trigger the special Owner Pull timeout.
          trigger(Event:Request_Timeout_Owner, addr, cache_entry, tbe);
      } else {
          // We don't have tokens. Trigger the standard timeout.
          trigger(Event:Request_Timeout, addr, cache_entry, tbe);
      }
    }
  }

  // Persistent Network
  in_port(persistentNetwork_in, PersistentMsg, persistentToL1Cache, rank=3) {
    if (persistentNetwork_in.isReady(clockEdge())) {
      peek(persistentNetwork_in, PersistentMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        // Apply the lockdown or unlockdown message to the table
        if (in_msg.Type == PersistentRequestType:GETX_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Write);
        } else if (in_msg.Type == PersistentRequestType:GETS_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Read);
        } else if (in_msg.Type == PersistentRequestType:DEACTIVATE_PERSISTENT) {
          persistentTable.persistentRequestUnlock(in_msg.addr, in_msg.Requestor);
        } else {
          error("Unexpected message");
        }

        // React to the message based on the current state of the table
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (persistentTable.isLocked(in_msg.addr)) {
          if (persistentTable.findSmallest(in_msg.addr) == machineID) {
            // Our Own Lock - this processor is highest priority
            trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                    cache_entry, tbe);
          } else {
            if (persistentTable.typeOfSmallest(in_msg.addr) == AccessType:Read) {
              if (getTokens(cache_entry, amtc_fullMask()) == 1 ||
                  getTokens(cache_entry, amtc_fullMask()) == (max_tokens() / 2) + 1) {
                trigger(Event:Persistent_GETS_Last_Token, in_msg.addr,
                        cache_entry, tbe);
              } else {
                trigger(Event:Persistent_GETS, in_msg.addr,
                        cache_entry, tbe);
              }
            } else {
              trigger(Event:Persistent_GETX, in_msg.addr,
                      cache_entry, tbe);
            }
          }
        } else {
          // Unlock case - no entries in the table
          trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                  cache_entry, tbe);
        }
      }
    }
  }

  // Response Network
  in_port(responseNetwork_in, ResponseMsg, responseToL1Cache, rank=2) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        // =====================================================================
        // 1. LATENCY PROFILING (Standard gem5 bookkeeping)
        // =====================================================================
        if ( machineIDToMachineType(in_msg.Sender) == MachineType:L2Cache ) {
          if (in_msg.Sender == mapAddressToRange(in_msg.addr,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0))) {
            // came from an off-chip L2 cache
            if (is_valid(tbe)) {
               // L1_TBEs[in_msg.addr].ExternalResponse := true;
               // profile_offchipL2_response(in_msg.addr);
            }
          } else {
               // profile_onchipL2_response(in_msg.addr );
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:Directory ) {
          if (is_valid(tbe)) {
            setExternalResponse(tbe);
            // profile_memory_response( in_msg.addr);
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
          // Local/Off-chip L1 profiling can go here
        } else {
          error("unexpected SenderMachine");
        }

        // =====================================================================
        // 2. SECTOR COMPLETION CHECK (Data Bytes)
        // =====================================================================
        bool is_complete := true;
        if (is_valid(tbe)) {
            int current_valid := 0;
            if (is_valid(cache_entry)) { current_valid := cache_entry.ValidSectors; }

            // CRITICAL FIX: ACKs NEVER carry valid data bytes!
            // We only trust the mask if it is a true DATA packet.
            int incoming_valid := 0;
            if (in_msg.Type == CoherenceResponseType:DATA_SHARED || in_msg.Type == CoherenceResponseType:DATA_OWNER) {
                incoming_valid := amtc_intersectMasks(in_msg.valid_sector_mask, tbe.RequestedSectorMask);
            }

            int future_valid := amtc_unionMasks(current_valid, incoming_valid);
            if (amtc_intersectMasks(future_valid, tbe.RequestedSectorMask) != tbe.RequestedSectorMask) {
                is_complete := false;
            }
        }

        // =====================================================================
        // 3. SHARED TOKEN CHECK (>= 1 token)
        // =====================================================================
        bool has_shared_tokens := true;
        if (is_valid(tbe)) {
            int future_t0 := in_msg.TokensSec0;
            int future_t1 := in_msg.TokensSec1;
            if (is_valid(cache_entry)) {
                future_t0 := future_t0 + cache_entry.TokensSec0;
                future_t1 := future_t1 + cache_entry.TokensSec1;
            }
            if (amtc_maskHasSector(tbe.RequestedSectorMask, 0) && future_t0 == 0) {
                has_shared_tokens := false;
            }
            if (amtc_maskHasSector(tbe.RequestedSectorMask, 1) && future_t1 == 0) {
                has_shared_tokens := false;
            }
        } else {
            has_shared_tokens := false;
        }

        // =====================================================================
        // 4. EXCLUSIVE TOKEN CHECK (512 tokens)
        // =====================================================================
        bool is_effectively_all_tokens := true;
        if (is_valid(tbe)) {
            int future_t0 := in_msg.TokensSec0;
            int future_t1 := in_msg.TokensSec1;
            if (is_valid(cache_entry)) {
                future_t0 := future_t0 + cache_entry.TokensSec0;
                future_t1 := future_t1 + cache_entry.TokensSec1;
            }
            int required_per_sector := max_tokens() / 2;
            if (amtc_maskHasSector(tbe.RequestedSectorMask, 0) && future_t0 < required_per_sector) {
                is_effectively_all_tokens := false;
            }
            if (amtc_maskHasSector(tbe.RequestedSectorMask, 1) && future_t1 < required_per_sector) {
                is_effectively_all_tokens := false;
            }
        } else {
            is_effectively_all_tokens := false;
        }

        // =====================================================================
        // 5. BULLETPROOF EVENT ROUTING
        // =====================================================================
        if (in_msg.Type == CoherenceResponseType:ACK ||
            in_msg.Type == CoherenceResponseType:ACK_OWNER ||
            in_msg.Type == CoherenceResponseType:DATA_OWNER ||
            in_msg.Type == CoherenceResponseType:DATA_SHARED) {

            // IF THE TRANSACTION IS NOW FINISHED:
            if (is_complete && is_effectively_all_tokens) {
                // Force a completion event for Writes
                trigger(Event:Data_All_Tokens, in_msg.addr, cache_entry, tbe);
            }
            else if (is_complete && has_shared_tokens) {
                // Force a completion event for Reads to wake the CPU!
                if (in_msg.Type == CoherenceResponseType:DATA_OWNER || in_msg.Type == CoherenceResponseType:ACK_OWNER) {
                    trigger(Event:Data_Owner, in_msg.addr, cache_entry, tbe);
                } else {
                    trigger(Event:Data_Shared, in_msg.addr, cache_entry, tbe);
                }
            }
            // IF THE TRANSACTION IS STILL PENDING (Partial):
            else {
                if (in_msg.Type == CoherenceResponseType:ACK) {
                    trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
                } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER) {
                    trigger(Event:Ack_Owner, in_msg.addr, cache_entry, tbe);
                } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
                    trigger(Event:Data_Owner_Partial, in_msg.addr, cache_entry, tbe);
                } else {
                    trigger(Event:Data_Shared_Partial, in_msg.addr, cache_entry, tbe);
                }
            }
        } else {
            error("Unexpected message type received in L1 response network");
        }
      }
    }
  }

  // Request Network
  in_port(requestNetwork_in, RequestMsg, requestToL1Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceRequestType:GETX) {
          if (in_msg.isLocal) {
            trigger(Event:Transient_Local_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
          else {
            trigger(Event:Transient_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          if (getTokens(cache_entry,amtc_fullMask()) == 1 ||
              getTokens(cache_entry,amtc_fullMask()) == (max_tokens() / 2) + 1) {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
          }
          else {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
          }
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  // Mandatory Queue
  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...", rank=0) {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest, block_on="LineAddress") {

        TBE tbe := L1_TBEs[in_msg.LineAddress];
        //int req_offset := getOffset(in_msg.PhysicalAddress);

        // Use the function you defined for mask calculation
        // THE FIX
        int needed_mask := amtc_getRequiredSectorMask(in_msg.LineAddress, in_msg.PhysicalAddress, in_msg.Size);

        // ===================================================================
        // 1. INSTRUCTION FETCH
        // ===================================================================
        if (in_msg.Type == RubyRequestType:IFETCH) {
          Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
          if (is_valid(L1Icache_entry)) {
            bool has_data := (amtc_intersectMasks(L1Icache_entry.ValidSectors, needed_mask) == needed_mask);
            bool has_tokens := true;
            if (amtc_maskHasSector(needed_mask, 0) && L1Icache_entry.TokensSec0 == 0) { has_tokens := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Icache_entry.TokensSec1 == 0) { has_tokens := false; }

            if (!has_data || !has_tokens) {
              trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            }
          } else {
            Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
            if (is_valid(L1Dcache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Dcache_entry, tbe); }
            if (L1Icache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              Addr victim := L1Icache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1ICacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 2. DATA LOADS & READS
        // ===================================================================
        else if (in_msg.Type == RubyRequestType:LD || in_msg.Type == RubyRequestType:Locked_RMW_Read) {
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            bool has_data := (amtc_intersectMasks(L1Dcache_entry.ValidSectors, needed_mask) == needed_mask);
            bool has_tokens := true;
            if (amtc_maskHasSector(needed_mask, 0) && L1Dcache_entry.TokensSec0 == 0) { has_tokens := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Dcache_entry.TokensSec1 == 0) { has_tokens := false; }

            if (!has_data || !has_tokens) {
                trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
                trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            }
          } else {
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Icache_entry, tbe); }
            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
              Addr victim := L1Dcache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1DCacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 3. STORES & ATOMICS
        // ===================================================================
        else if (in_msg.Type == RubyRequestType:ST || in_msg.Type == RubyRequestType:ATOMIC || in_msg.Type == RubyRequestType:Locked_RMW_Write) {
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            bool has_write_permission := true;
            int tokens_per_sector := max_tokens() / 2;

            if (amtc_maskHasSector(needed_mask, 0) && L1Dcache_entry.TokensSec0 < tokens_per_sector) { has_write_permission := false; }
            if (amtc_maskHasSector(needed_mask, 1) && L1Dcache_entry.TokensSec1 < tokens_per_sector) { has_write_permission := false; }

            if (!has_write_permission) {
                trigger(Event:Store_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
                trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            }
          } else {
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) { trigger(Event:L1_Replacement, in_msg.LineAddress, L1Icache_entry, tbe); }
            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
              Addr victim := L1Dcache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1DCacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
        // ===================================================================
        // 4. CATCH-ALL (Flushes, etc.)
        // ===================================================================
        else {
           trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, getL1DCacheEntry(in_msg.LineAddress), tbe);
        }
      }
    }
  }

  // ACTIONS
action(a_issueReadRequest, "a", desc="Issue GETS") {
      assert(is_valid(tbe));
      if (tbe.IssueCount == 0) {
        outstandingRequests := outstandingRequests + 1;
      }

      if (tbe.IssueCount >= retry_threshold) {
        // Issue a persistent request if possible
        if (okToIssueStarving(address, machineID) && (starving == false)) {
          enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Type := PersistentRequestType:GETS_PERSISTENT;
            out_msg.Requestor := machineID;
            out_msg.Destination.broadcast(MachineType:L1Cache);
            out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
            out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
            out_msg.MessageSize := MessageSizeType:Persistent_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
            // Notice: No is_owner_pull here!
          }
          markPersistentEntries(address);
          starving := true;

          outstandingPersistentRequests := outstandingPersistentRequests + 1;
          tbe.IssueCount := tbe.IssueCount + 1;
          tbe.WentPersistent := true;
        }
        else {
          // Set a wakeup timer
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(reissue_wakeup_latency));
        }
      } else {
        // ------------------------------------------------------------------
        // ENQUEUE 1: Send to L2 / Directory
        // ------------------------------------------------------------------
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

          out_msg.RetryNum := tbe.IssueCount;
          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Request_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Reissue_Control;
          }

          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // is_owner_pull is safely applied here to the RequestMsg
          if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
              out_msg.is_owner_pull := true;
          } else {
              out_msg.is_owner_pull := false;
          }
        }

        // ------------------------------------------------------------------
        // ENQUEUE 2: Broadcast to other local L1s
        // ------------------------------------------------------------------
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          out_msg.Destination.broadcast(MachineType:L1Cache);
          out_msg.Destination.remove(machineID);

          out_msg.RetryNum := tbe.IssueCount;
          out_msg.isLocal := true;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          //out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // is_owner_pull is safely applied here to the RequestMsg
          if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
              out_msg.is_owner_pull := true;
          } else {
              out_msg.is_owner_pull := false;
          }
        }

        tbe.IssueCount := tbe.IssueCount + 1;

        if (dynamic_timeout_enabled) {
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
        } else {
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
        }
      }
  }

  action(b_issueWriteRequest, "b", desc="Issue GETX") {

      assert(is_valid(tbe));
      if (tbe.IssueCount == 0) {
        // Update outstanding requests
        //profile_outstanding_request(outstandingRequests);
        outstandingRequests := outstandingRequests + 1;
      }

      if (tbe.IssueCount >= retry_threshold) {
        // Issue a persistent request if possible
        if ( okToIssueStarving(address, machineID) && (starving == false)) {
          enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Type := PersistentRequestType:GETX_PERSISTENT;
            out_msg.Requestor := machineID;
            out_msg.Destination.broadcast(MachineType:L1Cache);

            //
            // Currently the configuration system limits the system to only one
            // chip.  Therefore, if we assume one shared L2 cache, then only one
            // pertinent L2 cache exist.
            //
            //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));

            out_msg.Destination.add(mapAddressToRange(address,
                                      MachineType:L2Cache, l2_select_low_bit,
                                      l2_select_num_bits, intToID(0)));

            out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
            out_msg.MessageSize := MessageSizeType:Persistent_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          }
          markPersistentEntries(address);
          starving := true;

          // Update outstanding requests
          //profile_outstanding_persistent_request(outstandingPersistentRequests);
          outstandingPersistentRequests := outstandingPersistentRequests + 1;

          if (tbe.IssueCount == 0) {
            //profile_persistent_prediction(address, tbe.TypeOfAccess);
          }

          // Increment IssueCount
          tbe.IssueCount := tbe.IssueCount + 1;

          tbe.WentPersistent := true;

          // Do not schedule a wakeup, a persistent requests will always complete
        }
        else {

          // We'd like to issue a persistent request, but are not allowed
          // to issue a P.R. right now.  This, we do not increment the
          // IssueCount.

          // Set a wakeup timer
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(reissue_wakeup_latency));
        }

      } else  {
        // Make a normal request
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;

          out_msg.Destination.add(mapAddressToRange(address,
                                    MachineType:L2Cache, l2_select_low_bit,
                                    l2_select_num_bits, intToID(0)));

          out_msg.RetryNum := tbe.IssueCount;

          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Request_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Reissue_Control;
          }
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
        }

        // send to other local L1s too
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;
          out_msg.isLocal := true;

          //
          // Since only one chip, assuming all L1 caches are local
          //
          //out_msg.Destination := getOtherLocalL1IDs(machineID);
          out_msg.Destination.broadcast(MachineType:L1Cache);
          out_msg.Destination.remove(machineID);

          out_msg.RetryNum := tbe.IssueCount;
          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          }
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
        }

        // Increment IssueCount
        tbe.IssueCount := tbe.IssueCount + 1;

        DPRINTF(RubySlicc, "incremented issue count to %d\n",
                tbe.IssueCount);

        // Set a wakeup timer
        if (dynamic_timeout_enabled) {
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
        } else {
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
        }
      }
  }

  action(b_issueUpgradeRequest, "bU", desc="Issue an upgrade request (tokens only)") {
    peek(mandatoryQueue_in, RubyRequest) {
      // Enqueue the request to the network
      // (Note: Replace 'issue_latency' with whatever your standard latency variable is, e.g., 'l1_request_latency')
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        // Route to the Directory
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

        // Control message only, no data payload
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;

        // AMTC Specifics: Request tokens for the specific sector the CPU wants to write
        out_msg.sector_mask := amtc_singleSectorMaskFromAddr(address);
        out_msg.requested_sector_mask := amtc_singleSectorMaskFromAddr(address);
      }
    }
  }

  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.TokensSec0 := in_msg.TokensSec0;
        out_msg.TokensSec1 := in_msg.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := in_msg.Dirty;
        //Preserve the AMTC sector masks so the Directory knows what it is receiving
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.token_sector_mask := in_msg.token_sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
      }
    }
  }

  action(c_ownedReplacement, "c", desc="Issue writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));

      // STRICT ISOLATION: Only write back sectors we actually modified!
      // This prevents overwriting the L2 with our stale clean data.
      int wb_mask := cache_entry.DirtySectors;

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.token_sector_mask := amtc_fullMask(); // Send all tokens back
      out_msg.requested_sector_mask := wb_mask;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;

      // If we didn't dirty anything, DO NOT send a data payload.
      if (wb_mask == 0) {
        out_msg.Dirty := false;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.valid_sector_mask := 0;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      } else {
        out_msg.Dirty := true;
        out_msg.Type := CoherenceResponseType:WB_OWNED;
        out_msg.valid_sector_mask := wb_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
      }
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(cc_sharedReplacement, "\c", desc="Issue shared writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));

        // Shared evictions never carry physical data.
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(tr_tokenReplacement, "tr", desc="Issue token writeback") {
    assert(is_valid(cache_entry));
    // CRITICAL FIX: Check the actual sector tokens!
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;

        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) { wb_mask := amtc_fullMask(); }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
      }
    }
    // CRITICAL FIX: Zero out the actual sector tokens!
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }


  action(d_sendDataWithToken, "d", desc="Send data and a token from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.valid_sector_mask := cache_entry.ValidSectors;
        out_msg.Dirty := false;

        // Safely delegate exactly 1 token for requested sectors
        if (amtc_maskHasSector(in_msg.requested_sector_mask, 0) && cache_entry.TokensSec0 > 1) {
            out_msg.TokensSec0 := 1;
            cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
        } else {
            out_msg.TokensSec0 := 0;
        }

        if (amtc_maskHasSector(in_msg.requested_sector_mask, 1) && cache_entry.TokensSec1 > 1) {
            out_msg.TokensSec1 := 1;
            cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
        } else {
            out_msg.TokensSec1 := 0;
        }

        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          out_msg.MessageSize := MessageSizeType:Response_Data;
        }
      }
    }
  }

  action(d_sendDataWithNTokenIfAvail, "\dd", desc="Send data and N tokens from cache to requestor") {
    assert(is_valid(cache_entry));
    int tokens_per_sector := max_tokens() / 2;
    int owner_limit := N_tokens + tokens_per_sector;

    peek(requestNetwork_in, RequestMsg) {
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      int send_t0 := 0;
      int send_t1 := 0;

      // Evaluate Sector 0
      if (amtc_maskHasSector(send_mask, 0)) {
        if (cache_entry.TokensSec0 > owner_limit) {
            send_t0 := N_tokens;
        } else if (cache_entry.TokensSec0 > 1) {
            send_t0 := 1;
        }
      }

      // Evaluate Sector 1
      if (amtc_maskHasSector(send_mask, 1)) {
        if (cache_entry.TokensSec1 > owner_limit) {
            send_t1 := N_tokens;
        } else if (cache_entry.TokensSec1 > 1) {
            send_t1 := 1;
        }
      }

      // If we have any tokens to give, send the payload
      if (send_t0 > 0 || send_t1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          if (amtc_maskHasSector(send_mask, 0)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32); }
          if (amtc_maskHasSector(send_mask, 1)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32); }

          out_msg.valid_sector_mask := send_mask;
          out_msg.Dirty := false;

          if (in_msg.isLocal) {
            out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
          } else {
            out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
          }
        }

        // Deduct tokens
        cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
        cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;

        // Downgrade ValidSectors if we lost our Owner status for that sector
        if (cache_entry.TokensSec0 < tokens_per_sector) {
            cache_entry.ValidSectors := amtc_clearSector(cache_entry.ValidSectors, 0);
        }
        if (cache_entry.TokensSec1 < tokens_per_sector) {
            cache_entry.ValidSectors := amtc_clearSector(cache_entry.ValidSectors, 1);
        }
      }
    }
  }

action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        // ... (existing addressing) ...

        out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;

        // SECTOR AWARE COPY: Only send what we actually have!
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        out_msg.valid_sector_mask := cache_entry.ValidSectors;

        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          // CRITICAL FIX: Shrink the NoC packet if we only have 1 sector!
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
        }
      }
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

action(e_sendAckWithCollectedTokens, "e", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // Evaluate our sectored token pools directly
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;

        // This is an ACK action. We yield the tokens as a control message.
        out_msg.Type := CoherenceResponseType:ACK;

        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Control;

        // AMTC Metadata: Dynamically flag which sectors these tokens belong to
        int t_mask := 0;
        if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
        if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

        out_msg.token_sector_mask := t_mask;
        out_msg.valid_sector_mask := 0; // ACKs never carry valid data
      }
    }

    // Safely zero out local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

action(ee_sendDataWithAllTokens, "\e", desc="Send data and all tokens from cache to starver") {
    assert(is_valid(cache_entry));
    assert(cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0);

    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(persistentTable.findSmallest(address));

      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;

      out_msg.valid_sector_mask := cache_entry.ValidSectors;
      out_msg.token_sector_mask := cache_entry.ValidSectors;
      out_msg.Dirty := cache_entry.Dirty;

      // Dynamic message sizing based on how many sectors are valid
      out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
    }

    // Safely zero out the sector token pools
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(f_sendAckWithAllButNorOneTokens, "f", desc="Send ack with all our tokens but one to starver.") {
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;

    // Evaluate Sector 0: If we have > 1 token, keep 1 and send the rest.
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
    }
    // Evaluate Sector 1: If we have > 1 token, keep 1 and send the rest.
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
    }

    if (send_t0 > 0 || send_t1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK; // ACKs never carry data
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := MessageSizeType:Response_Control;

        // AMTC Metadata: Flag which sectors these tokens belong to
        int t_mask := 0;
        if (send_t0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
        if (send_t1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

        out_msg.token_sector_mask := t_mask;
        out_msg.valid_sector_mask := 0;
      }
    }
  }

  action(ff_sendDataWithAllButNorOneTokens, "\f", desc="Send data and out tokens but one to starver") {
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }
    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    if (send_t0 > 0 || send_t1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(persistentTable.findSmallest(address));

          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          // Sector-Aware Data Copy: Only send the bytes we are yielding
          if (amtc_maskHasSector(send_mask, 0)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32); }
          if (amtc_maskHasSector(send_mask, 1)) { out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32); }

          out_msg.valid_sector_mask := send_mask;
          out_msg.token_sector_mask := send_mask;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
      }
    }
  }

  action(fo_sendDataWithOwnerToken, "fo", desc="Send data and owner tokens") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;

        out_msg.valid_sector_mask := cache_entry.ValidSectors;
        out_msg.token_sector_mask := cache_entry.ValidSectors;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(g_bounceResponseToStarver, "g", desc="Redirect response to starving processor") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        // CRITICAL FIX: Combine incoming tokens with our local tokens!
        if (is_valid(cache_entry)) {
            out_msg.TokensSec0 := in_msg.TokensSec0 + cache_entry.TokensSec0;
            out_msg.TokensSec1 := in_msg.TokensSec1 + cache_entry.TokensSec1;
        } else {
            out_msg.TokensSec0 := in_msg.TokensSec0;
            out_msg.TokensSec1 := in_msg.TokensSec1;
        }

        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.token_sector_mask := in_msg.token_sector_mask;
        out_msg.Dirty := in_msg.Dirty;
        out_msg.MessageSize := in_msg.MessageSize;
      }
    }

    // Safely zero out our local tokens since we just yielded them all
    if (is_valid(cache_entry)) {
        cache_entry.TokensSec0 := 0;
        cache_entry.TokensSec1 := 0;
    }
  }

  action(h_load_hit, "hd", desc="CPU load hit") {
    // Always assert validity first!
    assert(is_valid(cache_entry));

    L1Dcache.setMRU(cache_entry);

    // Unconditional callback
    sequencer.readCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);
  }

 action(h_ifetch_hit, "hi", desc="CPU ifetch hit") {
    assert(is_valid(cache_entry));

    L1Icache.setMRU(cache_entry);

    // Unconditional callback. We trust the in_port only fired Ifetch
    // because the specific sector the CPU wants is actually here.
    sequencer.readCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);

    // --- OPTIONAL: AGGRESSIVE PREFETCHING ---
    // If you want to fetch the rest of the line without stalling the CPU:
    if (cache_entry.ValidSectors != amtc_fullMask()) {
        DPRINTF(RubySlicc, "Partial ifetch hit. Issuing background fetch for addr %#x\n", address);

        // Instead of a trigger, we directly enqueue a background GETS request for the missing mask
        peek(mandatoryQueue_in, RubyRequest) {
            enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:GETS;
                out_msg.Requestor := machineID;
                out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
                out_msg.MessageSize := MessageSizeType:Request_Control;
                out_msg.AccessMode := in_msg.AccessMode;
                out_msg.Prefetch := in_msg.Prefetch;

                // Ask for everything we don't currently have
                out_msg.requested_sector_mask := amtc_subtractMask(amtc_fullMask(), cache_entry.ValidSectors);
                out_msg.sector_mask := out_msg.requested_sector_mask;
            }
        }
    }
  }

action(hh_store_hit, "\\h", desc="CPU store hit") {
  L1Dcache.setMRU(cache_entry);
  sequencer.writeCallback(address, cache_entry.DataBlk, false, MachineType:L1Cache);
  cache_entry.Dirty := true;

  // Look directly into the CPU queue to get the UNSTRIPPED physical address
  peek(mandatoryQueue_in, RubyRequest) {
    int req_offset := getOffset(in_msg.PhysicalAddress);
    int store_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);

    // Now we accurately dirty ONLY the sector the CPU actually wrote to!
    cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, store_mask);
  }
}



action(x_external_load_hit, "x", desc="External load completion") {
  peek(responseNetwork_in, ResponseMsg) {
    L1Icache.setMRU(address);
    L1Dcache.setMRU(address);
    //sequencer.readCallback(address, cache_entry.DataBlk, true, machineIDToMachineType(in_msg.Sender));
  }
}

action(xx_external_store_hit, "\\x", desc="External store completion (sector-aware)") {
    assert(is_valid(cache_entry));

    peek(responseNetwork_in, ResponseMsg) {
      if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
        L1Icache.setMRU(address);
        L1Dcache.setMRU(address);

        //sequencer.writeCallback(address, cache_entry.DataBlk, true, machineIDToMachineType(in_msg.Sender));

        cache_entry.Dirty := true;
        if (is_valid(tbe)) {
          cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, tbe.RequestedSectorMask);
        }
      }
    }
  }


  action(initTBERequestTracking, "irt", desc="Initialize AMTC sector tracking") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_sid := amtc_sectorFromAddr(in_msg.PhysicalAddress);
      int req_mask := amtc_maskFromSector(req_sid);

      tbe.RequestedSectorMask := req_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := req_sid;
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.FromGPU := false;

      DPRINTF(RubySlicc,
        "AMTC_L1_TBE_INIT addr=%#x line=%#x sid=%d mask=%d\n",
        in_msg.LineAddress, address, req_sid, req_mask);
    }
  }

action(i_allocateTBE, "i", desc="Allocate TBE") {
    check_allocate(L1_TBEs);
    L1_TBEs.allocate(address);
    set_tbe(L1_TBEs[address]);
    tbe.IssueCount := 0;

    peek(mandatoryQueue_in, RubyRequest) {
      tbe.PC := in_msg.ProgramCounter;
      tbe.TypeOfAccess := cache_request_type_to_access_type(in_msg.Type);
      if (in_msg.Type == RubyRequestType:ATOMIC) {
        tbe.IsAtomic := true;
      }
      tbe.Prefetch := in_msg.Prefetch;
      tbe.AccessMode := in_msg.AccessMode;

      // =========================================================
      // AMTC MIXED-MODE FETCH LOGIC
      // =========================================================
      int req_mask := amtc_fullMask();

      tbe.RequestedSectorMask := req_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := 0; // Default to 0 for full line
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.FromGPU := false;
      tbe.IsSyncRequest := false;
      tbe.IsBypassRequest := false;
      tbe.IsAtomicRequest := tbe.IsAtomic;
      tbe.IsSignalRequest := false;
      tbe.CURequestor := 0;
      tbe.Wfid := 0;
      tbe.InstSeqNum := 0;
      tbe.IssueTime := curCycle();

    }
  }

  action(ta_traceStalledAddress, "ta", desc="Trace Stalled Address") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
  }

  action(j_setReissueTimer, "ja", desc="Set the reissue timer for a persistent request") {
    assert(is_valid(tbe));
    // Example: Schedule a wakeup event after a certain latency
    // This depends on how your specific gem5 version handles SLICC timers
    // enqueue(node_wakeup_network_out, NodeWakeupMsg, reissue_timeout) { ... }

    // Or if you use a direct timer table:
    //reissueTimerTable.set(address, clockEdge() + reissue_timeout);
  }

  action(j_unsetReissueTimer, "j", desc="Unset reissue timer.") {
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
  }

  action(jj_unsetUseTimer, "\j", desc="Unset use timer.") {
    if (useTimerTable.isSet(address)) {
      useTimerTable.unset(address);
    }
  }

  action(k_popMandatoryQueue, "k", desc="Pop mandatory queue.") {
    mandatoryQueue_in.dequeue(clockEdge());
  }

  action(l_popPersistentQueue, "l", desc="Pop persistent queue.") {
    persistentNetwork_in.dequeue(clockEdge());
  }

  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
