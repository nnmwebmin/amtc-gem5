machine(MachineType:L1Cache, "Token protocol")
 : Sequencer * sequencer;
   CacheMemory * L1Icache;
   CacheMemory * L1Dcache;
   int l2_select_num_bits;
   int N_tokens;

   Cycles l1_request_latency := 2;
   Cycles l1_response_latency := 2;
   int retry_threshold := 1;
   Cycles fixed_timeout_latency := 100;
   Cycles reissue_wakeup_latency := 10;
   Cycles use_timeout_latency := 50;

   bool dynamic_timeout_enabled := "True";
   bool no_mig_atomic := "True";
   bool send_evictions;

   // Message Queues
   // From this node's L1 cache TO the network

   // a local L1 -> this L2 bank
   MessageBuffer * responseFromL1Cache, network="To", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentFromL1Cache, network="To", virtual_network="3",
        vnet_type="persistent";
   // a local L1 -> this L2 bank, currently ordered with directory forwarded requests
   MessageBuffer * requestFromL1Cache, network="To", virtual_network="1",
        vnet_type="request";

   // To this node's L1 cache FROM the network

   // a L2 bank -> this L1
   MessageBuffer * responseToL1Cache, network="From", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentToL1Cache, network="From", virtual_network="3",
        vnet_type="persistent";
   // a L2 bank -> this L1
   MessageBuffer * requestToL1Cache, network="From", virtual_network="1",
        vnet_type="request";

   MessageBuffer * mandatoryQueue;
{
  // STATES
  state_declaration(State, desc="Cache states", default="L1Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, "NP", desc="Not Present";
    I, AccessPermission:Invalid, "I", desc="Idle";
    S, AccessPermission:Read_Only, "S", desc="Shared";
    O, AccessPermission:Read_Only, "O", desc="Owned";
    M, AccessPermission:Read_Only, "M", desc="Modified (dirty)";
    MM, AccessPermission:Read_Write, "MM", desc="Modified (dirty and locally modified)";
    M_W, AccessPermission:Read_Only, "M^W", desc="Modified (dirty), waiting";
    MM_W, AccessPermission:Read_Write, "MM^W", desc="Modified (dirty and locally modified), waiting";

    // Transient States
    IM, AccessPermission:Busy, "IM", desc="Issued GetX";
    SM, AccessPermission:Read_Only, "SM", desc="Issued GetX, we still have an old copy of the line";
    OM, AccessPermission:Read_Only, "OM", desc="Issued GetX, received data";
    IS, AccessPermission:Busy, "IS", desc="Issued GetS";

    // Locked states
    I_L, AccessPermission:Busy, "I^L", desc="Invalid, Locked";
    S_L, AccessPermission:Busy, "S^L", desc="Shared, Locked";
    IM_L, AccessPermission:Busy, "IM^L", desc="Invalid, Locked, trying to go to Modified";
    SM_L, AccessPermission:Busy, "SM^L", desc="Shared, Locked, trying to go to Modified";
    IS_L, AccessPermission:Busy, "IS^L", desc="Invalid, Locked, trying to go to Shared";

    // Transient States for Sector Misses
    S_IS, AccessPermission:Busy, "S_IS", desc="Shared, waiting for sector GETS";
    O_IS, AccessPermission:Busy, "O_IS", desc="Owned, waiting for sector GETS";
    M_IS, AccessPermission:Busy, "M_IS", desc="Modified, waiting for sector GETS";
    M_IM, AccessPermission:Busy, "M_IM", desc="Modified, waiting for sector GETX";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {
    Load,            desc="Load request from the processor";
    Ifetch,          desc="I-fetch request from the processor";
    Store,           desc="Store request from the processor";
    Atomic,          desc="Atomic request from the processor";
    L1_Replacement,  desc="L1 Replacement";

    // Responses
    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Data_All_Tokens,   desc="Received a data message, we are now the owner, we now have all the tokens";
    Ack,                     desc="Received an ack message";
    Ack_All_Tokens,          desc="Received an ack message, we now have all the tokens";

    // Requests
    Transient_GETX,  desc="A GetX from another processor";
    Transient_Local_GETX,  desc="A GetX from another processor";
    Transient_GETS,  desc="A GetS from another processor";
    Transient_Local_GETS,  desc="A GetS from another processor";
    Transient_GETS_Last_Token,  desc="A GetS from another processor";
    Transient_Local_GETS_Last_Token,  desc="A GetS from another processor";

    // Lock/Unlock for distributed
    Persistent_GETX,     desc="Another processor has priority to read/write";
    Persistent_GETS,     desc="Another processor has priority to read";
    Persistent_GETS_Last_Token, desc="Another processor has priority to read, no more tokens";
    Own_Lock_or_Unlock,  desc="This processor now has priority";

    // Triggers
    Request_Timeout,         desc="Timeout";
    Use_TimeoutStarverX,             desc="Timeout";
    Use_TimeoutStarverS,             desc="Timeout";
    Use_TimeoutNoStarvers,             desc="Timeout";
    Use_TimeoutNoStarvers_NoMig,     desc="Timeout Don't Migrate";

    Load_Sector_Miss,  desc="Load request for a missing sector";
    Store_Sector_Miss, desc="Store/Atomic request for a missing sector";
    Data_Shared_Partial, desc="A partial Data_Shared arrived";
    Data_Owner_Partial, desc="A partial Data_Owner arrived";

    // ADD THESE PHASE 2 EVENTS:
    Ack_Owner,              desc="Received an owner ack message (no data)";
    Ack_Owner_All_Tokens,   desc="Received an owner ack, we now have all tokens";

  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    int Tokens,              desc="The number of tokens we're holding for the line";
    DataBlock DataBlk,       desc="data for the block";

    // AMTC per-sector metadata for a 64B Ruby line split into 2 x 32B sectors.
    // These fields are metadata-only in the first CPU-only baseline; the
    // original line-token behavior remains authoritative until mask-native
    // transitions are enabled.
    int ValidSectors, default="0", desc="AMTC valid-sector mask; default full line";
    int DirtySectors, default="0", desc="AMTC dirty-sector mask";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";
      }



  // TBE fields
  structure(TBE, desc="...") {
    Addr addr,                      desc="Physical address for this TBE";
    State TBEState,                       desc="Transient state";
    int IssueCount,      default="0",     desc="The number of times we've issued a request for this line.";
    Addr PC,                           desc="Program counter of request";

    bool WentPersistent, default="false",  desc="Request went persistent";
    bool ExternalResponse, default="false", desc="Response came from an external controller";
    bool IsAtomic, default="false",       desc="Request was an atomic request";

    // AMTC TBE sector tracking. Defaults preserve full-line MOESI_CMP_token
    // behavior. Later CPU-sector work should narrow RequestedSectorMask to
    // one or more 32B sectors.
    int RequestedSectorMask, default="3", desc="AMTC requested sector mask";
    int ReceivedSectorMask, default="0", desc="AMTC sectors with data received";
    int TokenReadySectorMask, default="0", desc="AMTC sectors with token condition satisfied";
    int InstalledSectorMask, default="0", desc="AMTC sectors installed in cache";
    int RespondedSectorMask, default="0", desc="AMTC sectors responded upward";
    int LastSectorID, default="0", desc="AMTC primary sector id";
    bool HasOutstandingRequest, default="false", desc="AMTC live request pending";
    bool CallbackIssued, default="false", desc="AMTC sequencer callback issued";

    // Reserved GPU-ready fields. They are intentionally unused in the CPU-only
    // bring-up, but keep AMTC messages/TBEs compatible with future VIPER TCP/TCC.
    bool FromGPU, default="false", desc="Future GPU-originated request";
    bool IsSyncRequest, default="false", desc="Future coherent sync/fence/signal request";
    bool IsBypassRequest, default="false", desc="Future GPU bypass request";
    bool IsAtomicRequest, default="false", desc="Future atomic request";
    bool IsSignalRequest, default="false", desc="Future HSA signal/doorbell request";
    int CURequestor, default="0", desc="Future GPU CU id";
    int Wfid, default="0", desc="Future GPU wavefront id";
    int InstSeqNum, default="0", desc="Future GPU instruction sequence number";

    AccessType TypeOfAccess,
                desc="Type of request (used for profiling)";
    Cycles IssueTime,                       desc="Time the request was issued";
    RubyAccessMode AccessMode,    desc="user/supervisor access type";
    PrefetchBit Prefetch,         desc="Is this a prefetch request";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  structure(PersistentTable, external="yes") {
    void persistentRequestLock(Addr, MachineID, AccessType);
    void persistentRequestUnlock(Addr, MachineID);
    bool okToIssueStarving(Addr, MachineID);
    MachineID findSmallest(Addr);
    AccessType typeOfSmallest(Addr);
    void markEntries(Addr);
    bool isLocked(Addr);
    int countStarvingForAddress(Addr);
    int countReadStarvingForAddress(Addr);
  }

  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);
  Cycles curCycle();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  TBETable L1_TBEs, template="<L1Cache_TBE>", constructor="m_number_of_TBEs";

  bool starving, default="false";
  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  PersistentTable persistentTable;
  TimerTable useTimerTable;
  TimerTable reissueTimerTable;

  int outstandingRequests, default="0";
  int outstandingPersistentRequests, default="0";

  // Constant that provides hysteresis for calculated the estimated average
  int averageLatencyHysteresis, default="(8)";
  Cycles averageLatencyCounter,
        default="(Cycles(500) << (*m_averageLatencyHysteresis_ptr))";

  Cycles averageLatencyEstimate() {
    DPRINTF(RubySlicc, "%d\n",
            (averageLatencyCounter >> averageLatencyHysteresis));
    return averageLatencyCounter >> averageLatencyHysteresis;
  }

  void updateAverageLatencyEstimate(Cycles latency) {
    DPRINTF(RubySlicc, "%d\n", latency);

    // By subtracting the current average and then adding the most
    // recent sample, we calculate an estimate of the recent average.
    // If we simply used a running sum and divided by the total number
    // of entries, the estimate of the average would adapt very slowly
    // after the execution has run for a long time.
    // averageLatencyCounter := averageLatencyCounter - averageLatencyEstimate() + latency;

    averageLatencyCounter := averageLatencyCounter - averageLatencyEstimate() + latency;
  }

  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    if(is_valid(L1Dcache_entry)) {
      return L1Dcache_entry;
    }

    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  Entry getL1DCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache.lookup(addr));
    return L1Dcache_entry;
  }

  Entry getL1ICacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache.lookup(addr));
    return L1Icache_entry;
  }

  int getTokens(Entry cache_entry, int sid) {
    if (is_valid(cache_entry)) {
      if (sid == 0) {
        return cache_entry.TokensSec0;
      }
      if (sid == 1) {
        return cache_entry.TokensSec1;
      }
    }
    return 0;
  }

  // ----------------------------------------------------------------------
  // AMTC mask helpers for the trimmed prototype.
  // Physical Ruby block: 64B. Logical AMTC sectors: 2 x 32B.
  // sector_id 0 -> mask 1 (bytes 0..31), sector_id 1 -> mask 2
  // (bytes 32..63), full-line mask -> 3.
  // Keep field names unchanged so L2/Directory can still compile while the
  // L1 implementation avoids 4-sector metadata overhead.
  // ----------------------------------------------------------------------

  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_calculateNeededMask(int offset, int size) {
    if (size == 0) { return 0; }
    int end_offset := offset + size - 1;
    int mask := 0;
    if (offset < 32) { mask := mask + 1; }
    if ((offset < 64) && (end_offset >= 32)) { mask := mask + 2; }
    return mask;
  }

  int amtc_sanitizeMask(int mask) {
    // Accept old full-line defaults such as 15 from untrimmed controllers, but
    // collapse them to the two valid 32B sectors used by this L1.
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    // 64B Ruby line, 2 x 32B sectors.
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  bool amtc_isSectorAvailable(int valid_mask, Addr addr) {
    int req_sid := amtc_sectorFromAddr(addr);
    return amtc_maskHasSector(valid_mask, req_sid);
  }


  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else {
      if (persistentTable.isLocked(addr) &&
          (persistentTable.findSmallest(addr) != machineID)) {
        return State:I_L;
      } else {
        return State:NP;
      }
    }
  }


  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    assert((L1Dcache.isTagPresent(addr) && L1Icache.isTagPresent(addr)) == false);

    // =========================================================
    // TBE State Management (Unchanged)
    // =========================================================
    if (is_valid(tbe)) {
      assert(state != State:I);
      assert(state != State:S);
      assert(state != State:O);
      assert(state != State:MM);
      assert(state != State:M);
      tbe.TBEState := state;
    }

    if (is_valid(tbe)) {
      if (state != State:M && state != State:MM && state != State:O) {
        tbe.TBEState := state;
      }
    }

    // =========================================================
    // Cache Entry State & Phase 2 Token Math
    // =========================================================
    if (is_valid(cache_entry)) {

      // Basic sanity checks: No sector can have negative tokens
      assert(cache_entry.TokensSec0 >= 0);
      assert(cache_entry.TokensSec1 >= 0);

      // In AMTC, the whole line's max_tokens() is divided equally among sectors
      int tokens_per_sector := max_tokens() / 2;

      // ---------------------------------------------------------
      // Invalid / Locked / NP States
      // ---------------------------------------------------------
      if ((state == State:I_L) ||
          (state == State:IM_L) ||
          (state == State:IS_L) ||
          (state == State:NP)) {
        // Make sure we have absolutely no tokens
        assert(cache_entry.TokensSec0 == 0);
        assert(cache_entry.TokensSec1 == 0);

      } else if ((state == State:S_L) ||
                 (state == State:SM_L)) {
        // Shared-locked: must have at least one token for any valid sector
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 >= 1);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 >= 1);
        }
      }

      // ---------------------------------------------------------
      // Modified-like States (M, MM, M_W, MM_W)
      // ---------------------------------------------------------
      if (state == State:MM || state == State:M || state == State:MM_W || state == State:M_W) {
        // We must have at least one valid sector to be in a Modified state
        assert(cache_entry.ValidSectors != 0);
        DPRINTF(RubySlicc, "State=%d Valid=%x T0=%d T1=%d\n",
        state, cache_entry.ValidSectors,
        cache_entry.TokensSec0,
        cache_entry.TokensSec1);

        // If we hold 512 tokens for a sector, we are Modified for that sector.
        // If we hold < 512, it is a Shared/Invalid sector and should not crash a partial Modified state.

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
            // Only assert if we actually intended to be modified for Sector 0
            if (cache_entry.TokensSec0 > 1) {
                assert(cache_entry.TokensSec0 == tokens_per_sector);
            }
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
             // Only assert if we actually intended to be modified for Sector 1
            if (cache_entry.TokensSec1 > 1) {
                assert(cache_entry.TokensSec1 == tokens_per_sector);
            }
        }
    }

      // ---------------------------------------------------------
      // Shared-like States (S, SM)
      // ---------------------------------------------------------
      if (state == State:S || state == State:SM) {
        assert(cache_entry.ValidSectors != 0);

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      // ---------------------------------------------------------
      // Owned-like States (O, OM)
      // ---------------------------------------------------------
      if (state == State:O || state == State:OM) {
        assert(cache_entry.ValidSectors != 0);

        // Owner must hold tokens for its valid sectors
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := L1_TBEs[addr];
    if(is_valid(tbe)) {
      return L1Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L1Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L1Cache_State_to_permission(state));
    }
  }

  Event mandatory_request_type_to_event(RubyRequestType type) {
    if (type == RubyRequestType:LD) {
      return Event:Load;
    } else if (type == RubyRequestType:IFETCH) {
      return Event:Ifetch;
    } else if (type == RubyRequestType:ST) {
      return Event:Store;
    } else if (type == RubyRequestType:ATOMIC) {
      if (no_mig_atomic) {
        return Event:Atomic;
      } else {
        return Event:Store;
      }
    } else {
      error("Invalid RubyRequestType");
    }
  }

  AccessType cache_request_type_to_access_type(RubyRequestType type) {
    if ((type == RubyRequestType:LD) || (type == RubyRequestType:IFETCH)) {
      return AccessType:Read;
    } else if ((type == RubyRequestType:ST) || (type == RubyRequestType:ATOMIC)) {
      return AccessType:Write;
    } else {
      error("Invalid RubyRequestType");
    }
  }

  // NOTE: direct local hits should not call this function
  bool isExternalHit(Addr addr, MachineID sender) {
    if (machineIDToMachineType(sender) == MachineType:L1Cache) {
      return true;
    } else if (machineIDToMachineType(sender) == MachineType:L2Cache) {

      if (sender == mapAddressToRange(addr, MachineType:L2Cache,
                      l2_select_low_bit, l2_select_num_bits, intToID(0))) {
        return false;
      } else {
        return  true;
      }
    }

    return true;
  }

  bool okToIssueStarving(Addr addr, MachineID machineID) {
    return persistentTable.okToIssueStarving(addr, machineID);
  }

  void markPersistentEntries(Addr addr) {
    persistentTable.markEntries(addr);
  }

  void setExternalResponse(TBE tbe) {
    assert(is_valid(tbe));
    tbe.ExternalResponse := true;
  }

  bool IsAtomic(TBE tbe) {
    assert(is_valid(tbe));
    return tbe.IsAtomic;
  }

  // ** OUT_PORTS **
  out_port(persistentNetwork_out, PersistentMsg, persistentFromL1Cache);
  out_port(requestNetwork_out, RequestMsg, requestFromL1Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL1Cache);
  out_port(requestRecycle_out, RequestMsg, requestToL1Cache);

  // ** IN_PORTS **

  // Use Timer
  in_port(useTimerTable_in, Addr, useTimerTable, rank=5) {
    if (useTimerTable_in.isReady(clockEdge())) {
      Addr readyAddress := useTimerTable.nextAddress();
      TBE tbe := L1_TBEs.lookup(readyAddress);

      if (persistentTable.isLocked(readyAddress) &&
          (persistentTable.findSmallest(readyAddress) != machineID)) {
        if (persistentTable.typeOfSmallest(readyAddress) == AccessType:Write) {
          trigger(Event:Use_TimeoutStarverX, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutStarverS, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      } else {
        if (no_mig_atomic && IsAtomic(tbe)) {
          trigger(Event:Use_TimeoutNoStarvers_NoMig, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        } else {
          trigger(Event:Use_TimeoutNoStarvers, readyAddress,
                  getCacheEntry(readyAddress), tbe);
        }
      }
    }
  }

  // Reissue Timer
  in_port(reissueTimerTable_in, Addr, reissueTimerTable, rank=4) {
    Tick current_time := clockEdge();
    if (reissueTimerTable_in.isReady(current_time)) {
      Addr addr := reissueTimerTable.nextAddress();
      trigger(Event:Request_Timeout, addr, getCacheEntry(addr),
              L1_TBEs.lookup(addr));
    }
  }

  // Persistent Network
  in_port(persistentNetwork_in, PersistentMsg, persistentToL1Cache, rank=3) {
    if (persistentNetwork_in.isReady(clockEdge())) {
      peek(persistentNetwork_in, PersistentMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        // Apply the lockdown or unlockdown message to the table
        if (in_msg.Type == PersistentRequestType:GETX_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Write);
        } else if (in_msg.Type == PersistentRequestType:GETS_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Read);
        } else if (in_msg.Type == PersistentRequestType:DEACTIVATE_PERSISTENT) {
          persistentTable.persistentRequestUnlock(in_msg.addr, in_msg.Requestor);
        } else {
          error("Unexpected message");
        }

        // React to the message based on the current state of the table
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (persistentTable.isLocked(in_msg.addr)) {
          if (persistentTable.findSmallest(in_msg.addr) == machineID) {
            // Our Own Lock - this processor is highest priority
            trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                    cache_entry, tbe);
          } else {
            if (persistentTable.typeOfSmallest(in_msg.addr) == AccessType:Read) {
              if (getTokens(cache_entry, amtc_fullMask()) == 1 ||
                  getTokens(cache_entry, amtc_fullMask()) == (max_tokens() / 2) + 1) {
                trigger(Event:Persistent_GETS_Last_Token, in_msg.addr,
                        cache_entry, tbe);
              } else {
                trigger(Event:Persistent_GETS, in_msg.addr,
                        cache_entry, tbe);
              }
            } else {
              trigger(Event:Persistent_GETX, in_msg.addr,
                      cache_entry, tbe);
            }
          }
        } else {
          // Unlock case - no entries in the table
          trigger(Event:Own_Lock_or_Unlock, in_msg.addr,
                  cache_entry, tbe);
        }
      }
    }
  }

  // Response Network
  in_port(responseNetwork_in, ResponseMsg, responseToL1Cache, rank=2) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        // =====================================================================
        // 1. LATENCY PROFILING (Standard gem5 bookkeeping)
        // =====================================================================
        if ( machineIDToMachineType(in_msg.Sender) == MachineType:L2Cache ) {
          if (in_msg.Sender == mapAddressToRange(in_msg.addr,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0))) {
            // came from an off-chip L2 cache
            if (is_valid(tbe)) {
               // L1_TBEs[in_msg.addr].ExternalResponse := true;
               // profile_offchipL2_response(in_msg.addr);
            }
          } else {
               // profile_onchipL2_response(in_msg.addr );
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:Directory ) {
          if (is_valid(tbe)) {
            setExternalResponse(tbe);
            // profile_memory_response( in_msg.addr);
          }
        } else if ( machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
          // Local/Off-chip L1 profiling can go here
        } else {
          error("unexpected SenderMachine");
        }

        // =====================================================================
        // 2. SECTOR COMPLETION CHECK (AMTC Architecture)
        // =====================================================================
        bool is_complete := true;
        if (is_valid(tbe)) {
            int current_valid := 0;
            if (is_valid(cache_entry)) {
                current_valid := cache_entry.ValidSectors;
            }

            // What requested bytes did this specific packet bring?
            int incoming_valid := amtc_intersectMasks(in_msg.valid_sector_mask, tbe.RequestedSectorMask);

            // What will our cache hold after we merge it?
            int future_valid := amtc_unionMasks(current_valid, incoming_valid);

            // Have we satisfied every sector the CPU asked for?
            if (amtc_intersectMasks(future_valid, tbe.RequestedSectorMask) != tbe.RequestedSectorMask) {
                is_complete := false;
            }
        }

// =====================================================================
        // 3. TRUE SECTOR TOKEN COUNTING & EVENT ROUTING (Phase 2 Upgrade)
        // =====================================================================
        bool is_effectively_all_tokens := true;

        if (is_valid(tbe)) {
            // Step A: Predict exactly how many tokens we will hold after merging
            int future_t0 := in_msg.TokensSec0;
            int future_t1 := in_msg.TokensSec1;

            if (is_valid(cache_entry)) {
                future_t0 := future_t0 + cache_entry.TokensSec0;
                future_t1 := future_t1 + cache_entry.TokensSec1;
            }

            // Step B: In this architecture, max_tokens() is the whole line.
            // Therefore, 100% ownership of ONE sector is exactly (max_tokens() / 2).
            int required_per_sector := max_tokens() / 2;

            // Step C: Strictly evaluate ONLY the sectors the CPU requested
            if (amtc_maskHasSector(tbe.RequestedSectorMask, 0)) {
                if (future_t0 < required_per_sector) {
                    is_effectively_all_tokens := false;
                }
            }

            if (amtc_maskHasSector(tbe.RequestedSectorMask, 1)) {
                if (future_t1 < required_per_sector) {
                    is_effectively_all_tokens := false;
                }
            }
        } else {
            // If there's no TBE, this is a stale or background packet.
            // We safely route it to standard Ack/Data_Shared for absorption.
            is_effectively_all_tokens := false;
        }

        // =====================================================================
        // EVENT ROUTING (Unchanged, but now protected by true sector math!)
        // =====================================================================
        if (in_msg.Type == CoherenceResponseType:ACK) {
          if (is_effectively_all_tokens) {
            trigger(Event:Ack_All_Tokens, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
          }

        } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER) {
          // MISSING BRANCH ADDED HERE
          if (is_effectively_all_tokens) {
            trigger(Event:Ack_Owner_All_Tokens, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Ack_Owner, in_msg.addr, cache_entry, tbe);
          }

        } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
                   in_msg.Type == CoherenceResponseType:DATA_SHARED) {

          if (!is_complete) {
            if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
              trigger(Event:Data_Owner_Partial, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:Data_Shared_Partial, in_msg.addr, cache_entry, tbe);
            }
          } else if (is_effectively_all_tokens) {
            // Mathematical Perfection: The data is complete AND we independently
            // secured all tokens for every requested sector! Wake the CPU!
            trigger(Event:Data_All_Tokens, in_msg.addr, cache_entry, tbe);
          } else {
            if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
              trigger(Event:Data_Owner, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:Data_Shared, in_msg.addr, cache_entry, tbe);
            }
          }

        } else {
          error("Unexpected message type received in L1 response network");
        }
      }
    }
  }

  // Request Network
  in_port(requestNetwork_in, RequestMsg, requestToL1Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := L1_TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceRequestType:GETX) {
          if (in_msg.isLocal) {
            trigger(Event:Transient_Local_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
          else {
            trigger(Event:Transient_GETX, in_msg.addr,
                    cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          if (getTokens(cache_entry,amtc_fullMask()) == 1 ||
              getTokens(cache_entry,amtc_fullMask()) == (max_tokens() / 2) + 1) {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS_Last_Token, in_msg.addr,
                      cache_entry, tbe);
            }
          }
          else {
            if (in_msg.isLocal) {
              trigger(Event:Transient_Local_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
            else {
              trigger(Event:Transient_GETS, in_msg.addr,
                      cache_entry, tbe);
            }
          }
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  // Mandatory Queue
  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...", rank=0) {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest, block_on="LineAddress") {

        TBE tbe := L1_TBEs[in_msg.LineAddress];
        int req_offset := getOffset(in_msg.PhysicalAddress);
        int needed_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);

        if (in_msg.Type == RubyRequestType:IFETCH) {
          Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
          if (is_valid(L1Icache_entry)) {
            // SECTOR AWARE: Check if ALL requested bytes reside in valid sectors
            if (amtc_intersectMasks(L1Icache_entry.ValidSectors, needed_mask) != needed_mask) {
              trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            }
          } else {
            // Standard Line Miss Logic (Unchanged)
            Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
            if (is_valid(L1Dcache_entry)) {
                trigger(Event:L1_Replacement, in_msg.LineAddress, L1Dcache_entry, tbe);
            }
            if (L1Icache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Icache_entry, tbe);
            } else {
              Addr victim := L1Icache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1ICacheEntry(victim), L1_TBEs[victim]);
            }
          }
        } else {
          // DATA BRANCH (LD, ST, ATOMIC)
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            // CRITICAL FIX: Use needed_mask here too to prevent unaligned access bugs!
            if (amtc_intersectMasks(L1Dcache_entry.ValidSectors, needed_mask) != needed_mask) {
                if (in_msg.Type == RubyRequestType:LD) {
                    trigger(Event:Load_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
                } else {
                    trigger(Event:Store_Sector_Miss, in_msg.LineAddress, L1Dcache_entry, tbe);
                }
            } else {
                trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            }
          } else {
            // Standard Line Miss Logic (Unchanged)
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) {
              trigger(Event:L1_Replacement, in_msg.LineAddress, L1Icache_entry, tbe);
            }
            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress, L1Dcache_entry, tbe);
            } else {
              Addr victim := L1Dcache.cacheProbe(in_msg.LineAddress);
              trigger(Event:L1_Replacement, victim, getL1DCacheEntry(victim), L1_TBEs[victim]);
            }
          }
        }
      }
    }
  }

  // ACTIONS
action(a_issueReadRequest, "a", desc="Issue GETS") {
      assert(is_valid(tbe));
      if (tbe.IssueCount == 0) {
        outstandingRequests := outstandingRequests + 1;
      }

      if (tbe.IssueCount >= retry_threshold) {
        // Issue a persistent request if possible
        if (okToIssueStarving(address, machineID) && (starving == false)) {
          enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Type := PersistentRequestType:GETS_PERSISTENT;
            out_msg.Requestor := machineID;
            out_msg.Destination.broadcast(MachineType:L1Cache);
            out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
            out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
            out_msg.MessageSize := MessageSizeType:Persistent_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
            // Notice: No is_owner_pull here!
          }
          markPersistentEntries(address);
          starving := true;

          outstandingPersistentRequests := outstandingPersistentRequests + 1;
          tbe.IssueCount := tbe.IssueCount + 1;
          tbe.WentPersistent := true;
        }
        else {
          // Set a wakeup timer
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(reissue_wakeup_latency));
        }
      } else {
        // ------------------------------------------------------------------
        // ENQUEUE 1: Send to L2 / Directory
        // ------------------------------------------------------------------
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

          out_msg.RetryNum := tbe.IssueCount;
          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Request_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Reissue_Control;
          }
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // is_owner_pull is safely applied here to the RequestMsg
          if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
              out_msg.is_owner_pull := true;
          } else {
              out_msg.is_owner_pull := false;
          }
        }

        // ------------------------------------------------------------------
        // ENQUEUE 2: Broadcast to other local L1s
        // ------------------------------------------------------------------
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          out_msg.Destination.broadcast(MachineType:L1Cache);
          out_msg.Destination.remove(machineID);

          out_msg.RetryNum := tbe.IssueCount;
          out_msg.isLocal := true;
          out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;

          // is_owner_pull is safely applied here to the RequestMsg
          if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
              out_msg.is_owner_pull := true;
          } else {
              out_msg.is_owner_pull := false;
          }
        }

        tbe.IssueCount := tbe.IssueCount + 1;

        if (dynamic_timeout_enabled) {
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
        } else {
          reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
        }
      }
  }

  action(b_issueWriteRequest, "b", desc="Issue GETX") {

      assert(is_valid(tbe));
      if (tbe.IssueCount == 0) {
        // Update outstanding requests
        //profile_outstanding_request(outstandingRequests);
        outstandingRequests := outstandingRequests + 1;
      }

      if (tbe.IssueCount >= retry_threshold) {
        // Issue a persistent request if possible
        if ( okToIssueStarving(address, machineID) && (starving == false)) {
          enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
            out_msg.addr := address;
            out_msg.Type := PersistentRequestType:GETX_PERSISTENT;
            out_msg.Requestor := machineID;
            out_msg.Destination.broadcast(MachineType:L1Cache);

            //
            // Currently the configuration system limits the system to only one
            // chip.  Therefore, if we assume one shared L2 cache, then only one
            // pertinent L2 cache exist.
            //
            //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));

            out_msg.Destination.add(mapAddressToRange(address,
                                      MachineType:L2Cache, l2_select_low_bit,
                                      l2_select_num_bits, intToID(0)));

            out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
            out_msg.MessageSize := MessageSizeType:Persistent_Control;
            out_msg.Prefetch := tbe.Prefetch;
            out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          }
          markPersistentEntries(address);
          starving := true;

          // Update outstanding requests
          //profile_outstanding_persistent_request(outstandingPersistentRequests);
          outstandingPersistentRequests := outstandingPersistentRequests + 1;

          if (tbe.IssueCount == 0) {
            //profile_persistent_prediction(address, tbe.TypeOfAccess);
          }

          // Increment IssueCount
          tbe.IssueCount := tbe.IssueCount + 1;

          tbe.WentPersistent := true;

          // Do not schedule a wakeup, a persistent requests will always complete
        }
        else {

          // We'd like to issue a persistent request, but are not allowed
          // to issue a P.R. right now.  This, we do not increment the
          // IssueCount.

          // Set a wakeup timer
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(reissue_wakeup_latency));
        }

      } else  {
        // Make a normal request
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;

          out_msg.Destination.add(mapAddressToRange(address,
                                    MachineType:L2Cache, l2_select_low_bit,
                                    l2_select_num_bits, intToID(0)));

          out_msg.RetryNum := tbe.IssueCount;

          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Request_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Reissue_Control;
          }
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
        }

        // send to other local L1s too
        enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;
          out_msg.isLocal := true;

          //
          // Since only one chip, assuming all L1 caches are local
          //
          //out_msg.Destination := getOtherLocalL1IDs(machineID);
          out_msg.Destination.broadcast(MachineType:L1Cache);
          out_msg.Destination.remove(machineID);

          out_msg.RetryNum := tbe.IssueCount;
          if (tbe.IssueCount == 0) {
            out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          } else {
            out_msg.MessageSize := MessageSizeType:Broadcast_Control;
          }
          out_msg.Prefetch := tbe.Prefetch;
          out_msg.AccessMode := tbe.AccessMode;
          out_msg.sector_id := tbe.LastSectorID;
          out_msg.sector_mask := tbe.RequestedSectorMask;
          out_msg.requested_sector_mask := tbe.RequestedSectorMask;
          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := tbe.IsAtomic;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
        }

        // Increment IssueCount
        tbe.IssueCount := tbe.IssueCount + 1;

        DPRINTF(RubySlicc, "incremented issue count to %d\n",
                tbe.IssueCount);

        // Set a wakeup timer
        if (dynamic_timeout_enabled) {
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
        } else {
          reissueTimerTable.set(
            address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
        }
      }
  }

  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := in_msg.Dirty;
      }
    }
  }

  action(c_ownedReplacement, "c", desc="Issue writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address,
                                MachineType:L2Cache, l2_select_low_bit,
                                l2_select_num_bits, intToID(0)));

      // SECTOR AWARE: Prefer DirtySectors for the payload size.
      // Fallback to ValidSectors if we are just doing a capacity eviction of clean data.
      int wb_mask := cache_entry.DirtySectors;
      if (wb_mask == 0) {
        wb_mask := cache_entry.ValidSectors;
      }
      if (wb_mask == 0) {
        wb_mask := amtc_fullMask(); // Safety fallback
      }

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.valid_sector_mask := wb_mask;
      out_msg.token_sector_mask := wb_mask;
      out_msg.requested_sector_mask := wb_mask;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Type := CoherenceResponseType:WB_OWNED;
      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;

      // SECTOR AWARE: Dynamically shrink the NoC packet!
      out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
    }
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(cc_sharedReplacement, "\c", desc="Issue shared writeback") {
    assert(is_valid(cache_entry));
    assert (cache_entry.Tokens > 0);
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) {
          wb_mask := amtc_fullMask();
        }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := wb_mask;
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;

        // ADD THIS MISSING LINE:
        out_msg.DataBlk := cache_entry.DataBlk;

        out_msg.Dirty := false;
        out_msg.Type := CoherenceResponseType:WB_SHARED_DATA;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);

        out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
    }
    cache_entry.Tokens := 0;
  }

  action(tr_tokenReplacement, "tr", desc="Issue token writeback") {
    assert(is_valid(cache_entry));
    if (cache_entry.Tokens > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));
        out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;

        // SECTOR AWARE: Track which sectors these returned tokens belong to
        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) {
          wb_mask := amtc_fullMask();
        }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := 0; // 0 because no data payload is sent
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;

        // Maintain the tiny 8-byte control size
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
      }
    }
    cache_entry.Tokens := 0;
  }


  action(d_sendDataWithToken, "d", desc="Send data and a token from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        //out_msg.Tokens := 1;
        out_msg.DataBlk := cache_entry.DataBlk;
        // out_msg.Dirty := cache_entry.Dirty;
        out_msg.Dirty := false;
        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          out_msg.MessageSize := MessageSizeType:Response_Data;
        }
      }
    }
    cache_entry.Tokens := cache_entry.Tokens - 1;
    assert(cache_entry.Tokens >= 1);
  }

  action(d_sendDataWithNTokenIfAvail, "\dd", desc="Send data and a token from cache to requestor") {
    assert(is_valid(cache_entry));
    int tokens_per_sector := max_tokens() / 2;
    peek(requestNetwork_in, RequestMsg) {
      if (cache_entry.Tokens > (N_tokens + (max_tokens() / 2))) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
          out_msg.DataBlk := cache_entry.DataBlk;
          // out_msg.Dirty := cache_entry.Dirty;
          out_msg.Dirty := false;
          if (in_msg.isLocal) {
            out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
          } else {
            out_msg.MessageSize := MessageSizeType:Response_Data;
          }
        }
        cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := cache_entry.TokensSec1 - N_tokens;
        if (cache_entry.TokensSec1 < tokens_per_sector) {
            cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 2);
        }
      }
      else if (cache_entry.Tokens > 1) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := 1;
      out_msg.TokensSec1 := 1;
          out_msg.DataBlk := cache_entry.DataBlk;
          // out_msg.Dirty := cache_entry.Dirty;
          out_msg.Dirty := false;
          if (in_msg.isLocal) {
            out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
          } else {
            out_msg.MessageSize := MessageSizeType:Response_Data;
          }
        }
        cache_entry.Tokens := cache_entry.Tokens - 1;
      }
    }
//    assert(cache_entry.Tokens >= 1);
  }

action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        // ... (existing addressing) ...

        out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;

        // SECTOR AWARE COPY: Only send what we actually have!
        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        out_msg.valid_sector_mask := cache_entry.ValidSectors;

        if (in_msg.isLocal) {
          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
        } else {
          // CRITICAL FIX: Shrink the NoC packet if we only have 1 sector!
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(cache_entry.ValidSectors);
        }
      }
    }
    cache_entry.Tokens := 0;
  }

  action(e_sendAckWithCollectedTokens, "e", desc="Send ack with the tokens we've collected thus far.") {
    // assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
    assert(is_valid(cache_entry));
    if (cache_entry.Tokens > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        int expected_tokens := amtc_expectedTokensForMask(cache_entry.ValidSectors);
        if (cache_entry.Tokens > (expected_tokens / 2)){
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
        } else {
          out_msg.Type := CoherenceResponseType:ACK;
        }
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
        assert(cache_entry.Tokens >= 1);
        out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
    cache_entry.Tokens := 0;
  }

  action(ee_sendDataWithAllTokens, "\e", desc="Send data and all tokens from cache to starver") {
    //assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
    assert(is_valid(cache_entry));
    assert(cache_entry.Tokens > 0);
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(persistentTable.findSmallest(address));
      int expected_tokens := amtc_expectedTokensForMask(cache_entry.ValidSectors);
      assert(cache_entry.Tokens == expected_tokens);
      out_msg.TokensSec0 := cache_entry.TokensSec0;
      out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    cache_entry.Tokens := 0;
  }

  action(f_sendAckWithAllButNorOneTokens, "f", desc="Send ack with all our tokens but one to starver.") {
    //assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
    assert(is_valid(cache_entry));
    assert(cache_entry.Tokens > 0);
    if (cache_entry.Tokens > 1) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        int expected_tokens := amtc_expectedTokensForMask(cache_entry.ValidSectors);
        if ((cache_entry.Tokens > (expected_tokens / 2))) {
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
        } else {
          out_msg.Type := CoherenceResponseType:ACK;
        }
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
        assert(cache_entry.Tokens >= 1);
        if (cache_entry.TokensSec0 > N_tokens) {
          out_msg.TokensSec0 := cache_entry.TokensSec0 - N_tokens;

      out_msg.TokensSec1 := cache_entry.TokensSec1 -N_tokens;
        } else {
          out_msg.TokensSec0 := cache_entry.TokensSec0 -1;
      out_msg.TokensSec1 := cache_entry.TokensSec1 -1;
        }
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }

  }

  action(ff_sendDataWithAllButNorOneTokens, "\f", desc="Send data and out tokens but one to starver") {
    //assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
    assert(is_valid(cache_entry));
    assert(cache_entry.Tokens > ((max_tokens() / 2) + 1));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
out_msg.TokensSec0 := cache_entry.TokensSec0;
out_msg.TokensSec1 := cache_entry.TokensSec1;

        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    if (cache_entry.Tokens > (N_tokens + (max_tokens() / 2))) {
      cache_entry.Tokens := N_tokens;
    } else {
      cache_entry.Tokens := 1;
    }
  }

  action(fo_sendDataWithOwnerToken, "fo", desc="Send data and owner tokens") {
    assert(is_valid(cache_entry));
    assert(cache_entry.Tokens == ((max_tokens() / 2) + 1));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
        out_msg.TokensSec0 := cache_entry.TokensSec0;
out_msg.TokensSec1 := cache_entry.TokensSec1;

        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    cache_entry.Tokens := 0;
  }

  action(g_bounceResponseToStarver, "g", desc="Redirect response to starving processor") {
    // assert(persistentTable.isLocked(address));

    peek(responseNetwork_in, ResponseMsg) {
      // assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
      // FIXME, should use a 3rd vnet in some cases
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
       out_msg.TokensSec0 := cache_entry.TokensSec0;
out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := in_msg.Dirty;
        out_msg.MessageSize := in_msg.MessageSize;
      }
    }
  }

action(h_load_hit, "hd", desc="CPU load hit (sector-aware)") {
    assert(is_valid(cache_entry));

    // 1. Handle Callback: Is the SPECIFIC sector the CPU wants valid?
    if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
      L1Dcache.setMRU(cache_entry);
      sequencer.readCallback(address, cache_entry.DataBlk, false,
                             MachineType:L1Cache);
    }

    // 2. Handle Missing Sectors: Is the rest of the line incomplete?
    if (cache_entry.ValidSectors != amtc_fullMask()) {
      DPRINTF(RubySlicc, "Partial valid sector hit. Requesting missing sectors for addr %#x\n", address);
      // trigger(Event:LoadMiss, address, cache_entry, tbe);
      // (Or enqueue a GETS for the missing mask here)
    }
  }

  action(h_ifetch_hit, "hi", desc="CPU ifetch hit (sector-aware)") {
    assert(is_valid(cache_entry));

    // 1. Handle Callback
    if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
      L1Icache.setMRU(cache_entry);
      sequencer.readCallback(address, cache_entry.DataBlk, false,
                             MachineType:L1Cache);
    }

    // 2. Handle Missing Sectors
    if (cache_entry.ValidSectors != amtc_fullMask()) {
      DPRINTF(RubySlicc, "Partial ifetch hit. Requesting missing sectors for addr %#x\n", address);
      // trigger(Event:IfetchMiss, address, cache_entry, tbe);
    }
  }

  action(hh_store_hit, "\\h", desc="CPU store hit (sector-aware)") {
    assert(is_valid(cache_entry));

    // 1. Handle Callback (Only write if we own the target sector)
    if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
      L1Dcache.setMRU(cache_entry);
      sequencer.writeCallback(address, cache_entry.DataBlk, false,
                              MachineType:L1Cache);
      cache_entry.Dirty := true;

      peek(mandatoryQueue_in, RubyRequest) {
        int store_mask := amtc_singleSectorMaskFromAddr(in_msg.PhysicalAddress);
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, store_mask);
      }
    }

    // 2. Handle Missing Sectors
    if (cache_entry.ValidSectors != amtc_fullMask()) {
      DPRINTF(RubySlicc, "Partial store hit. Requesting missing sectors for addr %#x\n", address);
      // trigger(Event:StoreMiss, address, cache_entry, tbe);
      // (Or enqueue a GETX for the missing mask here)
    }
  }

  action(x_external_load_hit, "x", desc="External load completion (sector-aware)") {
    assert(is_valid(cache_entry));

    peek(responseNetwork_in, ResponseMsg) {

      // 1. Wake the CPU if the response brought the sector we need
      if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
        L1Icache.setMRU(address);
        L1Dcache.setMRU(address);

        sequencer.readCallback(address, cache_entry.DataBlk,
                               isExternalHit(address, in_msg.Sender),
                               machineIDToMachineType(in_msg.Sender));
      }

      // 2. Did this response leave us with remaining missing sectors?
      if (cache_entry.ValidSectors != amtc_fullMask()) {
        DPRINTF(RubySlicc, "External response still partial. Requesting missing sectors for %#x\n", address);
        // trigger(Event:LoadMiss, address, cache_entry, tbe);
      }
    }
  }

  action(xx_external_store_hit, "\\x", desc="External store completion (sector-aware)") {
    assert(is_valid(cache_entry));

    peek(responseNetwork_in, ResponseMsg) {

      // 1. Wake the CPU if the response brought the sector we need to write to
      if (amtc_isSectorAvailable(cache_entry.ValidSectors, address)) {
        L1Icache.setMRU(address);
        L1Dcache.setMRU(address);

        sequencer.writeCallback(address, cache_entry.DataBlk,
                                isExternalHit(address, in_msg.Sender),
                                machineIDToMachineType(in_msg.Sender));

        cache_entry.Dirty := true;
        if (is_valid(tbe)) {
          cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, tbe.RequestedSectorMask);
        }
      }

      // 2. Do we still need to fetch other sectors for this line?
      if (cache_entry.ValidSectors != amtc_fullMask()) {
        DPRINTF(RubySlicc, "External store response still partial. Requesting missing sectors for %#x\n", address);
        // trigger(Event:StoreMiss, address, cache_entry, tbe);
      }
    }
  }


  action(initTBERequestTracking, "irt", desc="Initialize AMTC sector tracking") {
    peek(mandatoryQueue_in, RubyRequest) {
      int req_sid := amtc_sectorFromAddr(in_msg.PhysicalAddress);
      int req_mask := amtc_maskFromSector(req_sid);

      tbe.RequestedSectorMask := req_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := req_sid;
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.FromGPU := false;

      DPRINTF(RubySlicc,
        "AMTC_L1_TBE_INIT addr=%#x line=%#x sid=%d mask=%d\n",
        in_msg.LineAddress, address, req_sid, req_mask);
    }
  }

action(i_allocateTBE, "i", desc="Allocate TBE") {
    check_allocate(L1_TBEs);
    L1_TBEs.allocate(address);
    set_tbe(L1_TBEs[address]);
    tbe.IssueCount := 0;

    peek(mandatoryQueue_in, RubyRequest) {
      tbe.PC := in_msg.ProgramCounter;
      tbe.TypeOfAccess := cache_request_type_to_access_type(in_msg.Type);
      if (in_msg.Type == RubyRequestType:ATOMIC) {
        tbe.IsAtomic := true;
      }
      tbe.Prefetch := in_msg.Prefetch;
      tbe.AccessMode := in_msg.AccessMode;

      // =========================================================
      // AMTC MIXED-MODE FETCH LOGIC
      // =========================================================
      int req_offset := getOffset(in_msg.PhysicalAddress);
      int req_mask := amtc_calculateNeededMask(req_offset, in_msg.Size);

      if (in_msg.Type == RubyRequestType:IFETCH) {
          req_mask := amtc_fullMask();
      }

      tbe.RequestedSectorMask := req_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.InstalledSectorMask := 0;
      tbe.RespondedSectorMask := 0;
      tbe.LastSectorID := amtc_primarySectorFromMask(req_mask);
      tbe.HasOutstandingRequest := true;
      tbe.CallbackIssued := false;
      tbe.FromGPU := false;
      tbe.IsSyncRequest := false;
      tbe.IsBypassRequest := false;
      tbe.IsAtomicRequest := tbe.IsAtomic;
      tbe.IsSignalRequest := false;
      tbe.CURequestor := 0;
      tbe.Wfid := 0;
      tbe.InstSeqNum := 0;
      tbe.IssueTime := curCycle();
    }
  }

  action(ta_traceStalledAddress, "ta", desc="Trace Stalled Address") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
  }

  action(j_unsetReissueTimer, "j", desc="Unset reissue timer.") {
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
  }

  action(jj_unsetUseTimer, "\j", desc="Unset use timer.") {
    useTimerTable.unset(address);
  }

  action(k_popMandatoryQueue, "k", desc="Pop mandatory queue.") {
    mandatoryQueue_in.dequeue(clockEdge());
  }

  action(l_popPersistentQueue, "l", desc="Pop persistent queue.") {
    persistentNetwork_in.dequeue(clockEdge());
  }

  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(n_popResponseQueue, "n", desc="Pop response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(o_scheduleUseTimeout, "o", desc="Schedule a use timeout.") {
    useTimerTable.set(
        address, clockEdge() + cyclesToTicks(use_timeout_latency));
  }

  action(p_informL2AboutTokenLoss, "p", desc="Inform L2 about loss of all tokens") {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
       out_msg.addr := address;
       out_msg.Type := CoherenceResponseType:INV;
       out_msg.TokensSec0 := 0;
out_msg.TokensSec1 := 0;
       out_msg.Sender := machineID;

       out_msg.Destination.add(mapAddressToRange(address,
                                 MachineType:L2Cache, l2_select_low_bit,
                                 l2_select_num_bits, intToID(0)));
       out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(q_updateTokensFromResponse, "q", desc="Update token count based on response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      int tokens_per_sector := max_tokens() / 2;

      // --- 1. Update tokens ---
      cache_entry.TokensSec0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      // --- 2. Dirty handling (fine as is) ---
      if (in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }

      // --- 3. CRITICAL: Recompute ValidSectors from tokens ---
      int new_valid := 0;

      if (cache_entry.TokensSec0 == tokens_per_sector) {
          new_valid := amtc_unionMasks(new_valid, 1);
      }

      if (cache_entry.TokensSec1 == tokens_per_sector) {
          new_valid := amtc_unionMasks(new_valid, 2);
      }

      cache_entry.ValidSectors := new_valid;
    }
  }

action(amtc_completeIfAlreadyOwnsSector, "aco",
       desc="Complete upgrade if sector tokens are already locally owned") {
    if (is_valid(cache_entry)) {
      int expected := amtc_expectedTokensForMask(cache_entry.ValidSectors);
      DPRINTF(RubySlicc,
        "AMTC_L1_COMPLETE_OWNED_SECTOR addr=%#x tokens=%d valid=%d expected=%d\n",
        address, cache_entry.Tokens, cache_entry.ValidSectors, expected);

      // 1. CRITICAL FIX: Relax the token assertion for heterogeneous states
      // assert(cache_entry.Tokens == expected);
      assert(cache_entry.Tokens > 0);
      assert(cache_entry.Tokens <= max_tokens());

      // 2. CRITICAL FIX: Only upgrade the requested sector to Dirty!
      // Do not accidentally mark read-only Shared sectors as dirty.
      int upgrade_mask := cache_entry.ValidSectors;
      if (is_valid(tbe)) {
          upgrade_mask := amtc_intersectMasks(cache_entry.ValidSectors, tbe.RequestedSectorMask);
      }

      cache_entry.DirtySectors :=
        amtc_unionMasks(cache_entry.DirtySectors, upgrade_mask);
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {

    assert(is_valid(tbe));
    if (tbe.WentPersistent) {
      // assert(starving);
      outstandingRequests := outstandingRequests - 1;
      enqueue(persistentNetwork_out, PersistentMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := PersistentRequestType:DEACTIVATE_PERSISTENT;
        out_msg.Requestor := machineID;
        out_msg.Destination.broadcast(MachineType:L1Cache);

        //
        // Currently the configuration system limits the system to only one
        // chip.  Therefore, if we assume one shared L2 cache, then only one
        // pertinent L2 cache exist.
        //
        //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));

        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Persistent_Control;
      }
      starving := false;
    }

    // Update average latency
    if (tbe.IssueCount <= 1) {
      if (tbe.ExternalResponse) {
        updateAverageLatencyEstimate(curCycle() - tbe.IssueTime);
      }
    }

    // Profile
    //if (tbe.WentPersistent) {
    //  profile_token_retry(address, tbe.TypeOfAccess, 2);
    //}
    //else {
    //  profile_token_retry(address, tbe.TypeOfAccess, 1);
    //}

    //profile_token_retry(address, tbe.TypeOfAccess, tbe.IssueCount);
    L1_TBEs.deallocate(address);
    unset_tbe();
  }

  action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));
    if (cache_entry.Tokens > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
          out_msg.addr := address;
          int expected_tokens := amtc_expectedTokensForMask(cache_entry.ValidSectors);
          if ( (cache_entry.Tokens > (expected_tokens / 2))) {
            out_msg.Type := CoherenceResponseType:DATA_OWNER;
          } else {
            out_msg.Type := CoherenceResponseType:ACK;
          }
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          assert(cache_entry.Tokens >= 1);
          out_msg.TokensSec0 := cache_entry.TokensSec0;
out_msg.TokensSec1 := cache_entry.TokensSec1;
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }
    cache_entry.Tokens := 0;
  }

action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := in_msg.valid_sector_mask;
      if (is_valid(tbe)) {
        copy_mask := amtc_intersectMasks(copy_mask, tbe.RequestedSectorMask);
      }

      // If the incoming message has no data (ACK), just skip.
      if (copy_mask != 0) {

          if (amtc_maskHasSector(copy_mask, 0)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }

          if (amtc_maskHasSector(copy_mask, 1)) {
              cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          // ===================================================================
          // CRITICAL FIX: Lock the metadata strictly to the bytes we just copied!
          // ===================================================================
          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, copy_mask);
          }
      }
    }
  }

  action(gg_deallocateL1CacheBlock, "\g", desc="Deallocate cache block.  Sets the cache to invalid, allowing a replacement in parallel with a fetch.") {
    assert(getTokens(cache_entry, amtc_fullMask()) == 0);
    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    } else {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(ii_allocateL1DCacheBlock, "\i", desc="Set L1 D-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Dcache.allocate(address, new Entry));
    }
  }

  action(pp_allocateL1ICacheBlock, "\p", desc="Set L1 I-cache tag equal to tag of block B.") {
    if (is_valid(cache_entry)) {
    } else {
      set_cache_entry(L1Icache.allocate(address, new Entry));
    }
  }

  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
    if (send_evictions) {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
      sequencer.evictionCallback(address);
    }
  }

  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
    L1Icache.profileDemandMiss();
  }

  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
    L1Icache.profileDemandHit();
  }

  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
    L1Dcache.profileDemandMiss();
  }

  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
    L1Dcache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      //assert(cache_entry.DataBlk == in_msg.DataBlk);
    }
  }

  action(zz_stallAndWaitMandatoryQueue, "\z", desc="Send the head of the mandatory queue to the back of the queue.") {
    peek(mandatoryQueue_in, RubyRequest) {
      APPEND_TRANSITION_COMMENT(in_msg.LineAddress);
    }
    stall_and_wait(mandatoryQueue_in, address);
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  action(ka_wakeUpAllDependents, "ka", desc="wake-up all dependents") {
    wakeUpAllBuffers();
  }

action(amtc_markValidSectorsFromResponse, "mvs", desc="Mark valid sectors from response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // Only process masks from actual data-carrying messages
      if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
          in_msg.Type == CoherenceResponseType:DATA_SHARED) {

          int update_mask := amtc_sanitizeMask(in_msg.valid_sector_mask);

          if (is_valid(tbe)) {
            update_mask := amtc_intersectMasks(update_mask, tbe.RequestedSectorMask);
          }

          int new_valid := cache_entry.ValidSectors;

          // TOKEN-AWARE VALIDATION: We only need > 0 tokens to hold valid read-only data!
          if (amtc_maskHasSector(update_mask, 0) && cache_entry.TokensSec0 > 0) {
              new_valid := amtc_unionMasks(new_valid, 1); // mark sector 0 valid
          }

          if (amtc_maskHasSector(update_mask, 1) && cache_entry.TokensSec1 > 0) {
              new_valid := amtc_unionMasks(new_valid, 2); // mark sector 1 valid
          }

          cache_entry.ValidSectors := new_valid;
      }
    }
  }

  action(amtc_recomputeValidFromTokens, "rv", desc="Recompute valid sectors from tokens") {
  int new_valid := 0;

  // Tokens > 0 means we have at least Shared permission, so the data is valid!
  if (cache_entry.TokensSec0 > 0) {
    new_valid := amtc_unionMasks(new_valid, 1);
  }
  if (cache_entry.TokensSec1 > 0) {
    new_valid := amtc_unionMasks(new_valid, 2);
  }

  cache_entry.ValidSectors := new_valid;
}


  action(ao_issueOwnerReadRequest, "ao", desc="Issue a GETS request as the Owner") {
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:GETS;
      out_msg.Requestor := machineID;
      out_msg.Destination.broadcast(MachineType:L1Cache);
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

      int req_mask := tbe.RequestedSectorMask;
      out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
      out_msg.sector_mask := req_mask;
      out_msg.requested_sector_mask := req_mask;


      out_msg.MessageSize := MessageSizeType:Broadcast_Control;

      // CRITICAL UPGRADE: Tell the Directory we already own the line
      out_msg.is_owner_pull := true;
    }
  }

  // =============================================================================
  // PERFORMANCE ACCELERATOR: IMMEDIATE MISSING SECTOR PULL
  // =============================================================================
  action(a_issueImmediateMissingReadRequest, "aim", desc="Instantly request missing sectors") {
      assert(is_valid(tbe));

      // Calculate exactly which sectors are STILL missing from our cache entry
      int missing_mask := tbe.RequestedSectorMask;
      if (is_valid(cache_entry)) {
          missing_mask := amtc_subtractMask(tbe.RequestedSectorMask, cache_entry.ValidSectors);
      }

      // If there is nothing missing, we don't need to do anything
      if (missing_mask != 0) {
          // ENQUEUE 1: Send to L2/Directory immediately
          enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceRequestType:GETS;
              out_msg.Requestor := machineID;
              out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache, l2_select_low_bit, l2_select_num_bits, intToID(0)));
              out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

              out_msg.RetryNum := tbe.IssueCount;
              out_msg.MessageSize := MessageSizeType:Reissue_Control;
              out_msg.Prefetch := tbe.Prefetch;
              out_msg.AccessMode := tbe.AccessMode;

              // Only ask for the specific sectors we don't have yet
              out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
              out_msg.sector_mask := missing_mask;
              out_msg.requested_sector_mask := missing_mask;

              out_msg.is_gpu := false;
              out_msg.is_sync := false;
              out_msg.is_bypass := false;
              out_msg.is_atomic := tbe.IsAtomic;
              out_msg.is_signal := false;
              out_msg.merged_req := false;

              // If we already hold half the tokens, this MUST be an owner pull
              if (getTokens(cache_entry, amtc_fullMask()) >= (max_tokens() / 2)) {
                  out_msg.is_owner_pull := true;
              } else {
                  out_msg.is_owner_pull := false;
              }
          }

          // ENQUEUE 2: Broadcast to Local L1s
          enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceRequestType:GETS;
              out_msg.Requestor := machineID;
              out_msg.Destination.broadcast(MachineType:L1Cache);
              out_msg.Destination.remove(machineID);

              out_msg.RetryNum := tbe.IssueCount;
              out_msg.isLocal := true;
              out_msg.MessageSize := MessageSizeType:Broadcast_Control;
              out_msg.Prefetch := tbe.Prefetch;
              out_msg.AccessMode := tbe.AccessMode;

              out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
              out_msg.sector_mask := missing_mask;
              out_msg.requested_sector_mask := missing_mask;

              out_msg.is_gpu := false;
              out_msg.is_sync := false;
              out_msg.is_bypass := false;
              out_msg.is_atomic := tbe.IsAtomic;
              out_msg.is_signal := false;
              out_msg.merged_req := false;

              if (getTokens(cache_entry,amtc_fullMask()) >= (max_tokens() / 2)) {
                  out_msg.is_owner_pull := true;
              } else {
                  out_msg.is_owner_pull := false;
              }
          }

          tbe.IssueCount := tbe.IssueCount + 1;

          // Refresh the timer so we don't time out while waiting for this new request
          if (dynamic_timeout_enabled) {
            reissueTimerTable.set(address, clockEdge() + cyclesToTicks(averageLatencyEstimate()));
          } else {
            reissueTimerTable.set(address, clockEdge() + cyclesToTicks(fixed_timeout_latency));
          }
      }
  }

  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  // Transitions for Load/Store/L2_Replacement from transient states
  transition({IM, SM, OM, IS, IM_L, IS_L, I_L, S_L, SM_L, M_W, MM_W}, L1_Replacement) {
    ta_traceStalledAddress;
    zz_stallAndWaitMandatoryQueue;
  }

  transition({IM, SM, OM, IS, IM_L, IS_L, SM_L}, {Store, Atomic}) {
    zz_stallAndWaitMandatoryQueue;
  }

  transition({IM, IS, IM_L, IS_L}, {Load, Ifetch}) {
    zz_stallAndWaitMandatoryQueue;
  }

  // Lockdowns
  transition({NP, I, S, O, M, MM, M_W, MM_W, IM, SM, OM, IS}, Own_Lock_or_Unlock) {
    l_popPersistentQueue;
  }

  // Transitions from NP
  transition(NP, Load, IS) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(NP, Ifetch, IS) {
    pp_allocateL1ICacheBlock;
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileInstMiss;
    k_popMandatoryQueue;
  }

  transition(NP, {Store, Atomic}, IM) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(NP, {Ack, Data_Shared, Data_Owner, Data_All_Tokens}) {
    bb_bounceResponse;
    n_popResponseQueue;
  }

  transition(NP, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS}) {
    m_popRequestQueue;
  }

  transition(NP, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    l_popPersistentQueue;
  }

  // Transitions from Idle
  transition(I, Load, IS) {
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(I, Ifetch, IS) {
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileInstMiss;
    k_popMandatoryQueue;
  }

  transition(I, {Store, Atomic}, IM) {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(I, L1_Replacement) {
    ta_traceStalledAddress;
    tr_tokenReplacement;
    gg_deallocateL1CacheBlock;
    ka_wakeUpAllDependents;
  }

  transition(I, {Transient_GETX, Transient_Local_GETX}) {
    t_sendAckWithCollectedTokens;
    m_popRequestQueue;
  }

  transition(I, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    m_popRequestQueue;
  }

  transition(I, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  transition(I_L, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}) {
    l_popPersistentQueue;
  }

  transition(I, Ack) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(I, Data_Shared, S) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(I, Data_Owner, O) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(I, Data_All_Tokens, M) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // Transitions from Shared
  transition({S, SM, S_L, SM_L}, Load) {
    h_load_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition({S, SM, S_L, SM_L}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    k_popMandatoryQueue;
  }

  transition(S, {Store, Atomic}, SM) {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(S, L1_Replacement, I) {
    ta_traceStalledAddress;
    cc_sharedReplacement; // Only needed in some cases
    forward_eviction_to_cpu;
    gg_deallocateL1CacheBlock;
    ka_wakeUpAllDependents;
  }

  transition(S, {Transient_GETX, Transient_Local_GETX}, I) {
    t_sendAckWithCollectedTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    m_popRequestQueue;
  }

  // only owner responds to non-local requests
  transition(S, Transient_GETS) {
    m_popRequestQueue;
  }

  transition(S, Transient_Local_GETS) {
    d_sendDataWithToken;
    m_popRequestQueue;
  }

  transition(S, {Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    m_popRequestQueue;
  }

  transition({S, S_L}, Persistent_GETX, I_L) {
    e_sendAckWithCollectedTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(S, {Persistent_GETS, Persistent_GETS_Last_Token}, S_L) {
    f_sendAckWithAllButNorOneTokens;
    l_popPersistentQueue;
  }

  transition(S_L, {Persistent_GETS, Persistent_GETS_Last_Token}) {
    l_popPersistentQueue;
  }

  transition(S, Ack) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(S, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(S, Data_Owner, O) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(S, Data_All_Tokens, M) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // Transitions from Owned
  transition({O, OM}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    k_popMandatoryQueue;
  }

  transition({O, OM}, Load) {
    h_load_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(O, {Store, Atomic}, OM) {
    i_allocateTBE;
    //hh_store_hit
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(O, L1_Replacement, I) {
    ta_traceStalledAddress;
    c_ownedReplacement;
    forward_eviction_to_cpu
    gg_deallocateL1CacheBlock;
    ka_wakeUpAllDependents;
  }

  transition(O, {Transient_GETX, Transient_Local_GETX}, I) {
    dd_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    m_popRequestQueue;
  }

  transition(O, Persistent_GETX, I_L) {
    ee_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(O, Persistent_GETS, S_L) {
    ff_sendDataWithAllButNorOneTokens;
    l_popPersistentQueue;
  }

  transition(O, Persistent_GETS_Last_Token, I_L) {
    fo_sendDataWithOwnerToken;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(O, Transient_GETS) {
    d_sendDataWithToken;
    m_popRequestQueue;
  }

  transition(O, Transient_Local_GETS) {
    d_sendDataWithToken;
    m_popRequestQueue;
  }

  // ran out of tokens, wait for it to go persistent
  transition(O, {Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
    m_popRequestQueue;
  }

  transition(O, Ack) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(O, Ack_All_Tokens, M) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(O, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(O, Data_All_Tokens, M) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // =====================================================================
  // STALE RESPONSE ABSORPTION IN STABLE STATES
  // =====================================================================

  // Absorb late token-only packets
  transition({M, MM}, {Ack, Ack_All_Tokens}) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // Absorb late data packets (from duplicate memory fetches)
  transition({M, MM}, {Data_Shared, Data_Owner, Data_All_Tokens, Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // Transitions from Modified
  transition({MM, MM_W}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    k_popMandatoryQueue;
  }

  transition({MM, MM_W}, Load) {
    h_load_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition({MM_W}, {Store, Atomic}) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(MM, Store) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(MM, Atomic, M) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(MM, L1_Replacement, I) {
    ta_traceStalledAddress;
    c_ownedReplacement;
    forward_eviction_to_cpu
    gg_deallocateL1CacheBlock;
    ka_wakeUpAllDependents;
  }

  transition(MM, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS}, I) {
    dd_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    m_popRequestQueue;
  }

  transition({MM_W}, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS}) { // Ignore the request
    m_popRequestQueue;
  }

  // Implement the migratory sharing optimization, even for persistent requests
  transition(MM, {Persistent_GETX, Persistent_GETS}, I_L) {
    ee_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  // ignore persistent requests in lockout period
  transition(MM_W, {Persistent_GETX, Persistent_GETS}) {
    l_popPersistentQueue;
  }

  transition(MM_W, Use_TimeoutNoStarvers, MM) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(MM_W, Use_TimeoutNoStarvers_NoMig, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  // Transitions from Dirty Exclusive
  transition({M, M_W}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    k_popMandatoryQueue;
  }

  transition({M, M_W}, Load) {
    h_load_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M, Store, MM) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M, Atomic) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M_W, Store, MM_W) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M_W, Atomic) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M, L1_Replacement, I) {
    ta_traceStalledAddress;
    c_ownedReplacement;
    forward_eviction_to_cpu
    gg_deallocateL1CacheBlock;
    ka_wakeUpAllDependents;
  }

  transition(M, {Transient_GETX, Transient_Local_GETX}, I) {
    dd_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    m_popRequestQueue;
  }

  transition(M, Transient_Local_GETS, O) {
    d_sendDataWithToken;
    m_popRequestQueue;
  }

  transition(M, Transient_GETS, O) {
    d_sendDataWithNTokenIfAvail;
    m_popRequestQueue;
  }

  transition(M_W, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS}) { // Ignore the request
    m_popRequestQueue;
  }

  transition(M, Persistent_GETX, I_L) {
    ee_sendDataWithAllTokens;
    p_informL2AboutTokenLoss;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(M, Persistent_GETS, S_L) {
    ff_sendDataWithAllButNorOneTokens;
    l_popPersistentQueue;
  }

  // ignore persistent requests in lockout period
  transition(M_W, {Persistent_GETX, Persistent_GETS}) {
    l_popPersistentQueue;
  }

  transition(M_W, Use_TimeoutStarverS, S_L) {
    s_deallocateTBE;
    ff_sendDataWithAllButNorOneTokens;
    jj_unsetUseTimer;
  }

  // someone unlocked during timeout
  transition(M_W, {Use_TimeoutNoStarvers, Use_TimeoutNoStarvers_NoMig}, M) {
    s_deallocateTBE;
    jj_unsetUseTimer;
    kd_wakeUpDependents;
  }

  transition(M_W, Use_TimeoutStarverX, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;
  }

  // migratory
  transition(MM_W, {Use_TimeoutStarverX, Use_TimeoutStarverS}, I_L) {
    s_deallocateTBE;
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu;
    p_informL2AboutTokenLoss;
    jj_unsetUseTimer;

  }

  // Handle completion of a write upgrade while in the waiting state
// =====================================================================
  // DATA PATH: The response contains valid physical bytes
  // =====================================================================
  transition({M_W, MM_W}, Data_All_Tokens, MM) {
    u_writeDataToCache;  // <--- Safe to use! The payload has data.
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    amtc_completeIfAlreadyOwnsSector;
    j_unsetReissueTimer;
    jj_unsetUseTimer;
    s_deallocateTBE;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // =====================================================================
  // ACK PATH: The response is just tokens, no data!
  // =====================================================================
  transition({M_W, MM_W}, Ack_All_Tokens, MM) {
    // CRITICAL FIX: Do NOT call u_writeDataToCache here!
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    amtc_completeIfAlreadyOwnsSector;
    j_unsetReissueTimer;
    jj_unsetUseTimer;
    s_deallocateTBE;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // Transient_GETX and Transient_GETS in transient states
  transition(OM, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    m_popRequestQueue;  // Even if we have the data, we can pretend we don't have it yet.
  }

  transition(IS, {Transient_GETX, Transient_Local_GETX}) {
    t_sendAckWithCollectedTokens;
    m_popRequestQueue;
  }

  transition(IS, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    m_popRequestQueue;
  }

  transition(IS, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, IS_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  transition(IS_L, {Persistent_GETX, Persistent_GETS}) {
    l_popPersistentQueue;
  }

  transition(IM, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}, IM_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  transition(IM_L, {Persistent_GETX, Persistent_GETS}) {
    l_popPersistentQueue;
  }

  transition({SM, SM_L}, Persistent_GETX, IM_L) {
    e_sendAckWithCollectedTokens;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(SM, {Persistent_GETS, Persistent_GETS_Last_Token}, SM_L) {
    f_sendAckWithAllButNorOneTokens;
    l_popPersistentQueue;
  }

  transition(SM_L, {Persistent_GETS, Persistent_GETS_Last_Token}) {
    l_popPersistentQueue;
  }

  transition(OM, Persistent_GETX, IM_L) {
    ee_sendDataWithAllTokens;
    forward_eviction_to_cpu
    l_popPersistentQueue;
  }

  transition(OM, Persistent_GETS, SM_L) {
    ff_sendDataWithAllButNorOneTokens;
    l_popPersistentQueue;
  }

  transition(OM, Persistent_GETS_Last_Token, IM_L) {
    fo_sendDataWithOwnerToken;
    l_popPersistentQueue;
  }

  // Transitions from IM/SM

  transition({IM, SM}, Ack) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(IM, Data_Shared, SM) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(IM, Data_Owner, M) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    j_unsetReissueTimer;
    n_popResponseQueue;
    s_deallocateTBE;
    kd_wakeUpDependents;
  }

transition(IM, Data_All_Tokens, M_W) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(SM, Data_Owner, OM) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(SM, Data_All_Tokens, MM_W) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition({IM, SM}, {Transient_GETX, Transient_Local_GETX}, IM) { // We don't have the data yet, but we might have collected some tokens.  We give them up here to avoid livelock
    t_sendAckWithCollectedTokens;
    forward_eviction_to_cpu;
    m_popRequestQueue;
  }

  transition({IM, SM}, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS}) {
    m_popRequestQueue;
  }

  transition({IM, SM}, Request_Timeout) {
    j_unsetReissueTimer;
    b_issueWriteRequest;
  }

  // Transitions from OM

  transition(OM, Ack, M) {
    amtc_markValidSectorsFromResponse;
    amtc_completeIfAlreadyOwnsSector;
    xx_external_store_hit; // <--- ADD THIS CALLBACK
    j_unsetReissueTimer;
    n_popResponseQueue;
    s_deallocateTBE;
    kd_wakeUpDependents;
  }

  transition(OM, Ack_All_Tokens, MM_W) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(OM, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(OM, Data_All_Tokens, MM_W) {
    w_assertIncomingDataAndCacheDataMatch;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(OM, Request_Timeout, M) {
    amtc_completeIfAlreadyOwnsSector;
    j_unsetReissueTimer;
    s_deallocateTBE;
    kd_wakeUpDependents;
  }
  // Transitions from IS

  transition(IS, Ack) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  transition(IS, Data_Shared, S) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, Data_Owner, O) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, Data_All_Tokens, M_W) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, Request_Timeout) {
    j_unsetReissueTimer;
    a_issueReadRequest;
  }

  // Transitions from I_L

  transition(I_L, Load, IS_L) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(I_L, Ifetch, IS_L) {
    pp_allocateL1ICacheBlock;
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileInstMiss;
    k_popMandatoryQueue;
  }

  transition(I_L, {Store, Atomic}, IM_L) {
    ii_allocateL1DCacheBlock;
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }


  // Transitions from S_L

  transition(S_L, {Store, Atomic}, SM_L) {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // Other transitions from *_L states

  transition({I_L, IM_L, IS_L, S_L, SM_L}, {Transient_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token, Transient_Local_GETS, Transient_GETX, Transient_Local_GETX}) {
    m_popRequestQueue;
  }

  transition({I_L, IM_L, IS_L, S_L, SM_L}, Ack) {
    g_bounceResponseToStarver;
    n_popResponseQueue;
  }

  transition({I_L, IM_L, S_L, SM_L}, {Data_Shared, Data_Owner}) {
    g_bounceResponseToStarver;
    n_popResponseQueue;
  }

  transition({I_L, S_L}, Data_All_Tokens) {
    g_bounceResponseToStarver;
    n_popResponseQueue;
  }

  transition(IS_L, Request_Timeout) {
    j_unsetReissueTimer;
    a_issueReadRequest;
  }

  transition({IM_L, SM_L}, Request_Timeout) {
    j_unsetReissueTimer;
    b_issueWriteRequest;
  }

  // Opportunisticly Complete the memory operation in the following
  // cases.  Note: these transitions could just use
  // g_bounceResponseToStarver, but if we have the data and tokens, we
  // might as well complete the memory request while we have the
  // chance (and then immediately forward on the data)

  transition(IM_L, Data_All_Tokens, MM_W) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    j_unsetReissueTimer;
    o_scheduleUseTimeout;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM_L, Data_All_Tokens, S_L) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    ff_sendDataWithAllButNorOneTokens;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
  }

  transition(IS_L, Data_Shared, I_L) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    s_deallocateTBE;
    e_sendAckWithCollectedTokens;
    p_informL2AboutTokenLoss;
    j_unsetReissueTimer;
    n_popResponseQueue;
  }

  transition(IS_L, Data_Owner, I_L) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    ee_sendDataWithAllTokens;
    s_deallocateTBE;
    p_informL2AboutTokenLoss;
    j_unsetReissueTimer;
    n_popResponseQueue;
  }

  transition(IS_L, Data_All_Tokens, M_W) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    x_external_load_hit;
    j_unsetReissueTimer;
    o_scheduleUseTimeout;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // Own_Lock_or_Unlock

  transition(I_L, Own_Lock_or_Unlock, I) {
    l_popPersistentQueue;
    kd_wakeUpDependents;
  }

  transition(S_L, Own_Lock_or_Unlock, S) {
    l_popPersistentQueue;
    kd_wakeUpDependents;
  }

  transition(IM_L, Own_Lock_or_Unlock, IM) {
    l_popPersistentQueue;
    kd_wakeUpDependents;
  }

  transition(IS_L, Own_Lock_or_Unlock, IS) {
    l_popPersistentQueue;
    kd_wakeUpDependents;
  }

  transition(SM_L, Own_Lock_or_Unlock, SM) {
    l_popPersistentQueue;
    kd_wakeUpDependents;
  }

  transition({M, MM, M_W, MM_W}, Request_Timeout) {
    j_unsetReissueTimer;
  }

  // =====================================================================
  // AMTC: SECTOR MISS TRANSITIONS
  // =====================================================================
// =====================================================================
  // 1. TRIGGER THE FETCH FOR LOAD SECTOR MISSES (Reads)
  // =====================================================================
  transition(S, Load_Sector_Miss, S_IS) {
    i_allocateTBE;
    a_issueReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(O, Load_Sector_Miss, O_IS) {
    i_allocateTBE;
    ao_issueOwnerReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // =====================================================================
  // 2. TRIGGER THE FETCH FOR STORE SECTOR MISSES (Writes)
  // =====================================================================
  // A Shared cache writing a missing sector needs Data + All Tokens
  transition(S, Store_Sector_Miss, IM) {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // An Owner cache writing a missing sector needs Data + All Tokens
  transition(O, Store_Sector_Miss, M_IM) {
    i_allocateTBE;
    b_issueWriteRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // =====================================================================
  // 3. STALL CONCURRENT MISSES
  // =====================================================================
  // If the CPU hits another miss while we are already waiting for an upgrade, stall it!
  transition({SM, OM}, {Load_Sector_Miss, Store_Sector_Miss}) {
    zz_stallAndWaitMandatoryQueue;
  }

 // -------------------------------------------------------------------------
  // STABLE STATES: Safe to allocate TBE and pull the missing sector
  // -------------------------------------------------------------------------
 transition({M, MM}, Load_Sector_Miss, M_IS) {
    i_allocateTBE;
    ao_issueOwnerReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition({M, MM}, Store_Sector_Miss, M_IM) {
    i_allocateTBE;
    ao_issueOwnerReadRequest;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  // -------------------------------------------------------------------------
  // TRANSIENT STATES: The TBE is busy tracking the Use_Timeout!
  // We MUST stall the CPU request until the timeout finishes and we reach M/MM.
  // -------------------------------------------------------------------------
transition({M_W, MM_W}, {Load_Sector_Miss, Store_Sector_Miss}) {
    zz_stallAndWaitMandatoryQueue;
  }
  // 2. Stall incoming CPU requests while waiting for the missing sector
  transition({S_IS, O_IS, M_IS, M_IM}, {Load, Ifetch, Store, Atomic, L1_Replacement, Load_Sector_Miss, Store_Sector_Miss}) {
      zz_stallAndWaitMandatoryQueue;
  }

  // 3. Network Responses (Merge the data, return to the correct base state)
  transition(S_IS, Ack) { amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; n_popResponseQueue; }
  transition(S_IS, Data_Shared, S) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(S_IS, Data_Owner, O) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(S_IS, Data_All_Tokens, M) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(S_IS, Request_Timeout) { j_unsetReissueTimer; a_issueReadRequest; }

  transition(O_IS, Ack) { amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; n_popResponseQueue; }
  transition(O_IS, Data_Shared, O) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(O_IS, Data_Owner, O) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(O_IS, Data_All_Tokens, M) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(O_IS, Request_Timeout) { j_unsetReissueTimer; a_issueReadRequest; }

  transition(M_IS, Ack) { amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; n_popResponseQueue; }
  transition(M_IS, Data_Shared, M) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(M_IS, Data_Owner, M) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(M_IS, Data_All_Tokens, M) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; x_external_load_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(M_IS, Request_Timeout) { j_unsetReissueTimer; a_issueReadRequest; }

  transition(M_IM, Ack) { amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; n_popResponseQueue; }
  // Data-only response for a store/upgrade miss is not sufficient.
  // Install the returned data, but do not issue the store callback and do not
  // move to MM until owner/all-token coverage arrives.
transition(M_IM, Data_Shared, MM) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;
    s_deallocateTBE;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }
  transition(M_IM, Data_Owner, MM) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; xx_external_store_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(M_IM, Data_All_Tokens, MM) { u_writeDataToCache; amtc_markValidSectorsFromResponse; q_updateTokensFromResponse; xx_external_store_hit; s_deallocateTBE; j_unsetReissueTimer; n_popResponseQueue; kd_wakeUpDependents; }
  transition(M_IM, Request_Timeout)
  {
    j_unsetReissueTimer;
    ao_issueOwnerReadRequest;
  }

  // 4. Ignore transient requests safely while waiting
  transition({S_IS, O_IS, M_IS, M_IM}, {Transient_GETX, Transient_Local_GETX, Transient_GETS, Transient_Local_GETS, Transient_GETS_Last_Token, Transient_Local_GETS_Last_Token}) {
     m_popRequestQueue;
  }

  transition({S_IS, O_IS, M_IS, M_IM}, Own_Lock_or_Unlock) { l_popPersistentQueue; }
  transition({S_IS, O_IS, M_IS, M_IM}, {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token}) {
     e_sendAckWithCollectedTokens; // safely drop tokens to prevent persistent deadlock
     l_popPersistentQueue;
  }

  transition({IS, IS_L, M_IM, M_IS, S_IS, O_IS}, {Data_Shared_Partial, Data_Owner_Partial}) {
    u_writeDataToCache;
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    n_popResponseQueue;
  }

  // Transition to handle getting all tokens via ACK while waiting for an Instruction Fetch
  transition(IS, Ack_All_Tokens, IS) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;

    // We have the tokens, but we are missing the data!
    // Force an immediate read request to get the bytes from the Directory/Memory.
    a_issueImmediateMissingReadRequest;

    n_popResponseQueue;
  }

  // Handle early tokens arriving for a missing sector on a partially Modified line
  transition({M_IM, M_IS},Ack_All_Tokens) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;

    // We got the tokens for the missing sector, but we still need the data bytes!
    a_issueImmediateMissingReadRequest;

    n_popResponseQueue;
  }

  // ====================================================================
  // THE UPGRADE: We already had the data, and now we have the tokens!
  // ====================================================================
  transition(SM, Ack_All_Tokens, MM_W) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    xx_external_store_hit;       // Complete the CPU store!
    o_scheduleUseTimeout;
    j_unsetReissueTimer;
    n_popResponseQueue;
    kd_wakeUpDependents;
  }

  // ====================================================================
  // THE SECTOR MISS: We got the tokens, but we STILL need the data!
  // ====================================================================
  transition(IM, Ack_All_Tokens) {
q_updateTokensFromResponse;
amtc_markValidSectorsFromResponse;
    a_issueImmediateMissingReadRequest; // Force the Directory to send data
    n_popResponseQueue;
  }

  transition(IM, Ack_Owner_All_Tokens, M) { // Or whatever your target state is
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

}
