machine(MachineType:Directory, "Token protocol")
 : DirectoryMemory * directory;
   int l2_select_num_bits;
   Cycles directory_latency := 5;
   bool distributed_persistent := "True";
   Cycles fixed_timeout_latency := 100;
   Cycles reissue_wakeup_latency := 10;
   Cycles to_memory_controller_latency := 1;

   // Message Queues from dir to other controllers / network
   MessageBuffer * dmaResponseFromDir, network="To", virtual_network="5",
        vnet_type="response";

   MessageBuffer * responseFromDir, network="To", virtual_network="4",
        vnet_type="response";

   MessageBuffer * requestFromDir, network="To", virtual_network="1",
        vnet_type="request";

   // Message Queues to dir from other controllers / network
   MessageBuffer * responseToDir, network="From", virtual_network="4",
        vnet_type="response";

   MessageBuffer * requestToDir, network="From", virtual_network="2",
        vnet_type="request";

   MessageBuffer * dmaRequestToDir, network="From", virtual_network="0",
        vnet_type="request";

   MessageBuffer * requestToMemory;
   MessageBuffer * responseFromMemory;
   MessageBuffer * triggerQueue;
{
  // STATES
  state_declaration(State, desc="Directory states", default="Directory_State_I") {
    // --- STABLE DOMAIN STATES ---
    I,   AccessPermission:Invalid,    desc="Dir owns all tokens, no caching";
    CS,  AccessPermission:Read_Only,  desc="CPU Shared (Dir holds remainder)";
    GS,  AccessPermission:Read_Only,  desc="GPU Shared (Dir holds remainder)";
    CGS, AccessPermission:Read_Only,  desc="CPU+GPU Shared (Dir holds remainder)";
    CE,  AccessPermission:Read_Write, desc="CPU Exclusive (CPU holds ALL tokens)";
    GE,  AccessPermission:Read_Write, desc="GPU Exclusive (GPU holds ALL tokens)";
    CE_XFER, AccessPermission:Read_Write, desc="CPU ownership transition state";
    GE_XFER, AccessPermission:Read_Write, desc="GPU ownership transition state";

    // --- TRANSIENT MEMORY WAITS ---
    CS_W,  AccessPermission:Busy, desc="Fetching memory for CPU Shared";
    GS_W,  AccessPermission:Busy, desc="Fetching memory for GPU Shared";
    CE_W,  AccessPermission:Busy, desc="Fetching memory for CPU Exclusive";
    GE_W,  AccessPermission:Busy, desc="Fetching memory for GPU Exclusive";
    CGS_W, AccessPermission:Busy, desc="Fetching memory to add domain to Shared";

    // --- TRANSIENT UPGRADES & MIGRATIONS ---
    MIG_C2G,     AccessPermission:Busy, desc="Migrating CE to GE";
    MIG_G2C,     AccessPermission:Busy, desc="Migrating GE to CE";
    CGS_CPU_UPG, AccessPermission:Busy, desc="Upgrading CGS to CE (waiting on GPU Ack)";
    CGS_GPU_UPG, AccessPermission:Busy, desc="Upgrading CGS to GE (waiting on CPU Ack)";

    CE_W_DataOnly, AccessPermission:Busy, desc="Fetching data-only for CPU Owner Pull";
    GE_W_DataOnly, AccessPermission:Busy, desc="Fetching data-only for GPU Owner Pull";
  }

  // Events
  enumeration(Event, desc="Directory events") {
    CPU_GETS, desc="A GETS from the CPU domain";
    GPU_GETS, desc="A GETS from the GPU domain";
    CPU_GETX, desc="A GETX from the CPU domain";
    GPU_GETX, desc="A GETX from the GPU domain";

    Lockdown, desc="A lockdown request arrives";
    Unlockdown, desc="An un-lockdown request arrives";
    Own_Lock_or_Unlock, desc="own lock or unlock";
    Own_Lock_or_Unlock_Tokens, desc="own lock or unlock with tokens";
    Data_Owner, desc="Data arrive";
    Data_Shared,  desc="Data from a sharer";
    Ack_Owner, desc="Owner token arrived without data because it was clean";
    Tokens, desc="Tokens arrive";
    Request_Timeout, desc="A DMA request has timed out";

    // Memory Controller
    Memory_Data, desc="Data from memory arrives";
    Tokens_Ack,  desc="Tokens returned from an invalidation";
    Memory_Ack, desc="Writeback Ack from memory arrives";

    // DMA requests
    DMA_READ, desc="A DMA Read memory request";
    DMA_WRITE, desc="A DMA Write memory request";
    GETS_Owner_Pull, desc="The Owner is requesting raw data for a missing sector";



    // TWO INTERNAL TRIGGERS ---
    Write_Complete,  desc="Internal trigger: All data and tokens for a write are accumulated";
    Read_Complete,   desc="Internal trigger: All data for a read is accumulated";
  }

  // TYPES
  // DirectoryEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry", main="false") {
    //State DirectoryState,          desc="Directory state";
    //int Tokens, default="max_tokens()", desc="Number of tokens for the line we're holding";
    int TokensSec0, default="max_tokens() / 2", desc="AMTC token count for sector 0";
    int TokensSec1, default="max_tokens() / 2", desc="AMTC token count for sector 1";
    int ValidSectors, default="0", desc="AMTC memory-valid sectors tracked by the directory";
    int DirtySectors, default="0", desc="AMTC dirty sectors known by the directory";
    int OwnerSectorMask, default="0", desc="AMTC sectors likely held by owner";
    int SharerSectorMask, default="0", desc="AMTC sectors likely shared";
    int RequestedSectorMask, default="0", desc="AMTC requested sector mask for outstanding directory transaction";
    int ReceivedSectorMask, default="0", desc="AMTC sectors received for outstanding directory transaction";
    int LastSectorID, default="0", desc="AMTC primary sector id for outstanding transaction";

    Set Owner,                     desc="Probable Owner of the line.  More accurately, the set of processors who need to see a GetS or GetO.  We use a Set for convenience, but only one bit is set at a time.";
    Set Sharers,                   desc="Probable sharers of the line.  More accurately, the set of processors who need to see a GetX";

    State DirectoryState,          desc="Directory state";
  DataBlock DataBlk,             desc="data for the block";

  // --- PHASE 1: DOMAIN METADATA ---
  bool cpu_shared, default="false";
  bool gpu_shared, default="false";
  bool cpu_dirty,  default="false";
  bool gpu_dirty,  default="false";
  MachineID last_cpu_owner;
  MachineID last_gpu_owner;
  }


  // TBE entries for DMA requests
  structure(TBE, desc="TBE entries for outstanding DMA requests") {
    //Addr PhysicalAddress, desc="physical address";
    //State TBEState,        desc="Transient State";
    //DataBlock DataBlk,     desc="Current view of the associated address range";
    //int Len,               desc="...";
    //MachineID DmaRequestor, desc="DMA requestor";
    MachineID OriginalRequestorMachId;
    bool WentPersistent,   desc="Did the DMA request require a persistent request";
    int RequestedSectorMask, default="3", desc="AMTC requested sector mask for outstanding directory transaction";
    int ReceivedSectorMask, default="0", desc="AMTC sectors received for outstanding directory transaction";
    int TokenReadySectorMask, default="0", desc="AMTC sectors with tokens ready for response";
    int LastSectorID, default="0", desc="AMTC primary sector id for outstanding transaction";
    bool FromGPU, default="false", desc="AMTC transaction originated from GPU-side controller";
    bool IsSyncRequest, default="false", desc="AMTC transaction requires coherent sync semantics";

    Addr PhysicalAddress,   desc="Physical address for this TBE";
  State TBEState,        desc="Transient state";
  DataBlock DataBlk,     desc="Data block";
  int Len,               desc="Data block length";
  MachineID DmaReqDest,  desc="DMA requestor";
  // ADD THIS LINE HERE
  MachineID last_requestor, desc="ID of the original requestor for domain tracking";

  // --- PHASE 1: TBE EXTENSION ---
  bool req_from_cpu,     default="false";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  structure(TriggerMsg, desc="Internal trigger message", interface="Message") {
    Addr addr, desc="Physical address";
    Event Type, desc="Event to trigger";
    // CRITICAL FIX: Use the underscore instead of the colon here
    MessageSizeType MessageSize, default="MessageSizeType_Request_Control";
  }

  // ** OBJECTS **

  TimerTable reissueTimerTable;
  TBETable TBEs, template="<Directory_TBE>", constructor="m_number_of_TBEs";
  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  Tick clockEdge();
  Tick clockEdge(Cycles c);
  Tick cyclesToTicks(Cycles c);
  void set_tbe(TBE b);
  void unset_tbe();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);

  // -------------------------------------------------------------------------
  // AMTC compact sector helpers.
  // Physical Ruby coherence block remains 64B. Logical sharing is represented
  // as 2 x 32B sectors: sector 0 = bytes 0..31, sector 1 = bytes 32..63.
  // Full-line mask is 3. Old full-line mask values such as 15 are sanitized
  // to 3 so untrimmed controllers cannot accidentally re-enable 4 sectors.
  // -------------------------------------------------------------------------

  // Helper to determine origin domain
  bool is_cpu_domain(MachineID mach) {
    // Use machineIDToMachineType to extract the enum for comparison
    return (machineIDToMachineType(mach) == MachineType:L2Cache ||
            machineIDToMachineType(mach) == MachineType:L1Cache);
  }
  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  Entry getDirectoryEntry(Addr addr), return_by_pointer="yes" {
    Entry dir_entry := static_cast(Entry, "pointer", directory[addr]);

    if (is_valid(dir_entry)) {
      return dir_entry;
    }

    dir_entry :=  static_cast(Entry, "pointer",
                              directory.allocate(addr, new Entry));
    return dir_entry;
  }

  State getState(TBE tbe, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else {
      return getDirectoryEntry(addr).DirectoryState;
    }
  }

  void setState(TBE tbe, Addr addr, State state) {
    if (is_valid(tbe)) {
      tbe.TBEState := state;
    }
    getDirectoryEntry(addr).DirectoryState := state;
    Entry dir_entry := getDirectoryEntry(addr);

    assert((dir_entry.Owner.count() == 0) || (dir_entry.Owner.count() == 1));

    // 1. ABSOLUTE BOUNDS: Tokens can never be negative or exceed the maximum
    assert(dir_entry.TokensSec0 >= 0);
    assert(dir_entry.TokensSec0 <= (max_tokens() / 2));
    assert(dir_entry.TokensSec1 >= 0);
    assert(dir_entry.TokensSec1 <= (max_tokens() / 2));

    // ====================================================================
    // 2. PHASE 1 DOMAIN INVARIANTS
    // ====================================================================

    // INVARIANT A: Invalid & Initialization Wait States
    // If no cache holds the line, OR we are waiting for memory before sending
    // the first response, the Directory MUST hold exactly 100% of the tokens.
    if (state == State:I || state == State:CS_W || state == State:CE_W || state == State:GS_W || state == State:GE_W) {
      assert(dir_entry.TokensSec0 == (max_tokens() / 2));
      assert(dir_entry.TokensSec1 == (max_tokens() / 2));
    }

    // INVARIANT B: Stable Exclusive
    // If a domain has stable exclusive write access, the Directory MUST hold 0 tokens.
    if (state == State:CE || state == State:GE || state == State:CE_W_DataOnly || state == State:GE_W_DataOnly) {
      assert(dir_entry.TokensSec0 == 0);
      assert(dir_entry.TokensSec1 == 0);
    }

    // INVARIANT C: Shared & In-Flight Upgrades
    // If the line is shared, the Directory must have given away at least 1 token.
    if (state == State:CS || state == State:GS || state == State:CGS || state == State:CGS_W) {
      assert((dir_entry.TokensSec0 < (max_tokens() / 2)) ||
             (dir_entry.TokensSec1 < (max_tokens() / 2)));
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      return Directory_State_to_permission(tbe.TBEState);
    }

    if (directory.isPresent(addr)) {
      DPRINTF(RubySlicc, "%s\n", Directory_State_to_permission(getDirectoryEntry(addr).DirectoryState));
      return Directory_State_to_permission(getDirectoryEntry(addr).DirectoryState);
    }

    DPRINTF(RubySlicc, "AccessPermission_NotPresent\n");
    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Addr addr, State state) {
    getDirectoryEntry(addr).changePermission(Directory_State_to_permission(state));
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      testAndRead(addr, tbe.DataBlk, pkt);
    } else {
      functionalMemoryRead(pkt);
    }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;

    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes +
            testAndWrite(addr, tbe.DataBlk, pkt);
    }

    num_functional_writes := num_functional_writes + functionalMemoryWrite(pkt);
    return num_functional_writes;
  }

  bool amtc_hasAllTokens(Addr addr) {

    Entry entry := getDirectoryEntry(addr);

    return
        (entry.TokensSec0 == (max_tokens() / 2)) &&
        (entry.TokensSec1 == (max_tokens() / 2));
  }

  bool amtc_hasRequestedData(TBE tbe) {
    return amtc_maskContainsAll(tbe.ReceivedSectorMask, tbe.RequestedSectorMask);
  }

  bool amtc_hasRequestedTokens(TBE tbe) {
    return amtc_maskContainsAll(tbe.TokenReadySectorMask, tbe.RequestedSectorMask);
  }

  bool amtc_readComplete(TBE tbe) {
    return amtc_hasRequestedData(tbe);
  }

  bool amtc_writeComplete(Addr addr, TBE tbe) {
    return amtc_hasRequestedData(tbe) && amtc_hasRequestedTokens(tbe);
  }

  void amtc_assertTokenBounds(int tokens) {
    assert(tokens >= 0);
    assert(tokens <= (max_tokens() / 2));
  }

  // ** OUT_PORTS **
  out_port(responseNetwork_out, ResponseMsg, responseFromDir);
  out_port(requestNetwork_out, RequestMsg, requestFromDir);
  out_port(dmaResponseNetwork_out, DMAResponseMsg, dmaResponseFromDir);
  out_port(memQueue_out, MemoryMsg, requestToMemory);
  out_port(triggerQueue_out, TriggerMsg, triggerQueue);

  // ** IN_PORTS **
  // off-chip memory request/response is done
  in_port(memQueue_in, MemoryMsg, responseFromMemory) {
    if (memQueue_in.isReady(clockEdge())) {
      peek(memQueue_in, MemoryMsg) {
        if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
          trigger(Event:Memory_Data, in_msg.addr, TBEs[in_msg.addr]);
        } else if (in_msg.Type == MemoryRequestType:MEMORY_WB) {
          trigger(Event:Memory_Ack, in_msg.addr, TBEs[in_msg.addr]);
        } else {
          DPRINTF(RubySlicc, "%s\n", in_msg.Type);
          error("Invalid message");
        }
      }
    }
  }

  // Reissue Timer
  in_port(reissueTimerTable_in, Addr, reissueTimerTable) {
    Tick current_time := clockEdge();
    if (reissueTimerTable_in.isReady(current_time)) {
      Addr addr := reissueTimerTable.nextAddress();
      trigger(Event:Request_Timeout, addr, TBEs.lookup(addr));
    }
  }

  in_port(responseNetwork_in, ResponseMsg, responseToDir) {
    if (responseNetwork_in.isReady(clockEdge())) {
        peek(responseNetwork_in, ResponseMsg) {

            assert(in_msg.Destination.isElement(machineID));

            if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {

                trigger(Event:Data_Owner,
                        in_msg.addr,
                        TBEs[in_msg.addr]);

            } else if (in_msg.Type == CoherenceResponseType:DATA_SHARED) {
                trigger(Event:Data_Shared, in_msg.addr, TBEs[in_msg.addr]);
            } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER) {

                trigger(Event:Ack_Owner,
                        in_msg.addr,
                        TBEs[in_msg.addr]);

            } else if (in_msg.Type == CoherenceResponseType:ACK) {

                trigger(Event:Tokens,
                        in_msg.addr,
                        TBEs[in_msg.addr]);

            } else {

                error("Invalid response type");

            }
        }
    }
}

in_port(requestNetwork_in, RequestMsg, requestToDir) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        // --- DOMAIN-AWARE EVENT SPLITTING ---

        // 1. CRITICAL FIX: Intercept ALL Owner Pulls FIRST, regardless of whether
        // the original request was a GETS or GETX.
        if (in_msg.is_owner_pull) {
            trigger(Event:GETS_Owner_Pull, in_msg.addr, TBEs[in_msg.addr]);
        }
        // 2. Normal GETS Routing
        else if (in_msg.Type == CoherenceRequestType:GETS) {
            if (is_cpu_domain(in_msg.Requestor)) {
                trigger(Event:CPU_GETS, in_msg.addr, TBEs[in_msg.addr]);
            } else {
                trigger(Event:GPU_GETS, in_msg.addr, TBEs[in_msg.addr]);
            }
        }
        // 3. Normal GETX Routing
        else if (in_msg.Type == CoherenceRequestType:GETX) {
            if (is_cpu_domain(in_msg.Requestor)) {
                trigger(Event:CPU_GETX, in_msg.addr, TBEs[in_msg.addr]);
            } else {
                trigger(Event:GPU_GETX, in_msg.addr, TBEs[in_msg.addr]);
            }
        }
        else {
            error("Invalid message");
        }
      }
    }
  }

  in_port(dmaRequestQueue_in, DMARequestMsg, dmaRequestToDir) {
      if (dmaRequestQueue_in.isReady(clockEdge())) {
          peek(dmaRequestQueue_in, DMARequestMsg) {

              if (in_msg.Type == DMARequestType:READ) {
                  trigger(Event:DMA_READ,
                          in_msg.LineAddress,
                          TBEs[in_msg.LineAddress]);
              } else if (in_msg.Type == DMARequestType:WRITE) {
                  trigger(Event:DMA_WRITE,
                          in_msg.LineAddress,
                          TBEs[in_msg.LineAddress]);
              } else {
                  error("Invalid DMA message");
              }
          }
      }
  }

  in_port(triggerQueue_in, TriggerMsg, triggerQueue) {
    if (triggerQueue_in.isReady(clockEdge())) {
      peek(triggerQueue_in, TriggerMsg) {
        // Dynamically trigger the event stored in the message
        trigger(in_msg.Type, in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Actions

  action(a_sendTokens, "a", desc="Send tokens to requestor") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int send_t0 := 0;
      int send_t1 := 0;

      if (in_msg.Type == CoherenceRequestType:GETS) {
          // Give 1 token for requested sectors
          if (amtc_maskHasSector(in_msg.sector_mask, 0) && dir_entry.TokensSec0 > 0) { send_t0 := 1; }
          if (amtc_maskHasSector(in_msg.sector_mask, 1) && dir_entry.TokensSec1 > 0) { send_t1 := 1; }
      } else {
          // GETX: Give ALL tokens we hold for the requested sectors
          if (amtc_maskHasSector(in_msg.sector_mask, 0)) { send_t0 := dir_entry.TokensSec0; }
          if (amtc_maskHasSector(in_msg.sector_mask, 1)) { send_t1 := dir_entry.TokensSec1; }
      }

      if (send_t0 > 0 || send_t1 > 0) {
          enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
            out_msg.addr := address;
            out_msg.Type := CoherenceResponseType:ACK;
            out_msg.Sender := machineID;
            out_msg.Destination.add(in_msg.Requestor);

            out_msg.TokensSec0 := send_t0;
            out_msg.TokensSec1 := send_t1;

            out_msg.sector_id := in_msg.sector_id;
            out_msg.sector_mask := in_msg.sector_mask;
            out_msg.token_sector_mask := in_msg.sector_mask;
            out_msg.requested_sector_mask := in_msg.requested_sector_mask;
            out_msg.MessageSize := MessageSizeType:Response_Control;
          }
          dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
          dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;
      }
    }
  }

  action(bw_broadcastWrite, "bw", desc="Broadcast GETX if we need tokens") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      //
      // Assert that we only send a message if we don't already have ALL the tokens
      // for BOTH sectors.
      //
      Entry dir_entry := getDirectoryEntry(address);
      assert((dir_entry.TokensSec0 < (max_tokens() / 2)) ||
             (dir_entry.TokensSec1 < (max_tokens() / 2)));

      enqueue(requestNetwork_out, RequestMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        //
        // Since only one chip, assuming all L1 caches are local
        //
        out_msg.Destination.broadcast(MachineType:L1Cache);
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.RetryNum := 0;
        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;

        // AMTC Metadata: DMA writes request the full line
        out_msg.sector_id := 0;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
        out_msg.is_gpu := false;
        out_msg.is_sync := false;
      }
    }
  }

  action(br_broadcastRead, "br", desc="Broadcast GETS for data") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;

        //
        // Since only one chip, assuming all L1 caches are local
        //
        out_msg.Destination.broadcast(MachineType:L1Cache);
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.RetryNum := 0;
        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
      }
    }
  }

  action(cwc_checkWriteComplete, "cwc", desc="Check Write completion and fire trigger") {
    if (amtc_hasRequestedTokens(tbe) && amtc_hasRequestedData(tbe)) {
        enqueue(triggerQueue_out, TriggerMsg, 1) {
            out_msg.addr := address;
            out_msg.Type := Event:Write_Complete;
        }
    }
  }

  action(crc_checkReadComplete, "crc", desc="Check Read completion and fire trigger") {
    if (amtc_hasRequestedTokens(tbe) && amtc_hasRequestedData(tbe)) {
        enqueue(triggerQueue_out, TriggerMsg, 1) {
            out_msg.addr := address;
            out_msg.Type := Event:Read_Complete;
        }
    }
  }

  action(d_sendMemoryDataOwnerResponse, "d", desc="Send data to requestor without tokens") {
    peek(memQueue_in, MemoryMsg) {

      Entry entry := getDirectoryEntry(address);
      int req_mask := entry.RequestedSectorMask;
      MachineID dest;

      if (req_mask == 0) {
          //req_mask := amtc_fullMask();
      }

      int req_sid := entry.LastSectorID;

      if (is_valid(tbe)) {
          req_mask := tbe.RequestedSectorMask;
          if (req_mask == 0) {
            //req_mask := amtc_fullMask();
          }
          req_sid := tbe.LastSectorID;
          dest := tbe.OriginalRequestorMachId;
        }  else {
          dest := in_msg.OriginalRequestorMachId;
        }

      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        //out_msg.Destination.add(in_msg.OriginalRequestorMachId);
        out_msg.Destination.add(dest);

        // CRITICAL FIX: No assert! No token math! We already sent the tokens!
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;

        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := false;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.sector_id := req_sid;
        out_msg.sector_mask := amtc_sanitizeMask(req_mask);
        out_msg.valid_sector_mask := amtc_sanitizeMask(req_mask);

        // CRITICAL FIX: token_sector_mask is 0 because there are no tokens here.
        out_msg.token_sector_mask := 0;
        out_msg.requested_sector_mask := amtc_sanitizeMask(req_mask);
        out_msg.merged_resp := false;
      }
    }
  }

  action(qf_queueMemoryFetchRequest, "qf", desc="Queue off-chip fetch request") {
    peek(requestNetwork_in, RequestMsg) {

      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int req_sid := amtc_primarySectorFromMask(req_mask);
      Entry entry := getDirectoryEntry(address);

      entry.RequestedSectorMask := req_mask;
      entry.LastSectorID := req_sid;

      if (is_valid(tbe)) {
        tbe.RequestedSectorMask := req_mask;
        tbe.OriginalRequestorMachId := in_msg.Requestor;
        tbe.LastSectorID := req_sid;
        tbe.ReceivedSectorMask := 0;
        tbe.TokenReadySectorMask := 0;
      }

      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := in_msg.Requestor;
        out_msg.OriginalRequestorMachId := in_msg.Requestor;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := amtc_countSectors(req_mask) * 32;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_QUEUE_MEM addr=%#x sid=%d mask=%d\n",
        address, req_sid, req_mask);
    }
  }

  action(fd_memoryDma, "fd", desc="Queue off-chip fetch request") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := in_msg.Requestor;
        out_msg.OriginalRequestorMachId := in_msg.Requestor;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 64;
      }
    }
  }

  action(lq_queueMemoryWbRequest, "lq", desc="Write data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := in_msg.Sender;
        out_msg.OriginalRequestorMachId := in_msg.Sender;
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Len := amtc_countSectors(in_msg.valid_sector_mask) * 32;
      }
    }
  }

  action(ld_queueMemoryDmaWriteFromTbe, "ld", desc="Write DMA data to memory") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      //out_msg.Sender := tbe.DmaRequestor;
      out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Len := tbe.Len;
    }
  }

  action(lr_queueMemoryDmaReadWriteback, "lr",
         desc="Write DMA data from read to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := machineID;
        out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Len := 0;
      }
    }
  }

  action(vd_allocateDmaRequestInTBE, "vd", desc="Record Data in TBE") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.DataBlk := in_msg.DataBlk;
      tbe.PhysicalAddress := in_msg.PhysicalAddress;
      tbe.Len := in_msg.Len;
      //tbe.DmaRequestor := in_msg.Requestor;
      tbe.WentPersistent := false;
    }
  }

  action(rd_recordDataInTbe, "rd", desc="Record data in TBE") {
    peek(responseNetwork_in, ResponseMsg) {
      DataBlock DataBlk := tbe.DataBlk;
      tbe.DataBlk := in_msg.DataBlk;
      tbe.DataBlk.copyPartial(DataBlk, getOffset(tbe.PhysicalAddress),
                              tbe.Len);
    }
  }

  action(f_incrementTokens, "f", desc="Increment the number of tokens we're tracking") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      dir_entry.TokensSec0 := dir_entry.TokensSec0 + in_msg.TokensSec0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 + in_msg.TokensSec1;
    }
  }

  action(aat_assertAllTokens, "aat", desc="assert that we have all tokens") {
    assert(getDirectoryEntry(address).TokensSec0 == (max_tokens() / 2));
    assert(getDirectoryEntry(address).TokensSec1 == (max_tokens() / 2));
  }

  action(j_popIncomingRequestQueue, "j", desc="Pop incoming request queue") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(z_recycleRequest, "z", desc="Recycle the request queue") {
    requestNetwork_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(k_popIncomingResponseQueue, "k", desc="Pop incoming response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(kz_recycleResponse, "kz", desc="Recycle incoming response queue") {
    responseNetwork_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(p_popDmaRequestQueue, "pd", desc="pop dma request queue") {
    dmaRequestQueue_in.dequeue(clockEdge());
  }

  action(y_recycleDmaRequestQueue, "y", desc="recycle dma request queue") {
    dmaRequestQueue_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(l_popMemQueue, "q", desc="Pop off-chip request queue") {
    dequeueMemRespQueue();
  }

  action(rs_resetScheduleTimeout, "rs", desc="Reschedule Schedule Timeout") {
    //
    // currently only support a fixed timeout latency
    //
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
      reissueTimerTable.set(address, clockEdge(fixed_timeout_latency));
    }
  }

  action(st_scheduleTimeout, "st", desc="Schedule Timeout") {
    //
    // currently only support a fixed timeout latency
    //
    reissueTimerTable.set(address, clockEdge(fixed_timeout_latency));
  }

  action(ut_unsetReissueTimer, "ut", desc="Unset reissue timer.") {
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
  }

  action(da_sendDmaAck, "da", desc="Send Ack to DMA controller") {
    enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
      out_msg.PhysicalAddress := address;
      out_msg.LineAddress := address;
      out_msg.Type := DMAResponseType:ACK;
      //out_msg.Destination.add(tbe.DmaRequestor);
      out_msg.MessageSize := MessageSizeType:Writeback_Control;
    }
  }

  action(dm_sendMemoryDataToDma, "dm", desc="Send Data to DMA controller from memory") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
        out_msg.PhysicalAddress := address;
        out_msg.LineAddress := address;
        out_msg.Type := DMAResponseType:DATA;
        //
        // we send the entire data block and rely on the dma controller to
        // split it up if need be
        //
        out_msg.DataBlk := in_msg.DataBlk;
        //out_msg.Destination.add(tbe.DmaRequestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

  action(dd_sendDmaData, "dd", desc="Send Data to DMA controller") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
        out_msg.PhysicalAddress := address;
        out_msg.LineAddress := address;
        out_msg.Type := DMAResponseType:DATA;
        //
        // we send the entire data block and rely on the dma controller to
        // split it up if need be
        //
        out_msg.DataBlk := in_msg.DataBlk;
        //out_msg.Destination.add(tbe.DmaRequestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

action(d_sendMemoryDataWithoutTokens, "d_nt", desc="Send requested sector data without tokens") {
    peek(memQueue_in, MemoryMsg) {
      // Use a local variable to find the mask
      int final_mask := 0;
      int final_sid  := 0;
      MachineID dest;

      if (is_valid(tbe)) {
          dest := tbe.OriginalRequestorMachId;
      } else {
          dest := in_msg.OriginalRequestorMachId;
      }

      //assert(dest != MachineID(-1));
      if (is_valid(tbe)) {
          // If TBE exists, it's the most accurate source
          final_mask := tbe.RequestedSectorMask;
          final_sid  := tbe.LastSectorID;
      } else {
          // Fallback to the persistent Directory Entry
          Entry directory_entry := getDirectoryEntry(address);
          if (is_valid(directory_entry)) {
              final_mask := directory_entry.RequestedSectorMask;
              final_sid  := directory_entry.LastSectorID;
          }
      }

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(dest);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := false;

        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.token_sector_mask := 0;

        out_msg.sector_id := final_sid;
        out_msg.sector_mask := final_mask;
        out_msg.valid_sector_mask := final_mask;
        out_msg.requested_sector_mask := final_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(final_mask);
      }
    }
  }

  action(j_dropStaleRequest, "j_drop", desc="Drop a stale incoming request") {
    // Simply pop the queue without doing anything else
    requestNetwork_in.dequeue(clockEdge());
  }

  action(l_writeTbeDataToMemory, "lwt", desc="Write assembled TBE data to DRAM") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      out_msg.Sender := machineID;
      out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
      out_msg.Len := tbe.Len;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
    }
  }

  // Send the fully assembled line from the TBE to the DMA Controller
  action(dt_sendTbeDataToDma, "dt", desc="Send accumulated TBE data to DMA") {
    enqueue(dmaResponseNetwork_out, DMAResponseMsg, directory_latency) {
      out_msg.LineAddress := address;
      out_msg.Type := DMAResponseType:DATA;
      out_msg.DataBlk := tbe.DataBlk;
      //out_msg.Destination.add(tbe.DmaRequestor);
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
  }

  // Update the Directory's memory copy from the TBE after a read/write
  action(lt_queueTbeWritebackToMemory, "lt", desc="Queue memory writeback from TBE") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      out_msg.Sender := machineID;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
    }
  }

  action(z_stallAndWaitRequest, "\z", desc="Stall incoming requests") {
    stall_and_wait(requestNetwork_in, address);
  }

  action(y_stallAndWaitDmaRequest, "\y", desc="Stall incoming DMA requests") {
    stall_and_wait(dmaRequestQueue_in, address);
  }

  action(kz_stallAndWaitResponse, "\kz", desc="Stall incoming responses") {
    stall_and_wait(responseNetwork_in, address);
  }

  action(qw_wakeUpDependents, "\qw", desc="Wake up any stalled requests") {
    wakeUpBuffers(address);
  }


  action(rb_recordReceivedSectors, "rb", desc="Record received data sectors") {
    peek(responseNetwork_in, ResponseMsg) {
      tbe.ReceivedSectorMask := amtc_unionMasks(tbe.ReceivedSectorMask, in_msg.valid_sector_mask);
    }
  }

  action(rt_recordTokenSectors, "rt", desc="Record received token sectors") {
    peek(responseNetwork_in, ResponseMsg) {
      tbe.TokenReadySectorMask := amtc_unionMasks(tbe.TokenReadySectorMask, in_msg.token_sector_mask);
    }
  }

  action(ccw_checkWriteCompletion, "ccw", desc="Check write completion") {
    if (amtc_writeComplete(address, tbe)) {
      enqueue(triggerQueue_out, TriggerMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := Event:Write_Complete; // You must add Write_Complete to your Event enumeration
      }
    }
  }

  action(ccr_checkReadCompletion, "ccr", desc="Check read completion") {
    if (amtc_readComplete(tbe)) {
      enqueue(triggerQueue_out, TriggerMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := Event:Read_Complete; // You must add Read_Complete to your Event enumeration
      }
    }
  }

  action(tq_popTriggerQueue, "tq", desc="Pop internal trigger queue") {
    triggerQueue_in.dequeue(clockEdge());
  }

  // ====================================================================
  // PHASE 1 ACTIONS: METADATA & LOCALITY ROUTING
  // ====================================================================

  // Action to save the requestor ID into the TBE (Call this first in your transition)
  //action(st_saveRequestor, "stsr", desc="Save requestor in TBE") {
  //  assert(is_valid(tbe));
  //  tbe.last_requestor := tbe.last_requestor;
  //}

  // ====================================================================
  // PHASE 1 ACTIONS: METADATA & LOCALITY ROUTING
  // ====================================================================

  action(u_set_cpu_shared, "scs", desc="Set CPU shared metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).cpu_shared := true;
    getDirectoryEntry(address).last_cpu_owner := requestor;
  }

  action(u_set_gpu_shared, "sgs", desc="Set GPU shared metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).gpu_shared := true;
    getDirectoryEntry(address).last_gpu_owner := requestor;
  }

  action(u_set_cpu_exclusive, "sce", desc="Set CPU exclusive metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).cpu_shared := true;
    getDirectoryEntry(address).cpu_dirty  := true;
    getDirectoryEntry(address).gpu_shared := false;
    getDirectoryEntry(address).gpu_dirty  := false;
    getDirectoryEntry(address).last_cpu_owner := requestor;
  }

  action(u_set_gpu_exclusive, "sge", desc="Set GPU exclusive metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).gpu_shared := true;
    getDirectoryEntry(address).gpu_dirty  := true;
    getDirectoryEntry(address).cpu_shared := false;
    getDirectoryEntry(address).cpu_dirty  := false;
    getDirectoryEntry(address).last_gpu_owner := requestor;
  }

  action(a_fwd_gets_locality_aware, "fwdS", desc="Locality-aware GETS routing") {
    assert(is_valid(tbe));
    Entry e := getDirectoryEntry(address);
    bool from_cpu := is_cpu_domain(tbe.last_requestor);

    if (from_cpu) {
      if (!e.gpu_shared && !e.gpu_dirty) {
        // FAST PATH: GPU doesn't have it.
        // FIX: Using responseNetwork_out (your defined port)
        enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(tbe.last_requestor);
          out_msg.TokensSec0 := (max_tokens() / 2);
          out_msg.TokensSec1 := (max_tokens() / 2);
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.DataBlk := e.DataBlk;
        }
      } else if (e.gpu_dirty) {
        // GPU holds modified data.
        // FIX: Using requestNetwork_out (your defined port for forwards)
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := tbe.last_requestor;
          out_msg.Destination.add(e.last_gpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    } else {
      // SYMMETRIC GPU LOGIC
      if (!e.cpu_shared && !e.cpu_dirty) {
        // FAST PATH: Stay in GPU domain.
        // FIX: Using responseNetwork_out
        enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(tbe.last_requestor);
          out_msg.TokensSec0 := (max_tokens() / 2);
          out_msg.TokensSec1 := (max_tokens() / 2);
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.DataBlk := e.DataBlk;
        }
      } else if (e.cpu_dirty) {
        // FIX: Using requestNetwork_out
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := tbe.last_requestor;
          out_msg.Destination.add(e.last_cpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    }
  }

action(a_inv_remote_domain_on_getx, "invR", desc="Invalidate remote domain on upgrade") {
    assert(is_valid(tbe));
    Entry e := getDirectoryEntry(address);
    bool from_cpu := is_cpu_domain(tbe.last_requestor);

    if (from_cpu && e.gpu_shared) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
            out_msg.addr := address;
            // Use GETX as the token-reclaim/invalidation signal
            out_msg.Type := CoherenceRequestType:GETX;
            out_msg.Requestor := tbe.last_requestor;
            out_msg.Destination.add(e.last_gpu_owner);
            out_msg.MessageSize := MessageSizeType:Forwarded_Control;

            // Ensure AMTC metadata is set for a full-line invalidate
            out_msg.sector_mask := amtc_fullMask();
            out_msg.requested_sector_mask := amtc_fullMask();
        }
    } else if (!from_cpu && e.cpu_shared) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
            out_msg.addr := address;
            out_msg.Type := CoherenceRequestType:GETX;
            out_msg.Requestor := tbe.last_requestor;
            out_msg.Destination.add(e.last_cpu_owner);
            out_msg.MessageSize := MessageSizeType:Forwarded_Control;

            out_msg.sector_mask := amtc_fullMask();
            out_msg.requested_sector_mask := amtc_fullMask();
        }
    }
  }

// --- TBE MANAGEMENT ---
  action(v_allocateTBE, "v", desc="Allocate TBE on transient entry") {
    peek(requestNetwork_in, RequestMsg) {
      if (is_invalid(tbe)) {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
        tbe.last_requestor := in_msg.Requestor;
      }
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE on stable entry") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(d_send_mem_and_1_token_cpu, "s1c", desc="Send memory and 1 token to CPU") {
    peek(memQueue_in, MemoryMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);
      getDirectoryEntry(address).DataBlk := in_msg.DataBlk;

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;

        out_msg.Sender := machineID; // <--- ADD THIS LINE

        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_mem_and_all_tokens_cpu, "sac", desc="Send memory and ALL tokens to CPU") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      getDirectoryEntry(address).DataBlk := in_msg.DataBlk;

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;

        out_msg.Sender := machineID; // <--- ADD THIS LINE

        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(fwd_req_to_gpu, "fr2g", desc="Forward request to GPU Owner") {
    peek(requestNetwork_in, RequestMsg) {
      // Anti-Loop Check
      if (getDirectoryEntry(address).last_gpu_owner != in_msg.Requestor) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type; // Preserve exact type
          out_msg.Requestor := in_msg.Requestor;
          out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    }
  }


  action(fwd_inv_to_gpu, "fi2g", desc="Forward Invalidations to GPU sharers") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
      }
    }
  }

  action(fwd_inv_to_cpu, "fi2c", desc="Forward Invalidations to CPU sharers") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
      }
    }
  }

  action(d_send_mem_and_1_token_gpu, "s1g", desc="Send memory and 1 token to GPU") {
    peek(memQueue_in, MemoryMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_mem_and_all_tokens_gpu, "sag", desc="Send memory and ALL tokens to GPU") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  // --- UPGRADE TOKEN RELEASES ---

  action(d_send_remaining_tokens_cpu, "src", desc="Give remaining tokens to CPU for upgrade") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor); // Send directly to the requesting CPU
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(d_send_remaining_tokens_gpu, "srg", desc="Give remaining tokens to GPU for upgrade/migration") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor); // Send directly to the requesting GPU
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  // --- DIRECTORY-DIRECT REPLIES (For Shared States) ---

  action(d_send_dir_data_and_1_token_cpu, "sdd1c", desc="Send Dir data and 1 token to CPU") {
    peek(requestNetwork_in, RequestMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);
      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor); // Send straight back to requestor
        out_msg.DataBlk := getDirectoryEntry(address).DataBlk; // Use Directory's saved copy
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_dir_data_and_1_token_gpu, "sdd1g", desc="Send Dir data and 1 token to GPU") {
    peek(requestNetwork_in, RequestMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);
      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := getDirectoryEntry(address).DataBlk;
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_mem_data_only_cpu, "sdoc", desc="Send memory data only to CPU") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;

        // Zero Tokens Sent!
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;

        // Dynamic Sector Awareness Optimization
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.requested_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;
      }
    }
  }

  action(d_send_mem_data_only_gpu, "sdog", desc="Send memory data only to GPU") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.requested_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;
      }
    }
  }

  action(d_forward_tokens_to_cpu, "ft2c", desc="Forward loose tokens to the CPU Owner") {
    peek(responseNetwork_in, ResponseMsg) {
      if (in_msg.TokensSec0 > 0 || in_msg.TokensSec1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);

          // Blindly forward the tokens (No TBE access!)
          out_msg.TokensSec0 := in_msg.TokensSec0;
          out_msg.TokensSec1 := in_msg.TokensSec1;

          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.sector_mask := amtc_fullMask();
          out_msg.requested_sector_mask := amtc_fullMask();
          out_msg.token_sector_mask := in_msg.token_sector_mask;
        }
      }
    }
  }



  // (Ensure your d_forward_tokens_to_gpu is updated to match this exactly!)

  // NOTE: Apply the EXACT SAME logic to d_forward_tokens_to_gpu,
  // just changing 'last_cpu_owner' to 'last_gpu_owner' in the enqueue block!

  action(d_forward_tokens_to_gpu, "ft2g", desc="Forward loose tokens to the GPU Owner") {
    peek(responseNetwork_in, ResponseMsg) {
      // Only bother sending if there are actually tokens to send
      if (in_msg.TokensSec0 > 0 || in_msg.TokensSec1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;

          // CRITICAL DIFFERENCE: Route to GPU owner
          out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);

          out_msg.TokensSec0 := in_msg.TokensSec0;
          out_msg.TokensSec1 := in_msg.TokensSec1;

          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.sector_mask := amtc_fullMask();
          out_msg.requested_sector_mask := amtc_fullMask();
          out_msg.token_sector_mask := in_msg.token_sector_mask;
        }
      }
    }
  }

  action(f_forwardRequestToSharers, "\f", desc="Forward request to the node with data") {
    peek(requestNetwork_in, RequestMsg) {
      // Enqueue the forwarded request onto the outgoing request network
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;

        // Pass the exact same request type along (GETS or GETS_Owner_Pull)
        out_msg.Type := in_msg.Type;

        // Keep the original requestor so the data goes straight to the L1
        out_msg.Requestor := in_msg.Requestor;

        // Route it to the cache that downgraded but kept the valid data
        out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);

        out_msg.MessageSize := MessageSizeType:Request_Control;

        // Forward the sector masks so the sharer knows exactly which bytes to send
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := in_msg.sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
        out_msg.is_owner_pull := in_msg.is_owner_pull;
      }
    }
  }

  // ============================================================================
  // NEW & MODIFIED ACTIONS
  // ============================================================================

  action(st_saveRequestor, "\st", desc="Save pending requestor") {
    peek(requestNetwork_in, RequestMsg) {
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.last_requestor := in_msg.Requestor;
    }
  }

  action(f_commitTransferredOwner, "\fcto", desc="Commit transferred ownership") {
    Entry dir_entry := getDirectoryEntry(address);
    dir_entry.last_cpu_owner := tbe.last_requestor;
    dir_entry.cpu_shared := true;
    dir_entry.cpu_dirty := true;
    dir_entry.gpu_shared := false;
    dir_entry.gpu_dirty := false;
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(fwd_req_to_cpu, "fr2c", desc="Forward request to CPU Owner") {
    peek(requestNetwork_in, RequestMsg) {
      if (getDirectoryEntry(address).last_cpu_owner != in_msg.Requestor &&
          getDirectoryEntry(address).last_cpu_owner != machineID) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      } else {
        // ALWAYS respond with ACK_OWNER to prevent sequencer deadlock
        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.TokensSec0 := 0;
          out_msg.TokensSec1 := 0;
          out_msg.sector_mask := amtc_fullMask();
          out_msg.requested_sector_mask := amtc_fullMask();
          out_msg.token_sector_mask := 0;
          out_msg.valid_sector_mask := 0;
        }
      }
    }
  }


  // ============================================================================
  // PHASE 1: MEMORY DATA RESOLUTION FOR DOMAIN STATES
  // ============================================================================

  // When memory returns data for a CPU Shared request
  transition(CS, Memory_Data) {
    // Send data to the CPU requester (saved in TBE)
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for a GPU Shared request
  transition(GS, Memory_Data) {
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for a joint Shared request
  transition(CGS, Memory_Data) {
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for an Exclusive request (CE/GE)
  // Note: These usually need to send tokens along with the data
  transition(CE, Memory_Data) {
    // If the request was a GETX, we use the OwnerResponse to send tokens
    d_sendMemoryDataOwnerResponse;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition(GE, Memory_Data) {
    d_sendMemoryDataOwnerResponse;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // ============================================================================
  // 1. INITIALIZATION (From Invalid)
  // ============================================================================
  transition(I, CPU_GETS, CS_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, GPU_GETS, GS_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, CPU_GETX, CE_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, GPU_GETX, GE_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }


  // Memory Returns for Initialization
  transition(CS_W, Memory_Data, CS) { d_send_mem_and_1_token_cpu; u_set_cpu_shared; s_deallocateTBE; l_popMemQueue; qw_wakeUpDependents; }
  transition(CE_W, Memory_Data, CE) { d_send_mem_and_all_tokens_cpu; u_set_cpu_exclusive; s_deallocateTBE; l_popMemQueue; qw_wakeUpDependents; }
  // (Symmetric Memory_Data transitions for GS_W -> GS, GE_W -> GE)

  // ============================================================================
  // 2. CPU SHARED (CS)
  // ============================================================================
  transition(CS, CPU_GETS) {
    // Directory holds tokens and data. Reply directly.
    d_send_dir_data_and_1_token_cpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }
  transition(CS, GPU_GETS, CGS) {
    // Cross-domain: Directory already has the data! No need to fetch from memory.
    d_send_dir_data_and_1_token_gpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }
  transition(CS, CPU_GETX, CE) {
    d_send_remaining_tokens_cpu; u_set_cpu_exclusive; j_popIncomingRequestQueue;
  }
  transition(CS, GPU_GETX, MIG_C2G) {
    v_allocateTBE; fwd_inv_to_cpu; j_popIncomingRequestQueue;
  }

  transition(CGS_W, Memory_Data, CGS) {
    // Fulfill the GPU's request to join the shared state
    d_send_mem_and_1_token_gpu; u_set_gpu_shared; s_deallocateTBE; l_popMemQueue; qw_wakeUpDependents;
  }

  // ============================================================================
  // CE → CE_XFER → CE TRANSITIONS
  // ============================================================================

  // CRITICAL FIX: Instantly transfer ownership without allocating a TBE!
  transition(CE, CPU_GETX) {
    fwd_req_to_cpu;
    u_set_cpu_exclusive;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 3. CPU+GPU SHARED (CGS)
  // ============================================================================
  transition(GS, GPU_GETS) {
    d_send_dir_data_and_1_token_gpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }
  transition(GS, CPU_GETS, CGS) {
    d_send_dir_data_and_1_token_cpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }

  transition(CGS, CPU_GETS) {
    d_send_dir_data_and_1_token_cpu; j_popIncomingRequestQueue;
  }
  transition(CGS, GPU_GETS) {
    d_send_dir_data_and_1_token_gpu; j_popIncomingRequestQueue;
  }

  transition(CGS, CPU_GETX, CGS_CPU_UPG) {
    v_allocateTBE; fwd_inv_to_gpu; j_popIncomingRequestQueue;
  }
  transition(CGS_CPU_UPG, Tokens_Ack, CE) {
    // Upgrade complete when GPU returns its tokens
    f_incrementTokens; d_send_remaining_tokens_cpu; u_set_cpu_exclusive; s_deallocateTBE; k_popIncomingResponseQueue; qw_wakeUpDependents;
  }

  // ============================================================================
  // 4. CPU EXCLUSIVE (CE)
  // ============================================================================
  transition(CE, CPU_GETS) { fwd_req_to_cpu; j_popIncomingRequestQueue; }

  // FIX: Forward the GETX safely, and update the Directory's owner record
  //transition(CE, CPU_GETX) { fwd_req_to_cpu; u_set_cpu_exclusive; j_popIncomingRequestQueue; }

  transition(CE, GPU_GETS, CGS) {
    fwd_req_to_cpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }
  transition(CE, GPU_GETX, MIG_C2G) {
    v_allocateTBE; fwd_inv_to_cpu; j_popIncomingRequestQueue;
  }

  transition(MIG_C2G, Tokens_Ack, GE) {
    f_incrementTokens; d_send_remaining_tokens_gpu; u_set_gpu_exclusive; s_deallocateTBE; k_popIncomingResponseQueue; qw_wakeUpDependents;
  }

  // ============================================================================
  // 5. GPU EXCLUSIVE (GE)
  // ============================================================================
  transition(GE, GPU_GETS) { fwd_req_to_gpu; j_popIncomingRequestQueue; }

  // FIX: Safe forward and update owner
  transition(GE, GPU_GETX) { fwd_req_to_gpu; u_set_gpu_exclusive; j_popIncomingRequestQueue; }

  transition(GE, CPU_GETS, CGS) {
    fwd_req_to_gpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }
  transition(GE, CPU_GETX, MIG_G2C) {
    v_allocateTBE; fwd_inv_to_gpu; j_popIncomingRequestQueue;
  }

  // =====================================================================
  // CRITICAL FIX: Added missing completion transition to prevent TBE leaks!
  // =====================================================================
  transition(MIG_G2C, Tokens_Ack, CE) {
    f_incrementTokens;
    d_send_remaining_tokens_cpu;
    u_set_cpu_exclusive;
    s_deallocateTBE; // <--- This prevents the TBE table from filling up!
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

//============================================================================
  // 5. STALLS
  // ============================================================================

  // Stall all standard requests during memory waits, migrations, and transfers
  transition({CS_W, GS_W, CE_W, GE_W, CGS_W, MIG_C2G, MIG_G2C, CGS_CPU_UPG, CGS_GPU_UPG, CE_XFER, GE_XFER}, {CPU_GETS, GPU_GETS, CPU_GETX, GPU_GETX, GETS_Owner_Pull}) {
    z_stallAndWaitRequest;
  }

  // CRITICAL FIX: Stall all requests (including retries) during Data-Only pulls
  transition({CE_W_DataOnly, GE_W_DataOnly}, {CPU_GETS, GPU_GETS, CPU_GETX, GPU_GETX, GETS_Owner_Pull}) {
    z_stallAndWaitRequest;
  }

  // ============================================================================
  // 2. CPU SHARED (CS)
  // ============================================================================
  // Handle normal reads AND owner pulls exactly the same way: reply with data
  transition(CS, {GETS_Owner_Pull}) {
    f_forwardRequestToSharers;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 3. GPU SHARED (GS)
  // ============================================================================
  transition(GS, {GETS_Owner_Pull}) {
    d_send_dir_data_and_1_token_gpu;
    u_set_gpu_shared;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 4. CPU+GPU SHARED (CGS)
  // ============================================================================
  transition(CGS, {GETS_Owner_Pull}) {
    d_send_dir_data_and_1_token_cpu;
    j_popIncomingRequestQueue;
  }

  // Note: Since GETS_Owner_Pull doesn't distinguish between CPU and GPU in the event name,
  // we route it based on the domain. We need a GPU variant for CGS.
  // Assuming you have an event like GPU_GETS_Owner_Pull or you route it inside the in_port.
  // If you only have one GETS_Owner_Pull event, you might need to handle it based on the
  // requestor's domain inside the action or the in_port.

  // Transitions for Owner Pulling partial data
  transition(CE, GETS_Owner_Pull, CE_W_DataOnly) {
    v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue;
  }
  transition(GE, GETS_Owner_Pull, GE_W_DataOnly) {
    v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue;
  }

  // Resolution from Memory
  transition(CE_W_DataOnly, Memory_Data, CE) {
    d_send_mem_data_only_cpu; s_deallocateTBE; l_popMemQueue; qw_wakeUpDependents;
  }
  transition(GE_W_DataOnly, Memory_Data, GE) {
    d_send_mem_data_only_gpu; s_deallocateTBE; l_popMemQueue; qw_wakeUpDependents;
  }

  transition(CE_W_DataOnly, Tokens) {
    d_forward_tokens_to_cpu;
    k_popIncomingResponseQueue;
  }

  transition(GE_W_DataOnly, Tokens) {
    d_forward_tokens_to_gpu; // Assuming you made the symmetric GPU action
    k_popIncomingResponseQueue;
  }

  // Inside your CE (CPU Exclusive) block:
  transition(CE, Tokens) {
    d_forward_tokens_to_cpu;
    k_popIncomingResponseQueue; // Assuming 'j' is your action to pop the response network
  }

  // Inside your CS (CPU Shared) block:
  // (In CS, the L1 is the active reader, so it should get the loose tokens to eventually upgrade)
  transition(CS, Tokens) {
    d_forward_tokens_to_cpu;
    k_popIncomingResponseQueue;
  }



}
