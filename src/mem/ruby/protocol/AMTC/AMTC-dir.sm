machine(MachineType:Directory, "Token protocol")
 : DirectoryMemory * directory;
   int l2_select_num_bits;
   Cycles directory_latency := 5;
   bool distributed_persistent := "True";
   Cycles fixed_timeout_latency := 100;
   Cycles reissue_wakeup_latency := 10;
   Cycles to_memory_controller_latency := 1;

   // Message Queues from dir to other controllers / network
   MessageBuffer * dmaResponseFromDir, network="To", virtual_network="5",
        vnet_type="response";

   MessageBuffer * responseFromDir, network="To", virtual_network="4",
        vnet_type="response";

   MessageBuffer * requestFromDir, network="To", virtual_network="1",
        vnet_type="request";

   // Message Queues to dir from other controllers / network
   MessageBuffer * responseToDir, network="From", virtual_network="4",
        vnet_type="response";

   MessageBuffer * requestToDir, network="From", virtual_network="2",
        vnet_type="request";

   // AMTC audit83: TCC/NB forwarded RequestMsg path.
   // This is intentionally separate from requestToDir because TCC forwards
   // SQC/TCP requests on its NB path.  Directory actions handling this queue
   // must peek/pop requestNetworkFromNB_in, not requestNetwork_in.
   MessageBuffer * requestToDirFromNB, network="From", virtual_network="5",
        vnet_type="request";

   MessageBuffer * dmaRequestToDir, network="From", virtual_network="0",
        vnet_type="request";

   MessageBuffer * requestToMemory;
   MessageBuffer * responseFromMemory;
   MessageBuffer * triggerQueue;
{
  // STATES
  state_declaration(State, desc="Directory states", default="Directory_State_I") {
    // --- STABLE DOMAIN STATES ---
    I,   AccessPermission:Invalid,    desc="Dir owns all tokens, no caching";
    CS,  AccessPermission:Read_Only,  desc="CPU Shared (Dir holds remainder)";
    GS,  AccessPermission:Read_Only,  desc="GPU Shared (Dir holds remainder)";
    CGS, AccessPermission:Read_Only,  desc="CPU+GPU Shared (Dir holds remainder)";
    CE,  AccessPermission:Read_Write, desc="CPU Exclusive (CPU holds ALL tokens)";
    GE,  AccessPermission:Read_Write, desc="GPU Exclusive (GPU holds ALL tokens)";
    CE_XFER, AccessPermission:Read_Write, desc="CPU ownership transition state";
    GE_XFER, AccessPermission:Read_Write, desc="GPU ownership transition state";

    // --- TRANSIENT MEMORY WAITS ---
    CS_W,  AccessPermission:Busy, desc="Fetching memory for CPU Shared";
    GS_W,  AccessPermission:Busy, desc="Fetching memory for GPU Shared";
    CE_W,  AccessPermission:Busy, desc="Fetching memory for CPU Exclusive";
    GE_W,  AccessPermission:Busy, desc="Fetching memory for GPU Exclusive";
    CGS_W, AccessPermission:Busy, desc="Fetching memory to add domain to Shared";

    // --- TRANSIENT UPGRADES & MIGRATIONS ---
    MIG_C2G,     AccessPermission:Busy, desc="Migrating CE to GE";
    MIG_G2C,     AccessPermission:Busy, desc="Migrating GE to CE";
    CGS_CPU_UPG, AccessPermission:Busy, desc="Upgrading CGS to CE (waiting on GPU Ack)";
    CGS_GPU_UPG, AccessPermission:Busy, desc="Upgrading CGS to GE (waiting on CPU Ack)";

    CE_W_DataOnly, AccessPermission:Busy, desc="Fetching data-only for CPU Owner Pull";
    CE_W_Stale_GETX, AccessPermission:Busy, desc="Repair stale CPU-exclusive self-owner GETX by fetching memory and forcing owner tokens";
    CE_W_DMA_READ, AccessPermission:Busy, desc="DMA read while CPU-exclusive owner exists; fetch data for DMA and preserve CE";
    GE_W_DMA_READ, AccessPermission:Busy, desc="DMA read while GPU-exclusive owner exists; fetch data for DMA and preserve GE";

    CE_W_DMA_WRITE_BOTH, AccessPermission:Busy, desc="DMA write while CPU-exclusive owner exists; waiting for memory ack and CPU invalidation/data response";
    CE_W_DMA_WRITE_MEM,  AccessPermission:Busy, desc="DMA write while CPU-exclusive owner exists; waiting for memory ack after CPU invalidation response";
    CE_W_DMA_WRITE_TOK,  AccessPermission:Busy, desc="DMA write while CPU-exclusive owner exists; waiting for CPU invalidation/data response after memory ack";
    GE_W_DMA_WRITE_BOTH, AccessPermission:Busy, desc="DMA write while GPU-exclusive owner exists; waiting for memory ack and GPU invalidation/data response";
    GE_W_DMA_WRITE_MEM,  AccessPermission:Busy, desc="DMA write while GPU-exclusive owner exists; waiting for memory ack after GPU invalidation response";
    GE_W_DMA_WRITE_TOK,  AccessPermission:Busy, desc="DMA write while GPU-exclusive owner exists; waiting for GPU invalidation/data response after memory ack";

    GE_W_DataOnly, AccessPermission:Busy, desc="Fetching data-only for GPU Owner Pull";
    I_DMA_W, AccessPermission:Busy, desc="Fetching memory for DMA read from Invalid";

    CS_DMA_R_W, AccessPermission:Busy, desc="DMA read from CPU-shared state";
    CGS_DMA_R_W, AccessPermission:Busy, desc="DMA read from CPU/GPU-shared state";
    GS_DMA_R_W, AccessPermission:Busy, desc="DMA read from GPU-shared state";

    I_DMA_WRITE_W, AccessPermission:Busy, desc="DMA write from Invalid; waiting for memory ack";
  }

  // Events
  enumeration(Event, desc="Directory events") {
    CPU_GETS, desc="A GETS from the CPU domain";
    GPU_GETS, desc="A GETS from the GPU domain";
    // AMTC audit83: same logical GPU requests, but arriving from the new
    // requestNetworkFromNB_in queue.  They need queue-specific actions.
    GPU_GETS_NB, desc="A GETS from the GPU/TCC NB path";
    CPU_GETX, desc="A GETX from the CPU domain";
    CPU_GETX_Stale_Self, desc="Retrying CPU GETX after stale self-owner/no-progress loop";
    GPU_GETX, desc="A GETX from the GPU domain";
    GPU_GETX_NB, desc="A GETX from the GPU/TCC NB path";

    Lockdown, desc="A lockdown request arrives";
    Unlockdown, desc="An un-lockdown request arrives";
    Own_Lock_or_Unlock, desc="own lock or unlock";
    Own_Lock_or_Unlock_Tokens, desc="own lock or unlock with tokens";
    Data_Owner, desc="Data arrive";
    Data_Shared,  desc="Data from a sharer";
    Ack_Owner, desc="Owner token arrived without data because it was clean";
    Tokens, desc="Tokens arrive";
    Request_Timeout, desc="A DMA request has timed out";

    // Memory Controller
    Memory_Data, desc="Data from memory arrives";
    Tokens_Ack,  desc="Tokens returned from an invalidation";
    Memory_Ack, desc="Writeback Ack from memory arrives";
    Memory_Data_Stale, desc="Late memory data without a live TBE; consume only";
    Memory_Ack_Stale, desc="Late memory writeback ACK without a live TBE; consume only";

    // DMA requests
    DMA_READ, desc="A DMA Read memory request";
    DMA_WRITE, desc="A DMA Write memory request";
    GETS_Owner_Pull, desc="The Owner is requesting raw data for a missing sector";
    GETS_Owner_Pull_NB, desc="TCC/NB owner-pull repair GETS from stale-owner ACK path";

    CPU_GETS_Owner_Pull_Repair, desc="CPU GETS retry after stale owner ACK; do not forward again";



    // TWO INTERNAL TRIGGERS ---
    Write_Complete,  desc="Internal trigger: All data and tokens for a write are accumulated";
    Read_Complete,   desc="Internal trigger: All data for a read is accumulated";
    Tokens_All_Collected, desc="requested all tocken collected";
    Data_Owner_All_Collected, desc="Data and final tokens arrived from an eviction";
  }

  // TYPES
  // DirectoryEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry", main="false") {
    //State DirectoryState,          desc="Directory state";
    //int Tokens, default="max_tokens()", desc="Number of tokens for the line we're holding";
    int TokensSec0, default="max_tokens() / 2", desc="AMTC token count for sector 0";
    int TokensSec1, default="max_tokens() / 2", desc="AMTC token count for sector 1";
    int ValidSectors, default="0", desc="AMTC memory-valid sectors tracked by the directory";
    int DirtySectors, default="0", desc="AMTC dirty sectors known by the directory";
    int OwnerSectorMask, default="0", desc="AMTC sectors likely held by owner";
    int SharerSectorMask, default="0", desc="AMTC sectors likely shared";
    int RequestedSectorMask, default="0", desc="AMTC requested sector mask for outstanding directory transaction";
    int ReceivedSectorMask, default="0", desc="AMTC sectors received for outstanding directory transaction";
    int LastSectorID, default="0", desc="AMTC primary sector id for outstanding transaction";

    Set Owner,                     desc="Probable Owner of the line.  More accurately, the set of processors who need to see a GetS or GetO.  We use a Set for convenience, but only one bit is set at a time.";
    Set Sharers,                   desc="Probable sharers of the line.  More accurately, the set of processors who need to see a GetX";

    State DirectoryState,          desc="Directory state";
  DataBlock DataBlk,             desc="data for the block";

  // --- PHASE 1: DOMAIN METADATA ---
  bool cpu_shared, default="false";
  bool gpu_shared, default="false";
  bool cpu_dirty,  default="false";
  bool gpu_dirty,  default="false";
  MachineID last_cpu_owner;
  MachineID last_gpu_owner;
  }


  // TBE entries for DMA requests
  structure(TBE, desc="TBE entries for outstanding DMA requests") {
    //Addr PhysicalAddress, desc="physical address";
    //State TBEState,        desc="Transient State";
    //DataBlock DataBlk,     desc="Current view of the associated address range";
    //int Len,               desc="...";
    //MachineID DmaRequestor, desc="DMA requestor";
    MachineID OriginalRequestorMachId;
    bool WentPersistent,   desc="Did the DMA request require a persistent request";
    int RequestedSectorMask, default="3", desc="AMTC requested sector mask for outstanding directory transaction";
    int ReceivedSectorMask, default="0", desc="AMTC sectors received for outstanding directory transaction";
    int TokenReadySectorMask, default="0", desc="AMTC sectors with tokens ready for response";
    int LastSectorID, default="0", desc="AMTC primary sector id for outstanding transaction";
    bool FromGPU, default="false", desc="AMTC transaction originated from GPU-side controller";
    bool IsSyncRequest, default="false", desc="AMTC transaction requires coherent sync semantics";

    Addr PhysicalAddress,   desc="Physical address for this TBE";
  State TBEState,        desc="Transient state";
  DataBlock DataBlk,     desc="Data block";
  int Len,               desc="Data block length";
  MachineID DmaReqDest,  desc="DMA requestor";
  // ADD THIS LINE HERE
  MachineID last_requestor, desc="ID of the original requestor for domain tracking";

  // --- PHASE 1: TBE EXTENSION ---
  bool req_from_cpu,     default="false";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  structure(TriggerMsg, desc="Internal trigger message", interface="Message") {
    Addr addr, desc="Physical address";
    Event Type, desc="Event to trigger";
    // CRITICAL FIX: Use the underscore instead of the colon here
    MessageSizeType MessageSize, default="MessageSizeType_Request_Control";
  }

  // ** OBJECTS **

  TimerTable reissueTimerTable;
  TBETable TBEs, template="<Directory_TBE>", constructor="m_number_of_TBEs";
  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  Tick clockEdge();
  Tick clockEdge(Cycles c);
  Tick cyclesToTicks(Cycles c);
  void set_tbe(TBE b);
  void unset_tbe();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  void wakeUpAllBuffers();
  void wakeUpBuffers(Addr a);

  // -------------------------------------------------------------------------
  // AMTC compact sector helpers.
  // Physical Ruby coherence block remains 64B. Logical sharing is represented
  // as 2 x 32B sectors: sector 0 = bytes 0..31, sector 1 = bytes 32..63.
  // Full-line mask is 3. Old full-line mask values such as 15 are sanitized
  // to 3 so untrimmed controllers cannot accidentally re-enable 4 sectors.
  // -------------------------------------------------------------------------

  // Helper to determine origin domain
  bool is_cpu_domain(MachineID mach) {
    // Use machineIDToMachineType to extract the enum for comparison
    return (machineIDToMachineType(mach) == MachineType:L2Cache ||
            machineIDToMachineType(mach) == MachineType:L1Cache);
  }
  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  Entry getDirectoryEntry(Addr addr), return_by_pointer="yes" {
    Entry dir_entry := static_cast(Entry, "pointer", directory[addr]);

    if (is_valid(dir_entry)) {
      return dir_entry;
    }

    dir_entry :=  static_cast(Entry, "pointer",
                              directory.allocate(addr, new Entry));
    return dir_entry;
  }

  State getState(TBE tbe, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else {
      return getDirectoryEntry(addr).DirectoryState;
    }
  }

  void setState(TBE tbe, Addr addr, State state) {
    if (is_valid(tbe)) {
      tbe.TBEState := state;
    }
    getDirectoryEntry(addr).DirectoryState := state;
    Entry dir_entry := getDirectoryEntry(addr);

    assert((dir_entry.Owner.count() == 0) || (dir_entry.Owner.count() == 1));

    // 1. ABSOLUTE BOUNDS: Tokens can never be negative or exceed the maximum
    assert(dir_entry.TokensSec0 >= 0);
    assert(dir_entry.TokensSec0 <= (max_tokens() / 2));
    assert(dir_entry.TokensSec1 >= 0);
    assert(dir_entry.TokensSec1 <= (max_tokens() / 2));

    // ====================================================================
    // 2. PHASE 1 DOMAIN INVARIANTS
    // ====================================================================

    // INVARIANT A: Invalid & cold initialization wait states.
    //
    // Audit81:
    // Only I/CS_W/GS_W mean the directory is waiting before any exclusive
    // owner owns the line, so only these states require the directory to hold
    // all tokens.  CE_W/GE_W are exclusive-owner wait paths: tokens can still
    // be outside the directory while forwarded owner/DMA-write invalidation
    // responses are in flight.
    if (state == State:I || state == State:CS_W || state == State:GS_W) {
      assert(dir_entry.TokensSec0 == (max_tokens() / 2));
      assert(dir_entry.TokensSec1 == (max_tokens() / 2));
    }

    if (state == State:CE_W || state == State:GE_W ||
        state == State:CE_W_DMA_READ ||
        state == State:GE_W_DMA_READ ||
        state == State:CE_W_DMA_WRITE_BOTH ||
        state == State:CE_W_DMA_WRITE_MEM ||
        state == State:CE_W_DMA_WRITE_TOK ||
        state == State:GE_W_DMA_WRITE_BOTH ||
        state == State:GE_W_DMA_WRITE_MEM ||
        state == State:GE_W_DMA_WRITE_TOK) {
      DPRINTF(RubySlicc,
        "AMTC_DIR_STATE_CHECK_SKIP_EXCL_OR_DMA_WAIT addr=%#x state=%s T0=%d T1=%d owner=%s\n",
        addr, state, dir_entry.TokensSec0, dir_entry.TokensSec1,
        dir_entry.last_cpu_owner);
    }

    // INVARIANT B: Stable Exclusive
    // If a domain has stable exclusive write access, the Directory MUST hold 0 tokens.
    if (state == State:CE || state == State:GE || state == State:CE_W_DataOnly || state == State:GE_W_DataOnly) {
      assert(dir_entry.TokensSec0 == 0);
      assert(dir_entry.TokensSec1 == 0);
    }

    // INVARIANT C: Shared & In-Flight Upgrades
    if (state == State:CS || state == State:GS || state == State:CGS || state == State:CGS_W || state == State:CE || state == State:GE) {

       int max_t := max_tokens() / 2;
       assert((dir_entry.TokensSec0 < max_t) || (dir_entry.TokensSec1 < max_t));
     }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      return Directory_State_to_permission(tbe.TBEState);
    }

    if (directory.isPresent(addr)) {
      DPRINTF(RubySlicc, "%s\n", Directory_State_to_permission(getDirectoryEntry(addr).DirectoryState));
      return Directory_State_to_permission(getDirectoryEntry(addr).DirectoryState);
    }

    DPRINTF(RubySlicc, "AccessPermission_NotPresent\n");
    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Addr addr, State state) {
    getDirectoryEntry(addr).changePermission(Directory_State_to_permission(state));
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      testAndRead(addr, tbe.DataBlk, pkt);
    } else {
      functionalMemoryRead(pkt);
    }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;

    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes +
            testAndWrite(addr, tbe.DataBlk, pkt);
    }

    num_functional_writes := num_functional_writes + functionalMemoryWrite(pkt);
    return num_functional_writes;
  }

  bool amtc_hasAllTokens(Addr addr) {

    Entry entry := getDirectoryEntry(addr);

    return
        (entry.TokensSec0 == (max_tokens() / 2)) &&
        (entry.TokensSec1 == (max_tokens() / 2));
  }

  bool amtc_hasRequestedData(TBE tbe) {
    return amtc_maskContainsAll(tbe.ReceivedSectorMask, tbe.RequestedSectorMask);
  }

  bool amtc_hasRequestedTokens(TBE tbe) {
    return amtc_maskContainsAll(tbe.TokenReadySectorMask, tbe.RequestedSectorMask);
  }

  bool amtc_readComplete(TBE tbe) {
    return amtc_hasRequestedData(tbe);
  }

  bool amtc_writeComplete(Addr addr, TBE tbe) {
    return amtc_hasRequestedData(tbe) && amtc_hasRequestedTokens(tbe);
  }

  void amtc_assertTokenBounds(int tokens) {
    assert(tokens >= 0);
    assert(tokens <= (max_tokens() / 2));
  }

  // ** OUT_PORTS **
  out_port(responseNetwork_out, ResponseMsg, responseFromDir);
  out_port(requestNetwork_out, RequestMsg, requestFromDir);
  out_port(dmaResponseNetwork_out, DMAResponseMsg, dmaResponseFromDir);
  out_port(memQueue_out, MemoryMsg, requestToMemory);
  out_port(triggerQueue_out, TriggerMsg, triggerQueue);

  // ** IN_PORTS **
  // off-chip memory request/response is done
  in_port(memQueue_in, MemoryMsg, responseFromMemory) {
    if (memQueue_in.isReady(clockEdge())) {
      peek(memQueue_in, MemoryMsg) {
        if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
          // AMTC audit8: MEMORY_READ data may arrive after the request TBE
          // was already satisfied/deallocated by a forwarded owner response.
          // Do not use TBEs[in_msg.addr] unless the TBE is present; operator[]
          // can dereference/create an invalid entry and crash in recvTimingResp.
          if (TBEs.isPresent(in_msg.addr)) {
            trigger(Event:Memory_Data, in_msg.addr, TBEs[in_msg.addr]);
          } else {
            trigger(Event:Memory_Data_Stale, in_msg.addr, TBEs.lookup(in_msg.addr));
          }
        } else if (in_msg.Type == MemoryRequestType:MEMORY_WB) {
          // AMTC audit8: MEMORY_WB acknowledgements may arrive after the
          // original writeback TBE was deallocated or while a new same-line
          // memory-read TBE is active.  Route no-TBE ACKs to a stale sink.
          if (TBEs.isPresent(in_msg.addr)) {
            trigger(Event:Memory_Ack, in_msg.addr, TBEs[in_msg.addr]);
          } else {
            trigger(Event:Memory_Ack_Stale, in_msg.addr, TBEs.lookup(in_msg.addr));
          }
        } else {
          DPRINTF(RubySlicc, "%s\n", in_msg.Type);
          error("Invalid message");
        }
      }
    }
  }

  // Reissue Timer
  in_port(reissueTimerTable_in, Addr, reissueTimerTable) {
    Tick current_time := clockEdge();
    if (reissueTimerTable_in.isReady(current_time)) {
      Addr addr := reissueTimerTable.nextAddress();
      trigger(Event:Request_Timeout, addr, TBEs.lookup(addr));
    }
  }

  in_port(responseNetwork_in, ResponseMsg, responseToDir) {
    if (responseNetwork_in.isReady(clockEdge())) {
        peek(responseNetwork_in, ResponseMsg) {
            assert(in_msg.Destination.isElement(machineID));

            Entry dir_entry := getDirectoryEntry(in_msg.addr);
            int total_T0 := dir_entry.TokensSec0;
            int total_T1 := dir_entry.TokensSec1;

            // Classify completion using the actual token counts that will
            // be absorbed by q_updateTokensFromResponse.  Some replacement
            // paths carry data for only one sector but return tokens for both;
            // older messages may have token_sector_mask narrower than the
            // non-zero token fields.  The classifier and updater must agree.
            if (in_msg.TokensSec0 > 0 ||
                in_msg.token_sector_mask == 1 || in_msg.token_sector_mask == 3) {
                total_T0 := total_T0 + in_msg.TokensSec0;
            }

            if (in_msg.TokensSec1 > 0 ||
                in_msg.token_sector_mask == 2 || in_msg.token_sector_mask == 3) {
                total_T1 := total_T1 + in_msg.TokensSec1;
            }

            int max_t := max_tokens() / 2;
            bool is_final_piece := ((total_T0 >= max_t) && (total_T1 >= max_t));
            DPRINTF(RubySlicc, "AMTC_DIR_CLASSIFY_RESP addr=%#x type=%d curT0=%d curT1=%d inT0=%d inT1=%d tokmask=%x totalT0=%d totalT1=%d max=%d final=%d\n",
                    in_msg.addr, in_msg.Type, dir_entry.TokensSec0, dir_entry.TokensSec1,
                    in_msg.TokensSec0, in_msg.TokensSec1, in_msg.token_sector_mask,
                    total_T0, total_T1, max_t, is_final_piece);

            // =================================================================
            // 1. TOKEN RECOVERY
            // =================================================================
            if (in_msg.Type == CoherenceResponseType:ACK ||
                in_msg.Type == CoherenceResponseType:WB_TOKENS) {

                if (is_final_piece) {
                    trigger(Event:Tokens_All_Collected, in_msg.addr, TBEs[in_msg.addr]);
                } else {
                    trigger(Event:Tokens, in_msg.addr, TBEs[in_msg.addr]);
                }
            }

            // =================================================================
            // 2. DATA RECOVERY
            // =================================================================
            else if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
                     in_msg.Type == CoherenceResponseType:WB_OWNED ||
                     in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {

                if (is_final_piece) {
                    trigger(Event:Data_Owner_All_Collected, in_msg.addr, TBEs[in_msg.addr]);
                } else {
                    trigger(Event:Data_Owner, in_msg.addr, TBEs[in_msg.addr]);
                }
            }

            // =================================================================
            // 3. OTHER STANDARD RESPONSES
            // =================================================================
            else if (in_msg.Type == CoherenceResponseType:DATA_SHARED) {
                trigger(Event:Data_Shared, in_msg.addr, TBEs[in_msg.addr]);

            } else if (in_msg.Type == CoherenceResponseType:ACK_OWNER) {
                trigger(Event:Ack_Owner, in_msg.addr, TBEs[in_msg.addr]);

            } else {
                DPRINTF(RubySlicc, "Invalid response type: %s\n", in_msg.Type);
                error("Invalid response type");
            }
        }
    }
  }

  in_port(requestNetwork_in, RequestMsg, requestToDir) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        DPRINTF(RubySlicc,
                "AMTC_DIR_REQ_RAW_IN addr=%#x type=%s requestor=%s is_gpu=%d mask=%d reqmask=%d retry=%d ownerpull=%d\n",
                in_msg.addr,
                in_msg.Type,
                in_msg.Requestor,
                in_msg.is_gpu,
                in_msg.sector_mask,
                in_msg.requested_sector_mask,
                in_msg.RetryNum,
                in_msg.is_owner_pull);

        if (in_msg.Type == CoherenceRequestType:GETS) {
          if (is_cpu_domain(in_msg.Requestor)) {
            if (in_msg.RetryNum > 0 || in_msg.is_owner_pull) {
              DPRINTF(RubySlicc,
                      "AMTC_DIR_CPU_GETS_RETRY_REPAIR_IN_V21 addr=%#x req=%s retry=%d ownerpull=%d mask=%d reqmask=%d\n",
                      in_msg.addr,
                      in_msg.Requestor,
                      in_msg.RetryNum,
                      in_msg.is_owner_pull,
                      in_msg.sector_mask,
                      in_msg.requested_sector_mask);

              trigger(Event:CPU_GETS_Owner_Pull_Repair,
                      in_msg.addr, TBEs[in_msg.addr]);
            } else {
              trigger(Event:CPU_GETS, in_msg.addr, TBEs[in_msg.addr]);
            }
          } else {
            trigger(Event:GPU_GETS, in_msg.addr, TBEs[in_msg.addr]);
          }
        } else if (in_msg.Type == CoherenceRequestType:GETX) {
          if (is_cpu_domain(in_msg.Requestor)) {
            DPRINTF(RubySlicc,
                    "AMTC_DIR_CPU_GETX_CLASSIFY addr=%#x req=%s retry=%d ownerpull=%d mask=%d reqmask=%d\n",
                    in_msg.addr,
                    in_msg.Requestor,
                    in_msg.RetryNum,
                    in_msg.is_owner_pull,
                    in_msg.sector_mask,
                    in_msg.requested_sector_mask);

            /*
             * AMTC audit90:
             * Detect stale self-owner GETX much earlier than the old retry>=32
             * threshold.  The observed deadlock is:
             *   DIR state CE, owner=L2Cache-0, requestor=L2Cache-0,
             *   ownerpull=1, reqmask=3, but Directory holds no requested tokens.
             * The old CE->CPU_GETX path calls fwd_req_to_cpu(), which then sends
             * DATA_OWNER with send0=0/send1=0.  L2 enters IX with valid data but
             * no tokens and retries forever.  Treat that as stale metadata and
             * use the existing CE_W_Stale_GETX memory/forced-token repair path.
             */
            int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
            if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }
            if (req_mask == 0) { req_mask := amtc_fullMask(); }

            Entry dir_entry := getDirectoryEntry(in_msg.addr);
            bool stale_self_owner_zero_token := false;

            if (in_msg.RetryNum > 0 || in_msg.is_owner_pull) {
              if (dir_entry.last_cpu_owner == in_msg.Requestor ||
                  dir_entry.last_cpu_owner == machineID) {
                bool any_dir_token_for_req := false;

                if (amtc_maskHasSector(req_mask, 0) &&
                    dir_entry.TokensSec0 > 0) {
                  any_dir_token_for_req := true;
                }

                if (amtc_maskHasSector(req_mask, 1) &&
                    dir_entry.TokensSec1 > 0) {
                  any_dir_token_for_req := true;
                }

                if (!any_dir_token_for_req) {
                  stale_self_owner_zero_token := true;
                }
              }
            }

            if (stale_self_owner_zero_token) {
              DPRINTF(RubySlicc,
                      "AMTC_DIR_CPU_GETX_STALE_SELF_ZERO_TOKEN addr=%#x req=%s owner=%s retry=%d ownerpull=%d mask=%d T0=%d T1=%d\n",
                      in_msg.addr,
                      in_msg.Requestor,
                      dir_entry.last_cpu_owner,
                      in_msg.RetryNum,
                      in_msg.is_owner_pull,
                      req_mask,
                      dir_entry.TokensSec0,
                      dir_entry.TokensSec1);

              trigger(Event:CPU_GETX_Stale_Self,
                      in_msg.addr, TBEs[in_msg.addr]);
            } else if (in_msg.RetryNum >= 32) {
              trigger(Event:CPU_GETX_Stale_Self,
                      in_msg.addr, TBEs[in_msg.addr]);
            } else {
              trigger(Event:CPU_GETX,
                      in_msg.addr, TBEs[in_msg.addr]);
            }
          } else {
            trigger(Event:GPU_GETX,
                    in_msg.addr, TBEs[in_msg.addr]);
          }

        } else {
          error("Invalid request message to Directory");
        }
      }
    }
  }


  // AMTC audit83: TCC/NB forwarded request path.
  // This prevents old transitions from peeking requestNetwork_in while the
  // current message is actually in requestNetworkFromNB_in.
  in_port(requestNetworkFromNB_in, RequestMsg, requestToDirFromNB) {
    if (requestNetworkFromNB_in.isReady(clockEdge())) {
      peek(requestNetworkFromNB_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        DPRINTF(RubySlicc,
                "AMTC_DIR_REQ_FROM_NB_RAW addr=%#x type=%s requestor=%s is_gpu=%d owner_pull=%d retry=%d mask=%d\n",
                in_msg.addr,
                in_msg.Type,
                in_msg.Requestor,
                in_msg.is_gpu,
                in_msg.is_owner_pull,
                in_msg.RetryNum,
                in_msg.sector_mask);

        if (in_msg.is_owner_pull) {
          DPRINTF(RubySlicc,
                  "AMTC_DIR_NB_OWNER_PULL_GETS addr=%#x requestor=%s retry=%d mask=%d\n",
                  in_msg.addr,
                  in_msg.Requestor,
                  in_msg.RetryNum,
                  in_msg.requested_sector_mask);
          trigger(Event:GETS_Owner_Pull_NB, in_msg.addr, TBEs[in_msg.addr]);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          if (is_cpu_domain(in_msg.Requestor)) {
            trigger(Event:CPU_GETS, in_msg.addr, TBEs[in_msg.addr]);
          } else {
            trigger(Event:GPU_GETS_NB, in_msg.addr, TBEs[in_msg.addr]);
          }
        } else if (in_msg.Type == CoherenceRequestType:GETX) {
          if (is_cpu_domain(in_msg.Requestor)) {
            if (in_msg.RetryNum >= 32) {
              trigger(Event:CPU_GETX_Stale_Self, in_msg.addr, TBEs[in_msg.addr]);
            } else {
              trigger(Event:CPU_GETX, in_msg.addr, TBEs[in_msg.addr]);
            }
          } else {
            trigger(Event:GPU_GETX_NB, in_msg.addr, TBEs[in_msg.addr]);
          }
        } else {
          error("Invalid NB request message");
        }
      }
    }
  }

  in_port(dmaRequestQueue_in, DMARequestMsg, dmaRequestToDir) {
      if (dmaRequestQueue_in.isReady(clockEdge())) {
          peek(dmaRequestQueue_in, DMARequestMsg) {
              // AMTC bring-up debug: prove whether HSAPP/DMA requests enter the
              // directory and which directory state currently owns the line.
              DPRINTF(RubySlicc,
                      "AMTC_DIR_DMA_REQ_IN addr=%#x phys=%#x type=%s req=%s state=%s tbe_valid=%d\n",
                      in_msg.LineAddress,
                      in_msg.PhysicalAddress,
                      in_msg.Type,
                      in_msg.Requestor,
                      getState(TBEs[in_msg.LineAddress], in_msg.LineAddress),
                      is_valid(TBEs[in_msg.LineAddress]));

              if (in_msg.Type == DMARequestType:READ) {
                  trigger(Event:DMA_READ,
                          in_msg.LineAddress,
                          TBEs[in_msg.LineAddress]);
              } else if (in_msg.Type == DMARequestType:WRITE) {
                  trigger(Event:DMA_WRITE,
                          in_msg.LineAddress,
                          TBEs[in_msg.LineAddress]);
              } else {
                  error("Invalid DMA message");
              }
          }
      }
  }

  in_port(triggerQueue_in, TriggerMsg, triggerQueue) {
    if (triggerQueue_in.isReady(clockEdge())) {
      peek(triggerQueue_in, TriggerMsg) {
        // Dynamically trigger the event stored in the message
        trigger(in_msg.Type, in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Actions

  action(a_sendTokens, "a", desc="Send tokens to requestor") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int send_t0 := 0;
      int send_t1 := 0;

      if (in_msg.Type == CoherenceRequestType:GETS) {
          // Give 1 token for requested sectors
          if (amtc_maskHasSector(in_msg.sector_mask, 0) && dir_entry.TokensSec0 > 0) { send_t0 := 1; }
          if (amtc_maskHasSector(in_msg.sector_mask, 1) && dir_entry.TokensSec1 > 0) { send_t1 := 1; }
      } else {
          // GETX: Give ALL tokens we hold for the requested sectors
          if (amtc_maskHasSector(in_msg.sector_mask, 0)) { send_t0 := dir_entry.TokensSec0; }
          if (amtc_maskHasSector(in_msg.sector_mask, 1)) { send_t1 := dir_entry.TokensSec1; }
      }

      if (send_t0 > 0 || send_t1 > 0) {
          enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
            out_msg.addr := address;
            out_msg.Type := CoherenceResponseType:ACK;
            out_msg.Sender := machineID;
            out_msg.Destination.add(in_msg.Requestor);

            out_msg.TokensSec0 := send_t0;
            out_msg.TokensSec1 := send_t1;

            out_msg.sector_id := in_msg.sector_id;
            out_msg.sector_mask := in_msg.sector_mask;
            out_msg.token_sector_mask := in_msg.sector_mask;
            out_msg.requested_sector_mask := in_msg.requested_sector_mask;
            out_msg.MessageSize := MessageSizeType:Response_Control;
          }
          dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
          dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;
      }
    }
  }

  action(bw_broadcastWrite, "bw", desc="Broadcast GETX if we need tokens") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      //
      // Assert that we only send a message if we don't already have ALL the tokens
      // for BOTH sectors.
      //
      Entry dir_entry := getDirectoryEntry(address);
      assert((dir_entry.TokensSec0 < (max_tokens() / 2)) ||
             (dir_entry.TokensSec1 < (max_tokens() / 2)));

      enqueue(requestNetwork_out, RequestMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        //
        // Since only one chip, assuming all L1 caches are local
        //
        out_msg.Destination.broadcast(MachineType:L1Cache);
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.RetryNum := 0;
        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;

        // AMTC Metadata: DMA writes request the full line
        out_msg.sector_id := 0;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
        out_msg.is_gpu := false;
        out_msg.is_sync := false;
      }
    }
  }

  action(br_broadcastRead, "br", desc="Broadcast GETS for data") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;

        //
        // Since only one chip, assuming all L1 caches are local
        //
        out_msg.Destination.broadcast(MachineType:L1Cache);
        out_msg.Destination.add(mapAddressToRange(address,
                                  MachineType:L2Cache, l2_select_low_bit,
                                  l2_select_num_bits, intToID(0)));

        out_msg.RetryNum := 0;
        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
      }
    }
  }

  action(cwc_checkWriteComplete, "cwc", desc="Check Write completion and fire trigger") {
    if (amtc_hasRequestedTokens(tbe) && amtc_hasRequestedData(tbe)) {
        enqueue(triggerQueue_out, TriggerMsg, 1) {
            out_msg.addr := address;
            out_msg.Type := Event:Write_Complete;
        }
    }
  }

  action(crc_checkReadComplete, "crc", desc="Check Read completion and fire trigger") {
    if (amtc_hasRequestedTokens(tbe) && amtc_hasRequestedData(tbe)) {
        enqueue(triggerQueue_out, TriggerMsg, 1) {
            out_msg.addr := address;
            out_msg.Type := Event:Read_Complete;
        }
    }
  }

  action(d_sendMemoryDataOwnerResponse, "d", desc="Send data to requestor without tokens") {
    peek(memQueue_in, MemoryMsg) {

      Entry entry := getDirectoryEntry(address);
      int req_mask := entry.RequestedSectorMask;
      MachineID dest;

      if (req_mask == 0) {
          //req_mask := amtc_fullMask();
      }

      int req_sid := entry.LastSectorID;

      if (is_valid(tbe)) {
          req_mask := tbe.RequestedSectorMask;
          if (req_mask == 0) {
            //req_mask := amtc_fullMask();
          }
          req_sid := tbe.LastSectorID;
          dest := tbe.OriginalRequestorMachId;
        }  else {
          dest := in_msg.OriginalRequestorMachId;
        }

      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        //out_msg.Destination.add(in_msg.OriginalRequestorMachId);
        out_msg.Destination.add(dest);

        // CRITICAL FIX: No assert! No token math! We already sent the tokens!
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;

        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := false;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.sector_id := req_sid;
        out_msg.sector_mask := amtc_sanitizeMask(req_mask);
        out_msg.valid_sector_mask := amtc_sanitizeMask(req_mask);

        // CRITICAL FIX: token_sector_mask is 0 because there are no tokens here.
        out_msg.token_sector_mask := 0;
        out_msg.requested_sector_mask := amtc_sanitizeMask(req_mask);
        out_msg.merged_resp := false;
      }
    }
  }

  action(qf_queueMemoryFetchRequest, "qf", desc="Queue off-chip fetch request") {
    peek(requestNetwork_in, RequestMsg) {

      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int req_sid := amtc_primarySectorFromMask(req_mask);
      Entry entry := getDirectoryEntry(address);

      entry.RequestedSectorMask := req_mask;
      entry.LastSectorID := req_sid;

      if (is_valid(tbe)) {
        tbe.RequestedSectorMask := req_mask;
        tbe.OriginalRequestorMachId := in_msg.Requestor;
        tbe.LastSectorID := req_sid;
        tbe.ReceivedSectorMask := 0;
        tbe.TokenReadySectorMask := 0;
      }

      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := in_msg.Requestor;
        out_msg.OriginalRequestorMachId := in_msg.Requestor;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 64;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_QUEUE_MEM_FULL addr=%#x sid=%d mask=%d len=64\n",
        address, req_sid, req_mask);
    }
  }

  action(fd_memoryDma, "fd", desc="Queue off-chip DMA read fetch request") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := in_msg.Requestor;
        out_msg.OriginalRequestorMachId := in_msg.Requestor;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 64;
      }
      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_MEM_READ_FULL addr=%#x mask=%d len=64\n",
        address, dma_mask);
    }
  }

  action(lq_queueMemoryWbRequest, "lq", desc="Write data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := in_msg.Sender;
        out_msg.OriginalRequestorMachId := in_msg.Sender;
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Len := 64;
      }
    }
  }

  action(ld_queueMemoryDmaWriteFromTbe, "ld", desc="Write DMA data to memory") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      //out_msg.Sender := tbe.DmaRequestor;
      out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Len := 64;
    }
  }

  action(lr_queueMemoryDmaReadWriteback, "lr",
         desc="Write DMA data from read to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := machineID;
        out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Len := 64;
      }
    }
  }

  action(vd_allocateDmaRequestInTBE, "vd", desc="Record DMA request in TBE") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int dma_sid := amtc_primarySectorFromMask(dma_mask);

      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.DataBlk := in_msg.DataBlk;
      tbe.PhysicalAddress := in_msg.PhysicalAddress;
      tbe.Len := in_msg.Len;
      tbe.DmaReqDest := in_msg.Requestor;
      tbe.OriginalRequestorMachId := in_msg.Requestor;
      tbe.RequestedSectorMask := dma_mask;
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.LastSectorID := dma_sid;
      tbe.WentPersistent := false;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_TBE_INIT addr=%#x mask=%d sid=%d len=%d\n",
        address, dma_mask, dma_sid, in_msg.Len);
    }
  }

  action(rd_recordDataInTbe, "rd", desc="Record data in TBE") {
    peek(responseNetwork_in, ResponseMsg) {
      DataBlock DataBlk := tbe.DataBlk;
      tbe.DataBlk := in_msg.DataBlk;
      tbe.DataBlk.copyPartial(DataBlk, getOffset(tbe.PhysicalAddress),
                              tbe.Len);
    }
  }

  action(f_incrementTokens, "f", desc="Increment the number of tokens we're tracking") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      dir_entry.TokensSec0 := dir_entry.TokensSec0 + in_msg.TokensSec0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 + in_msg.TokensSec1;
    }
  }

  action(aat_assertAllTokens, "aat", desc="assert that we have all tokens") {
    assert(getDirectoryEntry(address).TokensSec0 == (max_tokens() / 2));
    assert(getDirectoryEntry(address).TokensSec1 == (max_tokens() / 2));
  }

  action(j_popIncomingRequestQueue, "j", desc="Pop incoming request queue") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(j_popIncomingRequestFromNBQueue, "jnb", desc="Pop incoming TCC/NB request queue") {
    requestNetworkFromNB_in.dequeue(clockEdge());
  }

  action(z_recycleRequest, "z", desc="Recycle the request queue") {
    DPRINTF(RubySlicc,
            "AMTC_DIR_RECYCLE_REQ addr=%#x transient_retry_or_wait\n",
            address);
    requestNetwork_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(k_popIncomingResponseQueue, "k", desc="Pop incoming response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }


  action(absorbLateSharedDataResponse, "alsd",
         desc="Absorb late/bounced DATA_SHARED response at Directory") {
    peek(responseNetwork_in, ResponseMsg) {
      DPRINTF(RubySlicc,
              "AMTC_DIR_ABSORB_LATE_DATA_SHARED addr=%#x sender=%s valid=%d tokmask=%d t0=%d t1=%d ",
              address,
              in_msg.Sender,
              in_msg.valid_sector_mask,
              in_msg.token_sector_mask,
              in_msg.TokensSec0,
              in_msg.TokensSec1);
    }
  }

  action(absorbStableStaleOwnerAck, "asoa",
         desc="Absorb stale zero-token ACK_OWNER responses in stable Directory states") {
    peek(responseNetwork_in, ResponseMsg) {
      DPRINTF(RubySlicc,
              "AMTC_DIR_ABSORB_STALE_ACK_OWNER addr=%#x sender=%s state_stable=1 valid=%d tokmask=%d t0=%d t1=%d reqmask=%d\n",
              address,
              in_msg.Sender,
              in_msg.valid_sector_mask,
              in_msg.token_sector_mask,
              in_msg.TokensSec0,
              in_msg.TokensSec1,
              in_msg.requested_sector_mask);
    }
  }

  action(kz_recycleResponse, "kz", desc="Recycle incoming response queue") {
    responseNetwork_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(p_popDmaRequestQueue, "pd", desc="pop dma request queue") {
    dmaRequestQueue_in.dequeue(clockEdge());
  }

  action(y_recycleDmaRequestQueue, "y", desc="recycle dma request queue") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      DPRINTF(RubySlicc,
              "AMTC_DIR_DMA_RECYCLE addr=%#x type=%s req=%s state=%s tbe_valid=%d\n",
              in_msg.LineAddress,
              in_msg.Type,
              in_msg.Requestor,
              getState(tbe, address),
              is_valid(tbe));
    }
    dmaRequestQueue_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(l_popMemQueue, "q", desc="Pop off-chip request queue") {
    dequeueMemRespQueue();
  }

  action(rs_resetScheduleTimeout, "rs", desc="Reschedule Schedule Timeout") {
    //
    // currently only support a fixed timeout latency
    //
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
      reissueTimerTable.set(address, clockEdge(fixed_timeout_latency));
    }
  }

  action(st_scheduleTimeout, "st", desc="Schedule Timeout") {
    //
    // currently only support a fixed timeout latency
    //
    reissueTimerTable.set(address, clockEdge(fixed_timeout_latency));
  }

  action(ut_unsetReissueTimer, "ut", desc="Unset reissue timer.") {
    if (reissueTimerTable.isSet(address)) {
      reissueTimerTable.unset(address);
    }
  }

  action(da_sendDmaAck, "da", desc="Send Ack to DMA controller") {
    enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
      out_msg.PhysicalAddress := address;
      out_msg.LineAddress := address;
      out_msg.Type := DMAResponseType:ACK;
      out_msg.sector_id := 0;
      out_msg.sector_mask := amtc_fullMask();
      out_msg.valid_sector_mask := 0;
      out_msg.token_sector_mask := 0;
      out_msg.Destination.add(tbe.DmaReqDest);
      out_msg.MessageSize := MessageSizeType:Writeback_Control;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_ACK_SEND addr=%#x mask=%d valid=%d token=%d\n",
        address, amtc_fullMask(), 0, 0);
    }
  }

  action(dm_sendMemoryDataToDma, "dm", desc="Send Data to DMA controller from memory") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
        out_msg.PhysicalAddress := address;
        out_msg.LineAddress := address;
        out_msg.Type := DMAResponseType:DATA;
        //
        // we send the entire data block and rely on the dma controller to
        // split it up if need be
        //
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.sector_id := tbe.LastSectorID;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.valid_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;
        out_msg.Destination.add(tbe.DmaReqDest);
        out_msg.MessageSize := MessageSizeType:Response_Data;

        DPRINTF(RubySlicc,
          "AMTC_DIR_DMA_DATA_SEND_MEM addr=%#x mask=%d sid=%d len=%d valid=%d token=%d\n",
          address, tbe.RequestedSectorMask, tbe.LastSectorID, tbe.Len,
          tbe.RequestedSectorMask, 0);
      }
    }
  }

  action(dd_sendDmaData, "dd", desc="Send Data to DMA controller from owner response") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(dmaResponseNetwork_out, DMAResponseMsg, 1) {
        out_msg.PhysicalAddress := address;
        out_msg.LineAddress := address;
        out_msg.Type := DMAResponseType:DATA;
        //
        // we send the entire data block and rely on the dma controller to
        // split it up if need be
        //
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.sector_id := tbe.LastSectorID;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.valid_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;
        out_msg.Destination.add(tbe.DmaReqDest);
        out_msg.MessageSize := MessageSizeType:Response_Data;

        DPRINTF(RubySlicc,
          "AMTC_DIR_DMA_DATA_SEND_OWNER addr=%#x mask=%d sid=%d len=%d resp_valid=%d resp_token=%d out_valid=%d out_token=%d\n",
          address, tbe.RequestedSectorMask, tbe.LastSectorID, tbe.Len,
          in_msg.valid_sector_mask, in_msg.token_sector_mask,
          tbe.RequestedSectorMask, 0);
      }
    }
  }

action(d_sendMemoryDataWithoutTokens, "d_nt", desc="Send requested sector data without tokens") {
    peek(memQueue_in, MemoryMsg) {
      // Use a local variable to find the mask
      int final_mask := 0;
      int final_sid  := 0;
      MachineID dest;

      if (is_valid(tbe)) {
          dest := tbe.OriginalRequestorMachId;
      } else {
          dest := in_msg.OriginalRequestorMachId;
      }

      //assert(dest != MachineID(-1));
      if (is_valid(tbe)) {
          // If TBE exists, it's the most accurate source
          final_mask := tbe.RequestedSectorMask;
          final_sid  := tbe.LastSectorID;
      } else {
          // Fallback to the persistent Directory Entry
          Entry directory_entry := getDirectoryEntry(address);
          if (is_valid(directory_entry)) {
              final_mask := directory_entry.RequestedSectorMask;
              final_sid  := directory_entry.LastSectorID;
          }
      }

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(dest);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := false;

        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.token_sector_mask := 0;

        out_msg.sector_id := final_sid;
        out_msg.sector_mask := final_mask;
        out_msg.valid_sector_mask := final_mask;
        out_msg.requested_sector_mask := final_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(final_mask);
      }
    }
  }

  action(j_dropStaleRequest, "j_drop", desc="Drop a stale incoming request") {
    // Simply pop the queue without doing anything else
    requestNetwork_in.dequeue(clockEdge());
  }

  action(l_writeTbeDataToMemory, "lwt", desc="Write assembled TBE data to DRAM") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      out_msg.Sender := machineID;
      out_msg.OriginalRequestorMachId := tbe.OriginalRequestorMachId;
      out_msg.Len := 64;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
    }
  }

  // Send the fully assembled line from the TBE to the DMA Controller
  action(dt_sendTbeDataToDma, "dt", desc="Send accumulated TBE data to DMA") {
    enqueue(dmaResponseNetwork_out, DMAResponseMsg, directory_latency) {
      out_msg.PhysicalAddress := tbe.PhysicalAddress;
      out_msg.LineAddress := address;
      out_msg.Type := DMAResponseType:DATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.sector_id := tbe.LastSectorID;
      out_msg.sector_mask := tbe.RequestedSectorMask;
      out_msg.valid_sector_mask := tbe.RequestedSectorMask;
      out_msg.token_sector_mask := 0;
      out_msg.Destination.add(tbe.DmaReqDest);
      out_msg.MessageSize := MessageSizeType:Response_Data;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_DATA_SEND_TBE addr=%#x phys=%#x mask=%d sid=%d len=%d valid=%d token=%d\n",
        address, tbe.PhysicalAddress, tbe.RequestedSectorMask,
        tbe.LastSectorID, tbe.Len, tbe.RequestedSectorMask, 0);
    }
  }

  // Update the Directory's memory copy from the TBE after a read/write
  action(lt_queueTbeWritebackToMemory, "lt", desc="Queue memory writeback from TBE") {
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_WB;
      out_msg.Sender := machineID;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
    }
  }

  action(z_stallAndWaitRequest, "\z", desc="Stall incoming requests") {
    stall_and_wait(requestNetwork_in, address);
  }

  action(z_stallAndWaitRequestFromNB, "znb", desc="Stall incoming TCC/NB requests") {
    stall_and_wait(requestNetworkFromNB_in, address);
  }

  action(y_stallAndWaitDmaRequest, "\y", desc="Stall incoming DMA requests") {
    DPRINTF(RubySlicc,
      "AMTC_DIR_DMA_STALL_WAIT addr=%#x waiting_state_duplicate_dma\n",
      address);
    stall_and_wait(dmaRequestQueue_in, address);
  }

  action(kz_stallAndWaitResponse, "\kz", desc="Stall incoming responses") {
    stall_and_wait(responseNetwork_in, address);
  }

  action(qw_wakeUpDependents, "\qw", desc="Wake up any stalled requests") {
    wakeUpBuffers(address);
  }


  action(rb_recordReceivedSectors, "rb", desc="Record received data sectors") {
    peek(responseNetwork_in, ResponseMsg) {
      tbe.ReceivedSectorMask := amtc_unionMasks(tbe.ReceivedSectorMask, in_msg.valid_sector_mask);
    }
  }

  action(rt_recordTokenSectors, "rt", desc="Record received token sectors") {
    peek(responseNetwork_in, ResponseMsg) {
      tbe.TokenReadySectorMask := amtc_unionMasks(tbe.TokenReadySectorMask, in_msg.token_sector_mask);
    }
  }

  action(ccw_checkWriteCompletion, "ccw", desc="Check write completion") {
    if (amtc_writeComplete(address, tbe)) {
      enqueue(triggerQueue_out, TriggerMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := Event:Write_Complete; // You must add Write_Complete to your Event enumeration
      }
    }
  }

  action(ccr_checkReadCompletion, "ccr", desc="Check read completion") {
    if (amtc_readComplete(tbe)) {
      enqueue(triggerQueue_out, TriggerMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := Event:Read_Complete; // You must add Read_Complete to your Event enumeration
      }
    }
  }

  action(tq_popTriggerQueue, "tq", desc="Pop internal trigger queue") {
    triggerQueue_in.dequeue(clockEdge());
  }

  // ====================================================================
  // PHASE 1 ACTIONS: METADATA & LOCALITY ROUTING
  // ====================================================================

  // Action to save the requestor ID into the TBE (Call this first in your transition)
  //action(st_saveRequestor, "stsr", desc="Save requestor in TBE") {
  //  assert(is_valid(tbe));
  //  tbe.last_requestor := tbe.last_requestor;
  //}

  // ====================================================================
  // PHASE 1 ACTIONS: METADATA & LOCALITY ROUTING
  // ====================================================================

  action(u_set_cpu_shared, "scs", desc="Set CPU shared metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).cpu_shared := true;
    getDirectoryEntry(address).last_cpu_owner := requestor;
  }

  action(u_set_gpu_shared, "sgs", desc="Set GPU shared metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).gpu_shared := true;
    getDirectoryEntry(address).last_gpu_owner := requestor;
  }

  action(u_set_gpu_shared_from_nb, "sgsnb", desc="Set GPU shared metadata from TCC/NB request") {
    peek(requestNetworkFromNB_in, RequestMsg) {
      getDirectoryEntry(address).gpu_shared := true;
      getDirectoryEntry(address).last_gpu_owner := in_msg.Requestor;
    }
  }

  action(u_set_cpu_exclusive, "sce", desc="Set CPU exclusive metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).cpu_shared := true;
    getDirectoryEntry(address).cpu_dirty  := true;
    getDirectoryEntry(address).gpu_shared := false;
    getDirectoryEntry(address).gpu_dirty  := false;
    getDirectoryEntry(address).last_cpu_owner := requestor;
  }

  action(u_set_gpu_exclusive, "sge", desc="Set GPU exclusive metadata") {
    MachineID requestor;
    if (is_valid(tbe)) {
      requestor := tbe.last_requestor;
    } else {
      peek(requestNetwork_in, RequestMsg) { requestor := in_msg.Requestor; }
    }
    getDirectoryEntry(address).gpu_shared := true;
    getDirectoryEntry(address).gpu_dirty  := true;
    getDirectoryEntry(address).cpu_shared := false;
    getDirectoryEntry(address).cpu_dirty  := false;
    getDirectoryEntry(address).last_gpu_owner := requestor;
  }

  action(a_fwd_gets_locality_aware, "fwdS", desc="Locality-aware GETS routing") {
    assert(is_valid(tbe));
    Entry e := getDirectoryEntry(address);
    bool from_cpu := is_cpu_domain(tbe.last_requestor);

    if (from_cpu) {
      if (!e.gpu_shared && !e.gpu_dirty) {
        // FAST PATH: GPU doesn't have it.
        // FIX: Using responseNetwork_out (your defined port)
        enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(tbe.last_requestor);
          out_msg.TokensSec0 := (max_tokens() / 2);
          out_msg.TokensSec1 := (max_tokens() / 2);
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.DataBlk := e.DataBlk;
        }
      } else if (e.gpu_dirty) {
        // GPU holds modified data.
        // FIX: Using requestNetwork_out (your defined port for forwards)
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := tbe.last_requestor;
          out_msg.Destination.add(e.last_gpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    } else {
      // SYMMETRIC GPU LOGIC
      if (!e.cpu_shared && !e.cpu_dirty) {
        // FAST PATH: Stay in GPU domain.
        // FIX: Using responseNetwork_out
        enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(tbe.last_requestor);
          out_msg.TokensSec0 := (max_tokens() / 2);
          out_msg.TokensSec1 := (max_tokens() / 2);
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.DataBlk := e.DataBlk;
        }
      } else if (e.cpu_dirty) {
        // FIX: Using requestNetwork_out
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := tbe.last_requestor;
          out_msg.Destination.add(e.last_cpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    }
  }

action(a_inv_remote_domain_on_getx, "invR", desc="Invalidate remote domain on upgrade") {
    assert(is_valid(tbe));
    Entry e := getDirectoryEntry(address);
    bool from_cpu := is_cpu_domain(tbe.last_requestor);

    if (from_cpu && e.gpu_shared) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
            out_msg.addr := address;
            // Use GETX as the token-reclaim/invalidation signal
            out_msg.Type := CoherenceRequestType:GETX;
            out_msg.Requestor := tbe.last_requestor;
            out_msg.Destination.add(e.last_gpu_owner);
            out_msg.MessageSize := MessageSizeType:Forwarded_Control;

            // Ensure AMTC metadata is set for a full-line invalidate
            out_msg.sector_mask := amtc_fullMask();
            out_msg.requested_sector_mask := amtc_fullMask();
        }
    } else if (!from_cpu && e.cpu_shared) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
            out_msg.addr := address;
            out_msg.Type := CoherenceRequestType:GETX;
            out_msg.Requestor := tbe.last_requestor;
            out_msg.Destination.add(e.last_cpu_owner);
            out_msg.MessageSize := MessageSizeType:Forwarded_Control;

            out_msg.sector_mask := amtc_fullMask();
            out_msg.requested_sector_mask := amtc_fullMask();
        }
    }
  }

// --- TBE MANAGEMENT ---
  action(v_allocateTBE, "v", desc="Allocate TBE on transient entry") {
    peek(requestNetwork_in, RequestMsg) {
      if (is_invalid(tbe)) {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
        tbe.last_requestor := in_msg.Requestor;
      }
    }
  }

  action(v_allocateTBEFromNB, "vnb", desc="Allocate TBE for NB/TCC request path") {
    peek(requestNetworkFromNB_in, RequestMsg) {
      if (is_invalid(tbe)) {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
      }

      tbe.last_requestor := in_msg.Requestor;
      tbe.OriginalRequestorMachId := in_msg.Requestor;
      tbe.RequestedSectorMask := amtc_normalizeMask(in_msg.requested_sector_mask, in_msg.sector_id);
      tbe.ReceivedSectorMask := 0;
      tbe.TokenReadySectorMask := 0;
      tbe.LastSectorID := in_msg.sector_id;
      tbe.FromGPU := true;
      tbe.IsSyncRequest := in_msg.is_sync;
      tbe.req_from_cpu := false;
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE on stable entry") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(d_send_mem_and_1_token_cpu, "s1c", desc="Send memory and 1 token to CPU") {
    peek(memQueue_in, MemoryMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);
      getDirectoryEntry(address).DataBlk := in_msg.DataBlk;

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;

        out_msg.Sender := machineID; // <--- ADD THIS LINE

        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_mem_and_all_tokens_cpu, "sac", desc="Send memory and ALL tokens to CPU") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      getDirectoryEntry(address).DataBlk := in_msg.DataBlk;

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;

        out_msg.Sender := machineID; // <--- ADD THIS LINE

        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(d_send_mem_and_forced_all_tokens_cpu, "sfc", desc="Repair stale CE CPU GETX by sending memory data and full logical owner tokens") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int req_mask := amtc_sanitizeMask(tbe.RequestedSectorMask);
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int tokens_per_sector := max_tokens() / 2;

      getDirectoryEntry(address).DataBlk := in_msg.DataBlk;

      DPRINTF(RubySlicc,
              "AMTC_DIR_STALE_CE_GETX_REPAIR_DATA addr=%#x req=%x forceT0=%d forceT1=%d\n",
              address, req_mask, tokens_per_sector, tokens_per_sector);

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;

        // This is a guarded recovery path only after many GETX retries.  The
        // previous owner is stale/non-responsive, so force a complete logical
        // owner grant to break the IM_WAIT_PARTIAL + ACK_OWNER(0) loop.
        out_msg.TokensSec0 := tokens_per_sector;
        out_msg.TokensSec1 := tokens_per_sector;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := amtc_fullMask();
      }

      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(fwd_req_to_gpu, "fr2g", desc="Forward request to GPU Owner") {
    peek(requestNetwork_in, RequestMsg) {
      // Anti-Loop Check
      if (getDirectoryEntry(address).last_gpu_owner != in_msg.Requestor) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type; // Preserve exact type
          out_msg.Requestor := in_msg.Requestor;
          out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.is_owner_pull := false;
        }
      }
    }
  }


  action(fwd_inv_to_gpu, "fi2g", desc="Forward Invalidations to GPU sharers") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
      }
    }
  }

  action(fwd_inv_to_cpu, "fi2c", desc="Forward Invalidations to CPU sharers") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.is_owner_pull := false;
      }
    }
  }

  action(d_send_mem_and_1_token_gpu, "s1g", desc="Send memory and 1 token to GPU") {
    peek(memQueue_in, MemoryMsg) {
      assert(getDirectoryEntry(address).TokensSec0 >= 1);

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 1;
        out_msg.TokensSec1 := 1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      getDirectoryEntry(address).TokensSec0 := getDirectoryEntry(address).TokensSec0 - 1;
      getDirectoryEntry(address).TokensSec1 := getDirectoryEntry(address).TokensSec1 - 1;
    }
  }

  action(d_send_mem_and_all_tokens_gpu, "sag", desc="Send memory and ALL tokens to GPU") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := dir_entry.TokensSec0;
        out_msg.TokensSec1 := dir_entry.TokensSec1;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := amtc_fullMask();
        out_msg.requested_sector_mask := amtc_fullMask();
        out_msg.token_sector_mask := amtc_fullMask();
        out_msg.valid_sector_mask := amtc_fullMask();
      }
      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  // --- UPGRADE TOKEN RELEASES ---

  action(d_send_remaining_tokens_cpu, "src", desc="Give ALL remaining CPU-domain tokens when Directory enters CE") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }

      // IMPORTANT:
      // Directory state CE is line-granular in this protocol.  Therefore when a
      // transition moves Directory to CE, the Directory must not retain tokens
      // for any sector.  The requested mask still describes the sector that
      // caused the upgrade, but token ownership must be transferred for the
      // whole line to satisfy the CE invariant.
      int send_t0 := dir_entry.TokensSec0;
      int send_t1 := dir_entry.TokensSec1;
      int tok_mask := 0;
      if (send_t0 > 0) { tok_mask := amtc_unionMasks(tok_mask, 1); }
      if (send_t1 > 0) { tok_mask := amtc_unionMasks(tok_mask, 2); }

      DPRINTF(RubySlicc,
              "AMTC_DIR_SEND_CPU_EXCL_ALL_TOKENS addr=%#x req=%x send0=%d send1=%d\n",
              address, req_mask, send_t0, send_t1);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
        out_msg.valid_sector_mask := 0;
      }

      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(d_send_remaining_tokens_gpu, "srg", desc="Give ALL remaining GPU-domain tokens when Directory enters GE") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }

      // GE is also line-granular, so do not retain directory tokens after
      // declaring GPU exclusive ownership.
      int send_t0 := dir_entry.TokensSec0;
      int send_t1 := dir_entry.TokensSec1;
      int tok_mask := 0;
      if (send_t0 > 0) { tok_mask := amtc_unionMasks(tok_mask, 1); }
      if (send_t1 > 0) { tok_mask := amtc_unionMasks(tok_mask, 2); }

      DPRINTF(RubySlicc,
              "AMTC_DIR_SEND_GPU_EXCL_ALL_TOKENS addr=%#x req=%x send0=%d send1=%d\n",
              address, req_mask, send_t0, send_t1);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
        out_msg.valid_sector_mask := 0;
      }

      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  action(d_send_dir_data_and_remaining_tokens_cpu, "sddac",
       desc="Send directory data and ownership tokens to CPU GETX requester") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) {
        req_mask := amtc_sanitizeMask(in_msg.sector_mask);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      int old_send_t0 := dir_entry.TokensSec0;
      int old_send_t1 := dir_entry.TokensSec1;

      int send_t0 := dir_entry.TokensSec0;
      int send_t1 := dir_entry.TokensSec1;

      /*
      * No bitwise operators.
      *
      * Sector 0 is requested when req_mask is 1 or 3.
      * Sector 1 is requested when req_mask is 2 or 3.
      */
      bool req_sec0 := false;
      bool req_sec1 := false;

      if (req_mask == 1) {
        req_sec0 := true;
      } else if (req_mask == 2) {
        req_sec1 := true;
      } else if (req_mask == 3) {
        req_sec0 := true;
        req_sec1 := true;
      }

      /*
      * DATA_OWNER must not be sent with zero ownership tokens for the
      * requested write sector.
      *
      * Temporary repair: force-grant requested-sector tokens when Directory
      * currently has none. Later this should be replaced by real sharer
      * invalidation and token collection.
      */
      if (req_sec0) {
        if (send_t0 == 0) {
          send_t0 := 512;
        }
      }

      if (req_sec1) {
        if (send_t1 == 0) {
          send_t1 := 512;
        }
      }

      int tok_mask := 0;
      if (send_t0 > 0) {
        tok_mask := amtc_unionMasks(tok_mask, 1);
      }
      if (send_t1 > 0) {
        tok_mask := amtc_unionMasks(tok_mask, 2);
      }

      bool fixed_zero_token := false;
      if (req_sec0) {
        if (old_send_t0 == 0) {
          fixed_zero_token := true;
        }
      }
      if (req_sec1) {
        if (old_send_t1 == 0) {
          fixed_zero_token := true;
        }
      }

      if (fixed_zero_token) {
        DPRINTF(RubySlicc,
                "AMTC_DIR_GETX_ZERO_TOKEN_OWNER_FIX addr=%#x req=%x old0=%d old1=%d new0=%d new1=%d\n",
                address, req_mask,
                old_send_t0, old_send_t1,
                send_t0, send_t1);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_GETX_OWNER_GRANT addr=%#x req=%x send0=%d send1=%d tokmask=%d\n",
              address, req_mask, send_t0, send_t1, tok_mask);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        out_msg.DataBlk := dir_entry.DataBlk;

        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);

        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
      }

      dir_entry.TokensSec0 := 0;
      dir_entry.TokensSec1 := 0;
    }
  }

  // --- DIRECTORY-DIRECT REPLIES (For Shared States) ---

  action(d_send_dir_data_and_1_token_cpu, "sdd1c", desc="Send directory data and up to 1 requested token to CPU") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }

      int send_t0 := 0;
      int send_t1 := 0;
      int tok_mask := 0;

      if (amtc_maskHasSector(req_mask, 0) && dir_entry.TokensSec0 > 0) {
        send_t0 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 1);
      }
      if (amtc_maskHasSector(req_mask, 1) && dir_entry.TokensSec1 > 0) {
        send_t1 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 2);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_SEND_CS_GETS_SAFE addr=%#x req=%x send_t0=%d send_t1=%d remain_t0=%d remain_t1=%d",
              address, req_mask, send_t0, send_t1,
              dir_entry.TokensSec0, dir_entry.TokensSec1);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := dir_entry.DataBlk;
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
      }

      dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;
    }
  }


  // AMTC audit83: Directory-direct DATA reply for TCC/NB requests.
  // The old d_send_dir_data_and_1_token_cpu peeks requestNetwork_in and crashes
  // when called for requestNetworkFromNB_in events.  This action is identical in
  // intent but uses the NB queue as source and TCC as destination.
  action(d_send_dir_data_and_1_token_nb, "ddnb", desc="Send directory data and up to 1 requested token to TCC/NB requester") {
    peek(requestNetworkFromNB_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }

      int send_t0 := 0;
      int send_t1 := 0;
      int tok_mask := 0;

      if (amtc_maskHasSector(req_mask, 0) && dir_entry.TokensSec0 > 0) {
        send_t0 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 1);
      }
      if (amtc_maskHasSector(req_mask, 1) && dir_entry.TokensSec1 > 0) {
        send_t1 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 2);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_SEND_DATA_TO_NB_REPAIR addr=%#x req=%s mask=%d send_t0=%d send_t1=%d remain_t0=%d remain_t1=%d\n",
              address, in_msg.Requestor, req_mask, send_t0, send_t1,
              dir_entry.TokensSec0, dir_entry.TokensSec1);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := dir_entry.DataBlk;
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
      }

      dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;
    }
  }

  action(d_send_dir_data_and_1_token_gpu, "sdd1g",
         desc="Send directory data and up to one requested token to GPU") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) {
        req_mask := amtc_sanitizeMask(in_msg.sector_mask);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      int send_t0 := 0;
      int send_t1 := 0;
      int tok_mask := 0;

      if (amtc_maskHasSector(req_mask, 0) && dir_entry.TokensSec0 > 0) {
        send_t0 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 1);
      }

      if (amtc_maskHasSector(req_mask, 1) && dir_entry.TokensSec1 > 0) {
        send_t1 := 1;
        tok_mask := amtc_unionMasks(tok_mask, 2);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_SEND_DATA_TO_GPU_SAFE addr=%#x req=%s mask=%d send_t0=%d send_t1=%d tokmask=%d remain_t0=%d remain_t1=%d\n",
              address, in_msg.Requestor, req_mask, send_t0, send_t1,
              tok_mask, dir_entry.TokensSec0, dir_entry.TokensSec1);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := dir_entry.DataBlk;
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;
      }

      dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;
    }
  }

  action(d_send_mem_data_only_cpu, "sdoc", desc="Send memory data only to CPU") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;

        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;

        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.requested_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;

        out_msg.valid_sector_mask := tbe.RequestedSectorMask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(tbe.RequestedSectorMask);
      }
    }
  }

  action(d_send_mem_data_only_gpu, "sdog", desc="Send memory data only to GPU") {
    peek(memQueue_in, MemoryMsg) {
      enqueue(responseNetwork_out, ResponseMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.last_requestor);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.sector_mask := tbe.RequestedSectorMask;
        out_msg.requested_sector_mask := tbe.RequestedSectorMask;
        out_msg.token_sector_mask := 0;
      }
    }
  }

  action(d_forward_tokens_to_cpu, "ft2c", desc="Forward loose tokens to the CPU Owner") {
    peek(responseNetwork_in, ResponseMsg) {
      if (in_msg.TokensSec0 > 0 || in_msg.TokensSec1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);

          // Blindly forward the tokens (No TBE access!)
          out_msg.TokensSec0 := in_msg.TokensSec0;
          out_msg.TokensSec1 := in_msg.TokensSec1;

          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.sector_mask := amtc_fullMask();
          out_msg.requested_sector_mask := amtc_fullMask();
          out_msg.token_sector_mask := in_msg.token_sector_mask;
        }
      }
    }
  }



  // (Ensure your d_forward_tokens_to_gpu is updated to match this exactly!)

  // NOTE: Apply the EXACT SAME logic to d_forward_tokens_to_gpu,
  // just changing 'last_cpu_owner' to 'last_gpu_owner' in the enqueue block!

  action(d_forward_tokens_to_gpu, "ft2g", desc="Forward loose tokens to the GPU Owner") {
    peek(responseNetwork_in, ResponseMsg) {
      // Only bother sending if there are actually tokens to send
      if (in_msg.TokensSec0 > 0 || in_msg.TokensSec1 > 0) {
        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;

          // CRITICAL DIFFERENCE: Route to GPU owner
          out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);

          out_msg.TokensSec0 := in_msg.TokensSec0;
          out_msg.TokensSec1 := in_msg.TokensSec1;

          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.sector_mask := amtc_fullMask();
          out_msg.requested_sector_mask := amtc_fullMask();
          out_msg.token_sector_mask := in_msg.token_sector_mask;
        }
      }
    }
  }

  action(f_forwardRequestToSharers, "\f", desc="Forward request to the node with data") {
    peek(requestNetwork_in, RequestMsg) {
      // Enqueue the forwarded request onto the outgoing request network
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;

        // Pass the exact same request type along (GETS or GETS_Owner_Pull)
        out_msg.Type := in_msg.Type;

        // Keep the original requestor so the data goes straight to the L1
        out_msg.Requestor := in_msg.Requestor;

        // Route it to the cache that downgraded but kept the valid data
        out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);

        out_msg.MessageSize := MessageSizeType:Request_Control;

        // Forward the sector masks so the sharer knows exactly which bytes to send
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := in_msg.sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
        out_msg.is_owner_pull := in_msg.is_owner_pull;
      }
    }
  }

  // ============================================================================
  // NEW & MODIFIED ACTIONS
  // ============================================================================

  action(st_saveRequestor, "\st", desc="Save pending requestor") {
    peek(requestNetwork_in, RequestMsg) {
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.last_requestor := in_msg.Requestor;
    }
  }

  action(f_commitTransferredOwner, "\fcto", desc="Commit transferred ownership") {
    Entry dir_entry := getDirectoryEntry(address);
    dir_entry.last_cpu_owner := tbe.last_requestor;
    dir_entry.cpu_shared := true;
    dir_entry.cpu_dirty := true;
    dir_entry.gpu_shared := false;
    dir_entry.gpu_dirty := false;
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(fwd_req_to_cpu, "fr2c", desc="Forward request to CPU Owner preserving AMTC sector metadata") {
    peek(requestNetwork_in, RequestMsg) {
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }

      if (getDirectoryEntry(address).last_cpu_owner != in_msg.Requestor &&
          getDirectoryEntry(address).last_cpu_owner != machineID) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;

          // Audit57: preserve the original sector request.  The previous
          // forwarding path left sector fields at their default/full-line values,
          // so a sector-1 GETS was forwarded to the owner as mask=3.  The owner
          // then donated sector-0 data, while the requester waited forever for
          // sector 1.
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
          out_msg.RetryNum := in_msg.RetryNum;
        }
      } else {
        /*
         * AMTC audit86:
         * Do not send ACK_OWNER(0) when the recorded CPU owner is the requester
         * itself, or when the Directory is the effective backing owner.
         *
         * This is common with sector misses: an L1 can be in M/MM for one sector
         * and issue GETS for a missing peer sector.  Domain splitting already
         * classifies it as CPU_GETS, but the old CE transition forwarded to the
         * CPU owner.  If owner == requester, that becomes a self-forward/stale
         * ACK loop and the L1 remains in M_IS/S_IS forever.
         *
         * Return backing directory data for the requested sectors instead.  Send
         * one token only for sectors whose tokens are actually held by Directory.
         */
        Entry dir_entry := getDirectoryEntry(address);
        int send_t0 := 0;
        int send_t1 := 0;
        int tok_mask := 0;

        if (amtc_maskHasSector(req_mask, 0) && dir_entry.TokensSec0 > 0) {
          send_t0 := 1;
          tok_mask := amtc_unionMasks(tok_mask, 1);
        }
        if (amtc_maskHasSector(req_mask, 1) && dir_entry.TokensSec1 > 0) {
          send_t1 := 1;
          tok_mask := amtc_unionMasks(tok_mask, 2);
        }

        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          if (in_msg.Type == CoherenceRequestType:GETX) {
            out_msg.Type := CoherenceResponseType:DATA_OWNER;
          } else {
            out_msg.Type := CoherenceResponseType:DATA_SHARED;
          }
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
          out_msg.DataBlk := dir_entry.DataBlk;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := tok_mask;
          out_msg.valid_sector_mask := req_mask;
          out_msg.Dirty := false;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
        }

        dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
        dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;

        DPRINTF(RubySlicc,
                "AMTC_DIR_CPU_SELF_OR_DIR_OWNER_DATA addr=%#x type=%s req=%s owner=%s mask=%d send0=%d send1=%d\n",
                address, in_msg.Type, in_msg.Requestor,
                getDirectoryEntry(address).last_cpu_owner, req_mask,
                send_t0, send_t1);
      }
    }
  }


  // AMTC audit83: same CPU-owner forward, but for TCC/NB input queue.
  // It deliberately keeps Requestor := TCC so the stale-owner ACK/data returns
  // to TCC, where the TCC-side stale-owner repair handles ACK_OWNER(0).
  action(fwd_req_to_cpu_from_nb, "fr2cnb", desc="Forward TCC/NB request to CPU Owner preserving AMTC sector metadata") {
    peek(requestNetworkFromNB_in, RequestMsg) {
      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) { req_mask := amtc_sanitizeMask(in_msg.sector_mask); }
      if (req_mask == 0) { req_mask := amtc_fullMask(); }

      if (getDirectoryEntry(address).last_cpu_owner != in_msg.Requestor &&
          getDirectoryEntry(address).last_cpu_owner != machineID) {
        enqueue(requestNetwork_out, RequestMsg, directory_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
          out_msg.MessageSize := MessageSizeType:Forwarded_Control;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
          out_msg.RetryNum := in_msg.RetryNum;
        }
      } else {
        /*
         * AMTC audit86:
         * NB/TCC request reached a CE line whose CPU owner is unavailable or
         * equivalent to Directory.  Do not return ACK_OWNER(0) to TCC here:
         * that forces another stale-owner repair loop.  Return backing data
         * directly to the TCC/NB requester.
         */
        Entry dir_entry := getDirectoryEntry(address);
        int send_t0 := 0;
        int send_t1 := 0;
        int tok_mask := 0;

        if (amtc_maskHasSector(req_mask, 0) && dir_entry.TokensSec0 > 0) {
          send_t0 := 1;
          tok_mask := amtc_unionMasks(tok_mask, 1);
        }
        if (amtc_maskHasSector(req_mask, 1) && dir_entry.TokensSec1 > 0) {
          send_t1 := 1;
          tok_mask := amtc_unionMasks(tok_mask, 2);
        }

        enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
          out_msg.addr := address;
          if (in_msg.Type == CoherenceRequestType:GETX) {
            out_msg.Type := CoherenceResponseType:DATA_OWNER;
          } else {
            out_msg.Type := CoherenceResponseType:DATA_SHARED;
          }
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
          out_msg.DataBlk := dir_entry.DataBlk;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.token_sector_mask := tok_mask;
          out_msg.valid_sector_mask := req_mask;
          out_msg.Dirty := false;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
        }

        dir_entry.TokensSec0 := dir_entry.TokensSec0 - send_t0;
        dir_entry.TokensSec1 := dir_entry.TokensSec1 - send_t1;

        DPRINTF(RubySlicc,
                "AMTC_DIR_NB_SELF_OR_DIR_OWNER_DATA addr=%#x type=%s req=%s owner=%s mask=%d send0=%d send1=%d\n",
                address, in_msg.Type, in_msg.Requestor,
                getDirectoryEntry(address).last_cpu_owner, req_mask,
                send_t0, send_t1);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_FWD_NB_REQ_TO_CPU addr=%#x type=%s req=%s owner=%s mask=%d\n",
              address, in_msg.Type, in_msg.Requestor,
              getDirectoryEntry(address).last_cpu_owner, req_mask);
    }
  }



  // Audit41: DMA/HSAPP command processor reads must see the latest CPU/GPU-owned
  // queue/packet data.  A memory-only read in CE/GE can return stale bytes because
  // the exclusive owner may hold the dirty packet in cache.  Forward a data-only
  // GETS to the recorded owner and have the owner respond to the Directory; the
  // Directory then forwards the data to DMA.  Tokens are intentionally not moved.
  action(fdr_fwdDmaReadToCpuOwner, "fdr2c", desc="Forward DMA read to CPU owner as data-only owner-pull") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      if (dma_mask == 0) { dma_mask := amtc_fullMask(); }

      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(getDirectoryEntry(address).last_cpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
        out_msg.RetryNum := 0;

        out_msg.sector_id := amtc_primarySectorFromMask(dma_mask);
        out_msg.sector_mask := dma_mask;
        out_msg.requested_sector_mask := dma_mask;
        out_msg.is_owner_pull := true;
        out_msg.is_gpu := false;
        out_msg.is_sync := in_msg.is_sync;
        out_msg.is_bypass := in_msg.is_bypass;
        out_msg.is_atomic := false;
        out_msg.is_signal := in_msg.is_signal;
        out_msg.isGLCSet := false;
        out_msg.isSLCSet := false;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_READ_FWD_CPU_OWNER addr=%#x mask=%d owner=%s\n",
        address, dma_mask, getDirectoryEntry(address).last_cpu_owner);
    }
  }

  action(fdr_fwdDmaReadToGpuOwner, "fdr2g", desc="Forward DMA read to GPU owner as data-only owner-pull") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      if (dma_mask == 0) { dma_mask := amtc_fullMask(); }

      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
        out_msg.RetryNum := 0;

        out_msg.sector_id := amtc_primarySectorFromMask(dma_mask);
        out_msg.sector_mask := dma_mask;
        out_msg.requested_sector_mask := dma_mask;
        out_msg.is_owner_pull := true;
        out_msg.is_gpu := true;
        out_msg.is_sync := in_msg.is_sync;
        out_msg.is_bypass := in_msg.is_bypass;
        out_msg.is_atomic := false;
        out_msg.is_signal := in_msg.is_signal;
        out_msg.isGLCSet := false;
        out_msg.isSLCSet := false;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_READ_FWD_GPU_OWNER addr=%#x mask=%d owner=%s\n",
        address, dma_mask, getDirectoryEntry(address).last_gpu_owner);
    }
  }


  // Audit45: DMA writes such as GPU completion signals must invalidate the
  // current CPU/GPU exclusive owner. Otherwise the CPU may keep polling a stale
  // cached signal line after the DMA write has updated memory. This is the DMA
  // equivalent of VIPER's probe/invalidate path for DMA writes.
  // Audit79: DMA writes to host-visible metadata must invalidate every CPU L1.
  //
  // Previous code sent GETX only to last_cpu_owner.  The HSA launch trace showed
  // DMA_WRITE addr=0x121a080 invalidating L1Cache-2 while l1_cntrl0 stayed S
  // and kept Load-hit polling stale readIndex.  Broadcast to all CPU L1s first;
  // optimize to tracked sharers later.
  action(fdw_fwdDmaWriteInvToCpuOwner, "fdw2c",
         desc="Broadcast DMA write invalidation to all CPU L1 caches") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      if (dma_mask == 0) { dma_mask := amtc_fullMask(); }

      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        // Correctness/proof path: invalidate all CPU L1s, not only a possibly
        // stale last_cpu_owner.
        out_msg.Destination.broadcast(MachineType:L1Cache);

        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
        out_msg.RetryNum := 0;

        out_msg.sector_id := amtc_primarySectorFromMask(dma_mask);
        out_msg.sector_mask := dma_mask;
        out_msg.requested_sector_mask := dma_mask;

        out_msg.is_owner_pull := false;
        out_msg.is_gpu := false;
        out_msg.is_sync := true;
        out_msg.is_bypass := in_msg.is_bypass;
        out_msg.is_atomic := in_msg.is_atomic;
        out_msg.is_signal := in_msg.is_signal;
        out_msg.isGLCSet := false;
        out_msg.isSLCSet := false;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_WRITE_BCAST_INV_CPU addr=%#x mask=%d old_owner=%s len=%d\n",
        address, dma_mask, getDirectoryEntry(address).last_cpu_owner, in_msg.Len);
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;

        // Audit82:
        // L1 invalidation alone is not sufficient.  The failing trace showed
        // l1_cntrl0 invalidated 0x121a080, then immediately refetched stale
        // data from l2_cntrl2:O while the DMA write was still completing.
        // Therefore the DMA-write serialization must also kill any L2 O/M/S
        // copy so the next CPU GETS is forced back through the directory/memory.
        out_msg.Destination.broadcast(MachineType:L2Cache);

        out_msg.MessageSize := MessageSizeType:Broadcast_Control;
        out_msg.Prefetch := PrefetchBit:No;
        out_msg.AccessMode := RubyAccessMode:Supervisor;
        out_msg.RetryNum := 0;

        out_msg.sector_id := amtc_primarySectorFromMask(dma_mask);
        out_msg.sector_mask := dma_mask;
        out_msg.requested_sector_mask := dma_mask;

        out_msg.is_owner_pull := false;
        out_msg.is_gpu := false;
        out_msg.is_sync := true;
        out_msg.is_bypass := in_msg.is_bypass;
        out_msg.is_atomic := in_msg.is_atomic;
        out_msg.is_signal := in_msg.is_signal;
        out_msg.isGLCSet := false;
        out_msg.isSLCSet := false;
      }

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_WRITE_BCAST_INV_L2 addr=%#x mask=%d old_owner=%s len=%d\n",
        address, dma_mask, getDirectoryEntry(address).last_cpu_owner, in_msg.Len);
    }
  }

  action(fdw_fwdDmaWriteInvToGpuOwner, "fdw2g", desc="Forward DMA write invalidation to GPU owner") {
    peek(dmaRequestQueue_in, DMARequestMsg) {
      int dma_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      enqueue(requestNetwork_out, RequestMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(getDirectoryEntry(address).last_gpu_owner);
        out_msg.MessageSize := MessageSizeType:Forwarded_Control;
        out_msg.sector_id := amtc_primarySectorFromMask(dma_mask);
        out_msg.sector_mask := dma_mask;
        out_msg.requested_sector_mask := dma_mask;
        out_msg.is_owner_pull := false;
        out_msg.is_gpu := true;
        out_msg.is_sync := true;
      }
      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_WRITE_INV_GPU_OWNER addr=%#x mask=%d owner=%s len=%d\n",
        address, dma_mask, getDirectoryEntry(address).last_gpu_owner, in_msg.Len);
    }
  }

  action(qd_updateTokensFromDmaWriteInvResp, "qd", desc="Drain tokens/data returned by DMA-write invalidation") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_WRITE_INV_RESP_DRAIN addr=%#x type=%d t0=%d t1=%d tokmask=%d valid=%d dirT0=%d dirT1=%d\n",
        address, in_msg.Type, in_msg.TokensSec0, in_msg.TokensSec1,
        in_msg.token_sector_mask, in_msg.valid_sector_mask,
        dir_entry.TokensSec0, dir_entry.TokensSec1);
    }
  }

  action(qd_markDmaWriteCompleteNoCachedCopies, "qdf", desc="Mark DMA write complete with no cached CPU/GPU copies") {
    Entry dir_entry := getDirectoryEntry(address);
    int max_t := max_tokens() / 2;

    // Audit82 proof-mode completion:
    // DMA_WRITE invalidates CPU L1 and L2 holders, and memory now contains the
    // DMA data.  The directory must not remain CE/GE with partial returned
    // tokens from old cached copies.  Reset to a cold/full-token directory
    // line before transitioning to I.
    //
    // V22: also preserve the DMA-written bytes in the directory copy.  The
    // v38/v21 run showed a post-kernel CPU read stuck on 0x12adb80 after a
    // DMA-write/invalidation drain.  The line was no longer owned by a valid
    // L2, so the repair GETS had to be served from the directory/memory copy.
    // Keeping tbe.DataBlk here makes the subsequent I-state repair response
    // self-contained and avoids sending the repair path back through a memory
    // fetch that can miss the waiter during barrier/completion handling.
    dir_entry.DataBlk := tbe.DataBlk;
    dir_entry.TokensSec0 := max_t;
    dir_entry.TokensSec1 := max_t;
    dir_entry.cpu_shared := false;
    dir_entry.gpu_shared := false;
    dir_entry.cpu_dirty := false;
    dir_entry.gpu_dirty := false;

    DPRINTF(RubySlicc,
      "AMTC_DIR_DMA_WRITE_COMPLETE_FULLTOK_V22 addr=%#x T0=%d T1=%d data_saved=1\n",
      address, dir_entry.TokensSec0, dir_entry.TokensSec1);
  }


  action(ft_memoryDmaFromTbe, "ftd", desc="Fallback DMA read fetch using recorded TBE request") {
    int dma_mask := tbe.RequestedSectorMask;
    if (dma_mask == 0) { dma_mask := amtc_fullMask(); }
    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := MemoryRequestType:MEMORY_READ;
      out_msg.Sender := tbe.DmaReqDest;
      out_msg.OriginalRequestorMachId := tbe.DmaReqDest;
      out_msg.MessageSize := MessageSizeType:Request_Control;
      out_msg.Len := 64;
    }
    DPRINTF(RubySlicc,
      "AMTC_DIR_DMA_READ_FALLBACK_MEM_FULL addr=%#x mask=%d len=64\n",
      address, dma_mask);
  }

  action(qdr_markDmaReadStaleCpuOwnerFallback, "qdr",
         desc="Clear stale CPU owner metadata after zero-token DMA-read ACK_OWNER fallback") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int max_t := max_tokens() / 2;

      /*
       * V56:
       * A DMA read in CE can probe the recorded CPU/L2 owner and receive
       * ACK_OWNER(0) with no valid sectors.  That means the recorded owner is
       * stale/residual and memory is the authoritative source.  Do not keep the
       * directory in CE with last_cpu_owner still pointing at the stale L2;
       * a later DMA_WRITE would broadcast invalidation and wait forever in
       * CE_W_DMA_WRITE_TOK.  Mark the line cold/full-token before the fallback
       * memory read completes.
       */
      dir_entry.TokensSec0 := max_t;
      dir_entry.TokensSec1 := max_t;
      dir_entry.ValidSectors := 0;
      dir_entry.DirtySectors := 0;
      dir_entry.OwnerSectorMask := 0;
      dir_entry.SharerSectorMask := 0;
      dir_entry.cpu_shared := false;
      dir_entry.gpu_shared := false;
      dir_entry.cpu_dirty := false;
      dir_entry.gpu_dirty := false;
      dir_entry.last_cpu_owner := machineID;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_READ_STALE_CPU_OWNER_CLEAR_V56 addr=%#x stale_owner=%s valid=%d tokmask=%d t0=%d t1=%d full0=%d full1=%d\n",
        address, in_msg.Sender, in_msg.valid_sector_mask,
        in_msg.token_sector_mask, in_msg.TokensSec0, in_msg.TokensSec1,
        dir_entry.TokensSec0, dir_entry.TokensSec1);
    }
  }

  action(qdg_markDmaReadStaleGpuOwnerFallback, "qdg",
         desc="Clear stale GPU owner metadata after zero-token DMA-read ACK_OWNER fallback") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      int max_t := max_tokens() / 2;

      dir_entry.TokensSec0 := max_t;
      dir_entry.TokensSec1 := max_t;
      dir_entry.ValidSectors := 0;
      dir_entry.DirtySectors := 0;
      dir_entry.OwnerSectorMask := 0;
      dir_entry.SharerSectorMask := 0;
      dir_entry.cpu_shared := false;
      dir_entry.gpu_shared := false;
      dir_entry.cpu_dirty := false;
      dir_entry.gpu_dirty := false;
      dir_entry.last_gpu_owner := machineID;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_READ_STALE_GPU_OWNER_CLEAR_V56 addr=%#x stale_owner=%s valid=%d tokmask=%d t0=%d t1=%d full0=%d full1=%d\n",
        address, in_msg.Sender, in_msg.valid_sector_mask,
        in_msg.token_sector_mask, in_msg.TokensSec0, in_msg.TokensSec1,
        dir_entry.TokensSec0, dir_entry.TokensSec1);
    }
  }

  action(qdm_saveDmaReadFallbackMemoryData, "qdm",
         desc="Save fallback memory data after stale-owner DMA read") {
    peek(memQueue_in, MemoryMsg) {
      Entry dir_entry := getDirectoryEntry(address);
      dir_entry.DataBlk := in_msg.DataBlk;
      dir_entry.ValidSectors := amtc_fullMask();
      dir_entry.DirtySectors := 0;

      DPRINTF(RubySlicc,
        "AMTC_DIR_DMA_READ_STALE_OWNER_MEMDATA_SAVE_V56 addr=%#x valid=%d len=%d\n",
        address, dir_entry.ValidSectors, in_msg.Len);
    }
  }

  action(q_updateTokensFromResponse, "\q", desc="Update token count from response") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      int max_t := max_tokens() / 2;
      dir_entry.TokensSec0 := dir_entry.TokensSec0 + in_msg.TokensSec0;
      dir_entry.TokensSec1 := dir_entry.TokensSec1 + in_msg.TokensSec1;

      if (dir_entry.TokensSec0 > max_t) {
        dir_entry.TokensSec0 := max_t;
      }
      if (dir_entry.TokensSec1 > max_t) {
        dir_entry.TokensSec1 := max_t;
      }

      DPRINTF(RubySlicc, "Directory absorbing stray tokens. T0=%d, T1=%d\n",
              dir_entry.TokensSec0, dir_entry.TokensSec1);
    }
  }

  action(amtc_evaluateStateFromTokens, "eval", desc="Trigger Settle if all tokens collected") {
    Entry dir_entry := getDirectoryEntry(address);
    int tokens_per_sector := max_tokens() / 2;

    if ((dir_entry.TokensSec0 == tokens_per_sector) &&
        (dir_entry.TokensSec1 == tokens_per_sector)) {

        // SLICC COMPLIANT: Enqueue a local event to handle the state change!
        enqueue(responseNetwork_out, ResponseMsg, 1) {
            out_msg.addr := address;
            out_msg.Type := CoherenceResponseType:ACK; // Or a custom internal message type
            out_msg.Destination.add(machineID); // Send it to OURSELVES
            out_msg.MessageSize := MessageSizeType:Response_Control;
        }
        DPRINTF(RubySlicc, "All tokens recovered. Firing self-ACK to settle state.\n");
    }
  }

  action(od_dropLateDmaWriteInvResp, "odlate",
       desc="Drop late DMA-write invalidation response after DMA completed") {
    peek(responseNetwork_in, ResponseMsg) {
      DPRINTF(RubySlicc,
        "AMTC_DIR_DROP_LATE_DMA_WRITE_INV_RESP addr=%#x type=%s t0=%d t1=%d tokmask=%d valid=%d\n",
        address, in_msg.Type,
        in_msg.TokensSec0, in_msg.TokensSec1,
        in_msg.token_sector_mask, in_msg.valid_sector_mask);
    }
  }

  action(d_send_dir_data_and_1_token_cpu_repair, "sddr",
       desc="Send CPU GETS repair data and force one token for requested sector") {
    peek(requestNetwork_in, RequestMsg) {
      Entry dir_entry := getDirectoryEntry(address);

      int req_mask := amtc_sanitizeMask(in_msg.requested_sector_mask);
      if (req_mask == 0) {
        req_mask := amtc_sanitizeMask(in_msg.sector_mask);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      bool req_sec0 := false;
      bool req_sec1 := false;

      if (req_mask == 1) {
        req_sec0 := true;
      } else if (req_mask == 2) {
        req_sec1 := true;
      } else if (req_mask == 3) {
        req_sec0 := true;
        req_sec1 := true;
      }

      int send_t0 := 0;
      int send_t1 := 0;

      /*
      * For GETS, only one token is required for the requested sector.
      * In stale-owner repair, the recorded owner already failed to provide it.
      * Force one token so the requester can complete S_IS.
      */
      if (req_sec0) {
        send_t0 := 1;
      }

      if (req_sec1) {
        send_t1 := 1;
      }

      int tok_mask := 0;
      if (send_t0 > 0) {
        tok_mask := amtc_unionMasks(tok_mask, 1);
      }
      if (send_t1 > 0) {
        tok_mask := amtc_unionMasks(tok_mask, 2);
      }

      DPRINTF(RubySlicc,
              "AMTC_DIR_CPU_GETS_REPAIR_DATA addr=%#x req=%s reqmask=%d send0=%d send1=%d tokmask=%d\n",
              address,
              in_msg.Requestor,
              req_mask,
              send_t0,
              send_t1,
              tok_mask);

      enqueue(responseNetwork_out, ResponseMsg, directory_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        out_msg.DataBlk := dir_entry.DataBlk;

        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);

        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := tok_mask;

        out_msg.Dirty := false;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;
      }
    }
  }

  action(qf_queueMemoryFetchRequestFromNB, "qfnb",
        desc="Queue memory fetch for NB/TCC request") {
    peek(requestNetworkFromNB_in, RequestMsg) {
      tbe.last_requestor := in_msg.Requestor;
      tbe.OriginalRequestorMachId := in_msg.Requestor;
      tbe.RequestedSectorMask := amtc_normalizeMask(in_msg.requested_sector_mask, in_msg.sector_id);
      tbe.LastSectorID := in_msg.sector_id;
      tbe.FromGPU := true;
      tbe.IsSyncRequest := in_msg.is_sync;
      tbe.req_from_cpu := false;

      enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := machineID;
        out_msg.OriginalRequestorMachId := in_msg.Requestor;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 64;
      }
    }
  }

  // ============================================================================
  // PHASE 1: MEMORY DATA RESOLUTION FOR DOMAIN STATES
  // ============================================================================

  transition(I,
            {Data_Owner, Data_Owner_All_Collected,
              Tokens, Tokens_All_Collected}) {
    od_dropLateDmaWriteInvResp;
    k_popIncomingResponseQueue;
  }

  // Stale owner probes can now be answered by L1 with ACK_OWNER(0) while the
  // Directory has already stayed or returned to a stable state.  In stable
  // states there is no TBE/request waiting for this ACK_OWNER, so it must only
  // be drained.  Without this transition CE + Ack_Owner aborts after the L1
  // stale-owner wait-state repair path.
  transition({I, CS, GS, CGS, CE, GE}, Ack_Owner) {
    absorbStableStaleOwnerAck;
    k_popIncomingResponseQueue;
  }

  // When memory returns data for a CPU Shared request
  transition(CS, Memory_Data) {
    // Send data to the CPU requester (saved in TBE)
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for a GPU Shared request
  transition(GS, Memory_Data) {
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for a joint Shared request
  transition(CGS, Memory_Data) {
    d_sendMemoryDataWithoutTokens;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // When memory returns data for an Exclusive request (CE/GE)
  // Note: These usually need to send tokens along with the data
  transition(CE, Memory_Data) {
    // If the request was a GETX, we use the OwnerResponse to send tokens
    d_sendMemoryDataOwnerResponse;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition(GE, Memory_Data) {
    d_sendMemoryDataOwnerResponse;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  // ============================================================================
  // 1. INITIALIZATION (From Invalid)
  // ============================================================================
  transition(I, CPU_GETS, CS_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }

  /* V22: repair GETS from I is different from a normal cold GETS.
   * The requesting L2 already has a live CPU waiter and is using the repair
   * path because a stale owner or DMA/invalidation path failed to provide data.
   * After DMA_WRITE completion qd_markDmaWriteCompleteNoCachedCopies() has
   * saved the authoritative line in dir_entry.DataBlk and restored full tokens.
   * Serve one shared token directly instead of allocating a new memory-fetch
   * TBE; otherwise the waiter can loop in L1 timeout while L2 repeatedly sends
   * AMTC_L2_PENDING_GETS_DIR_RETRY_V37.
   */
  transition(I, CPU_GETS_Owner_Pull_Repair, CS) {
    d_send_dir_data_and_1_token_cpu_repair;
    u_set_cpu_shared;
    j_popIncomingRequestQueue;
  }
  transition(I, GPU_GETS, GS_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, CPU_GETX, CE_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, CPU_GETX_Stale_Self, CE_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }
  transition(I, GPU_GETX, GE_W) { v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue; }

  transition(CS, DMA_WRITE, CE_W_DMA_WRITE_BOTH) {
    vd_allocateDmaRequestInTBE;
    fdw_fwdDmaWriteInvToCpuOwner;
    ld_queueMemoryDmaWriteFromTbe;
    p_popDmaRequestQueue;
  }

  transition(CGS, DMA_WRITE, CE_W_DMA_WRITE_BOTH) {
    vd_allocateDmaRequestInTBE;
    fdw_fwdDmaWriteInvToCpuOwner;
    ld_queueMemoryDmaWriteFromTbe;
    p_popDmaRequestQueue;
  }


  // Memory Returns for Initialization
  transition(CS_W, Memory_Data, CS)  {
    d_send_mem_and_1_token_cpu;
    u_set_cpu_shared;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  transition(CE_W, Memory_Data, CE) {
    d_send_mem_and_all_tokens_cpu;
    u_set_cpu_exclusive;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  transition(I, GPU_GETS_NB, GS_W) {
    v_allocateTBEFromNB;
    qf_queueMemoryFetchRequestFromNB;
    j_popIncomingRequestFromNBQueue;
  }

  transition(I, GPU_GETX_NB, GE_W) {
    v_allocateTBEFromNB;
    qf_queueMemoryFetchRequestFromNB;
    j_popIncomingRequestFromNBQueue;
  }


  // (Symmetric Memory_Data transitions for GS_W -> GS, GE_W -> GE)


  // ============================================================================
  // AMTC audit5: tolerate stale memory writeback ACK while a same-line fetch waits.
  //
  // A dirty WB can queue MEMORY_WB, then a later GETS/GETX for the same line can
  // move the directory into *_W waiting for MEMORY_READ data before the WB ACK
  // arrives.  In that case the ACK is not the completion event for the current
  // fetch; consume it and keep waiting for Memory_Data.
  // ============================================================================
  transition({CS_W, GS_W, CE_W, GE_W, CGS_W, CE_W_DataOnly, GE_W_DataOnly, CE_W_Stale_GETX, CE_W_DMA_READ, GE_W_DMA_READ}, Memory_Ack) {
    l_popMemQueue;
  }

  // AMTC audit8: stale/no-TBE memory responses. These are responses to an older
  // memory operation whose TBE was already deallocated, usually because a forwarded
  // owner/L2 response completed the requester first. They must only drain the
  // memory response queue and must not access tbe fields.
  transition({I, CS, GS, CGS, CE, GE, CE_XFER, GE_XFER,
              CS_W, GS_W, CE_W, GE_W, CGS_W,
              MIG_C2G, MIG_G2C, CGS_CPU_UPG, CGS_GPU_UPG,
              CE_W_DataOnly, GE_W_DataOnly, CE_W_Stale_GETX, CE_W_DMA_READ, GE_W_DMA_READ, CE_W_DMA_WRITE_BOTH, CE_W_DMA_WRITE_MEM, CE_W_DMA_WRITE_TOK, GE_W_DMA_WRITE_BOTH, GE_W_DMA_WRITE_MEM, GE_W_DMA_WRITE_TOK}, Memory_Data_Stale) {
    l_popMemQueue;
  }

  transition({I, CS, GS, CGS, CE, GE, CE_XFER, GE_XFER,
              CS_W, GS_W, CE_W, GE_W, CGS_W,
              MIG_C2G, MIG_G2C, CGS_CPU_UPG, CGS_GPU_UPG,
              CE_W_DataOnly, GE_W_DataOnly, CE_W_Stale_GETX, CE_W_DMA_READ, GE_W_DMA_READ, CE_W_DMA_WRITE_BOTH, CE_W_DMA_WRITE_MEM, CE_W_DMA_WRITE_TOK, GE_W_DMA_WRITE_BOTH, GE_W_DMA_WRITE_MEM, GE_W_DMA_WRITE_TOK}, Memory_Ack_Stale) {
    l_popMemQueue;
  }

  // ============================================================================
  // 2. CPU SHARED (CS)
  // ============================================================================
  transition(CS, CPU_GETS) {
    // Directory holds tokens and data. Reply directly.
    d_send_dir_data_and_1_token_cpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }
  transition(CS, GPU_GETS, CGS) {
    // Cross-domain: Directory already has the data! No need to fetch from memory.
    d_send_dir_data_and_1_token_gpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }

  transition(CS, GPU_GETS_NB, CGS) {
    d_send_dir_data_and_1_token_nb; u_set_gpu_shared_from_nb; j_popIncomingRequestFromNBQueue;
  }

  transition(CS, CPU_GETX_Stale_Self, CE) {
    d_send_dir_data_and_remaining_tokens_cpu;
    u_set_cpu_exclusive;
    j_popIncomingRequestQueue;
  }

  transition(CS, CPU_GETX, CE) {
    // Directory is in CS and has clean data.  For a CPU sector upgrade,
    // respond with DATA_OWNER plus requested remaining tokens in one message.
    // Do not split into ACK + later memory data; that reorders progress and
    // strands L1 S_IM when the store sector needs old bytes.
    d_send_dir_data_and_remaining_tokens_cpu;
    u_set_cpu_exclusive;
    j_popIncomingRequestQueue;
  }



  transition(CS, GPU_GETX, MIG_C2G) {
    v_allocateTBE; fwd_inv_to_cpu; j_popIncomingRequestQueue;
  }

  transition(CGS_W, Memory_Data, CGS) {
    d_send_mem_and_1_token_gpu;
    u_set_gpu_shared;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  // ============================================================================
  // CE → CE_XFER → CE TRANSITIONS
  // ============================================================================

  // CRITICAL FIX: Instantly transfer ownership without allocating a TBE!
  transition(CE, CPU_GETX) {
    fwd_req_to_cpu;
    u_set_cpu_exclusive;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 3. CPU+GPU SHARED (CGS)
  // ============================================================================
  transition(GS, GPU_GETS) {
    d_send_dir_data_and_1_token_gpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }

  transition(GS, GPU_GETS_NB) {
    d_send_dir_data_and_1_token_nb; u_set_gpu_shared_from_nb; j_popIncomingRequestFromNBQueue;
  }
  transition(GS, CPU_GETS, CGS) {
    d_send_dir_data_and_1_token_cpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }

  transition(CGS, CPU_GETS) {
    d_send_dir_data_and_1_token_cpu; j_popIncomingRequestQueue;
  }
  transition(CGS, GPU_GETS) {
    d_send_dir_data_and_1_token_gpu; j_popIncomingRequestQueue;
  }

  transition(CGS, GPU_GETS_NB) {
    d_send_dir_data_and_1_token_nb; j_popIncomingRequestFromNBQueue;
  }

  transition(CGS, CPU_GETX_Stale_Self, CGS_CPU_UPG) {
    v_allocateTBE; fwd_inv_to_gpu; j_popIncomingRequestQueue;
  }

  transition(CGS, CPU_GETX, CGS_CPU_UPG) {
    v_allocateTBE; fwd_inv_to_gpu; j_popIncomingRequestQueue;
  }
  transition(CGS_CPU_UPG, Tokens_Ack, CE) {
    // Upgrade complete when GPU returns its tokens
    f_incrementTokens; d_send_remaining_tokens_cpu; u_set_cpu_exclusive; s_deallocateTBE; k_popIncomingResponseQueue; qw_wakeUpDependents;
  }

  // ============================================================================
  // 4. CPU EXCLUSIVE (CE)
  // ============================================================================
  // Audit37: stale self-owner CPU GETX repair.  After many retries the
  // Directory may still be in CE, but the recorded CPU owner no longer has the
  // line.  Fetch memory and return a complete owner grant to the requester.
  transition(CE, CPU_GETX_Stale_Self, CE_W_Stale_GETX) {
    v_allocateTBE;
    qf_queueMemoryFetchRequest;
    j_popIncomingRequestQueue;
  }

  transition(CE_W_Stale_GETX, Memory_Data, CE) {
    d_send_mem_and_forced_all_tokens_cpu;
    u_set_cpu_exclusive;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  transition(CE, CPU_GETS) { fwd_req_to_cpu; j_popIncomingRequestQueue; }

  // Audit41: DMA read in CE must read the CPU owner's latest data, not
  // stale memory.  This path is used by the HSA packet processor when reading
  // CPU-written queue/doorbell/packet contents during kernel launch.
  transition(CE, DMA_READ, CE_W_DMA_READ) {
    vd_allocateDmaRequestInTBE;
    fdr_fwdDmaReadToCpuOwner;
    p_popDmaRequestQueue;
  }

  transition(CE_W_DMA_READ, {Data_Shared, Data_Owner, Data_Owner_All_Collected}, CE) {
    dd_sendDmaData;
    s_deallocateTBE;
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

  // If the recorded owner is stale and only sends ACK_OWNER(0), fall back to
  // memory instead of invalid-transitioning or waiting forever.
  transition(CE_W_DMA_READ, Ack_Owner) {
    qdr_markDmaReadStaleCpuOwnerFallback;
    ft_memoryDmaFromTbe;
    k_popIncomingResponseQueue;
  }

  transition(CE_W_DMA_READ, Memory_Data, I) {
    qdm_saveDmaReadFallbackMemoryData;
    dm_sendMemoryDataToDma;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }



  // Audit45: GPU/HSAPP DMA write while a CPU-exclusive owner exists. This is
  // the completion-signal/doorbell visibility case. Write the DMA payload to
  // memory, invalidate/probe the CPU owner, then ACK DMA only after both the
  // memory write and owner invalidation/data response have completed. Final
  // state is I because the DMA write becomes the authoritative memory copy and
  // the previous CPU owner was invalidated.
  transition(CE, DMA_WRITE, CE_W_DMA_WRITE_BOTH) {
    vd_allocateDmaRequestInTBE;
    fdw_fwdDmaWriteInvToCpuOwner;
    ld_queueMemoryDmaWriteFromTbe;
    p_popDmaRequestQueue;
  }

  transition(GS, DMA_WRITE, CE_W_DMA_WRITE_BOTH) {
    vd_allocateDmaRequestInTBE;
    fdw_fwdDmaWriteInvToCpuOwner;
    ld_queueMemoryDmaWriteFromTbe;
    p_popDmaRequestQueue;
  }

  transition(CE_W_DMA_WRITE_BOTH, Memory_Ack, CE_W_DMA_WRITE_TOK) {
    l_popMemQueue;
  }

  transition(CE_W_DMA_WRITE_BOTH, {Data_Shared, Data_Owner, Data_Owner_All_Collected, Tokens, Tokens_All_Collected}, CE_W_DMA_WRITE_MEM) {
    qd_updateTokensFromDmaWriteInvResp;
    k_popIncomingResponseQueue;
  }

  transition(CE_W_DMA_WRITE_TOK, {Data_Shared, Data_Owner, Data_Owner_All_Collected, Tokens, Tokens_All_Collected}, I) {
    qd_updateTokensFromDmaWriteInvResp;
    qd_markDmaWriteCompleteNoCachedCopies;
    da_sendDmaAck;
    s_deallocateTBE;
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

  transition(CE_W_DMA_WRITE_MEM, Memory_Ack, I) {
    qd_markDmaWriteCompleteNoCachedCopies;
    da_sendDmaAck;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  // FIX: Forward the GETX safely, and update the Directory's owner record
  //transition(CE, CPU_GETX) { fwd_req_to_cpu; u_set_cpu_exclusive; j_popIncomingRequestQueue; }

  transition(CE, GPU_GETS, CGS) {
    fwd_req_to_cpu; u_set_gpu_shared; j_popIncomingRequestQueue;
  }

  // Audit94: GPU/NB GETS in CE was repeatedly forwarded to the recorded CPU/L2
  // owner, but the owner often appears stale/NP for the GPU payload lines.  The
  // forwarded request then re-enters the L2 miss path as req=TCC-0 and no data
  // returns to TCC, leaving GPUCoalescer with many outstanding LDs.  For
  // bring-up, serve CE + GPU_GETS_NB directly from the directory copy and move
  // to CGS.  This is conservative for progress; later refine by validating the
  // owner is truly dirty before taking the owner-pull path.
  transition(CE, GPU_GETS_NB, CGS) {
    d_send_dir_data_and_1_token_nb; u_set_gpu_shared_from_nb; j_popIncomingRequestFromNBQueue;
  }
  transition(CE, GPU_GETX, MIG_C2G) {
    v_allocateTBE; fwd_inv_to_cpu; j_popIncomingRequestQueue;
  }

  transition(MIG_C2G, Tokens_Ack, GE) {
    f_incrementTokens; d_send_remaining_tokens_gpu; u_set_gpu_exclusive; s_deallocateTBE; k_popIncomingResponseQueue; qw_wakeUpDependents;
  }

  // ============================================================================
  // 5. GPU EXCLUSIVE (GE)
  // ============================================================================
  transition(GE, GPU_GETS) { fwd_req_to_gpu; j_popIncomingRequestQueue; }

  // Symmetric DMA read while GPU-exclusive metadata exists.
  transition(GE, DMA_READ, GE_W_DMA_READ) {
    vd_allocateDmaRequestInTBE;
    fdr_fwdDmaReadToGpuOwner;
    p_popDmaRequestQueue;
  }

  transition(GE_W_DMA_READ, {Data_Shared, Data_Owner, Data_Owner_All_Collected}, GE) {
    dd_sendDmaData;
    s_deallocateTBE;
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

  transition(GE_W_DMA_READ, Ack_Owner) {
    qdg_markDmaReadStaleGpuOwnerFallback;
    ft_memoryDmaFromTbe;
    k_popIncomingResponseQueue;
  }

  transition(GE_W_DMA_READ, Memory_Data, I) {
    qdm_saveDmaReadFallbackMemoryData;
    dm_sendMemoryDataToDma;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  // DMA read from shared states: fetch memory for DMA but return to
  // the original shared state. A DMA read is non-mutating, so it must not
  // collapse CS/CGS/GS into I; doing so violates the token invariant.
  transition(CS, DMA_READ, CS_DMA_R_W) {
    vd_allocateDmaRequestInTBE;
    fd_memoryDma;
    p_popDmaRequestQueue;
  }

  transition(CGS, DMA_READ, CGS_DMA_R_W) {
    vd_allocateDmaRequestInTBE;
    fd_memoryDma;
    p_popDmaRequestQueue;
  }

  transition(GS, DMA_READ, GS_DMA_R_W) {
    vd_allocateDmaRequestInTBE;
    fd_memoryDma;
    p_popDmaRequestQueue;
  }

  // Symmetric GPU-exclusive DMA write handling.
  transition(GE, DMA_WRITE, GE_W_DMA_WRITE_BOTH) {
    vd_allocateDmaRequestInTBE;
    fdw_fwdDmaWriteInvToGpuOwner;
    ld_queueMemoryDmaWriteFromTbe;
    p_popDmaRequestQueue;
  }

  transition(GE_W_DMA_WRITE_BOTH, Memory_Ack, GE_W_DMA_WRITE_TOK) {
    l_popMemQueue;
  }

  transition(GE_W_DMA_WRITE_BOTH, {Data_Shared, Data_Owner, Data_Owner_All_Collected, Tokens, Tokens_All_Collected}, GE_W_DMA_WRITE_MEM) {
    qd_updateTokensFromDmaWriteInvResp;
    k_popIncomingResponseQueue;
  }

  transition(GE_W_DMA_WRITE_TOK, {Data_Shared, Data_Owner, Data_Owner_All_Collected, Tokens, Tokens_All_Collected}, I) {
    qd_updateTokensFromDmaWriteInvResp;
    qd_markDmaWriteCompleteNoCachedCopies;
    da_sendDmaAck;
    s_deallocateTBE;
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

  transition(GE_W_DMA_WRITE_MEM, Memory_Ack, I) {
    qd_markDmaWriteCompleteNoCachedCopies;
    da_sendDmaAck;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  // FIX: Safe forward and update owner
  transition(GE, GPU_GETX) { fwd_req_to_gpu; u_set_gpu_exclusive; j_popIncomingRequestQueue; }

  transition(GE, CPU_GETS, CGS) {
    fwd_req_to_gpu; u_set_cpu_shared; j_popIncomingRequestQueue;
  }
  transition(GE, CPU_GETX, MIG_G2C) {
    v_allocateTBE; fwd_inv_to_gpu; j_popIncomingRequestQueue;
  }

  // =====================================================================
  // CRITICAL FIX: Added missing completion transition to prevent TBE leaks!
  // =====================================================================
  transition(MIG_G2C, Tokens_Ack, CE) {
    f_incrementTokens;
    d_send_remaining_tokens_cpu;
    u_set_cpu_exclusive;
    s_deallocateTBE; // <--- This prevents the TBE table from filling up!
    k_popIncomingResponseQueue;
    qw_wakeUpDependents;
  }

//============================================================================
  // 5. STALLS
  // ============================================================================

  // Audit92: DMA read owner-pull can bounce back as a standard request
  // while the directory is waiting in CE_W_DMA_READ/GE_W_DMA_READ.  Observed
  // HSAPP AQL queue read: DMA_READ addr=0x19d7000 entered CE_W_DMA_READ,
  // forwarded GETS to L2Cache-0, then a GPU_GETS arrived at the Directory and
  // was stalled forever, leaving DMA in BUSY_RD.  For bring-up, treat this as
  // stale/bounced owner-pull and fall back to memory using the recorded DMA TBE;
  // then pop the bounced request so the DMA Memory_Data path can complete.
  transition(CE_W_DMA_READ,
             {CPU_GETS, GPU_GETS, CPU_GETX, CPU_GETX_Stale_Self,
              CPU_GETS_Owner_Pull_Repair, GPU_GETX, GETS_Owner_Pull},
             CE_W_DMA_READ) {
    ft_memoryDmaFromTbe;
    j_popIncomingRequestQueue;
  }

  transition(GE_W_DMA_READ,
             {CPU_GETS, GPU_GETS, CPU_GETX, CPU_GETX_Stale_Self,
              CPU_GETS_Owner_Pull_Repair, GPU_GETX, GETS_Owner_Pull},
             GE_W_DMA_READ) {
    ft_memoryDmaFromTbe;
    j_popIncomingRequestQueue;
  }

  // Audit91: Do not park ordinary CPU/GPU retries with stall_and_wait while
  // the directory is in a transient memory/owner-transfer state.  The observed
  // L2 proxy miss deadlock was:
  //   L2Cache-3 sends GETS for 0x10f26c0 and enters IS,
  //   duplicate L1 retries are forwarded by L2,
  //   Directory can be in CS_W/CE_W-style wait and a stalled request may miss
  //   the wakeup, leaving L2 in IS forever.
  // Recycle the request instead; once Memory_Data/owner response completes and
  // the line reaches a stable state, the request will be retried and served.
  transition({CS_W, GS_W, CE_W, GE_W, CGS_W, CE_W_Stale_GETX, CE_W_DMA_WRITE_BOTH, CE_W_DMA_WRITE_MEM, CE_W_DMA_WRITE_TOK, GE_W_DMA_WRITE_BOTH, GE_W_DMA_WRITE_MEM, GE_W_DMA_WRITE_TOK, MIG_C2G, MIG_G2C, CGS_CPU_UPG, CGS_GPU_UPG, CE_XFER, GE_XFER}, {CPU_GETS, GPU_GETS, CPU_GETX, CPU_GETX_Stale_Self, CPU_GETS_Owner_Pull_Repair, GPU_GETX, GETS_Owner_Pull}) {
    z_recycleRequest;
  }

  transition({CS_W, GS_W, CE_W, GE_W, CGS_W, CE_W_Stale_GETX, CE_W_DMA_READ, GE_W_DMA_READ, CE_W_DMA_WRITE_BOTH, CE_W_DMA_WRITE_MEM, CE_W_DMA_WRITE_TOK, GE_W_DMA_WRITE_BOTH, GE_W_DMA_WRITE_MEM, GE_W_DMA_WRITE_TOK, MIG_C2G, MIG_G2C, CGS_CPU_UPG, CGS_GPU_UPG, CE_XFER, GE_XFER}, {GPU_GETS_NB, GPU_GETX_NB, GETS_Owner_Pull_NB}) {
    z_stallAndWaitRequestFromNB;
  }

  // CRITICAL FIX: Stall all requests (including retries) during Data-Only pulls
  transition({CE_W_DataOnly, GE_W_DataOnly}, {CPU_GETS, GPU_GETS, CPU_GETX, CPU_GETX_Stale_Self, CPU_GETS_Owner_Pull_Repair, GPU_GETX, GETS_Owner_Pull}) {
    z_stallAndWaitRequest;
  }

  // Stall duplicate DMA requests while a DMA read repair is already waiting on memory.
  transition({CE_W_DMA_READ, GE_W_DMA_READ, CE_W_DMA_WRITE_BOTH, CE_W_DMA_WRITE_MEM, CE_W_DMA_WRITE_TOK,
              GE_W_DMA_WRITE_BOTH, GE_W_DMA_WRITE_MEM, GE_W_DMA_WRITE_TOK}, {DMA_READ, DMA_WRITE}) {
    y_stallAndWaitDmaRequest;
  }

  // DMA requests can arrive while the directory is already waiting on a
  // non-DMA memory/owner-transfer path.  During HSAPP AQL queue reads this was
  // observed as q1 DMA_READ entering while the line was in CE_W/GE_W.  Parking
  // the DMA queue with stall_and_wait can miss the wakeup from the non-DMA TBE
  // and leave HSAPP dmaInProgress permanently true.  Recycle the DMA request
  // instead: once the active memory/owner transaction reaches a stable state,
  // the DMA request will re-enter and use the normal CE/GE/CS/GS DMA path.
  transition({CS_W, GS_W, CE_W, GE_W, CGS_W,
              CE_W_Stale_GETX,
              MIG_C2G, MIG_G2C,
              CGS_CPU_UPG, CGS_GPU_UPG,
              CE_XFER, GE_XFER},
            {DMA_READ, DMA_WRITE}) {
    y_recycleDmaRequestQueue;
  }

  // ============================================================================
  // 2. CPU SHARED (CS)
  // ============================================================================
  // Handle normal reads AND owner pulls exactly the same way: reply with data
  transition(CS, {GETS_Owner_Pull}) {
    f_forwardRequestToSharers;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 3. GPU SHARED (GS)
  // ============================================================================
  transition(GS, {GETS_Owner_Pull}) {
    d_send_dir_data_and_1_token_gpu;
    u_set_gpu_shared;
    j_popIncomingRequestQueue;
  }

  // ============================================================================
  // 4. CPU+GPU SHARED (CGS)
  // ============================================================================
  transition(CGS, {GETS_Owner_Pull}) {
    d_send_dir_data_and_1_token_cpu;
    j_popIncomingRequestQueue;
  }

  transition(CGS, {GETS_Owner_Pull_NB}) {
    d_send_dir_data_and_1_token_nb;
    j_popIncomingRequestFromNBQueue;
  }

  // Note: Since GETS_Owner_Pull doesn't distinguish between CPU and GPU in the event name,
  // we route it based on the domain. We need a GPU variant for CGS.
  // Assuming you have an event like GPU_GETS_Owner_Pull or you route it inside the in_port.
  // If you only have one GETS_Owner_Pull event, you might need to handle it based on the
  // requestor's domain inside the action or the in_port.

  // Transitions for Owner Pulling partial data
  transition(CE, GETS_Owner_Pull, CE_W_DataOnly) {
    v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue;
  }

  // If the TCC stale-owner repair arrives before the first CE->CGS transition
  // is visible, serve it on the NB queue rather than using the old CPU action.
  transition(CE, GETS_Owner_Pull_NB, CGS) {
    d_send_dir_data_and_1_token_nb;
    u_set_gpu_shared_from_nb;
    j_popIncomingRequestFromNBQueue;
  }
  transition(GE, GETS_Owner_Pull, GE_W_DataOnly) {
    v_allocateTBE; qf_queueMemoryFetchRequest; j_popIncomingRequestQueue;
  }

  // Resolution from Memory
  transition(CE_W_DataOnly, Memory_Data, CE) {
    d_send_mem_data_only_cpu; l_popMemQueue; s_deallocateTBE; qw_wakeUpDependents;
  }
  transition(GE_W_DataOnly, Memory_Data, GE) {
    d_send_mem_data_only_gpu; l_popMemQueue; s_deallocateTBE; qw_wakeUpDependents;
  }

  transition(CE_W_DataOnly, Tokens) {
    d_forward_tokens_to_cpu;
    k_popIncomingResponseQueue;
  }

  transition(GE_W_DataOnly, Tokens) {
    d_forward_tokens_to_gpu; // Assuming you made the symmetric GPU action
    k_popIncomingResponseQueue;
  }

  // Audit47: token-only writebacks can arrive while the directory still
  // carries stale exclusive-domain metadata.  Once the directory absorbs any
  // subset of tokens, stable CE/GE is no longer legal because CE/GE require
  // all requested-sector tokens to remain outside the directory.  Downgrade
  // the domain state to shared-domain metadata for partial token returns; the
  // full-token case is still handled by Tokens_All_Collected -> I below.
  transition({CS, GS, CGS}, Tokens) {
    q_updateTokensFromResponse;
    k_popIncomingResponseQueue;
  }

  transition(CE, Tokens, CS) {
    q_updateTokensFromResponse;
    k_popIncomingResponseQueue;
  }

  transition(GE, Tokens, GS) {
    q_updateTokensFromResponse;
    k_popIncomingResponseQueue;
  }

  // When all tokens are collected, the line can become idle.
  transition({CS, GS, CGS, CE, GE}, Tokens_All_Collected, I) {
    q_updateTokensFromResponse;
    k_popIncomingResponseQueue;
  }

  // AMTC audit-freeze/v16: a DATA_SHARED response can arrive late after the
  // requester already replaced/bounced the response, or after a stale owner
  // probe was already repaired.  In stable states this response is not the
  // current ownership transfer completion.  Do not absorb its partial token
  // payload into Directory and do not move CE/GE to I; just drain it.
  transition({I, CS, CGS, GS, CE, GE}, Data_Shared) {
    absorbLateSharedDataResponse;
    k_popIncomingResponseQueue;
  }

  // 1. Partial Eviction
 // 1. Shared States: Stay in the same state, absorb tokens, write to memory
  transition({CS, GS, CGS}, Data_Owner) {
    q_updateTokensFromResponse;
    lq_queueMemoryWbRequest;
    k_popIncomingResponseQueue;
  }

  transition(I, Memory_Data) {
    // Note: Replace l_popMemQueue with the specific action name your
    // Directory uses to pop the incoming memory network queue!
    l_popMemQueue;
  }

  transition(I, Memory_Ack) {
    l_popMemQueue;
  }

  // v16: CE + DATA_SHARED is handled by the stable stale-data absorber above.
  // A partial late DATA_SHARED must not move CE -> I because it can leave the
  // Directory in I with only a partial token set and trip the I-state invariant.

  // Audit12 hybrid owner writeback classification:
  //   Data_Owner partial       -> shared state (CS/GS)
  //   Data_Owner_All_Collected -> I
  transition(CE, Data_Owner, CS) {
    q_updateTokensFromResponse;
    lq_queueMemoryWbRequest;
    k_popIncomingResponseQueue;
  }

  transition(GE, Data_Owner, GS) {
    q_updateTokensFromResponse;
    lq_queueMemoryWbRequest;
    k_popIncomingResponseQueue;
  }

  transition({CS, GS, CGS, CE, GE}, Data_Owner_All_Collected, I) {
    q_updateTokensFromResponse;
    k_popIncomingResponseQueue;
  }

  transition(GS_W, Memory_Data, GS) {
    d_send_mem_and_1_token_gpu;
    u_set_gpu_shared;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  transition(GE_W, Memory_Data, GE) {
    d_send_mem_and_all_tokens_gpu;
    u_set_gpu_exclusive;
    l_popMemQueue;
    s_deallocateTBE;
    qw_wakeUpDependents;
  }

  // Requires adding an I_DMA_W state to your State declaration
  transition(I, DMA_READ, I_DMA_W) {
    vd_allocateDmaRequestInTBE;
    fd_memoryDma; // Your action to fetch memory for DMA
    p_popDmaRequestQueue;
  }

  transition(I_DMA_W, Memory_Data, I) {
    dm_sendMemoryDataToDma;
    s_deallocateTBE;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition(CE, CPU_GETS_Owner_Pull_Repair, CS) {
    d_send_dir_data_and_1_token_cpu_repair;
    u_set_cpu_shared;
    j_popIncomingRequestQueue;
  }

  transition(CS, CPU_GETS_Owner_Pull_Repair) {
    d_send_dir_data_and_1_token_cpu_repair;
    u_set_cpu_shared;
    j_popIncomingRequestQueue;
  }

  transition(CGS, CPU_GETS_Owner_Pull_Repair) {
    d_send_dir_data_and_1_token_cpu_repair;
    u_set_cpu_shared;
    j_popIncomingRequestQueue;
  }

  transition(CS_DMA_R_W, Memory_Data, CS) {
    dm_sendMemoryDataToDma;
    s_deallocateTBE;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition(CGS_DMA_R_W, Memory_Data, CGS) {
    dm_sendMemoryDataToDma;
    s_deallocateTBE;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition(GS_DMA_R_W, Memory_Data, GS) {
    dm_sendMemoryDataToDma;
    s_deallocateTBE;
    l_popMemQueue;
    qw_wakeUpDependents;
  }

  transition({CS_DMA_R_W, CGS_DMA_R_W, GS_DMA_R_W},
           {CPU_GETS, GPU_GETS,
            CPU_GETX, CPU_GETX_Stale_Self,
            CPU_GETS_Owner_Pull_Repair,
            GPU_GETX, GETS_Owner_Pull}) {
    z_stallAndWaitRequest;
  }

  transition({CS_DMA_R_W, CGS_DMA_R_W, GS_DMA_R_W},
            {GPU_GETS_NB, GPU_GETX_NB, GETS_Owner_Pull_NB}) {
    z_stallAndWaitRequestFromNB;
  }

  transition({CS_DMA_R_W, CGS_DMA_R_W, GS_DMA_R_W},
            {DMA_READ, DMA_WRITE}) {
    y_stallAndWaitDmaRequest;
  }

  transition(I, DMA_WRITE, I_DMA_WRITE_W) {
      vd_allocateDmaRequestInTBE;
      ld_queueMemoryDmaWriteFromTbe;
      p_popDmaRequestQueue;
  }

  transition(I_DMA_WRITE_W, Memory_Ack, I) {
      da_sendDmaAck;
      l_popMemQueue;
      s_deallocateTBE;
      qw_wakeUpDependents;
  }

  transition(I_DMA_WRITE_W, {DMA_READ, DMA_WRITE}) {
      y_stallAndWaitDmaRequest;
  }

}
