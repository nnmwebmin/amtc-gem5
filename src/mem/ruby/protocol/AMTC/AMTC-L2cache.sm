  action(sendPendingGetxDataToL1, "spxd",
        desc="Send full-line DATA_OWNER to saved pending L1 requester") {
    cache_entry := getCacheEntry(address);

    bool pending_l1_ok_v33 := false;
    if (cache_entry.PendingL1Valid &&
        machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
        cache_entry.PendingReqMask != 0) {
      pending_l1_ok_v33 := true;
    }

    if (!pending_l1_ok_v33) {
      DPRINTF(RubySlicc,
              "AMTC_L2_SEND_PENDING_GETX_DATA_SKIP_BAD_REQ_V33 addr=%#x pending=%d req=%s reqmask=%d is_getx=%d valid=%d T0=%d T1=%d state=%s\n",
              address, cache_entry.PendingL1Valid,
              cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
              cache_entry.PendingIsGetX, cache_entry.ValidSectors,
              cache_entry.TokensSec0, cache_entry.TokensSec1,
              getState(cache_entry, address));
    } else {

    int req_mask := cache_entry.PendingReqMask;
    if (req_mask == 0) {
      req_mask := amtc_fullMask();
    }

    int send_mask := req_mask;
    int tokens_per_sector := max_tokens() / 2;
    int held_t0 := cache_entry.PendingRequesterHeldTokensSec0;
    int held_t1 := cache_entry.PendingRequesterHeldTokensSec1;
    if (held_t0 < 0) { held_t0 := 0; }
    if (held_t1 < 0) { held_t1 := 0; }
    if (held_t0 > tokens_per_sector) { held_t0 := tokens_per_sector; }
    if (held_t1 > tokens_per_sector) { held_t1 := tokens_per_sector; }

    int send_t0 := 0;
    int send_t1 := 0;
    if (amtc_maskHasSector(send_mask, 0)) {
      int need_t0 := tokens_per_sector - held_t0;
      if (need_t0 < 0) { need_t0 := 0; }
      send_t0 := cache_entry.TokensSec0;
      if (send_t0 > need_t0) {
        send_t0 := need_t0;
      }
    }
    if (amtc_maskHasSector(send_mask, 1)) {
      int need_t1 := tokens_per_sector - held_t1;
      if (need_t1 < 0) { need_t1 := 0; }
      send_t1 := cache_entry.TokensSec1;
      if (send_t1 > need_t1) {
        send_t1 := need_t1;
      }
    }

    int token_mask := 0;
    if (send_t0 > 0) {
      token_mask := amtc_addSectorToMask(token_mask, 0);
    }
    if (send_t1 > 0) {
      token_mask := amtc_addSectorToMask(token_mask, 1);
    }

    DPRINTF(RubySlicc,
            "AMTC_L2_SEND_PENDING_GETX_DATA_V28 addr=%#x req=%s reqmask=%d sendmask=%d sent0=%d sent1=%d tokmask=%d\n",
            address,
            cache_entry.PendingL1Requestor,
            req_mask,
            send_mask,
            send_t0,
            send_t1,
            token_mask);

    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(cache_entry.PendingL1Requestor);

      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := true;

      out_msg.TokensSec0 := send_t0;
      out_msg.TokensSec1 := send_t1;

      out_msg.sector_id := 0;
      out_msg.sector_mask := send_mask;
      out_msg.requested_sector_mask := req_mask;
      out_msg.valid_sector_mask := send_mask;
      out_msg.token_sector_mask := token_mask;

      out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);

      out_msg.merged_resp := false;
      out_msg.isGLCSet := false;
      out_msg.isSLCSet := false;
    }

    // Requester-held tokens are metadata credit only.  Send only the
    // missing delta from L2, then clear L2 tokens for requested sectors to
    // avoid duplicate token ownership/overflow at the requester.
    if (amtc_maskHasSector(send_mask, 0)) {
      cache_entry.TokensSec0 := 0;
    }
    if (amtc_maskHasSector(send_mask, 1)) {
      cache_entry.TokensSec1 := 0;
    }
    }
  }

  action(dbg_l2ForceLocalGetxGrant, "fxdbg",
         desc="Debug forced local GETX owner grant from stuck IX") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IX_GETX_FORCE_LOCAL_GRANT_V14 addr=%#x valid=%d T0=%d T1=%d pending=%d req=%s reqmask=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }

  action(forcePendingGetxOwnerDataToL1, "fpxd",
         desc="Bring-up: force DATA_OWNER with synthetic ownership tokens to saved pending L1") {
    cache_entry := getCacheEntry(address);

    int req_mask := cache_entry.PendingReqMask;
    if (req_mask == 0) {
      req_mask := amtc_fullMask();
    }
    req_mask := amtc_sanitizeMask(req_mask);

    int send_t0 := 0;
    int send_t1 := 0;
    int token_mask := 0;

    if (amtc_maskHasSector(req_mask, 0)) {
      send_t0 := max_tokens() / 2;
      token_mask := amtc_addSectorToMask(token_mask, 0);
    }
    if (amtc_maskHasSector(req_mask, 1)) {
      send_t1 := max_tokens() / 2;
      token_mask := amtc_addSectorToMask(token_mask, 1);
    }

    DPRINTF(RubySlicc,
            "AMTC_L2_IX_GETX_FORCE_OWNER_DATA_V14 addr=%#x req=%s reqmask=%d sent0=%d sent1=%d tokmask=%d\n",
            address, cache_entry.PendingL1Requestor, req_mask,
            send_t0, send_t1, token_mask);

    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(cache_entry.PendingL1Requestor);

      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := true;

      out_msg.TokensSec0 := send_t0;
      out_msg.TokensSec1 := send_t1;

      out_msg.sector_id := cache_entry.PendingSectorId;
      out_msg.sector_mask := req_mask;
      out_msg.requested_sector_mask := req_mask;
      out_msg.valid_sector_mask := req_mask;
      out_msg.token_sector_mask := token_mask;

      out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);

      out_msg.merged_resp := false;
      out_msg.isGLCSet := false;
      out_msg.isSLCSet := false;
    }

    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(k_dataFromL2CacheToL1Requestor, "k", desc="AMTC strict complete DATA_SHARED response for passive L1") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) {
        req_mask := in_msg.sector_mask;
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }
      req_mask := amtc_sanitizeMask(req_mask);

      bool valid_complete := amtc_maskContainsAll(cache_entry.ValidSectors, req_mask);

      // If this L2 holds all tokens for a requested sector, the line data in
      // cache_entry.DataBlk is authoritative even if ValidSectors was narrowed
      // by an earlier sector writeback hint.  Do not suppress the response in
      // this case; otherwise the original L1 request is popped and no one ever
      // sends the missing sector data back to the passive L1.
      bool owner_data0 := (!amtc_maskHasSector(req_mask, 0)) ||
                          (cache_entry.TokensSec0 == (max_tokens() / 2));
      bool owner_data1 := (!amtc_maskHasSector(req_mask, 1)) ||
                          (cache_entry.TokensSec1 == (max_tokens() / 2));
      bool owner_data_complete := owner_data0 && owner_data1;

      bool data_complete := valid_complete || owner_data_complete;
      bool token0_ready := (!amtc_maskHasSector(req_mask, 0)) || (cache_entry.TokensSec0 > 0);
      bool token1_ready := (!amtc_maskHasSector(req_mask, 1)) || (cache_entry.TokensSec1 > 0);
      bool shared_complete := token0_ready && token1_ready;

      // Passive L1 contract:
      // Never send partial data as a final response.  L1 can accumulate, but
      // L2/TCC is the convergence coordinator and must only wake L1 once the
      // full requested sector mask has data and shared tokens.
      if (data_complete && shared_complete) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := req_mask;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);

          if (amtc_maskHasSector(req_mask, 0)) {
            out_msg.TokensSec0 := 1;
            cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
            if (cache_entry.TokensSec0 == 0) {
              cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 1);
            }
          } else {
            out_msg.TokensSec0 := 0;
          }

          if (amtc_maskHasSector(req_mask, 1)) {
            out_msg.TokensSec1 := 1;
            cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
            if (cache_entry.TokensSec1 == 0) {
              cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 2);
            }
          } else {
            out_msg.TokensSec1 := 0;
          }
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_COMPLETE_GETS_DATA_V5 addr=%#x req=%d valid=%d owner_data=%d t0=%d t1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                owner_data_complete, cache_entry.TokensSec0, cache_entry.TokensSec1);
      } else {
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.RetryNum := in_msg.RetryNum;
          out_msg.Destination.broadcast(MachineType:L2Cache);
          out_msg.Destination.remove(machineID);
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.AccessMode := in_msg.AccessMode;
          out_msg.Prefetch := in_msg.Prefetch;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.merged_req := in_msg.merged_req;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_SUPPRESS_PARTIAL_GETS addr=%#x req=%d valid=%d t0=%d t1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1);
      }
    }
  }

  action(k_dataOwnerFromL2CacheToL1Requestor, "\k", desc="Send data and tokens from L2 cache to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }

    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    amtc_assertTokenBounds(send_t0);
    amtc_assertTokenBounds(send_t1);

    // PHASE 2 ASSERT: We must be sending tokens for at least one sector!
    assert(send_t0 > 0 || send_t1 > 0);

      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int safe_send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      if (safe_send_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := safe_send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
        }
      } else {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Destination.broadcast(MachineType:L2Cache);
           out_msg.Destination.remove(machineID);
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
        }
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := address;
           out_msg.Type := CoherenceRequestType:GETS;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
           out_msg.sector_mask := req_mask;
           out_msg.requested_sector_mask := req_mask;
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := false ;
        }
      }
    }
  }

  action(k_dataAndAllTokensFromL2CacheToL1Requestor, "\kk", desc="AMTC strict complete DATA_OWNER response for passive L1") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) {
        req_mask := in_msg.sector_mask;
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }
      req_mask := amtc_sanitizeMask(req_mask);

      int tokens_per_sector := max_tokens() / 2;
      bool valid_complete := amtc_maskContainsAll(cache_entry.ValidSectors, req_mask);

      // If this L2 has all tokens for a requested sector, its DataBlk is the
      // authoritative owner copy even when ValidSectors was narrowed by prior
      // sector metadata.  Do not suppress GETX in that case; otherwise L2 pops
      // the request, changes state to I, and the directory only returns a
      // zero-token ACK_OWNER while L1 waits forever.
      bool owner_data0 := (!amtc_maskHasSector(req_mask, 0)) ||
                          (cache_entry.TokensSec0 == tokens_per_sector);
      bool owner_data1 := (!amtc_maskHasSector(req_mask, 1)) ||
                          (cache_entry.TokensSec1 == tokens_per_sector);
      bool owner_data_complete := owner_data0 && owner_data1;
      bool data_complete := valid_complete || owner_data_complete;

      // For an L1 upgrade from S/O to M, the requester may already hold its
      // shared token for the requested sector.  L2 is the coordinator and must
      // deliver the remaining tokens, not wait forever for a full sector token
      // count inside L2.  This fixes the S_IM case where L2 has 511 tokens and
      // L1 already has 1 token; requiring 512 here suppresses the only useful
      // DATA_OWNER response and leaves L1 waiting on zero-token ACK_OWNERs.
      int upgrade_tokens_needed := tokens_per_sector - 1;
      if (upgrade_tokens_needed < 1) { upgrade_tokens_needed := 1; }

      // Audit14: tolerate a small stale-sharer deficit in L2 O.
      // We have now seen both 510/511 and 509/511 cases at the CPU->GPU
      // handoff.  In both, the directory/sharer lists point at NP/I caches and
      // the requester loops forever on ACK_OWNER(0).  Treat up to a two-token
      // deficit as repairable and send the expected remaining grant; L1 clamps
      // accumulated sector tokens to tokens_per_sector.
      int repair_deficit_limit := 2;
      int near_upgrade_tokens_needed := upgrade_tokens_needed - repair_deficit_limit;
      if (near_upgrade_tokens_needed < 1) { near_upgrade_tokens_needed := 1; }

      bool excl0_ready := (!amtc_maskHasSector(req_mask, 0)) ||
                          (cache_entry.TokensSec0 >= near_upgrade_tokens_needed);
      bool excl1_ready := (!amtc_maskHasSector(req_mask, 1)) ||
                          (cache_entry.TokensSec1 >= near_upgrade_tokens_needed);
      bool exclusive_complete := excl0_ready && excl1_ready;

      // Passive L1 contract for GETX:
      // Never send DATA_OWNER/ACK as a final partial upgrade.  If L2 cannot
      // provide full requested-sector data and all tokens, keep coordination in
      // L2/TCC/Dir by forwarding the request.  L1 only accumulates and waits.
      if (data_complete && exclusive_complete) {
        int send_t0 := 0;
        int send_t1 := 0;
        int send_token_mask := 0;

        // GETX ownership is line-granular in this protocol.  Even when the
        // requester only needs data for one sector, do not strand tokens for
        // an unrequested sector in L2 O with ValidSectors==0.  Donate all
        // tokens that L2 currently holds; data remains sector-scoped via
        // valid_sector_mask/MessageSize below.
        if (cache_entry.TokensSec0 > 0) {
          if (amtc_maskHasSector(req_mask, 0) &&
              cache_entry.TokensSec0 < upgrade_tokens_needed &&
              cache_entry.TokensSec0 >= near_upgrade_tokens_needed) {
            send_t0 := upgrade_tokens_needed;
            DPRINTF(RubySlicc,
                    "AMTC_L2_NEAR_TOKEN_REPAIR_W2 addr=%#x sec=0 have=%d send=%d req=%d\n",
                    address, cache_entry.TokensSec0, send_t0, req_mask);
          } else {
            send_t0 := cache_entry.TokensSec0;
          }
          cache_entry.TokensSec0 := 0;
          send_token_mask := amtc_unionMasks(send_token_mask, 1);
        }
        if (cache_entry.TokensSec1 > 0) {
          if (amtc_maskHasSector(req_mask, 1) &&
              cache_entry.TokensSec1 < upgrade_tokens_needed &&
              cache_entry.TokensSec1 >= near_upgrade_tokens_needed) {
            send_t1 := upgrade_tokens_needed;
            DPRINTF(RubySlicc,
                    "AMTC_L2_NEAR_TOKEN_REPAIR_W2 addr=%#x sec=1 have=%d send=%d req=%d\n",
                    address, cache_entry.TokensSec1, send_t1, req_mask);
          } else {
            send_t1 := cache_entry.TokensSec1;
          }
          cache_entry.TokensSec1 := 0;
          send_token_mask := amtc_unionMasks(send_token_mask, 2);
        }

        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := req_mask;
          out_msg.token_sector_mask := send_token_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.merged_resp := false;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_COMPLETE_GETX_DATA addr=%#x req=%d tokmask=%d valid=%d owner_data=%d need=%d sent_t0=%d sent_t1=%d\n",
                address, req_mask, send_token_mask, cache_entry.ValidSectors,
                owner_data_complete, upgrade_tokens_needed, send_t0, send_t1);
      } else if (exclusive_complete) {
        // Write/RFO may complete with tokens only when L1 already has or will
        // install the data via the CPU store.  Do not suppress and pop the
        // request in this case: give L1 the remaining tokens it asked for.
        // This fixes S + Store_Sector_Miss where ValidSectors is stale/narrow
        // but L2 has the required 511 upgrade tokens.
        int send_t0 := 0;
        int send_t1 := 0;
        int send_token_mask := 0;

        // GETX ownership is line-granular in this protocol.  Even when the
        // requester only needs data for one sector, do not strand tokens for
        // an unrequested sector in L2 O with ValidSectors==0.  Donate all
        // tokens that L2 currently holds; data remains sector-scoped via
        // valid_sector_mask/MessageSize below.
        if (cache_entry.TokensSec0 > 0) {
          if (amtc_maskHasSector(req_mask, 0) &&
              cache_entry.TokensSec0 < upgrade_tokens_needed &&
              cache_entry.TokensSec0 >= near_upgrade_tokens_needed) {
            send_t0 := upgrade_tokens_needed;
            DPRINTF(RubySlicc,
                    "AMTC_L2_NEAR_TOKEN_REPAIR_W2 addr=%#x sec=0 have=%d send=%d req=%d\n",
                    address, cache_entry.TokensSec0, send_t0, req_mask);
          } else {
            send_t0 := cache_entry.TokensSec0;
          }
          cache_entry.TokensSec0 := 0;
          send_token_mask := amtc_unionMasks(send_token_mask, 1);
        }
        if (cache_entry.TokensSec1 > 0) {
          if (amtc_maskHasSector(req_mask, 1) &&
              cache_entry.TokensSec1 < upgrade_tokens_needed &&
              cache_entry.TokensSec1 >= near_upgrade_tokens_needed) {
            send_t1 := upgrade_tokens_needed;
            DPRINTF(RubySlicc,
                    "AMTC_L2_NEAR_TOKEN_REPAIR_W2 addr=%#x sec=1 have=%d send=%d req=%d\n",
                    address, cache_entry.TokensSec1, send_t1, req_mask);
          } else {
            send_t1 := cache_entry.TokensSec1;
          }
          cache_entry.TokensSec1 := 0;
          send_token_mask := amtc_unionMasks(send_token_mask, 2);
        }

        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := send_token_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.merged_resp := false;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_COMPLETE_GETX_TOKENS_ONLY addr=%#x req=%d tokmask=%d valid=%d need=%d sent_t0=%d sent_t1=%d\n",
                address, req_mask, send_token_mask, cache_entry.ValidSectors,
                upgrade_tokens_needed, send_t0, send_t1);
      } else {
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.RetryNum := in_msg.RetryNum;
          out_msg.Destination.broadcast(MachineType:L2Cache);
          out_msg.Destination.remove(machineID);
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.AccessMode := in_msg.AccessMode;
          out_msg.Prefetch := in_msg.Prefetch;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.merged_req := in_msg.merged_req;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_SUPPRESS_PARTIAL_GETX addr=%#x req=%d valid=%d owner_data=%d need=%d t0=%d t1=%d\n",
                address, req_mask, cache_entry.ValidSectors,
                owner_data_complete, upgrade_tokens_needed,
                cache_entry.TokensSec0, cache_entry.TokensSec1);
      }
    }
  }

  action(amtc_l2RecomputeValidFromTokens, "l2rv", desc="Rebuild valid-sector mask from retained tokens after donation") {
    if (is_valid(cache_entry)) {
      /*
       * Max-repair closure rule:
       * A stable L2 state must not keep an orphan token for a sector that is
       * not marked valid.  The IS/IX completion paths can donate the requested
       * sector token to L1 while leaving another sector token in L2.  The old
       * helper only removed valid bits for zero-token sectors; it did not add a
       * valid bit for a retained sector token.  That allowed states such as
       * valid=0, TokensSec0=1, TokensSec1=0 before committing S/NP, tripping
       * the stable-state invariant.
       *
       * In this proof-mode controller, any retained token means L2 has a usable
       * copy for that sector because the completion path just wrote DataBlk.
       * Therefore recompute ValidSectors from tokens in both directions:
       *   token == 0  -> clear valid bit
       *   token >  0  -> set valid bit
       */
      if (cache_entry.TokensSec0 == 0) {
        cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 1);
      } else {
        cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, 1);
      }

      if (cache_entry.TokensSec1 == 0) {
        cache_entry.ValidSectors := amtc_subtractMask(cache_entry.ValidSectors, 2);
      } else {
        cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, 2);
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_RECOMPUTE_VALID_FROM_TOKENS_V4 addr=%#x valid=%d t0=%d t1=%d\n",
              address, cache_entry.ValidSectors,
              cache_entry.TokensSec0, cache_entry.TokensSec1);
    }
  }

  action(r_markNewSharer, "r", desc="Mark the new local sharer from local request message") {
    peek(L1requestNetwork_in, RequestMsg) {
      if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
        if (in_msg.Type == CoherenceRequestType:GETX) {
          setNewWriter(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          addNewSharer(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        }
      }
    }
  }

  action(r_clearExclusive, "\rrr", desc="clear exclusive bit") {
    clearExclusiveBitIfExists(address);
  }

  action(r_setMRU, "\rr", desc="manually set the MRU bit for cache line" ) {
    peek(L1requestNetwork_in, RequestMsg) {
      if ((machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) &&
          (is_valid(cache_entry))) {
        L2cache.setMRU(address);
      }
    }
  }

  action(rm_updateRequestedMask, "rm", desc="Update requested sector mask from L1 request") {
    peek(L1requestNetwork_in, RequestMsg) {
      if (is_valid(cache_entry)) {
        int req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                           in_msg.sector_id);
        if (req_mask == 0) {
          req_mask := amtc_normalizeMask(in_msg.sector_mask,
                                         in_msg.sector_id);
        }
        if (req_mask == 0) {
          req_mask := amtc_fullMask();
        }
        if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
          req_mask := amtc_fullMask();
        }
        cache_entry.RequestedSectorMask :=
            amtc_unionMasks(cache_entry.RequestedSectorMask, req_mask);
      }
    }
  }

  action(rc_clearRequestedMask, "rc", desc="Clear requested sector mask upon M promotion") {
    if (is_valid(cache_entry)) {
      cache_entry.RequestedSectorMask := 0;
    }
  }

action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // AMTC Metadata: Dynamically flag which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry data
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(tt_sendLocalAckWithCollectedTokens, "tt", desc="Send requested collected tokens to local L1 without pretending data is complete") {
    assert(is_valid(cache_entry));

    peek(L1requestNetwork_in, RequestMsg) {
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) {
        req_mask := in_msg.sector_mask;
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }
      req_mask := amtc_sanitizeMask(req_mask);

      int send_t0 := 0;
      int send_t1 := 0;
      int t_mask := 0;

      if (amtc_maskHasSector(req_mask, 0) && cache_entry.TokensSec0 > 0) {
        send_t0 := cache_entry.TokensSec0;
        t_mask := amtc_unionMasks(t_mask, 1);
      }
      if (amtc_maskHasSector(req_mask, 1) && cache_entry.TokensSec1 > 0) {
        send_t1 := cache_entry.TokensSec1;
        t_mask := amtc_unionMasks(t_mask, 2);
      }

      if (t_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(t_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := t_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }

      if (send_t0 > 0) {
        cache_entry.TokensSec0 := 0;
      }
      if (send_t1 > 0) {
        cache_entry.TokensSec1 := 0;
      }
    }
  }

  action(t_popTriggerQueue, "tq", desc="Pop trigger queue") {
    triggerQueue_in.dequeue(clockEdge());
  }

  action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := in_msg.valid_sector_mask;

      // ===================================================================
      // L2 Refined Late Data Shield
      // ===================================================================
      int tokens_per_sector := max_tokens() / 2;

      if (amtc_maskHasSector(copy_mask, 0) &&
          cache_entry.TokensSec0 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          copy_mask := amtc_clearSector(copy_mask, 0);
      }

      if (amtc_maskHasSector(copy_mask, 1) &&
          cache_entry.TokensSec1 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          copy_mask := amtc_clearSector(copy_mask, 1);
      }

      if (copy_mask != 0) {
          if (amtc_maskHasSector(copy_mask, 0)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(copy_mask, 1)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, copy_mask);
          }
      }
    }
  }

  action(dbgReplacementTransientBusy, "drtb",
         desc="Replacement victim is transient; keep incoming request queued") {
    DPRINTF(RubySlicc,
            "AMTC_L2_REPL_TRANSIENT_BUSY victim=%#x  -- cannot replace now\n",
            address);
  }

  action(vv_allocateL2CacheBlock, "\v", desc="Set L2 cache tag equal to tag of block B.") {
    set_cache_entry(L2cache.allocate(address, new Entry));
  }

  // AMTC audit10: NP is a logical invalid state, but the tag may still be
  // present when setState() forced an entry to State:NP after token cleanup.
  // Writebacks can then arrive for the same line.  In that case, re-use the
  // existing tag instead of calling L2cache.allocate() and tripping
  // CacheMemory::allocate(!isTagPresent).
  action(vv_allocateL2CacheBlockIfNeeded, "va",
       desc="Allocate L2 block only when tag is absent and cache way is available") {
  if (is_valid(cache_entry) == false) {
    if (L2cache.cacheAvail(address)) {
      set_cache_entry(L2cache.allocate(address, new Entry));

      cache_entry.CacheState := State:NP;
      cache_entry.Dirty := false;
      cache_entry.ValidSectors := 0;
      cache_entry.DirtySectors := 0;
      cache_entry.TokenSectorMask := 0;
      cache_entry.RequestedSectorMask := 0;
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
      cache_entry.AccumulationPending := false;

      cache_entry.PendingL1Valid := false;
      cache_entry.PendingReqMask := 0;
      cache_entry.PendingSectorId := 0;
      cache_entry.PendingIsGetX := false;
      cache_entry.PendingRequesterHeldTokensSec0 := 0;
      cache_entry.PendingRequesterHeldTokensSec1 := 0;
      cache_entry.PendingRetrySent := false;
      cache_entry.PendingRetryNumSent := 0;

      DPRINTF(RubySlicc,
              "AMTC_L2_ALLOC_OK addr=%#x ",
              address);
    } else {
      DPRINTF(RubySlicc,
              "AMTC_L2_ALLOC_BLOCKED_NO_WAY addr=%#x  ",
              address);
      assert(L2cache.cacheAvail(address));
    }
  }
}

  action(rnp_deallocateNPVictimIfPresent, "rnp", desc="AMTC: safely clear an NP victim selected by cacheProbe during writeback allocation pressure.") {
    if (L2cache.isTagPresent(address)) {
      L2cache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(dbg_l2ForceRestartEmptyISGets, "frdbg", desc="Debug L2 IS GETS forced restart") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IS_GETS_FORCE_RESTART_V20 addr=%#x valid=%d T0=%d T1=%d pending=%d req=%s reqmask=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }


  action(dbg_l2ForceLocalGetsFill, "flgdbg", desc="Debug L2 IS GETS forced local fill") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IS_GETS_FORCE_LOCAL_FILL_V20 addr=%#x valid=%d T0=%d T1=%d pending=%d req=%s reqmask=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }

  action(dbg_l2ClearStaleDirPendingIX, "csdpx",
         desc="Debug clear empty/stale IX entry left by Directory/DMA invalidation") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IX_EMPTY_STALE_PENDING_CLEAR_V40 addr=%#x valid=%d T0=%d T1=%d pending=%d req=%s reqmask=%d is_getx=%d acc=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
            cache_entry.PendingIsGetX, cache_entry.AccumulationPending);
  }

  action(sendPendingGetxDirBroadcastRetryV49, "pgxb49",
         desc="Broadcast owner-pull GETX repair for empty pending IX GETX") {
    peek(L1requestNetwork_in, RequestMsg) {
      int req_mask := cache_entry.PendingReqMask;
      if (req_mask == 0) {
        req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                       in_msg.sector_id);
      }
      if (req_mask == 0) {
        req_mask := amtc_normalizeMask(in_msg.sector_mask,
                                       in_msg.sector_id);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      int req_sid := cache_entry.PendingSectorId;
      if (req_mask == amtc_fullMask()) {
        req_sid := 0;
      }

      cache_entry.PendingRetrySent := true;
      cache_entry.PendingRetryNumSent := in_msg.RetryNum;

      DPRINTF(RubySlicc,
              "AMTC_L2_EMPTY_GETX_DIR_BCAST_SEND_V49 addr=%#x retry=%d req=%s reqmask=%d inmask=%d valid=%d T0=%d T1=%d held0=%d held1=%d\n",
              address, in_msg.RetryNum, cache_entry.PendingL1Requestor,
              cache_entry.PendingReqMask, req_mask, cache_entry.ValidSectors,
              cache_entry.TokensSec0, cache_entry.TokensSec1,
              cache_entry.PendingRequesterHeldTokensSec0,
              cache_entry.PendingRequesterHeldTokensSec1);

      enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;
        out_msg.Destination.broadcast(MachineType:Directory);
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;
        out_msg.RetryNum := in_msg.RetryNum;
        out_msg.is_owner_pull := true;
        out_msg.sector_id := req_sid;
        out_msg.sector_mask := req_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.is_gpu := false;
        out_msg.is_sync := false;
        out_msg.is_bypass := false;
        out_msg.is_atomic := false;
        out_msg.is_signal := false;
        out_msg.merged_req := false;
        out_msg.isGLCSet := in_msg.isGLCSet;
        out_msg.isSLCSet := in_msg.isSLCSet;
      }
    }
  }

  action(dbg_l2EmptyGetxDirRestartV48, "egdr48",
         desc="Debug empty IX GETX restart through Directory path") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IX_EMPTY_GETX_DIR_RESTART_DONE_V48 addr=%#x valid=%d T0=%d T1=%d pending=%d req=%s reqmask=%d held0=%d held1=%d acc=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
            cache_entry.PendingRequesterHeldTokensSec0,
            cache_entry.PendingRequesterHeldTokensSec1,
            cache_entry.AccumulationPending);
  }

  action(dbg_l2DropPoisonLocalGetsV45, "dpg45",
         desc="Debug drop poisoned IX entry after local GETS escape") {
    DPRINTF(RubySlicc,
            "AMTC_L2_IX_EMPTY_GETS_DROP_POISON_DONE_V45 addr=%#x valid=%d T0=%d T1=%d pending=%d reqmask=%d\n",
            address, cache_entry.ValidSectors, cache_entry.TokensSec0,
            cache_entry.TokensSec1, cache_entry.PendingL1Valid,
            cache_entry.PendingReqMask);
  }

  action(rr_deallocateL2CacheBlock, "\r",
        desc="Safely deallocate L2 cache block") {
    if (L2cache.isTagPresent(address)) {
      L2cache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    L2cache.profileDemandMiss();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    L2cache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      if (in_msg.Type != CoherenceResponseType:ACK &&
          in_msg.Type != CoherenceResponseType:WB_TOKENS) {
        assert(is_valid(cache_entry));
        //assert(cache_entry.DataBlk == in_msg.DataBlk);
      }
    }
  }

  action(z_resetAccumulationFlag, "z", desc="Reset the accumulation trigger flag") {
    if (is_valid(cache_entry)) {
      cache_entry.AccumulationPending := false;
    }
  }



  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(n_popResponseQueue, "n", desc="Pop response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(o_popL1RequestQueue, "o", desc="Pop L1 request queue.") {
    L1requestNetwork_in.dequeue(clockEdge());
  }

  action(q_updateTokensFromResponse, "q", desc="Saturating update token count based on incoming response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      /*
       * Max-repair v6:
       * Directory repair DATA_SHARED may return a small shared token for a
       * sector where L2 already retained the maximum legal token count.  The
       * old additive update asserted immediately at amtc_assertTokenBounds()
       * when old+incoming exceeded max_tokens()/2.  For proof-mode repair,
       * treat these as duplicate/late repair tokens and saturate instead of
       * killing the run.
       */
      int tokens_per_sector := max_tokens() / 2;
      int new_t0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      int new_t1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      if (new_t0 > tokens_per_sector) {
        DPRINTF(RubySlicc,
                "AMTC_L2_RESP_TOKEN_SAT_V6 addr=%#x sec=0 old=%d in=%d max=%d type=%s\n",
                address, cache_entry.TokensSec0, in_msg.TokensSec0,
                tokens_per_sector, in_msg.Type);
        new_t0 := tokens_per_sector;
      }

      if (new_t1 > tokens_per_sector) {
        DPRINTF(RubySlicc,
                "AMTC_L2_RESP_TOKEN_SAT_V6 addr=%#x sec=1 old=%d in=%d max=%d type=%s\n",
                address, cache_entry.TokensSec1, in_msg.TokensSec1,
                tokens_per_sector, in_msg.Type);
        new_t1 := tokens_per_sector;
      }

      if (new_t0 < 0) {
        new_t0 := 0;
      }
      if (new_t1 < 0) {
        new_t1 := 0;
      }

      cache_entry.TokensSec0 := new_t0;
      cache_entry.TokensSec1 := new_t1;
      amtc_assertTokenBounds(cache_entry.TokensSec0);
      amtc_assertTokenBounds(cache_entry.TokensSec1);

      cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, in_msg.valid_sector_mask);

      if ((in_msg.Type == CoherenceResponseType:DATA_OWNER ||
           in_msg.Type == CoherenceResponseType:WB_OWNED) && in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_RESP_TOKEN_UPDATE_V6 addr=%#x type=%s valid=%d tokmask=%d t0=%d t1=%d\n",
              address, in_msg.Type, cache_entry.ValidSectors,
              in_msg.token_sector_mask, cache_entry.TokensSec0,
              cache_entry.TokensSec1);
    }
  }

  action(q_replaceTokensFromOwnerResponse, "qrtor",
        desc="Replace token count from authoritative DATA_OWNER response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int resp_mask := amtc_normalizeMask(in_msg.token_sector_mask,
                                          in_msg.sector_id);

      if (resp_mask == 0) {
        resp_mask := amtc_normalizeMask(in_msg.sector_mask,
                                        in_msg.sector_id);
      }

      if (resp_mask == 1) {
        cache_entry.TokensSec0 := in_msg.TokensSec0;
      } else if (resp_mask == 2) {
        cache_entry.TokensSec1 := in_msg.TokensSec1;
      } else if (resp_mask == 3) {
        cache_entry.TokensSec0 := in_msg.TokensSec0;
        cache_entry.TokensSec1 := in_msg.TokensSec1;
      }

      amtc_assertTokenBounds(cache_entry.TokensSec0);
      amtc_assertTokenBounds(cache_entry.TokensSec1);

      cache_entry.ValidSectors :=
        amtc_unionMasks(cache_entry.ValidSectors,
                        in_msg.valid_sector_mask);

      cache_entry.TokenSectorMask :=
        amtc_unionMasks(cache_entry.TokenSectorMask,
                        resp_mask);

      if ((in_msg.Type == CoherenceResponseType:DATA_OWNER ||
          in_msg.Type == CoherenceResponseType:WB_OWNED) &&
          in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors :=
          amtc_unionMasks(cache_entry.DirtySectors,
                          in_msg.valid_sector_mask);
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_OWNER_TOKEN_REPLACE addr=%#x resp_mask=%d t0=%d t1=%d valid=%d tokmask=%d\n",
              address,
              resp_mask,
              cache_entry.TokensSec0,
              cache_entry.TokensSec1,
              cache_entry.ValidSectors,
              cache_entry.TokenSectorMask);
    }
  }


  // Audit49: L1 writebacks can race with already-collected partial tokens in L2.
  // The writeback token fields represent the donor's returned ownership for the
  // sector, so do not let a late/overlapping writeback push a sector above the
  // architectural per-sector token count.  Saturate writeback absorption while
  // keeping normal data-response token updates strict.
  action(qwb_updateTokensFromWritebackResponse, "qwb", desc="Saturating update for L1 writeback token/data response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int tokens_per_sector := max_tokens() / 2;

      int new_t0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      int new_t1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      if (new_t0 > tokens_per_sector) {
        DPRINTF(RubySlicc,
                "AMTC_L2_WB_TOKEN_SAT addr=%#x sec=0 old=%d in=%d max=%d\n",
                address, cache_entry.TokensSec0, in_msg.TokensSec0, tokens_per_sector);
        new_t0 := tokens_per_sector;
      }

      if (new_t1 > tokens_per_sector) {
        DPRINTF(RubySlicc,
                "AMTC_L2_WB_TOKEN_SAT addr=%#x sec=1 old=%d in=%d max=%d\n",
                address, cache_entry.TokensSec1, in_msg.TokensSec1, tokens_per_sector);
        new_t1 := tokens_per_sector;
      }

      cache_entry.TokensSec0 := new_t0;
      cache_entry.TokensSec1 := new_t1;

      amtc_assertTokenBounds(cache_entry.TokensSec0);
      amtc_assertTokenBounds(cache_entry.TokensSec1);

      cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, in_msg.valid_sector_mask);

      if ((in_msg.Type == CoherenceResponseType:WB_OWNED ||
           in_msg.Type == CoherenceResponseType:DATA_OWNER) && in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_WB_TOKEN_UPDATE addr=%#x type=%s valid=%d tokmask=%d t0=%d t1=%d\n",
              address, in_msg.Type, cache_entry.ValidSectors,
              in_msg.token_sector_mask, cache_entry.TokensSec0, cache_entry.TokensSec1);
    }
  }

  action(dbg_accDoneState, "dads",
        desc="Debug L2 accumulation completion state/token summary") {
    DPRINTF(RubySlicc,
            "AMTC_L2_ACC_DONE addr=%#x valid=%d t0=%d t1=%d\n",
            address,
            cache_entry.ValidSectors,
            cache_entry.TokensSec0,
            cache_entry.TokensSec1);
  }

  action(forceDropTransientVictim, "fdtv",
        desc="Emergency drop of long-stuck transient L2 victim") {
    DPRINTF(RubySlicc,
            "AMTC_L2_FORCE_DROP_TRANSIENT_VICTIM victim=%#x \n",
            address);

    if (L2cache.isTagPresent(address)) {
      L2cache.deallocate(address);
    }

    unset_cache_entry();
  }

  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  transition({NP, I, S, O, M, IS, IX}, L1_INV) {

    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  // Directory/DMA owner-pull probes must never be treated as new local
  // L1 misses.  If L2 is NP/I/transient, it cannot donate data; return
  // ACK_OWNER(0) so the Directory CE_W_DMA_READ path can fall back to memory
  // instead of forming Directory->L2->Directory self-cycle.
  transition({NP, I, IS, IX}, Dir_Owner_GETS) {
    sendStaleOwnerAckToDirectoryFromL1Req;
    o_popL1RequestQueue;
  }

  // Stable owner-pull probes donate data directly to Directory/DMA.
  // Do not use j_forwardTransientRequestToLocalSharers here because this
  // event is sourced from L1requestNetwork_in, not requestNetwork_in.
  transition({S, O, M}, Dir_Owner_GETS) {
    sendDataToDirectoryOwnerPullFromL1Req;
    o_popL1RequestQueue;
  }

  // Transitions from NP

  transition(NP, {Transient_GETX, Transient_GETS}) {
    // forward message to local sharers
    r_clearExclusive;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }


  // Audit91: cold L1 misses must be remembered by L2.  Do not pop the
  // L1 request until DATA_* returns from Directory and is forwarded to L1.
  transition(NP, L1_GETS, IS) {
    vv_allocateL2CacheBlockIfNeeded;
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(NP, L1_GETX, IX) {
    vv_allocateL2CacheBlockIfNeeded;
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(NP, Writeback_Shared_Data, S) {
    vv_allocateL2CacheBlockIfNeeded;
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Tokens, I) {
    vv_allocateL2CacheBlockIfNeeded;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  // Transitions from Idle

  transition(I, L1_GETS, IS) {
    vv_allocateL2CacheBlockIfNeeded;
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    // AMTC FIX: GETS is a read path; token-only ACK is not a valid terminal
    // response because the requester still needs bytes.  Directory / data
    // owner must provide DATA_SHARED/DATA_OWNER, then L2 forwards DATA_SHARED
    // to the saved L1 requester.
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(I, L1_GETX, IX) {
    vv_allocateL2CacheBlockIfNeeded;
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    // Cold GETX cannot complete with token-only ACK from I.  Save requester
    // metadata and wait for Directory ownership data.
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  // AMTC audit16: response-side writeback allocation may pick an NP victim.
  // This is not a protocol error; it means the physical L2 tag slot is stale
  // or already logically invalid.  Free it and retry the blocked response.
  transition(NP, L2_Replacement, I) {
    rnp_deallocateNPVictimIfPresent;
  }

  transition(I, L2_Replacement) {
    c_cleanReplacement; // Only needed in some cases
    rr_deallocateL2CacheBlock;
  }

  transition(I, {Transient_GETX, Transient_GETS}) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(I, Writeback_Shared_Data, S) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(I, Writeback_Tokens) {
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }



  // Transitions from Directory-pending cold L1 misses


  action(dbgDropDupGetsPending, "ddgp",
         desc="Debug duplicate GETS while L2 GETS pending") {
    DPRINTF(RubySlicc,
            "AMTC_L2_DROP_DUP_GETS_PENDING addr=%#x  valid=%d req=%s reqmask=%d ",
            address, cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }

  action(dbgUpgradePendingGetsToGetx, "dupg",
         desc="Debug upgrade of pending L2 GETS to GETX") {
    DPRINTF(RubySlicc,
            "AMTC_L2_UPGRADE_PENDING_GETS_TO_GETX addr=%#x oldreq=%s oldmask=%d ",
            address, cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }

  action(dbgDropDupGetxPending, "ddxp",
         desc="Debug duplicate local request while L2 GETX pending") {
    DPRINTF(RubySlicc,
            "AMTC_L2_DROP_DUP_GETX_PENDING addr=%#x  valid=%d req=%s reqmask=%d ",
            address,  cache_entry.PendingL1Valid,
            cache_entry.PendingL1Requestor, cache_entry.PendingReqMask);
  }

    action(mergePendingMaskFromIncomingL1, "mpmi",
        desc="Merge incoming L1 request mask into pending L2 request") {
    peek(L1requestNetwork_in, RequestMsg) {
      int in_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                        in_msg.sector_id);

      if (in_mask == 0) {
        in_mask := amtc_normalizeMask(in_msg.sector_mask,
                                      in_msg.sector_id);
      }
      if (in_mask == 0) {
        in_mask := amtc_fullMask();
      }

      /*
       * V32: if an old transient window has a non-L1 pending requester
       * (observed as Directory-0 after repeated copy-mode execution), do not
       * merge the new L1 GETS/GETX into that stale owner-pull context.  Clear
       * the poisoned primary waiter and restart the primary pending metadata
       * from the current L1 request.
       */
      if (cache_entry.PendingL1Valid &&
          machineIDToMachineType(cache_entry.PendingL1Requestor) != MachineType:L1Cache) {
        DPRINTF(RubySlicc,
                "AMTC_L2_CLEAR_BAD_PENDING_NON_L1_V32 addr=%#x badreq=%s badmask=%d badgetx=%d incoming=%s type=%s inmask=%d retry=%d valid=%d T0=%d T1=%d\n",
                address, cache_entry.PendingL1Requestor,
                cache_entry.PendingReqMask, cache_entry.PendingIsGetX,
                in_msg.Requestor, in_msg.Type, in_mask, in_msg.RetryNum,
                cache_entry.ValidSectors, cache_entry.TokensSec0,
                cache_entry.TokensSec1);

        cache_entry.PendingL1Valid := false;
        cache_entry.PendingReqMask := 0;
        cache_entry.PendingSectorId := 0;
        cache_entry.PendingIsGetX := false;
        cache_entry.PendingRequesterHeldTokensSec0 := 0;
        cache_entry.PendingRequesterHeldTokensSec1 := 0;
        cache_entry.PendingRetrySent := false;
        cache_entry.PendingRetryNumSent := 0;
        cache_entry.AccumulationPending := false;
        cache_entry.PendingL1SecondValid := false;
        cache_entry.PendingL1SecondReqMask := 0;
        cache_entry.PendingL1SecondSectorId := 0;
        cache_entry.PendingL1SecondRetrySent := false;
        cache_entry.PendingL1SecondRetryNumSent := 0;
        cache_entry.PendingL1ThirdValid := false;
        cache_entry.PendingL1ThirdReqMask := 0;
        cache_entry.PendingL1ThirdSectorId := 0;
        cache_entry.PendingL1ThirdRetrySent := false;
        cache_entry.PendingL1ThirdRetryNumSent := 0;
        cache_entry.PendingL1FourthValid := false;
        cache_entry.PendingL1FourthReqMask := 0;
        cache_entry.PendingL1FourthSectorId := 0;
        cache_entry.PendingL1FourthRetrySent := false;
        cache_entry.PendingL1FourthRetryNumSent := 0;
      }

      if (!cache_entry.PendingL1Valid &&
          machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
        cache_entry.PendingL1Valid := true;
        cache_entry.PendingL1Requestor := in_msg.Requestor;
        cache_entry.PendingReqMask := 0;
        cache_entry.PendingSectorId := in_msg.sector_id;
        cache_entry.PendingIsGetX := false;
        cache_entry.PendingRequesterHeldTokensSec0 := 0;
        cache_entry.PendingRequesterHeldTokensSec1 := 0;
        cache_entry.PendingRetrySent := false;
        cache_entry.PendingRetryNumSent := 0;
        DPRINTF(RubySlicc,
                "AMTC_L2_REBIND_PENDING_TO_INCOMING_L1_V32 addr=%#x req=%s type=%s inmask=%d retry=%d\n",
                address, in_msg.Requestor, in_msg.Type, in_mask,
                in_msg.RetryNum);
      }

      int old_mask := cache_entry.PendingReqMask;
      int new_mask := old_mask;

      if (old_mask == 0) {
        new_mask := in_mask;
      } else if (old_mask == 1) {
        if (in_mask == 2) {
          new_mask := 3;
        } else if (in_mask == 3) {
          new_mask := 3;
        }
      } else if (old_mask == 2) {
        if (in_mask == 1) {
          new_mask := 3;
        } else if (in_mask == 3) {
          new_mask := 3;
        }
      } else if (old_mask == 3) {
        new_mask := 3;
      }

      cache_entry.PendingReqMask := new_mask;

      if (new_mask == 3) {
        cache_entry.PendingSectorId := 0;
      } else {
        cache_entry.PendingSectorId := in_msg.sector_id;
      }

      if (new_mask != old_mask) {
        cache_entry.PendingRetrySent := false;
        cache_entry.PendingRetryNumSent := 0;
      }

      if (in_msg.Type == CoherenceRequestType:GETX) {
        cache_entry.PendingIsGetX := true;
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_MERGE_PENDING_L1_MASK_V32 addr=%#x type=%s oldmask=%d inmask=%d newmask=%d req=%s is_getx=%d retry=%d\n",
              address,
              in_msg.Type,
              old_mask,
              in_mask,
              cache_entry.PendingReqMask,
              cache_entry.PendingL1Requestor,
              cache_entry.PendingIsGetX,
              in_msg.RetryNum);
    }
  }

  action(maybeForwardPendingGetsRetry, "mfgr",
        desc="Forward retryable pending GETS repair to Directory if original response is missing") {
    peek(L1requestNetwork_in, RequestMsg) {
      int in_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                        in_msg.sector_id);
      if (in_mask == 0) {
        in_mask := amtc_normalizeMask(in_msg.sector_mask,
                                      in_msg.sector_id);
      }
      if (in_mask == 0) {
        in_mask := amtc_fullMask();
      }

      cache_entry.PendingReqMask :=
          amtc_unionMasks(cache_entry.PendingReqMask, in_mask);
      if (cache_entry.PendingReqMask == 3) {
        cache_entry.PendingSectorId := 0;
      }

      bool send_repair := false;
      bool reset_epoch := false;

      if (in_msg.RetryNum == 0) {
        /*
         * Retry epoch restart only.  Do not send an owner-pull GETX repair at
         * retry 0: Directory may immediately forward that GETX back to the
         * same L1 that is still in IS_WAIT_ALL/S_IS, causing
         * Transient_GETX-in-wait-state aborts.  Wait for the L1 timeout path
         * to prove the original IX transaction is really stuck.
         */
        reset_epoch := true;
        send_repair := false;
        cache_entry.PendingRetryNumSent := 0;
      } else {
        if (in_msg.RetryNum < cache_entry.PendingRetryNumSent) {
          reset_epoch := true;
          cache_entry.PendingRetryNumSent := 0;
        }

        if (in_msg.RetryNum >= 1) {
          int next_retry := cache_entry.PendingRetryNumSent + 1;
          if (in_msg.RetryNum >= next_retry) {
            send_repair := true;
            cache_entry.PendingRetryNumSent := in_msg.RetryNum;
          }
        }
      }

      if (send_repair) {
        cache_entry.PendingRetrySent := true;

        DPRINTF(RubySlicc,
                "AMTC_L2_PENDING_GETS_REFWD_MAX_REPAIR addr=%#x retry=%d last=%d reset=%d req=%s reqmask=%d inmask=%d ownerpull=1\n",
                address,
                in_msg.RetryNum,
                cache_entry.PendingRetryNumSent,
                reset_epoch,
                cache_entry.PendingL1Requestor,
                cache_entry.PendingReqMask,
                in_mask);

        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETS;
          out_msg.Requestor := machineID;
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));

          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.AccessMode := in_msg.AccessMode;
          out_msg.Prefetch := in_msg.Prefetch;

          out_msg.RetryNum := in_msg.RetryNum;
          out_msg.is_owner_pull := true;

          out_msg.sector_id := cache_entry.PendingSectorId;
          out_msg.sector_mask := cache_entry.PendingReqMask;
          out_msg.requested_sector_mask := cache_entry.PendingReqMask;

          out_msg.is_gpu := false;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := false;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
        }
      } else {
        DPRINTF(RubySlicc,
                "AMTC_L2_DROP_DUP_GETS_PENDING_WINDOW addr=%#x retry=%d last=%d valid=%d req=%s reqmask=%d inmask=%d\n",
                address,
                in_msg.RetryNum,
                cache_entry.PendingRetryNumSent,
                cache_entry.PendingL1Valid,
                cache_entry.PendingL1Requestor,
                cache_entry.PendingReqMask,
                in_mask);
      }
    }
  }

  action(markPendingGetsRetrySent, "mprs",
        desc="Mark pending GETS recovery retry as sent") {
    cache_entry.PendingRetrySent := true;
    DPRINTF(RubySlicc,
            "AMTC_L2_PENDING_GETS_REFWD addr=%#x req=%s reqmask=%d\n",
            address,
            cache_entry.PendingL1Requestor,
            cache_entry.PendingReqMask);
  }


  action(dbgIXPendingNoComplete, "dixp",
        desc="Log IX response that did not yet complete pending GETX") {
    if (is_valid(cache_entry)) {
      DPRINTF(RubySlicc,
              "AMTC_L2_IX_PENDING_WAIT addr=%#x pending=%d req=%s reqmask=%d is_getx=%d valid=%d T0=%d T1=%d retry_sent=%d retry_num=%d\n",
              address,
              cache_entry.PendingL1Valid,
              cache_entry.PendingL1Requestor,
              cache_entry.PendingReqMask,
              cache_entry.PendingIsGetX,
              cache_entry.ValidSectors,
              cache_entry.TokensSec0,
              cache_entry.TokensSec1,
              cache_entry.PendingRetrySent,
              cache_entry.PendingRetryNumSent);
    }
  }

  action(maybeForwardPendingGetxRetry, "mfxr",
        desc="Forward pending GETX retry to Directory if IX response is missing") {
    peek(L1requestNetwork_in, RequestMsg) {
      int in_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                        in_msg.sector_id);
      if (in_mask == 0) {
        in_mask := amtc_normalizeMask(in_msg.sector_mask,
                                      in_msg.sector_id);
      }
      if (in_mask == 0) {
        in_mask := amtc_fullMask();
      }

      bool pending_ok := true;
      if (!cache_entry.PendingL1Valid) {
        pending_ok := false;
      } else {
        if (machineIDToMachineType(cache_entry.PendingL1Requestor) != MachineType:L1Cache) {
          pending_ok := false;
        }
      }

      /*
       * V32: never launch owner-pull GETX repair using a bad/non-L1 pending
       * requester.  This was the failure signature for 0x11b3080:
       * PendingL1Requestor=Directory-0, valid=0, tiny tokens, retry increasing
       * forever.  Clear the poisoned window and let the next L1 retry be
       * reclassified or restarted by the IX stale-pending guard.
       */
      if (!pending_ok) {
        DPRINTF(RubySlicc,
                "AMTC_L2_ABORT_GETX_REPAIR_BAD_PENDING_V32 addr=%#x pending=%d req=%s reqmask=%d is_getx=%d incoming=%s type=%s inmask=%d retry=%d valid=%d T0=%d T1=%d\n",
                address, cache_entry.PendingL1Valid,
                cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
                cache_entry.PendingIsGetX, in_msg.Requestor, in_msg.Type,
                in_mask, in_msg.RetryNum, cache_entry.ValidSectors,
                cache_entry.TokensSec0, cache_entry.TokensSec1);

        cache_entry.PendingL1Valid := false;
        cache_entry.PendingReqMask := 0;
        cache_entry.PendingSectorId := 0;
        cache_entry.PendingIsGetX := false;
        cache_entry.PendingRequesterHeldTokensSec0 := 0;
        cache_entry.PendingRequesterHeldTokensSec1 := 0;
        cache_entry.PendingRetrySent := false;
        cache_entry.PendingRetryNumSent := 0;
        cache_entry.AccumulationPending := false;
      } else {
        if (in_msg.Type != CoherenceRequestType:GETX && !cache_entry.PendingIsGetX) {
          /*
           * V34: this is a pending GETS/read retry, not a GETX ownership
           * retry.  V32/V33 only skipped GETX repair here, leaving a valid
           * L1 read waiter stuck forever when L2 had no data/tokens
           * (valid=0,T0=0,T1=0).  Reissue a directory GETS to make progress,
           * keeping the saved L1 requester so the eventual Data_Shared can be
           * returned to that CPU Sequencer.
           */
          cache_entry.PendingReqMask :=
              amtc_unionMasks(cache_entry.PendingReqMask, in_mask);
          if (cache_entry.PendingReqMask == 3) {
            cache_entry.PendingSectorId := 0;
          } else {
            cache_entry.PendingSectorId := amtc_primarySectorFromMask(cache_entry.PendingReqMask);
          }

          /* V43: last-resort local completion for an empty IX pending GETS.
           * V42 proved this escape can unblock the CPU read at 0x11b3080,
           * but it left the L2 line in IX with no pending waiter.  That stale
           * transient can later interfere with the HSA/AQL DMA path.  Fire
           * earlier, then enqueue the existing GETS-complete trigger so the
           * line leaves IX and becomes a normal shared line after the saved L1
           * request is satisfied.  This remains a bring-up escape, not the
           * final coherence rule.
           */
          if (in_msg.RetryNum >= 128 &&
              cache_entry.ValidSectors == 0 &&
              cache_entry.TokensSec0 <= 1 &&
              cache_entry.TokensSec1 <= 1) {
            int force_mask := amtc_sanitizeMask(cache_entry.PendingReqMask);
            if (force_mask == 0) {
              force_mask := in_mask;
            }
            if (force_mask == 0) {
              force_mask := amtc_fullMask();
            }

            int force_t0 := 0;
            int force_t1 := 0;
            int force_tokmask := 0;
            if (amtc_maskHasSector(force_mask, 0)) {
              force_t0 := 1;
              force_tokmask := amtc_unionMasks(force_tokmask, 1);
            }
            if (amtc_maskHasSector(force_mask, 1)) {
              force_t1 := 1;
              force_tokmask := amtc_unionMasks(force_tokmask, 2);
            }

            DPRINTF(RubySlicc,
                    "AMTC_L2_IX_EMPTY_GETS_FORCE_LOCAL_DATA_V43 addr=%#x retry=%d req=%s pending=%s reqmask=%d inmask=%d valid=%d T0=%d T1=%d send0=%d send1=%d\n",
                    address, in_msg.RetryNum, in_msg.Requestor,
                    cache_entry.PendingL1Requestor, force_mask, in_mask,
                    cache_entry.ValidSectors, cache_entry.TokensSec0,
                    cache_entry.TokensSec1, force_t0, force_t1);

            enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceResponseType:DATA_SHARED;
              out_msg.Sender := machineID;
              out_msg.Destination.add(cache_entry.PendingL1Requestor);
              out_msg.DataBlk := cache_entry.DataBlk;
              out_msg.Dirty := false;
              out_msg.TokensSec0 := force_t0;
              out_msg.TokensSec1 := force_t1;
              out_msg.sector_id := amtc_primarySectorFromMask(force_mask);
              out_msg.sector_mask := force_mask;
              out_msg.valid_sector_mask := force_mask;
              out_msg.token_sector_mask := force_tokmask;
              out_msg.requested_sector_mask := force_mask;
              out_msg.MessageSize := amtc_getSizeFromDirtyMask(force_mask);
            }

            cache_entry.PendingL1Valid := false;
            cache_entry.PendingReqMask := 0;
            cache_entry.PendingSectorId := 0;
            cache_entry.PendingIsGetX := false;
            cache_entry.PendingRequesterHeldTokensSec0 := 0;
            cache_entry.PendingRequesterHeldTokensSec1 := 0;
            cache_entry.PendingRetrySent := false;
            cache_entry.PendingRetryNumSent := 0;

            /* V45: do not keep a fake shared L2 copy after the emergency
             * local DATA_SHARED.  v44 completed the L1 read, but then
             * recomputed ValidSectors=3 from two residual one-token sectors and
             * left the line as S.  Later CPU invalidation / HSA AQL DMA traffic
             * re-entered the same line and the run degraded into host polling.
             * Drop the poisoned IX entry after the L1 response; the next real
             * requester must refetch through the normal Directory/memory path.
             */
            cache_entry.AccumulationPending := true;
            DPRINTF(RubySlicc,
                    "AMTC_L2_IX_EMPTY_GETS_DROP_POISON_V45 addr=%#x valid=%d T0=%d T1=%d force_mask=%d\n",
                    address, cache_entry.ValidSectors, cache_entry.TokensSec0,
                    cache_entry.TokensSec1, force_mask);
            enqueue(triggerQueue_out, TriggerMsg, 1) {
              out_msg.addr := address;
              out_msg.Type := Event:L2_Gets_Local_Escape_Drop;
            }

          } else {

          bool send_gets_repair := false;
          bool reset_gets_epoch := false;

          if (in_msg.RetryNum == 0) {
            reset_gets_epoch := true;
            send_gets_repair := false;
            cache_entry.PendingRetryNumSent := 0;
          } else {
            if (in_msg.RetryNum < cache_entry.PendingRetryNumSent) {
              reset_gets_epoch := true;
              cache_entry.PendingRetryNumSent := 0;
            }

            int next_gets_retry := cache_entry.PendingRetryNumSent + 1;
            if (in_msg.RetryNum >= next_gets_retry) {
              send_gets_repair := true;
              cache_entry.PendingRetryNumSent := in_msg.RetryNum;
            }
          }

          if (send_gets_repair) {
            cache_entry.PendingRetrySent := true;

            DPRINTF(RubySlicc,
                    "AMTC_L2_PENDING_GETS_DIR_RETRY_V37 addr=%#x retry=%d last=%d reset=%d req=%s pending=%s reqmask=%d inmask=%d valid=%d T0=%d T1=%d ownerpull=1 clean_gets_repair=1 fullmask=3 dir_retry=1\n",
                    address, in_msg.RetryNum, cache_entry.PendingRetryNumSent,
                    reset_gets_epoch, in_msg.Requestor,
                    cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
                    in_mask, cache_entry.ValidSectors, cache_entry.TokensSec0,
                    cache_entry.TokensSec1);

            enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
              out_msg.addr := address;
              out_msg.Type := CoherenceRequestType:GETS;

              /* Directory must reply to this L2 proxy.  The L2 will then
               * satisfy PendingL1Requestor with DATA_SHARED.
               */
              out_msg.Requestor := machineID;
              out_msg.Destination.add(
                  mapAddressToMachine(address, MachineType:Directory));

              out_msg.MessageSize := MessageSizeType:Request_Control;
              out_msg.AccessMode := in_msg.AccessMode;
              out_msg.Prefetch := in_msg.Prefetch;
              /* V37: this is not a normal first-time GETS.  L2 has a real
               * pending L1 GETS waiter, but local L2 has no data/tokens and
               * prior clean replay reached Directory, which forwarded again to
               * a stale owner L2.  Mark this as a Directory repair retry so
               * AMTC-dir.sm routes it through CPU_GETS_Owner_Pull_Repair
               * instead of normal CE+CPU_GETS forwarding.
               *
               * Keep PendingReqMask unchanged so the eventual DATA_SHARED to
               * the waiting L1 remains sector-limited, but request a full-line
               * backing repair from Directory.
               */
              out_msg.RetryNum := 1;
              out_msg.is_owner_pull := true;

              out_msg.sector_id := 0;
              out_msg.sector_mask := amtc_fullMask();
              out_msg.requested_sector_mask := amtc_fullMask();

              out_msg.is_gpu := false;
              out_msg.is_sync := false;
              out_msg.is_bypass := false;
              out_msg.is_atomic := false;
              out_msg.is_signal := false;
              out_msg.merged_req := false;
              out_msg.isGLCSet := in_msg.isGLCSet;
              out_msg.isSLCSet := in_msg.isSLCSet;
            }
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_HOLD_PENDING_GETS_RETRY_WINDOW_V37 addr=%#x retry=%d last=%d reset=%d req=%s pending=%s reqmask=%d inmask=%d valid=%d T0=%d T1=%d\n",
                    address, in_msg.RetryNum, cache_entry.PendingRetryNumSent,
                    reset_gets_epoch, in_msg.Requestor,
                    cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
                    in_mask, cache_entry.ValidSectors, cache_entry.TokensSec0,
                    cache_entry.TokensSec1);
          }
          }
        } else {
          cache_entry.PendingReqMask :=
              amtc_unionMasks(cache_entry.PendingReqMask, in_mask);
          if (cache_entry.PendingReqMask == 3) {
            cache_entry.PendingSectorId := 0;
          }

          bool send_repair := false;
          bool reset_epoch := false;

          if (in_msg.RetryNum == 0) {
            /*
             * Retry epoch restart only.  Do not send an owner-pull GETX repair at
             * retry 0: Directory may immediately forward that GETX back to the
             * same L1 that is still in IS_WAIT_ALL/S_IS, causing
             * Transient_GETX-in-wait-state aborts.  Wait for the L1 timeout path
             * to prove the original IX transaction is really stuck.
             */
            reset_epoch := true;
            send_repair := false;
            cache_entry.PendingRetryNumSent := 0;
          } else {
            if (in_msg.RetryNum < cache_entry.PendingRetryNumSent) {
              reset_epoch := true;
              cache_entry.PendingRetryNumSent := 0;
            }

            if (in_msg.RetryNum >= 1) {
              int next_retry := cache_entry.PendingRetryNumSent + 1;
              if (in_msg.RetryNum >= next_retry) {
                send_repair := true;
                cache_entry.PendingRetryNumSent := in_msg.RetryNum;
              }
            }
          }

          if (send_repair) {
            cache_entry.PendingRetrySent := true;

            /*
             * V67 clean-exit repair: keep normal first GETX as full-line and
             * do not narrow PendingReqMask.  Instead, when the retry loop proves
             * a CPU GETX is stuck while L2 already has some valid data but one
             * token sector is starved, complete the saved GETX locally with the
             * existing full-line synthetic DATA_OWNER grant.  This avoids the
             * v65/v66 NP invariant failure caused by sector-granting and then
             * deallocating an L2 block that still owns the other sector.
             *
             * Seen signatures:
             *   addr=0x60a00 valid=1 T0=2 T1=0 inmask=2 reqmask=3
             *   addr=0x3c980 valid=3 T0=0 T1=2 inmask=1 reqmask=3
             */
            if (cache_entry.CacheState == State:IX &&
                in_msg.RetryNum >= 1 &&
                cache_entry.PendingL1Valid &&
                cache_entry.PendingIsGetX &&
                machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                cache_entry.PendingReqMask == 3 &&
                cache_entry.ValidSectors == 0 &&
                cache_entry.TokensSec0 <= 1 &&
                cache_entry.TokensSec1 <= 1 &&
                cache_entry.PendingRequesterHeldTokensSec0 > 0 &&
                cache_entry.PendingRequesterHeldTokensSec1 > 0) {
              /*
               * V68 clean-exit repair: handle the residual-held IX GETX retry
               * loop directly in the retry-loop path.  This is the recurring
               * post-pass signature:
               *   valid=0 T0=1 T1=1 held0=1 held1=1 reqmask=3 inmask=2
               * Earlier v47/v51 escapes do not fire here because they live in
               * the direct L1 request classification path or require a different
               * held-token shape.  Keep the grant full-line before using the
               * existing local DATA_OWNER + L2 deallocate path, so NP asserts are
               * not violated by residual sector tokens.
               */
              cache_entry.PendingReqMask := amtc_fullMask();
              cache_entry.PendingSectorId := 0;

              DPRINTF(RubySlicc,
                      "AMTC_L2_PENDING_GETX_RESIDUAL_HELD_FULL_LOCAL_GRANT_V68 addr=%#x retry=%d reqmask=%d inmask=%d valid=%d T0=%d T1=%d held0=%d held1=%d\n",
                      address,
                      in_msg.RetryNum,
                      cache_entry.PendingReqMask,
                      in_mask,
                      cache_entry.ValidSectors,
                      cache_entry.TokensSec0,
                      cache_entry.TokensSec1,
                      cache_entry.PendingRequesterHeldTokensSec0,
                      cache_entry.PendingRequesterHeldTokensSec1);

              enqueue(triggerQueue_out, TriggerMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := Event:L1_GETX_Force_Local_Grant_TriggerQ;
              }
            } else if (cache_entry.CacheState == State:IX &&
                in_msg.RetryNum >= 1 &&
                cache_entry.PendingL1Valid &&
                cache_entry.PendingIsGetX &&
                machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                cache_entry.PendingReqMask == 3 &&
                cache_entry.ValidSectors != 0 &&
                cache_entry.TokensSec0 <= 2 &&
                cache_entry.TokensSec1 <= 2 &&
                (cache_entry.TokensSec0 == 0 ||
                 cache_entry.TokensSec1 == 0)) {
              cache_entry.PendingReqMask := amtc_fullMask();
              cache_entry.PendingSectorId := 0;

              DPRINTF(RubySlicc,
                      "AMTC_L2_PENDING_GETX_TOKENSTARVED_FULL_LOCAL_GRANT_V67 addr=%#x retry=%d reqmask=%d inmask=%d valid=%d T0=%d T1=%d\n",
                      address,
                      in_msg.RetryNum,
                      cache_entry.PendingReqMask,
                      in_mask,
                      cache_entry.ValidSectors,
                      cache_entry.TokensSec0,
                      cache_entry.TokensSec1);

              enqueue(triggerQueue_out, TriggerMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := Event:L1_GETX_Force_Local_Grant_TriggerQ;
              }
            } else {
              DPRINTF(RubySlicc,
                      "AMTC_L2_PENDING_GETX_REFWD_MAX_REPAIR_V32 addr=%#x retry=%d last=%d reset=%d req=%s reqmask=%d inmask=%d valid=%d T0=%d T1=%d acc=%d ownerpull=1\n",
                      address,
                      in_msg.RetryNum,
                      cache_entry.PendingRetryNumSent,
                      reset_epoch,
                      cache_entry.PendingL1Requestor,
                      cache_entry.PendingReqMask,
                      in_mask,
                      cache_entry.ValidSectors,
                      cache_entry.TokensSec0,
                      cache_entry.TokensSec1,
                      cache_entry.AccumulationPending);

              enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:GETX;

                /*
                 * Repair must complete at L2.  L2 will then reply to the saved L1.
                 * Do not target the retrying L1 directly from Directory.
                 */
                out_msg.Requestor := machineID;

                out_msg.Destination.add(
                    mapAddressToMachine(address, MachineType:Directory));

                out_msg.MessageSize := MessageSizeType:Request_Control;
                out_msg.AccessMode := in_msg.AccessMode;
                out_msg.Prefetch := in_msg.Prefetch;

                out_msg.RetryNum := in_msg.RetryNum;
                out_msg.is_owner_pull := true;

                out_msg.sector_id := cache_entry.PendingSectorId;
                out_msg.sector_mask := cache_entry.PendingReqMask;
                out_msg.requested_sector_mask := cache_entry.PendingReqMask;

                out_msg.is_gpu := false;
                out_msg.is_sync := false;
                out_msg.is_bypass := false;
                out_msg.is_atomic := false;
                out_msg.is_signal := false;
                out_msg.merged_req := false;
                out_msg.isGLCSet := in_msg.isGLCSet;
                out_msg.isSLCSet := in_msg.isSLCSet;
              }
            }
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_HOLD_PENDING_GETX_RETRY_WINDOW_V32 addr=%#x retry=%d last=%d reqmask=%d inmask=%d\n",
                    address,
                    in_msg.RetryNum,
                    cache_entry.PendingRetryNumSent,
                    cache_entry.PendingReqMask,
                    in_mask);
          }
        }
      }
    }
  }

  action(z_stallL1RequestQueue, "zsl1",
        desc="Stall L1 request queue while replacement victim is transient") {
    DPRINTF(RubySlicc,
            "AMTC_L2_STALL_L1_REQ_TRANSIENT_VICTIM addr=%#x \n",
            address
            );
  }



  action(dropNoWayTransientVictimRequest, "dnwt",
         desc="Drop duplicate L1 retry when no L2 way is available and victim is transient") {
    peek(L1requestNetwork_in, RequestMsg) {
      DPRINTF(RubySlicc,
              "AMTC_L2_DROP_L1_REQ_TRANSIENT_VICTIM reqaddr=%#x type=%s retry=%d ",
              in_msg.addr,
              in_msg.Type,
              in_msg.RetryNum);
    }
  }

  action(logPendingGetsWhileIS, "lpgis",
        desc="Log GETS arriving while L2 has a pending GETS miss") {
    peek(L1requestNetwork_in, RequestMsg) {
      DPRINTF(RubySlicc,
              "AMTC_L2_IS_GETS_FORWARD_ANYWAY addr=%#x incoming=%s pending=%s inmask=%d pendingmask=%d retry=%d\n",
              address,
              in_msg.Requestor,
              cache_entry.PendingL1Requestor,
              amtc_normalizeMask(in_msg.requested_sector_mask, in_msg.sector_id),
              cache_entry.PendingReqMask,
              in_msg.RetryNum);
    }
  }

  action(saveSecondGetsWaiterOrDropRetry, "sgw",
         desc="Save/repair GETS waiters while L2 read miss is pending") {
    peek(L1requestNetwork_in, RequestMsg) {
      int in_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                        in_msg.sector_id);
      if (in_mask == 0) {
        in_mask := amtc_normalizeMask(in_msg.sector_mask,
                                      in_msg.sector_id);
      }
      if (in_mask == 0) {
        in_mask := amtc_fullMask();
      }

      if (in_msg.Requestor == cache_entry.PendingL1Requestor) {
        int primary_overlap := amtc_intersectMasks(in_mask,
                                                   cache_entry.PendingReqMask);

        if (primary_overlap == in_mask) {
          bool should_forward := false;
          bool force_repair := false;

          if (in_msg.RetryNum == 0) {
            should_forward := true;
          } else {
            if (!cache_entry.PendingRetrySent) {
              /*
               * Audit87: The original I/NP -> IS GETS request can be lost or
               * not reflected in PendingRetrySent.  Do not drop the first
               * primary retry when sent=0; re-forward it immediately.  The
               * observed deadlock was:
               *   L2 IS + AMTC_L2_IS_GETS_DROP_PRIMARY_RETRY sent=0 forever
               *   L1 IS_WAIT_ALL retries until Sequencer deadlock.
               */
              should_forward := true;
            } else {
              if (in_msg.RetryNum >= 8) {
                /*
                 * Keep primary repair retryable.  One forwarded owner-pull is
                 * not sufficient if Directory/owner state is stale or the
                 * repair races with another transient.  Start the
                 * repair at retry 8 during bring-up instead of waiting
                 * for retry 32/64 cycles.
                 */
                should_forward := true;
                force_repair := true;
              }
            }
          }

          if (should_forward) {
            cache_entry.PendingRetrySent := true;
            cache_entry.PendingRetryNumSent := in_msg.RetryNum;
            DPRINTF(RubySlicc,
                    "AMTC_L2_IS_GETS_FORWARD_PRIMARY_REPAIR addr=%#x req=%s inmask=%d total=%d retry=%d repair=%d\n",
                    address,
                    in_msg.Requestor,
                    in_mask,
                    cache_entry.PendingReqMask,
                    in_msg.RetryNum,
                    force_repair);

            enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
              out_msg.addr := in_msg.addr;
              out_msg.Type := in_msg.Type;
              out_msg.Requestor := machineID;
              out_msg.RetryNum := in_msg.RetryNum;

              out_msg.Destination.broadcast(MachineType:Directory);
              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_REPAIR_BCAST_V10 addr=%#x req=%s retry=%d mask=%d path=primary\n",
                      address, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.PendingReqMask);

              out_msg.sector_id := in_msg.sector_id;
              out_msg.sector_mask := cache_entry.PendingReqMask;
              out_msg.requested_sector_mask := cache_entry.PendingReqMask;

              out_msg.is_gpu := in_msg.is_gpu;
              out_msg.is_sync := in_msg.is_sync;
              out_msg.is_bypass := in_msg.is_bypass;
              out_msg.is_atomic := in_msg.is_atomic;
              out_msg.is_signal := in_msg.is_signal;
              out_msg.merged_req := in_msg.merged_req;

              if (force_repair) {
                out_msg.is_owner_pull := true;
              } else {
                out_msg.is_owner_pull := in_msg.is_owner_pull;
              }

              out_msg.MessageSize := MessageSizeType:Request_Control;
              out_msg.AccessMode := in_msg.AccessMode;
              out_msg.Prefetch := in_msg.Prefetch;
            }
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_IS_GETS_DROP_PRIMARY_RETRY addr=%#x req=%s inmask=%d total=%d retry=%d sent=%d\n",
                    address,
                    in_msg.Requestor,
                    in_mask,
                    cache_entry.PendingReqMask,
                    in_msg.RetryNum,
                    cache_entry.PendingRetrySent);
          }

        } else {
          cache_entry.PendingReqMask :=
              amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

          bool should_forward_new_primary_mask := false;
          bool force_repair_new_primary_mask := false;

          if (in_msg.RetryNum == 0) {
            should_forward_new_primary_mask := true;
          } else {
            if (!cache_entry.PendingRetrySent) {
              /*
               * Audit87: same repair for a primary retry that also expands the
               * sector mask.  If the initial directory request was not marked
               * sent, do not wait until retry 8 before forwarding.
               */
              should_forward_new_primary_mask := true;
            } else {
              if (in_msg.RetryNum >= 8) {
                should_forward_new_primary_mask := true;
                force_repair_new_primary_mask := true;
              }
            }
          }

          if (should_forward_new_primary_mask) {
            cache_entry.PendingRetrySent := true;
            cache_entry.PendingRetryNumSent := in_msg.RetryNum;
            DPRINTF(RubySlicc,
                    "AMTC_L2_IS_GETS_FORWARD_PRIMARY_NEW_MASK addr=%#x req=%s inmask=%d total=%d retry=%d repair=%d\n",
                    address,
                    in_msg.Requestor,
                    in_mask,
                    cache_entry.PendingReqMask,
                    in_msg.RetryNum,
                    force_repair_new_primary_mask);

            enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
              out_msg.addr := in_msg.addr;
              out_msg.Type := in_msg.Type;
              out_msg.Requestor := machineID;
              out_msg.RetryNum := in_msg.RetryNum;
              out_msg.Destination.broadcast(MachineType:Directory);
              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_REPAIR_BCAST_V10 addr=%#x req=%s retry=%d mask=%d path=new_mask\n",
                      address, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.PendingReqMask);
              out_msg.sector_id := in_msg.sector_id;
              out_msg.sector_mask := cache_entry.PendingReqMask;
              out_msg.requested_sector_mask := cache_entry.PendingReqMask;
              out_msg.is_gpu := in_msg.is_gpu;
              out_msg.is_sync := in_msg.is_sync;
              out_msg.is_bypass := in_msg.is_bypass;
              out_msg.is_atomic := in_msg.is_atomic;
              out_msg.is_signal := in_msg.is_signal;
              out_msg.merged_req := in_msg.merged_req;
              if (force_repair_new_primary_mask) {
                out_msg.is_owner_pull := true;
              } else {
                out_msg.is_owner_pull := in_msg.is_owner_pull;
              }
              out_msg.MessageSize := MessageSizeType:Request_Control;
              out_msg.AccessMode := in_msg.AccessMode;
              out_msg.Prefetch := in_msg.Prefetch;
            }
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_IS_GETS_MERGE_PRIMARY_MASK addr=%#x req=%s inmask=%d total=%d retry=%d sent=%d\n",
                    address,
                    in_msg.Requestor,
                    in_mask,
                    cache_entry.PendingReqMask,
                    in_msg.RetryNum,
                    cache_entry.PendingRetrySent);
          }
        }
      } else {
        if (!cache_entry.PendingL1SecondValid) {
          cache_entry.PendingL1SecondValid := true;
          cache_entry.PendingL1SecondRequestor := in_msg.Requestor;
          cache_entry.PendingL1SecondReqMask := in_mask;
          cache_entry.PendingL1SecondSectorId := in_msg.sector_id;
          cache_entry.PendingL1SecondRetrySent := false;
          cache_entry.PendingL1SecondRetryNumSent := 0;

          cache_entry.PendingReqMask :=
              amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

          DPRINTF(RubySlicc,
                  "AMTC_L2_IS_GETS_SAVE_SECOND_WAITER addr=%#x primary=%s second=%s secondmask=%d total=%d retry=%d\n",
                  address,
                  cache_entry.PendingL1Requestor,
                  in_msg.Requestor,
                  in_mask,
                  cache_entry.PendingReqMask,
                  in_msg.RetryNum);
        } else {
          if (in_msg.Requestor == cache_entry.PendingL1SecondRequestor) {
            cache_entry.PendingL1SecondReqMask :=
                amtc_unionMasks(cache_entry.PendingL1SecondReqMask, in_mask);
            cache_entry.PendingReqMask :=
                amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

            bool should_forward_second := false;
            bool force_repair_second := false;

            if (in_msg.RetryNum >= 8) {
              /*
               * Do not gate second-waiter repair with a one-shot flag.
               * The previous repair may be lost behind stale owner state or
               * another pending miss.  The L1 timeout cadence already rate
               * limits these retries, so keep forwarding high-retry repairs.
               * Start at retry 8 for post-kernel result-check progress.
               */
              should_forward_second := true;
              force_repair_second := true;
              cache_entry.PendingL1SecondRetrySent := true;
            }

            if (should_forward_second) {
              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_FORWARD_SECOND_REPAIR addr=%#x second=%s secondmask=%d total=%d retry=%d repair=%d\n",
                      address,
                      cache_entry.PendingL1SecondRequestor,
                      cache_entry.PendingL1SecondReqMask,
                      cache_entry.PendingReqMask,
                      in_msg.RetryNum,
                      force_repair_second);

              enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
                out_msg.addr := in_msg.addr;
                out_msg.Type := in_msg.Type;
                out_msg.Requestor := machineID;
                out_msg.RetryNum := in_msg.RetryNum;

                out_msg.Destination.add(
                    mapAddressToMachine(address, MachineType:Directory));

                out_msg.sector_id := in_msg.sector_id;
                out_msg.sector_mask := cache_entry.PendingReqMask;
                out_msg.requested_sector_mask := cache_entry.PendingReqMask;

                out_msg.is_gpu := in_msg.is_gpu;
                out_msg.is_sync := in_msg.is_sync;
                out_msg.is_bypass := in_msg.is_bypass;
                out_msg.is_atomic := in_msg.is_atomic;
                out_msg.is_signal := in_msg.is_signal;
                out_msg.merged_req := in_msg.merged_req;
                out_msg.is_owner_pull := true;

                out_msg.MessageSize := MessageSizeType:Request_Control;
                out_msg.AccessMode := in_msg.AccessMode;
                out_msg.Prefetch := in_msg.Prefetch;
              }
            } else {
              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_MERGE_SECOND_WAITER addr=%#x second=%s secondmask=%d total=%d retry=%d sent=%d\n",
                      address,
                      cache_entry.PendingL1SecondRequestor,
                      cache_entry.PendingL1SecondReqMask,
                      cache_entry.PendingReqMask,
                      in_msg.RetryNum,
                      cache_entry.PendingL1SecondRetrySent);
            }
          } else {
            if (!cache_entry.PendingL1ThirdValid) {
              cache_entry.PendingL1ThirdValid := true;
              cache_entry.PendingL1ThirdRequestor := in_msg.Requestor;
              cache_entry.PendingL1ThirdReqMask := in_mask;
              cache_entry.PendingL1ThirdSectorId := in_msg.sector_id;
              cache_entry.PendingL1ThirdRetrySent := false;
              cache_entry.PendingL1ThirdRetryNumSent := 0;

              cache_entry.PendingReqMask :=
                  amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_SAVE_THIRD_WAITER addr=%#x primary=%s second=%s third=%s thirdmask=%d total=%d retry=%d\n",
                      address,
                      cache_entry.PendingL1Requestor,
                      cache_entry.PendingL1SecondRequestor,
                      in_msg.Requestor,
                      in_mask,
                      cache_entry.PendingReqMask,
                      in_msg.RetryNum);
            } else {
              if (in_msg.Requestor == cache_entry.PendingL1ThirdRequestor) {
                cache_entry.PendingL1ThirdReqMask :=
                    amtc_unionMasks(cache_entry.PendingL1ThirdReqMask, in_mask);
                cache_entry.PendingReqMask :=
                    amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

                bool forward_third_repair := false;
                if (in_msg.RetryNum == 0) {
                  /*
                   * A stored waiter can start a fresh L1 retry sequence while
                   * the L2 entry is still in IS from an older miss epoch.  In
                   * that case the saved last-forwarded retry number can be
                   * larger than the incoming retry number.  Reset the limiter
                   * and allow one repair/refresh request.
                   */
                  forward_third_repair := true;
                  cache_entry.PendingL1ThirdRetrySent := true;
                  cache_entry.PendingL1ThirdRetryNumSent := 0;
                } else {
                  if (in_msg.RetryNum >= 8) {
                    if (in_msg.RetryNum < cache_entry.PendingL1ThirdRetryNumSent) {
                      forward_third_repair := true;
                      cache_entry.PendingL1ThirdRetrySent := true;
                      cache_entry.PendingL1ThirdRetryNumSent := in_msg.RetryNum;
                    } else {
                      if (in_msg.RetryNum >= cache_entry.PendingL1ThirdRetryNumSent + 8) {
                        forward_third_repair := true;
                        cache_entry.PendingL1ThirdRetrySent := true;
                        cache_entry.PendingL1ThirdRetryNumSent := in_msg.RetryNum;
                      }
                    }
                  }
                }

                if (forward_third_repair) {
                  DPRINTF(RubySlicc,
                          "AMTC_L2_IS_GETS_FORWARD_THIRD_REPAIR addr=%#x third=%s thirdmask=%d total=%d retry=%d last=%d\n",
                          address,
                          cache_entry.PendingL1ThirdRequestor,
                          cache_entry.PendingL1ThirdReqMask,
                          cache_entry.PendingReqMask,
                          in_msg.RetryNum,
                          cache_entry.PendingL1ThirdRetryNumSent);

                  enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
                    out_msg.addr := in_msg.addr;
                    out_msg.Type := in_msg.Type;
                    out_msg.Requestor := machineID;
                    out_msg.RetryNum := in_msg.RetryNum;
                    out_msg.Destination.add(
                        mapAddressToMachine(address, MachineType:Directory));
                    out_msg.sector_id := in_msg.sector_id;
                    out_msg.sector_mask := cache_entry.PendingReqMask;
                    out_msg.requested_sector_mask := cache_entry.PendingReqMask;
                    out_msg.is_gpu := in_msg.is_gpu;
                    out_msg.is_sync := in_msg.is_sync;
                    out_msg.is_bypass := in_msg.is_bypass;
                    out_msg.is_atomic := in_msg.is_atomic;
                    out_msg.is_signal := in_msg.is_signal;
                    out_msg.merged_req := in_msg.merged_req;
                    out_msg.is_owner_pull := true;
                    out_msg.MessageSize := MessageSizeType:Request_Control;
                    out_msg.AccessMode := in_msg.AccessMode;
                    out_msg.Prefetch := in_msg.Prefetch;
                  }
                } else {
                  DPRINTF(RubySlicc,
                          "AMTC_L2_IS_GETS_MERGE_THIRD_WAITER addr=%#x third=%s thirdmask=%d total=%d retry=%d last=%d\n",
                          address,
                          cache_entry.PendingL1ThirdRequestor,
                          cache_entry.PendingL1ThirdReqMask,
                          cache_entry.PendingReqMask,
                          in_msg.RetryNum,
                          cache_entry.PendingL1ThirdRetryNumSent);
                }
              } else {
                if (!cache_entry.PendingL1FourthValid) {
                  cache_entry.PendingL1FourthValid := true;
                  cache_entry.PendingL1FourthRequestor := in_msg.Requestor;
                  cache_entry.PendingL1FourthReqMask := in_mask;
                  cache_entry.PendingL1FourthSectorId := in_msg.sector_id;
                  cache_entry.PendingL1FourthRetrySent := false;
                  cache_entry.PendingL1FourthRetryNumSent := 0;

                  cache_entry.PendingReqMask :=
                      amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

                  DPRINTF(RubySlicc,
                          "AMTC_L2_IS_GETS_SAVE_FOURTH_WAITER addr=%#x primary=%s second=%s third=%s fourth=%s fourthmask=%d total=%d retry=%d\n",
                          address,
                          cache_entry.PendingL1Requestor,
                          cache_entry.PendingL1SecondRequestor,
                          cache_entry.PendingL1ThirdRequestor,
                          in_msg.Requestor,
                          in_mask,
                          cache_entry.PendingReqMask,
                          in_msg.RetryNum);
                } else {
                  if (in_msg.Requestor == cache_entry.PendingL1FourthRequestor) {
                    cache_entry.PendingL1FourthReqMask :=
                        amtc_unionMasks(cache_entry.PendingL1FourthReqMask, in_mask);
                    cache_entry.PendingReqMask :=
                        amtc_unionMasks(cache_entry.PendingReqMask, in_mask);

                    bool forward_fourth_repair := false;
                    if (in_msg.RetryNum == 0) {
                      /* See third-waiter retry limiter reset above. */
                      forward_fourth_repair := true;
                      cache_entry.PendingL1FourthRetrySent := true;
                      cache_entry.PendingL1FourthRetryNumSent := 0;
                    } else {
                      if (in_msg.RetryNum >= 8) {
                        if (in_msg.RetryNum < cache_entry.PendingL1FourthRetryNumSent) {
                          forward_fourth_repair := true;
                          cache_entry.PendingL1FourthRetrySent := true;
                          cache_entry.PendingL1FourthRetryNumSent := in_msg.RetryNum;
                        } else {
                          if (in_msg.RetryNum >= cache_entry.PendingL1FourthRetryNumSent + 8) {
                            forward_fourth_repair := true;
                            cache_entry.PendingL1FourthRetrySent := true;
                            cache_entry.PendingL1FourthRetryNumSent := in_msg.RetryNum;
                          }
                        }
                      }
                    }

                    if (forward_fourth_repair) {
                      DPRINTF(RubySlicc,
                              "AMTC_L2_IS_GETS_FORWARD_FOURTH_REPAIR addr=%#x fourth=%s fourthmask=%d total=%d retry=%d last=%d\n",
                              address,
                              cache_entry.PendingL1FourthRequestor,
                              cache_entry.PendingL1FourthReqMask,
                              cache_entry.PendingReqMask,
                              in_msg.RetryNum,
                              cache_entry.PendingL1FourthRetryNumSent);

                      enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
                        out_msg.addr := in_msg.addr;
                        out_msg.Type := in_msg.Type;
                        out_msg.Requestor := machineID;
                        out_msg.RetryNum := in_msg.RetryNum;
                        out_msg.Destination.add(
                            mapAddressToMachine(address, MachineType:Directory));
                        out_msg.sector_id := in_msg.sector_id;
                        out_msg.sector_mask := cache_entry.PendingReqMask;
                        out_msg.requested_sector_mask := cache_entry.PendingReqMask;
                        out_msg.is_gpu := in_msg.is_gpu;
                        out_msg.is_sync := in_msg.is_sync;
                        out_msg.is_bypass := in_msg.is_bypass;
                        out_msg.is_atomic := in_msg.is_atomic;
                        out_msg.is_signal := in_msg.is_signal;
                        out_msg.merged_req := in_msg.merged_req;
                        out_msg.is_owner_pull := true;
                        out_msg.MessageSize := MessageSizeType:Request_Control;
                        out_msg.AccessMode := in_msg.AccessMode;
                        out_msg.Prefetch := in_msg.Prefetch;
                      }
                    } else {
                      DPRINTF(RubySlicc,
                              "AMTC_L2_IS_GETS_MERGE_FOURTH_WAITER addr=%#x fourth=%s fourthmask=%d total=%d retry=%d last=%d\n",
                              address,
                              cache_entry.PendingL1FourthRequestor,
                              cache_entry.PendingL1FourthReqMask,
                              cache_entry.PendingReqMask,
                              in_msg.RetryNum,
                              cache_entry.PendingL1FourthRetryNumSent);
                    }
                  } else {
                    DPRINTF(RubySlicc,
                            "AMTC_L2_IS_GETS_DROP_OVERFLOW_WAITER addr=%#x incoming=%s primary=%s second=%s third=%s fourth=%s mask=%d retry=%d\n",
                            address,
                            in_msg.Requestor,
                            cache_entry.PendingL1Requestor,
                            cache_entry.PendingL1SecondRequestor,
                            cache_entry.PendingL1ThirdRequestor,
                            cache_entry.PendingL1FourthRequestor,
                            in_mask,
                            in_msg.RetryNum);
                  }
                }
              }
            }
          }
        }
      }
    }
  }

/* TRANSITIONS */
  transition(NP, L1_NoWay_Transient_Drop) {
    dropNoWayTransientVictimRequest;
    o_popL1RequestQueue;
  }

  // Audit94/V18: bounded bring-up escape for a GETS miss stuck in IS with no
  // data/tokens.  Lowered trigger from retry 16 to retry 1 because
  // post-kernel result-check loads progress only at issue=64, but every output line still waits for 16 L1 timeouts.
  // Trigger at the first retry to avoid pathological post-kernel result-check stalls.  The observed sequence was:
  //   AMTC_L2_ALLOC_OK / AMTC_L2_DIR_PROXY_BCAST_V10 addr=0x10f26c0
  //   no AMTC_DIR_REQ_RAW_IN / no Data_Shared
  //   repeated AMTC_L2_IS_GETS_REPAIR_BCAST_V10 retries forever.
  // Do not keep the L2 line in IS forever.  Drop the empty transient entry
  // and leave the L1 request queued so it is reprocessed from NP/I and sends
  // a fresh directory request.
  transition(IS, L1_GETS_Force_Restart, NP) {
    dbg_l2ForceRestartEmptyISGets;
    // V13 bring-up escape: the normal L2->Directory request path is not being
    // observed by the Directory for this stuck I-cache line.  Replaying the
    // same request only repeats AMTC_L2_DIR_PROXY_BCAST without any
    // AMTC_DIR_REQ_RAW_IN.  Complete the saved pending GETS locally so the
    // CPU sequencer can make forward progress, then drop the empty transient
    // L2 entry.  This is a temporary bring-up workaround, not the final
    // coherence model.
    dbg_l2ForceLocalGetsFill;
    sendPendingGetsDataToL1;
    sendPendingGetsDataToSecondL1;
    sendPendingGetsDataToThirdL1;
    sendPendingGetsDataToFourthL1;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    o_popL1RequestQueue;
  }

  // While a GETS is already pending, another GETS for the same line is a
  // timeout retry/duplicate. Drop only the duplicate read retry; do not
  // re-forward it to Directory.
  transition(IS, L1_GETS) {
    // Max-repair rule: never call a_broadcastLocalRequest here.
    // The action below either stores this L1 as a waiter or sends an
    // L2-owned owner-pull repair using the merged PendingReqMask.
    saveSecondGetsWaiterOrDropRetry;
    o_popL1RequestQueue;
  }

  // A GETX arriving while a GETS is pending is not a duplicate. It is a local
  // upgrade/write request. Merge it into the pending entry, forward one GETX
  // to Directory, and move to IX so the later response completes as DATA_OWNER.
  transition(IS, L1_GETX, IX) {
    dbgUpgradePendingGetsToGetx;
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  // Audit94: post-kernel DMA_WRITE can invalidate an L2 owner and leave a
  // stale Directory-0 pending window in IX with no data/tokens.  Later CPU
  // GETS retries then merge into IX forever:
  //   L2 IX + PendingL1Requestor=Directory-0 + valid=0 + T0=0 + T1=0
  // There is nothing useful for L2 to return.  Clear the stale transient entry
  // and leave the incoming L1 GETS queued, so it is reclassified as a fresh
  // NP/I miss and can fetch the DMA-written memory value.
  transition(IX, L1_GETS_Force_Restart, NP) {
    dbg_l2ClearStaleDirPendingIX;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    // Intentionally do not pop L1requestNetwork_in.
  }

  // V49: keep pending IX state intact and broadcast an owner-pull GETX retry
  // for the empty/no-held-token case.  This replaces the ineffective v48
  // deallocate/restart loop for 0x106f3c0.
  transition(IX, L1_GETX_Force_Dir_Bcast_Retry) {
    sendPendingGetxDirBroadcastRetryV49;
    // The retrying L1 request has been consumed to send this repair.  Keep the
    // saved PendingL1* state so the Directory response can complete back to L1.
    o_popL1RequestQueue;
  }

  // V48: empty pending GETX without held tokens cannot be completed locally.
  // Clear the stale IX entry and leave the current L1 GETX queued so it is
  // reclassified as a fresh miss and resent to Directory through the normal path.
  transition(IX, L1_GETX_Force_Dir_Restart, NP) {
    dbg_l2EmptyGetxDirRestartV48;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    // Intentionally do not pop L1requestNetwork_in.
  }

  // Audit93: bounded bring-up escape for a GETX/upgrade stuck in IX.
  // The observed sequence after v13 is:
  //   L1 Store_Sector_Miss addr=0x632c0 -> S_IM
  //   L2 IX receives repeated L1_GETX retries
  //   no Directory response / no DATA_OWNER completion
  // For bring-up only, synthesize an owner grant after long retry so the CPU
  // sequencer can move past the stuck store.  Replace with a clean Directory
  // response-path fix later.
  transition(IX, L1_GETX_Force_Local_Grant, NP) {
    dbg_l2ForceLocalGetxGrant;
    forcePendingGetxOwnerDataToL1;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    o_popL1RequestQueue;
  }

  // V67: same local GETX grant, but sourced from triggerQueue_out in the
  // retry-loop repair path.  Do not pop L1requestNetwork_in for this internal
  // trigger; the retrying L1 request has already been consumed by the outer
  // transition that scheduled this trigger.
  transition(IX, L1_GETX_Force_Local_Grant_TriggerQ, NP) {
    dbg_l2ForceLocalGetxGrant;
    forcePendingGetxOwnerDataToL1;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    t_popTriggerQueue;
  }

  transition(IX, L1_GETS) {
    mergePendingMaskFromIncomingL1;
    // Audit86: A timeout retry can arrive after the needed data/tokens are
    // already present in the IX entry but before/without a fresh response event.
    // Re-run the accumulation check on duplicate GETS/GETX so a pending L1
    // requester is not stranded forever waiting for a new Data_Owner message.
    cl2_checkL2Accumulation;
    maybeForwardPendingGetxRetry;
    o_popL1RequestQueue;
  }

  transition(IX, L1_GETX) {
    mergePendingMaskFromIncomingL1;
    // Audit86: same retry-side completion repair for sector-masked GETX, e.g.
    // addr=0x19c4c00 stuck with L1Cache-2 in S_IM and L2 IX receiving repeated
    // L1_GETX retries.
    cl2_checkL2Accumulation;
    maybeForwardPendingGetxRetry;
    o_popL1RequestQueue;
  }

  transition(IS, Data_Shared, S) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    sendPendingGetsDataToL1;
    sendPendingGetsDataToSecondL1;
    sendPendingGetsDataToThirdL1;
    sendPendingGetsDataToFourthL1;
    clearPendingL1Request;
    amtc_l2RecomputeValidFromTokens;
    uu_profileMiss;
    n_popResponseQueue;
  }

  transition(IS, Data_Owner, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    sendPendingGetsDataToL1;
    sendPendingGetsDataToSecondL1;
    sendPendingGetsDataToThirdL1;
    sendPendingGetsDataToFourthL1;
    clearPendingL1Request;
    amtc_l2RecomputeValidFromTokens;
    uu_profileMiss;
    n_popResponseQueue;
  }

  // Defensive: if a GETX receives shared data first, absorb it and keep
  // waiting.  A later owner/tokens response or accumulation-done trigger will
  // complete the original blocked L1 request.
  transition(IX, Data_Shared, IX) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    cl2_checkL2Accumulation;
    dbgIXPendingNoComplete;
    n_popResponseQueue;
  }

  // Audit82: DATA_OWNER can be partial during owner-pull retry.  Do not send
  // the saved pending GETX to L1 until cl2_checkL2Accumulation confirms that L2
  // has all requested data and tokens.  The old path sent DATA_OWNER with
  // sent0=0/sent1=512 and then cleared the pending request, causing L1 to enter
  // stable O with a valid sector but zero tokens.
  transition(IX, Data_Owner, IX) {
    u_writeDataToCache;
    q_replaceTokensFromOwnerResponse;
    cl2_checkL2Accumulation;
    dbgIXPendingNoComplete;
    n_popResponseQueue;
  }

  transition(IX, L2_Gets_Local_Escape_Drop, NP) {
    dbg_l2DropPoisonLocalGetsV45;
    z_resetAccumulationFlag;
    clearPendingL1Request;
    rr_deallocateL2CacheBlock;
    uu_profileMiss;
    t_popTriggerQueue;
  }

  transition(IX, L2_Gets_Accumulation_Done, S) {
    sendPendingGetsDataToL1;
    sendPendingGetsDataToSecondL1;
    sendPendingGetsDataToThirdL1;
    sendPendingGetsDataToFourthL1;
    z_resetAccumulationFlag;
    clearPendingL1Request;
    amtc_l2RecomputeValidFromTokens;
    uu_profileMiss;
    t_popTriggerQueue;
  }

  transition(IX, L2_Accumulation_Done, NP) {
    sendPendingGetxDataToL1;
    z_resetAccumulationFlag;
    clearPendingL1Request;
    amtc_l2RecomputeValidFromTokens;
    //r_setMRU;
    uu_profileMiss;
    t_popTriggerQueue;
  }

  transition(IS, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(IX, Ack) {
    q_updateTokensFromResponse;
    cl2_checkL2Accumulation;
    dbgIXPendingNoComplete;
    n_popResponseQueue;
  }

  transition({IS, IX}, {Transient_GETX, Transient_GETS}) {
    // L2 already has an outstanding miss for this line.  Drop/coalesce
    // external probes for now; Directory will retry/repair as needed.
    m_popRequestQueue;
  }

transition(IS, Writeback_Tokens) {
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  n_popResponseQueue;
}

transition(IX, Writeback_Tokens) {
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  cl2_checkL2Accumulation;
  dbgIXPendingNoComplete;
  n_popResponseQueue;
}

transition(IS, Writeback_Shared_Data) {
  u_writeDataToCache;
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  jwb_forwardWriteThroughToLocalSharers;
  n_popResponseQueue;
}

transition(IX, Writeback_Shared_Data) {
  u_writeDataToCache;
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  jwb_forwardWriteThroughToLocalSharers;
  cl2_checkL2Accumulation;
  n_popResponseQueue;
}

transition(IS, Writeback_Owned) {
  u_writeDataToCache;
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  n_popResponseQueue;
}

transition(IX, Writeback_Owned) {
  u_writeDataToCache;
  qwb_updateTokensFromWritebackResponse;
  h_updateFilterFromL1HintOrWB;
  cl2_checkL2Accumulation;
  n_popResponseQueue;
}

  // AMTC audit-freeze: cacheProbe may select a transient victim.
  // Never deallocate a line with an outstanding Directory/memory transaction.
  // Keep the incoming request queued and let the transient line complete.
  transition({IS, IX, SX, OX, MX}, L2_Replacement) {
    dbgReplacementTransientBusy;
  }

  // Transitions from Shared

  transition(S, L2_Replacement, I) {
    c_cleanReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(S, Transient_GETX, I) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(S, {Transient_GETS}) {
    j_forwardTransientRequestToLocalSharers;
    r_clearExclusive;
    m_popRequestQueue;
  }

  transition(S, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Tokens) {
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, Writeback_Shared_Data) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    n_popResponseQueue;
  }


  transition(S, Data_Owner, O) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Owned, O) {
    w_assertIncomingDataAndCacheDataMatch;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, {Data_Shared}) {
    q_updateTokensFromResponse; // Updates cache_entry.TokensSec0/1
    u_writeDataToCache;         // Updates cache_entry.ValidSectors [cite: 378]
    cl2_checkL2Accumulation;    // Fires trigger if entry is now complete
    n_popResponseQueue;
  }

  transition(S, L1_GETX, I) {
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }


  transition(S, L1_GETS_Partial_Miss, IS) {
    savePendingL1Request;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    markPendingDirRequestSent;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }


  transition(S, L1_GETS) {
    k_dataFromL2CacheToL1Requestor;
    amtc_l2RecomputeValidFromTokens;
    rm_updateRequestedMask;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }


  // Transitions from Owned

  transition(O, L2_Replacement, I) {
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(O, Transient_GETX, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(O, Transient_GETS) {
    // send multiple tokens
    r_clearExclusive;
    d_sendDataWithTokens;
    m_popRequestQueue;
  }

  transition(O, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(O, {Data_Shared, Data_Owner}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    u_writeDataToCache;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }


  transition(O, Writeback_Tokens) {
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(O, Writeback_Shared_Data) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    n_popResponseQueue;
  }

  // AMTC audit11: L2 can already be in O when a late L1 owned writeback
  // arrives for the same line.  This is not an invalid coherence event: the
  // writeback is returning dirty data/tokens from an evicted L1 owner.  Absorb
  // it into the existing O entry instead of treating O + Writeback_Owned as an
  // invalid transition.
  transition(O, Writeback_Owned, O) {
    w_assertIncomingDataAndCacheDataMatch;
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(O, L1_GETS) {
    z_resetAccumulationFlag;
    rm_updateRequestedMask;
    k_dataFromL2CacheToL1Requestor;
    amtc_l2RecomputeValidFromTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }


  transition(O, L1_GETX, O) {
    z_resetAccumulationFlag;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    // audit53: do not drop an O entry when the partial GETX was suppressed.
    // If tokens were actually donated, clear only the sectors that no longer
    // have tokens so stable O remains legal; if the action suppressed the
    // response, tokens/valid stay intact and future donor tokens can converge.
    amtc_l2RecomputeValidFromTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  // Transitions from M

  transition(M, L2_Replacement, I) {
    z_resetAccumulationFlag;
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  // MRM_DEBUG:  Give up all tokens even for GETS? ???
  transition(M, {Transient_GETX, Transient_GETS}, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  transition(M, L1_GETS, O) {
    z_resetAccumulationFlag;
    k_dataFromL2CacheToL1Requestor;
    amtc_l2RecomputeValidFromTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(M, L1_GETX, I) {
    z_resetAccumulationFlag;
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  //transition({S, O, SX, OX, MX}, L2_Accumulation_Done, M) {
  //  z_resetAccumulationFlag;
  //  rc_clearRequestedMask;
  //  t_popTriggerQueue;
  //}

  // Accumulation completed while already shared.
  // Stay shared. Do not promote to M.
  transition(S, L2_Accumulation_Done, S) {
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }

  // Accumulation completed while owned.
  // Stay owned. O may have dirty/owner data but not all tokens,
  // especially after donating one token to an L1 GETS requester.

  transition(O, L2_Accumulation_Done, O) {
    dbg_accDoneState;
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }

  // GETX/upgrade transient completed.
  // These are write-ownership collection paths, so M is valid here
  // only if the token collection actions really gathered all required tokens.
  transition(SX, L2_Accumulation_Done, M) {
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }

  transition(OX, L2_Accumulation_Done, M) {
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }

  transition(MX, L2_Accumulation_Done, M) {
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }



  // Late-arriving tokens after the first partial response are merged
  transition({SX, OX, MX}, Ack) {
    q_updateTokensFromResponse;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, {Data_Shared, Data_Owner}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    u_writeDataToCache;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, Writeback_Tokens) {
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, Writeback_Shared_Data) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, Writeback_Owned) {
    w_assertIncomingDataAndCacheDataMatch;
    qwb_updateTokensFromWritebackResponse;
    u_writeDataToCache;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  // -------------------------------------------------------------------------
  // TRANSIENT ACCUMULATION SHIELD
  // Ignore retries and new requests while we are busy accumulating.
  // The L1 caches will naturally time out and retry again later!
  // -------------------------------------------------------------------------

  transition({SX, OX, MX}, {L1_GETX, L1_GETS}) {
    o_popL1RequestQueue;
  }

  transition({SX, OX, MX}, {Transient_GETX, Transient_GETS}) {
    m_popRequestQueue;
  }

  // Audit84:
  // L1 shared replacement can return token-only WB_TOKENS while L2 is already
  // in stable M for the same line. This is not an invalid coherence event.
  // Absorb the returned tokens using the saturating writeback token path and
  // keep L2 in M.
  transition(M, Writeback_Tokens) {
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }
  transition(M, Writeback_Shared_Data) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    jwb_forwardWriteThroughToLocalSharers;
    n_popResponseQueue;
  }

  transition(M, Writeback_Owned) {
    u_writeDataToCache;
    qwb_updateTokensFromWritebackResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition({IS, IX, SX, OX, MX},
            L2_Replacement_Transient_Force,
            I) {
    forceDropTransientVictim;
  }

  transition({I, NP}, {Data_Shared, Data_Owner, Ack}) {
    n_popResponseQueue;
  }

  transition({I, NP}, Writeback_Owned) {
    n_popResponseQueue;
  }


}
