machine(MachineType:L2Cache, "Token protocol")
 : CacheMemory * L2cache;
   int N_tokens;
   Cycles l2_request_latency := 5;
   Cycles l2_response_latency := 5;
   bool filtering_enabled := "True";

   // L2 BANK QUEUES
   // From local bank of L2 cache TO the network

   // this L2 bank -> a local L1 || mod-directory
   MessageBuffer * responseFromL2Cache, network="To", virtual_network="4",
        vnet_type="response";
   // this L2 bank -> mod-directory
   MessageBuffer * GlobalRequestFromL2Cache, network="To", virtual_network="2",
        vnet_type="request";
   // this L2 bank -> a local L1
   MessageBuffer * L1RequestFromL2Cache, network="To", virtual_network="1",
        vnet_type="request";


   // FROM the network to this local bank of L2 cache

   // a local L1 || mod-directory -> this L2 bank
   MessageBuffer * responseToL2Cache, network="From", virtual_network="4",
        vnet_type="response";
   MessageBuffer * persistentToL2Cache, network="From", virtual_network="3",
        vnet_type="persistent";
   // mod-directory -> this L2 bank
   MessageBuffer * GlobalRequestToL2Cache, network="From", virtual_network="2",
        vnet_type="request";
   // a local L1 -> this L2 bank
   MessageBuffer * L1RequestToL2Cache, network="From", virtual_network="1",
        vnet_type="request";

{
  // STATES
  state_declaration(State, desc="L2 Cache states", default="L2Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, desc="Not Present";
    I, AccessPermission:Invalid, desc="Idle";
    S, AccessPermission:Read_Only, desc="Shared, not present in any local L1s";
    O, AccessPermission:Read_Only, desc="Owned, not present in any L1s";
    M, AccessPermission:Read_Write, desc="Modified, not present in any L1s";

    // Locked states
    I_L, AccessPermission:Busy, "I^L", desc="Invalid, Locked";
    S_L, AccessPermission:Busy, "S^L", desc="Shared, Locked";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {

    // Requests
    L1_GETS,             desc="local L1 GETS request";
    L1_GETS_Last_Token,    desc="local L1 GETS request";
    L1_GETX,             desc="local L1 GETX request";
    L1_INV,              desc="L1 no longer has tokens";
    Transient_GETX,      desc="A GetX from another processor";
    Transient_GETS,      desc="A GetS from another processor";
    Transient_GETS_Last_Token,   desc="A GetS from another processor";

    // events initiated by this L2
    L2_Replacement,     desc="L2 Replacement", format="!r";

    // events of external L2 responses

    // Responses
    Writeback_Tokens,               desc="Received a writeback from L1 with only tokens (no data)";
    Writeback_Shared_Data,               desc="Received a writeback from L1 that includes clean data";
    Writeback_All_Tokens,    desc="Received a writeback from L1";
    Writeback_Owned,                desc="Received a writeback from L1";


    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Data_All_Tokens,   desc="Received a data message, we are now the owner, we now have all the tokens";
    Ack,                     desc="Received an ack message";
    Ack_All_Tokens,          desc="Received an ack message, we now have all the tokens";

    // Lock/Unlock
    Persistent_GETX,     desc="Another processor has priority to read/write";
    Persistent_GETS,     desc="Another processor has priority to read";
    Persistent_GETS_Last_Token, desc="Another processor has priority to read";
    Own_Lock_or_Unlock,  desc="This processor now has priority";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    //int Tokens,              desc="The number of tokens we're holding for the line";
    int ValidSectors, default="0", desc="AMTC valid sectors in this L2 line";
    int DirtySectors, default="0", desc="AMTC dirty sectors in this L2 line";
    int TokenSectorMask, default="0", desc="AMTC sectors for which L2 token state is meaningful";
    int RequestedSectorMask, default="0", desc="AMTC last/merged requested sector mask seen by L2";
    DataBlock DataBlk,       desc="data for the block";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";
  }

  structure(DirEntry, desc="...", interface="AbstractCacheEntry", main="false") {
    Set Sharers,            desc="Set of the internal processors that want the block in shared state";
    bool exclusive, default="false", desc="if local exclusive is likely";
  }

  structure(PerfectCacheMemory, external="yes") {
    void allocate(Addr);
    void deallocate(Addr);
    DirEntry lookup(Addr);
    bool isTagPresent(Addr);
  }

  structure(PersistentTable, external="yes") {
    void persistentRequestLock(Addr, MachineID, AccessType);
    void persistentRequestUnlock(Addr, MachineID);
    MachineID findSmallest(Addr);
    AccessType typeOfSmallest(Addr);
    void markEntries(Addr);
    bool isLocked(Addr);
    int countStarvingForAddress(Addr);
    int countReadStarvingForAddress(Addr);
  }

  PersistentTable persistentTable;
  PerfectCacheMemory localDirectory, template="<L2Cache_DirEntry>";

  Tick clockEdge();
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  // -------------------------------------------------------------------------
  // AMTC compact sector helpers.
  // Physical Ruby coherence block remains 64B. Logical sharing is represented
  // as 2 x 32B sectors: sector 0 = bytes 0..31, sector 1 = bytes 32..63.
  // Full-line mask is 3. Old full-line mask values such as 15 are sanitized
  // to 3 so untrimmed controllers cannot accidentally re-enable 4 sectors.
  // -------------------------------------------------------------------------
  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  Entry getCacheEntry(Addr address), return_by_pointer="yes" {
    Entry cache_entry := static_cast(Entry, "pointer", L2cache.lookup(address));
    return cache_entry;
  }

  DirEntry getDirEntry(Addr address), return_by_pointer="yes" {
    return localDirectory.lookup(address);
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  int getTokens(Entry cache_entry, int sid) {
    if (is_valid(cache_entry)) {
      if (sid == 0) {
        return cache_entry.TokensSec0;
      }
      if (sid == 1) {
        return cache_entry.TokensSec1;
      }
    }
    return 0;
  }

  State getState(Entry cache_entry, Addr addr) {
    if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else if (persistentTable.isLocked(addr)) {
      return State:I_L;
    } else {
      return State:NP;
    }
  }

  void setState(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {

      // Basic sanity checks: No sector can have negative tokens
      assert(cache_entry.TokensSec0 >= 0);
      assert(cache_entry.TokensSec1 >= 0);

      // In AMTC, the whole line's max_tokens() is divided equally among sectors
      int tokens_per_sector := max_tokens() / 2;

      // =========================================================
      // NP & Locked States: Zero local token ownership allowed
      // =========================================================
      if (state == State:I_L || state == State:NP) {
        assert(cache_entry.TokensSec0 == 0);
        assert(cache_entry.TokensSec1 == 0);
      }

      // =========================================================
      // Modified State: Must hold ALL tokens for valid sectors
      // =========================================================
      if (state == State:M) {
        assert(cache_entry.ValidSectors != 0); // Must have at least one valid sector!

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 == tokens_per_sector);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 == tokens_per_sector);
        }
      }

      // =========================================================
      // Shared & Owned States: Must hold > 0 tokens for valid sectors
      // =========================================================
      if (state == State:S || state == State:O) {
        assert(cache_entry.ValidSectors != 0);

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L2Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L2Cache_State_to_permission(state));
    }
  }

  void removeSharer(Addr addr, NodeID id) {

    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.Sharers.remove(id);
      if (dir_entry.Sharers.count() == 0) {
        localDirectory.deallocate(addr);
      }
    }
  }

  bool sharersExist(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.Sharers.count() > 0) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  bool exclusiveExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.exclusive) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  // assumes that caller will check to make sure tag is present
  Set getSharers(Addr addr) {
    DirEntry dir_entry := getDirEntry(addr);
    return dir_entry.Sharers;
  }

  void setNewWriter(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.clear();
    dir_entry.Sharers.add(id);
    dir_entry.exclusive := true;
  }

  void addNewSharer(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.add(id);
    // dir_entry.exclusive := false;
  }

  void clearExclusiveBitIfExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.exclusive := false;
    }
  }

  // ** OUT_PORTS **
  out_port(globalRequestNetwork_out, RequestMsg, GlobalRequestFromL2Cache);
  out_port(localRequestNetwork_out, RequestMsg, L1RequestFromL2Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL2Cache);



  // ** IN_PORTS **

  // Persistent Network
  in_port(persistentNetwork_in, PersistentMsg, persistentToL2Cache) {
    if (persistentNetwork_in.isReady(clockEdge())) {
      peek(persistentNetwork_in, PersistentMsg) {
        assert(in_msg.Destination.isElement(machineID));

        if (in_msg.Type == PersistentRequestType:GETX_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Write);
        } else if (in_msg.Type == PersistentRequestType:GETS_PERSISTENT) {
          persistentTable.persistentRequestLock(in_msg.addr, in_msg.Requestor, AccessType:Read);
        } else if (in_msg.Type == PersistentRequestType:DEACTIVATE_PERSISTENT) {
          persistentTable.persistentRequestUnlock(in_msg.addr, in_msg.Requestor);
        } else {
          error("Unexpected message");
        }

        Entry cache_entry := getCacheEntry(in_msg.addr);
        // React to the message based on the current state of the table
        if (persistentTable.isLocked(in_msg.addr)) {

          if (persistentTable.typeOfSmallest(in_msg.addr) == AccessType:Read) {
            if (getTokens(cache_entry, amtc_fullMask()) == 1 ||
                getTokens(cache_entry, amtc_fullMask()) == (max_tokens() / 2) + 1) {
              trigger(Event:Persistent_GETS_Last_Token, in_msg.addr,
                      cache_entry);
            } else {
              trigger(Event:Persistent_GETS, in_msg.addr, cache_entry);
            }
          } else {
            trigger(Event:Persistent_GETX, in_msg.addr, cache_entry);
          }
        }
        else {
            trigger(Event:Own_Lock_or_Unlock, in_msg.addr, cache_entry);
        }
      }
    }
  }


  // Request Network
  in_port(requestNetwork_in, RequestMsg, GlobalRequestToL2Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        if (in_msg.Type == CoherenceRequestType:GETX) {
            trigger(Event:Transient_GETX, in_msg.addr, cache_entry);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          if (getTokens(cache_entry,amtc_fullMask()) == 1) {
            trigger(Event:Transient_GETS_Last_Token, in_msg.addr,
                    cache_entry);
          }
          else {
            trigger(Event:Transient_GETS, in_msg.addr, cache_entry);
          }
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  in_port(L1requestNetwork_in, RequestMsg, L1RequestToL2Cache) {
    if (L1requestNetwork_in.isReady(clockEdge())) {
      peek(L1requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);

        // ===================================================================
        // CRITICAL FIX: The Home Bank Filter
        // If an L1 is broadcasting for tokens, and we are empty (NP/I),
        // we ONLY fetch from the Directory if we are the Home L2 bank!
        // ===================================================================
        bool is_home_l2 := (mapAddressToMachine(in_msg.addr, MachineType:L2Cache) == machineID);
        State current_state := getState(cache_entry, in_msg.addr);

        if (!is_home_l2 && (current_state == State:NP || current_state == State:I)) {
            // We don't have the data, and we aren't the home bank. Drop the broadcast.
            L1requestNetwork_in.dequeue(clockEdge());
        } else {
            // We have the data, OR we are the home bank responsible for fetching it.
            if (in_msg.Type == CoherenceRequestType:GETX) {
              trigger(Event:L1_GETX, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceRequestType:GETS) {
              if (getTokens(cache_entry,amtc_fullMask()) == 1 ||
                  getTokens(cache_entry,amtc_fullMask()) == (max_tokens() / 2) + 1) {
                trigger(Event:L1_GETS_Last_Token, in_msg.addr, cache_entry);
              }
              else {
                trigger(Event:L1_GETS, in_msg.addr, cache_entry);
              }
            } else {
              error("Unexpected message");
            }
        }
      }
    }
  }


  // Response Network
    in_port(responseNetwork_in, ResponseMsg, responseToL2Cache) {
      if (responseNetwork_in.isReady(clockEdge())) {
        peek(responseNetwork_in, ResponseMsg) {
          assert(in_msg.Destination.isElement(machineID));
          Entry cache_entry := getCacheEntry(in_msg.addr);

          // =====================================================================
          // PHASE 2: L2 Sector Token Accounting
          // =====================================================================
          int future_t0 := in_msg.TokensSec0;
          int future_t1 := in_msg.TokensSec1;

          if (is_valid(cache_entry)) {
              future_t0 := future_t0 + cache_entry.TokensSec0;
              future_t1 := future_t1 + cache_entry.TokensSec1;
          }

          int required_per_sector := max_tokens() / 2;
          bool is_effectively_all_tokens := true;

          // We check if we have achieved "All Tokens" for the sectors
          // this specific writeback/response is targeting.
          int target_mask := in_msg.sector_mask;
          if (target_mask == 0) {
              target_mask := amtc_fullMask();
          }

          // Evaluate Sector 0
          if (amtc_maskHasSector(target_mask, 0)) {
              if (future_t0 < required_per_sector) {
                  is_effectively_all_tokens := false;
              }
          }
          // Evaluate Sector 1
          if (amtc_maskHasSector(target_mask, 1)) {
              if (future_t1 < required_per_sector) {
                  is_effectively_all_tokens := false;
              }
          }

          // =====================================================================
          // EVENT ROUTING
          // =====================================================================
          if (!is_effectively_all_tokens) {

            if (in_msg.Type == CoherenceResponseType:ACK) {
              trigger(Event:Ack, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
              trigger(Event:Data_Owner, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceResponseType:DATA_SHARED) {
              trigger(Event:Data_Shared, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceResponseType:WB_TOKENS ||
                       in_msg.Type == CoherenceResponseType:WB_OWNED ||
                       in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {

              if (L2cache.cacheAvail(in_msg.addr) || is_valid(cache_entry)) {
                // either room is available or the block is already present
                if (in_msg.Type == CoherenceResponseType:WB_TOKENS) {
                  assert(in_msg.Dirty == false);
                  trigger(Event:Writeback_Tokens, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {
                  assert(in_msg.Dirty == false);
                  trigger(Event:Writeback_Shared_Data, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_OWNED) {
                  trigger(Event:Writeback_Owned, in_msg.addr, cache_entry);
                }
              } else {
                  Addr victim := L2cache.cacheProbe(in_msg.addr);
                  trigger(Event:L2_Replacement, victim, getCacheEntry(victim));
              }

            } else if (in_msg.Type == CoherenceResponseType:INV) {
              trigger(Event:L1_INV, in_msg.addr, cache_entry);
            } else {
              error("Unexpected message");
            }

          } else {

            // WE HAVE ALL TOKENS FOR THE TARGET SECTORS
            if (in_msg.Type == CoherenceResponseType:ACK) {
              trigger(Event:Ack_All_Tokens, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER ||
                       in_msg.Type == CoherenceResponseType:DATA_SHARED) {
              trigger(Event:Data_All_Tokens, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceResponseType:WB_TOKENS ||
                       in_msg.Type == CoherenceResponseType:WB_OWNED ||
                       in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {

              if (L2cache.cacheAvail(in_msg.addr) || is_valid(cache_entry)) {
                // either room is available or the block is already present
                if (in_msg.Type == CoherenceResponseType:WB_TOKENS) {
                  assert(in_msg.Dirty == false);
                  assert( (getState(cache_entry, in_msg.addr) != State:NP) &&
                          (getState(cache_entry, in_msg.addr) != State:I) );
                  trigger(Event:Writeback_All_Tokens, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {
                  assert(in_msg.Dirty == false);
                  trigger(Event:Writeback_All_Tokens, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_OWNED) {
                  trigger(Event:Writeback_All_Tokens, in_msg.addr, cache_entry);
                }
              } else {
                  Addr victim := L2cache.cacheProbe(in_msg.addr);
                  trigger(Event:L2_Replacement, victim, getCacheEntry(victim));
              }

            } else if (in_msg.Type == CoherenceResponseType:INV) {
              trigger(Event:L1_INV, in_msg.addr, cache_entry);
            } else {
              DPRINTF(RubySlicc, "%s\n", in_msg.Type);
              error("Unexpected message");
            }
          }
        }
      }
    }


  // ACTIONS

  action(a_broadcastLocalRequest, "a", desc="broadcast local request globally") {

    peek(L1requestNetwork_in, RequestMsg) {

     // if this is a retry or no local sharers, broadcast normally
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := in_msg.addr;
           out_msg.Type := in_msg.Type;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;

           //
           // If a statically shared L2 cache, then no other L2 caches can
           // store the block
           //
           //out_msg.Destination.broadcast(MachineType:L2Cache);
           //out_msg.Destination.addNetDest(getAllPertinentL2Banks(address));
           //out_msg.Destination.remove(map_L1CacheMachId_to_L2Cache(address, in_msg.Requestor));


           out_msg.Destination.broadcast(MachineType:L2Cache);
           out_msg.Destination.remove(machineID);
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := in_msg.sector_id;
           out_msg.sector_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
           out_msg.requested_sector_mask := amtc_normalizeMask(in_msg.requested_sector_mask, in_msg.sector_id);
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           DPRINTF(RubySlicc, "AMTC_L2_FORWARD_MASK addr=%#x sid=%d mask=%d req_mask=%d\n",
                   address, out_msg.sector_id, out_msg.sector_mask, out_msg.requested_sector_mask);
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_owner_pull := in_msg.is_owner_pull;
        } //enqueue
      // } // if

         //profile_filter_action(0);
    } // peek
  } //action


  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
                out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.Dirty := in_msg.Dirty;
      }
    }
  }

  action(c_cleanReplacement, "c", desc="Issue clean writeback") {
    assert(is_valid(cache_entry));
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
                out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;

        // SECTOR AWARE: Pass the metadata up to the directory
        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) {
          wb_mask := amtc_fullMask();
        }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := 0; // Just an ACK, no valid data payload
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;

        // Maintain the tiny 8-byte control size
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
    }
  }

action(cc_dirtyReplacement, "\c", desc="Issue dirty writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
              out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;

      // SECTOR AWARE: Calculate the minimal required payload
      int wb_mask := cache_entry.ValidSectors;
      if (wb_mask == 0) {
        wb_mask := amtc_fullMask();
      }

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.valid_sector_mask := wb_mask;
      out_msg.token_sector_mask := wb_mask;
      out_msg.requested_sector_mask := wb_mask;

      if (cache_entry.Dirty) {
        // THE FIX: Use WB_OWNED instead of DATA_OWNER
        out_msg.Type := CoherenceResponseType:WB_OWNED;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
      } else {
        // THE FIX: Use WB_TOKENS instead of ACK_OWNER
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(d_sendDataWithTokens, "d", desc="Send data and a token from cache to requestor") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      // 1. Determine which sectors the requestor actually wants AND we hold
      int req_mask := in_msg.sector_mask;
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      // 2. Pre-calculate how many tokens to send for each sector
      int owner_limit := N_tokens + (max_tokens() / 2);
      int send_t0 := 0;
      int send_t1 := 0;

      if (amtc_maskHasSector(send_mask, 0)) {
        if (cache_entry.TokensSec0 > owner_limit) {
          send_t0 := N_tokens;
        } else {
          send_t0 := 1;
        }
      }

      if (amtc_maskHasSector(send_mask, 1)) {
        if (cache_entry.TokensSec1 > owner_limit) {
          send_t1 := N_tokens;
        } else {
          send_t1 := 1;
        }
      }

      // 3. Enqueue the tailored, sector-aware response
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        // PHASE 2: Attach the split tokens
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        // PHASE 1: Sector Aware Data Copy (Only send valid bytes)
        if (amtc_maskHasSector(send_mask, 0)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(send_mask, 1)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        // Metadata tracking
        out_msg.valid_sector_mask := send_mask;
        out_msg.token_sector_mask := send_mask;
        out_msg.Dirty := false;

        // PHASE 1: Dynamic Message Size! (Cuts bandwidth by 50% for half-line fetches)
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
      }

      // 4. Safely deduct the sent tokens from our cache entry
      cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;
    }
  }

  action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        assert(cache_entry.TokensSec0 >= 1);
        assert(cache_entry.TokensSec1 >= 1);
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.valid_sector_mask := cache_entry.ValidSectors;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(e_sendAckWithCollectedTokens, "e", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        // Attach the split tokens
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;

        // AMTC Metadata: Dynamically flag which sectors these tokens belong to
        int t_mask := 0;
        if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
        if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

        out_msg.token_sector_mask := t_mask;
        out_msg.valid_sector_mask := 0; // ACKs never carry data
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(ee_sendDataWithAllTokens, "\e", desc="Send data and all tokens from cache to starver") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA_OWNER;
      out_msg.Sender := machineID;
      out_msg.Destination.add(persistentTable.findSmallest(address));
      assert(cache_entry.TokensSec0 >= 1);
assert(cache_entry.TokensSec1 >= 1);
              out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

action(f_sendAckWithAllButOneTokens, "f", desc="Send ack with all our tokens but one to starver.") {
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;

    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
    }
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
    }

    if (send_t0 > 0 || send_t1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

action(ff_sendDataWithAllButOneTokens, "\f", desc="Send data and out tokens but one to starver") {
    // Make sure we never bounce tokens to ourself
    // assert(persistentTable.findSmallest(address) != id);
    assert(is_valid(cache_entry));

    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }

    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    // PHASE 2 ASSERT: We must be sending tokens for at least one sector!
    assert(send_t0 > 0 || send_t1 > 0);

    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));

        // Attach the split tokens
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        // PHASE 1: Sector Aware Data Copy (Only send physical bytes for the tokens we are forwarding)
        if (amtc_maskHasSector(send_mask, 0)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(send_mask, 1)) {
            out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        // Metadata Tracking
        out_msg.valid_sector_mask := send_mask;
        out_msg.token_sector_mask := send_mask;
        out_msg.Dirty := cache_entry.Dirty;

        // PHASE 1: Dynamic Message Size! (Cuts NoC bandwidth if only 1 sector is sent)
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
    }
  }

  action(fa_sendDataWithAllTokens, "fa", desc="Send data and out tokens but one to starver") {
    //assert(persistentTable.findSmallest(address) != id); // Make sure we never bounce tokens to ourself
    assert(is_valid(cache_entry));
      int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }

    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    // PHASE 2 ASSERT: We must be sending tokens for at least one sector!
    assert(send_t0 > 0 || send_t1 > 0);
    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
                out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }



  action(gg_bounceResponseToStarver, "\g", desc="Redirect response to starving processor") {
    // assert(persistentTable.isLocked(address));
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet in some cases
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(persistentTable.findSmallest(address));
