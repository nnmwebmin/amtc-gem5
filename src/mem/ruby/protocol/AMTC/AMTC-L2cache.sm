machine(MachineType:L2Cache, "Token protocol")
 : CacheMemory * L2cache;
   int N_tokens;
   Cycles l2_request_latency := 1;   // V32: restore low-latency CPU L2 proxy path
   Cycles l2_response_latency := 1;  // V32: reduce L2->L1 response hop overhead
   bool filtering_enabled := "True";

   // L2 BANK QUEUES
   // From local bank of L2 cache TO the network

   // this L2 bank -> a local L1 || mod-directory
   MessageBuffer * responseFromL2Cache, network="To", virtual_network="4",
        vnet_type="response";
   // this L2 bank -> mod-directory
   MessageBuffer * GlobalRequestFromL2Cache, network="To", virtual_network="2",
        vnet_type="request";
   // this L2 bank -> a local L1
   MessageBuffer * L1RequestFromL2Cache, network="To", virtual_network="1",
        vnet_type="request";

   // FROM the network to this local bank of L2 cache
   // a local L1 || mod-directory -> this L2 bank
   MessageBuffer * responseToL2Cache, network="From", virtual_network="4",
        vnet_type="response";
   // mod-directory -> this L2 bank
   MessageBuffer * GlobalRequestToL2Cache, network="From", virtual_network="2",
        vnet_type="request";
   // a local L1 -> this L2 bank
   MessageBuffer * L1RequestToL2Cache, network="From", virtual_network="1",
        vnet_type="request";

   // Internal loopback for accumulation triggers
   MessageBuffer * triggerQueue;

{
  // STATES
  state_declaration(State, desc="L2 Cache states", default="L2Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, desc="Not Present";
    I, AccessPermission:Invalid, desc="Idle";
    S, AccessPermission:Read_Only, desc="Shared, not present in any local L1s";
    O, AccessPermission:Read_Only, desc="Owned, not present in any L1s";
    M, AccessPermission:Read_Write, desc="Modified, not present in any L1s";

    // Audit90: L2 is now the CPU-side gateway (L1 -> L2 -> Directory).
    // Store the original L1 request metadata in the L2 entry while the
    // Directory response is pending.  Do not hold the L1 request queue head.
    IS, AccessPermission:Busy, desc="GETS forwarded to Directory; waiting for shared data";
    IX, AccessPermission:Busy, desc="GETX forwarded to Directory; waiting for ownership data";

    SX, AccessPermission:Busy, desc="Shared, waiting for L2 accumulation";
    OX, AccessPermission:Busy, desc="Owned, waiting for L2 accumulation";
    MX, AccessPermission:Busy, desc="Modified, waiting for L2 accumulation";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {

    // Requests
    L1_GETS,             desc="local L1 GETS request";
    L1_GETX,             desc="local L1 GETX request";
    L1_INV,              desc="L1 no longer has tokens";
    Transient_GETX,      desc="A GetX from another processor";
    Transient_GETS,      desc="A GetS from another processor";
    Dir_Owner_GETS,      desc="Directory owner-pull GETS to stale/transient L2 owner";
    L1_GETS_Force_Restart, desc="Force restart of long-stuck L2 GETS path without data/tokens";
    L1_GETS_Partial_Miss, desc="Stable L2 GETS cannot satisfy requested sector; convert to tracked miss";
    L1_GETX_Force_Local_Grant, desc="Force local owner grant for long-stuck L2 IX GETX miss";
    L1_GETX_Force_Local_Grant_TriggerQ, desc="Force local owner grant from trigger queue without popping L1 queue";
    L1_GETX_Force_Dir_Restart, desc="Force fresh Directory GETX replay for empty IX without held tokens";
    L1_GETX_Force_Dir_Bcast_Retry, desc="Broadcast owner-pull Directory GETX retry for empty IX without held tokens";

    // events initiated by this L2
    L2_Replacement,     desc="L2 Replacement", format="!r";

    // Responses
    Writeback_Tokens,               desc="Received a writeback from L1 with only tokens (no data)";
    Writeback_Shared_Data,               desc="Received a writeback from L1 that includes clean data";
    Writeback_Owned,                desc="Received a writeback from L1";

    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Ack,                     desc="Received an ack message";

    // Internal Triggers:
    L2_Accumulation_Done, desc="L2 now has all required tokens/sectors";
    L2_Gets_Accumulation_Done, desc="L2 has enough shared data/tokens to satisfy pending GETS";
    L2_Gets_Local_Escape_Drop, desc="Local GETS escape completed L1; drop poisoned IX entry";

    L2_Replacement_Transient_Force, desc="Force replacement of long-stuck transient L2 victim";

    L1_NoWay_Transient_Drop, desc="Drop/recycle L1 request when selected L2 replacement victim is transient";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    int ValidSectors, default="0", desc="AMTC valid sectors in this L2 line";
    int DirtySectors, default="0", desc="AMTC dirty sectors in this L2 line";
    int TokenSectorMask, default="0", desc="AMTC sectors for which L2 token state is meaningful";
    int RequestedSectorMask, default="0", desc="AMTC last/merged requested sector mask seen by L2";
    DataBlock DataBlk,       desc="data for the block";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";

    bool AccumulationPending, default="false";

    // Audit90: saved local L1 request for an outstanding L2 -> Directory miss.
    // The L1 request queue is popped after forwarding to Directory, so response
    // completion must not peek L1requestNetwork_in.
    bool PendingL1Valid, default="false", desc="L2 has saved a pending local L1 miss";
    MachineID PendingL1Requestor, desc="Saved L1 requester for pending miss";
    int PendingReqMask, default="0", desc="Saved requested sector mask for pending miss";
    int PendingSectorId, default="0", desc="Saved sector id for pending miss";
    bool PendingIsGetX, default="false", desc="Saved request was GETX";
    int PendingRequesterHeldTokensSec0, default="0", desc="GETX requester-held token credit for sector 0";
    int PendingRequesterHeldTokensSec1, default="0", desc="GETX requester-held token credit for sector 1";
    bool PendingRetrySent, default="false", desc="One recovery retry was already forwarded to Directory while L2 pending";
    int PendingRetryNumSent, default="0", desc="Highest L1 RetryNum for which L2 forwarded pending recovery";

    // AMTC closure: one extra local GETS waiter while a read miss is pending.
    // This covers the observed case where L1Cache-0 is the original pending
    // requester and L1Cache-3 later asks for the same line while L2 is in IS.
    bool PendingL1SecondValid, default="false", desc="Second local L1 GETS waiter while L2 miss is pending";
    MachineID PendingL1SecondRequestor, desc="Second saved L1 requester";
    int PendingL1SecondReqMask, default="0", desc="Second saved requested sector mask";
    int PendingL1SecondSectorId, default="0", desc="Second saved sector id";
    bool PendingL1SecondRetrySent, default="false", desc="One recovery retry was forwarded for second GETS waiter";
    int PendingL1SecondRetryNumSent, default="0", desc="Highest RetryNum forwarded for second GETS waiter";

    // AMTC closure: additional local GETS waiters while a read miss is pending.
    // With 4 CPU L1s, explicit third/fourth slots avoid forwarding waiter
    // retries to Directory forever.
    bool PendingL1ThirdValid, default="false", desc="Third local L1 GETS waiter while L2 miss is pending";
    MachineID PendingL1ThirdRequestor, desc="Third saved L1 requester";
    int PendingL1ThirdReqMask, default="0", desc="Third saved requested sector mask";
    int PendingL1ThirdSectorId, default="0", desc="Third saved sector id";
    bool PendingL1ThirdRetrySent, default="false", desc="One recovery retry was forwarded for third GETS waiter";
    int PendingL1ThirdRetryNumSent, default="0", desc="Highest RetryNum forwarded for third GETS waiter";

    bool PendingL1FourthValid, default="false", desc="Fourth local L1 GETS waiter while L2 miss is pending";
    MachineID PendingL1FourthRequestor, desc="Fourth saved L1 requester";
    int PendingL1FourthReqMask, default="0", desc="Fourth saved requested sector mask";
    int PendingL1FourthSectorId, default="0", desc="Fourth saved sector id";
    bool PendingL1FourthRetrySent, default="false", desc="One recovery retry was forwarded for fourth GETS waiter";
    int PendingL1FourthRetryNumSent, default="0", desc="Highest RetryNum forwarded for fourth GETS waiter";
  }

  structure(DirEntry, desc="...", interface="AbstractCacheEntry", main="false") {
    Set Sharers,            desc="Set of the internal processors that want the block in shared state";
    bool exclusive, default="false", desc="if local exclusive is likely";
  }

  structure(PerfectCacheMemory, external="yes") {
    void allocate(Addr);
    void deallocate(Addr);
    DirEntry lookup(Addr);
    bool isTagPresent(Addr);
  }

  structure(TriggerMsg, interface="Message") {
    Addr addr,             desc="Address for this trigger";
    Event Type,            desc="Type of event to trigger";

    // Required functional boilerplate for SLICC
    bool functionalWrite(Packet *pkt) {
        return false;
    }
    bool functionalRead(Packet *pkt) {
        return false;
    }
  }

  PerfectCacheMemory localDirectory, template="<L2Cache_DirEntry>";

  Tick clockEdge();
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  // -------------------------------------------------------------------------
  // AMTC compact sector helpers.
  // Physical Ruby coherence block remains 64B. Logical sharing is represented
  // as 2 x 32B sectors: sector 0 = bytes 0..31, sector 1 = bytes 32..63.
  // Full-line mask is 3. Old full-line mask values such as 15 are sanitized
  // to 3 so untrimmed controllers cannot accidentally re-enable 4 sectors.
  // -------------------------------------------------------------------------
  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }


  bool amtc_l2CanSatisfyGETS(Entry cache_entry, int req_mask) {
    int clean := amtc_sanitizeMask(req_mask);
    if (clean == 0) {
      clean := amtc_fullMask();
    }

    bool valid_complete := amtc_maskContainsAll(cache_entry.ValidSectors, clean);

    bool owner_data0 := (!amtc_maskHasSector(clean, 0)) ||
                        (cache_entry.TokensSec0 == (max_tokens() / 2));
    bool owner_data1 := (!amtc_maskHasSector(clean, 1)) ||
                        (cache_entry.TokensSec1 == (max_tokens() / 2));
    bool owner_data_complete := owner_data0 && owner_data1;

    bool token0_ready := (!amtc_maskHasSector(clean, 0)) ||
                         (cache_entry.TokensSec0 > 0);
    bool token1_ready := (!amtc_maskHasSector(clean, 1)) ||
                         (cache_entry.TokensSec1 > 0);

    return (valid_complete || owner_data_complete) && token0_ready && token1_ready;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  Entry getCacheEntry(Addr address), return_by_pointer="yes" {
    Entry cache_entry := static_cast(Entry, "pointer", L2cache.lookup(address));
    return cache_entry;
  }

  DirEntry getDirEntry(Addr address), return_by_pointer="yes" {
    return localDirectory.lookup(address);
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  int getTokensForMask(Entry cache_entry, int mask) {
    int total := 0;

    if (is_valid(cache_entry)) {

        if (amtc_maskHasSector(mask, 0)) {
            total := total + cache_entry.TokensSec0;
        }

        if (amtc_maskHasSector(mask, 1)) {
            total := total + cache_entry.TokensSec1;
        }
    }

    return total;
}

  bool amtc_l2StateIsTransient(State s) {
    if (s == State:IS) {
      return true;
    } else if (s == State:IX) {
      return true;
    } else if (s == State:SX) {
      return true;
    } else if (s == State:OX) {
      return true;
    } else if (s == State:MX) {
      return true;
    }

    return false;
  }

  State getState(Entry cache_entry, Addr addr) {
    if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else {
      return State:NP;
    }
  }

  void setState(Entry cache_entry, Addr addr, State state) {
  if (is_valid(cache_entry)) {

    // --- AMTC FIX: Dynamic Invalidation ---
    // If a transition attempts to keep us in a stable state (M, O, S)
    // but we've given away all our tokens (ValidSectors == 0),
    // force the state to NP (Not Present/Invalid).
    State intermediate_state := state;
    if ((state == State:M || state == State:O || state == State:S) &&
        (cache_entry.ValidSectors == 0)) {
        intermediate_state := State:NP;
    }

    // Basic sanity checks: No sector can have negative tokens
    assert(cache_entry.TokensSec0 >= 0);
    assert(cache_entry.TokensSec1 >= 0);

    // Ensure no transition sets state==I during a GETX upgrade path.
    if (cache_entry.CacheState == State:IS ||
        cache_entry.CacheState == State:IX ||
        cache_entry.CacheState == State:SX ||
        cache_entry.CacheState == State:OX ||
        cache_entry.CacheState == State:MX) {
      assert(intermediate_state != State:I);
    }

    int tokens_per_sector := max_tokens() / 2;

    // NP & Locked States: Zero local token ownership allowed
    if (intermediate_state == State:NP) {
      assert(cache_entry.TokensSec0 == 0);
      assert(cache_entry.TokensSec1 == 0);
    }

    // Modified State
    if (intermediate_state == State:M) {
      assert(cache_entry.ValidSectors != 0);
      if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
        assert(cache_entry.TokensSec0 == tokens_per_sector);
      }
      if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
        assert(cache_entry.TokensSec1 == tokens_per_sector);
      }
    }

    // Shared & Owned States
    if (intermediate_state == State:S || intermediate_state == State:O) {
      assert(cache_entry.ValidSectors != 0); // Line 393 is now safe!

      if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
        assert(cache_entry.TokensSec0 > 0);
      }
      if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
        assert(cache_entry.TokensSec1 > 0);
      }
    }

    // Finally, commit the (potentially modified) state
    cache_entry.CacheState := intermediate_state;
  }
}

  AccessPermission getAccessPermission(Addr addr) {
    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L2Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L2Cache_State_to_permission(state));
    }
  }

  void removeSharer(Addr addr, NodeID id) {

    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.Sharers.remove(id);
      if (dir_entry.Sharers.count() == 0) {
        localDirectory.deallocate(addr);
      }
    }
  }

  bool sharersExist(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.Sharers.count() > 0) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  bool exclusiveExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.exclusive) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  // assumes that caller will check to make sure tag is present
  Set getSharers(Addr addr) {
    DirEntry dir_entry := getDirEntry(addr);
    return dir_entry.Sharers;
  }

  void setNewWriter(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.clear();
    dir_entry.Sharers.add(id);
    dir_entry.exclusive := true;
  }

  void addNewSharer(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.add(id);
    // dir_entry.exclusive := false;
  }

  void clearExclusiveBitIfExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.exclusive := false;
    }
  }

  bool amtc_L2_hasAllTokens(Entry cache_entry) {
    int tokens_per_sector := max_tokens() / 2;
    if (amtc_maskHasSector(cache_entry.ValidSectors, 0) && cache_entry.TokensSec0 < tokens_per_sector) {
        return false;
    }
    if (amtc_maskHasSector(cache_entry.ValidSectors, 1) && cache_entry.TokensSec1 < tokens_per_sector) {
        return false;
    }
    return true;
  }

  void amtc_assertTokenBounds(int tokens) {
    assert(tokens >= 0);
    assert(tokens <= (max_tokens() / 2));
  }

  // ** OUT_PORTS **
  out_port(globalRequestNetwork_out, RequestMsg, GlobalRequestFromL2Cache);
  out_port(localRequestNetwork_out, RequestMsg, L1RequestFromL2Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL2Cache);
  out_port(triggerQueue_out, TriggerMsg, triggerQueue);



  // ** IN_PORTS **
  // Request Network
  in_port(requestNetwork_in, RequestMsg, GlobalRequestToL2Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        if (in_msg.Type == CoherenceRequestType:GETX) {
            trigger(Event:Transient_GETX, in_msg.addr, cache_entry);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
            trigger(Event:Transient_GETS, in_msg.addr, cache_entry);
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  in_port(L1requestNetwork_in, RequestMsg, L1RequestToL2Cache) {
    if (L1requestNetwork_in.isReady(clockEdge())) {
      peek(L1requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);

        if (is_valid(cache_entry)) {
          if (in_msg.Type == CoherenceRequestType:GETS) {
            if (in_msg.is_owner_pull &&
                machineIDToMachineType(in_msg.Requestor) == MachineType:Directory) {
              trigger(Event:Dir_Owner_GETS, in_msg.addr, cache_entry);
            } else if (cache_entry.CacheState == State:S) {
              int req_mask := in_msg.requested_sector_mask;
              if (req_mask == 0) {
                req_mask := in_msg.sector_mask;
              }
              if (req_mask == 0) {
                req_mask := amtc_fullMask();
              }
              req_mask := amtc_sanitizeMask(req_mask);

              if (amtc_l2CanSatisfyGETS(cache_entry, req_mask)) {
                trigger(Event:L1_GETS, in_msg.addr, cache_entry);
              } else {
                DPRINTF(RubySlicc,
                        "AMTC_L2_STABLE_S_PARTIAL_GETS_MISS_V21 addr=%#x req=%s retry=%d reqmask=%d valid=%d T0=%d T1=%d\n",
                        in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                        req_mask, cache_entry.ValidSectors,
                        cache_entry.TokensSec0, cache_entry.TokensSec1);
                trigger(Event:L1_GETS_Partial_Miss, in_msg.addr, cache_entry);
              }
            } else if (cache_entry.CacheState == State:IS &&
                      cache_entry.PendingL1Valid &&
                      in_msg.RetryNum >= 1) {
              DPRINTF(RubySlicc,
                      "AMTC_L2_IS_GETS_FORCE_LOCAL_FILL_TRIGGER_V22 addr=%#x req=%s retry=%d valid=%d T0=%d T1=%d pending=%d sent=%d reqmask=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1, cache_entry.PendingL1Valid,
                      cache_entry.PendingRetrySent, cache_entry.PendingReqMask);
              trigger(Event:L1_GETS_Force_Restart, in_msg.addr, cache_entry);
            } else if (cache_entry.CacheState == State:IX &&
                       in_msg.RetryNum >= 64 &&
                       cache_entry.PendingL1Valid &&
                       !cache_entry.PendingIsGetX &&
                       machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                       cache_entry.ValidSectors == 0 &&
                       cache_entry.TokensSec0 == 0 &&
                       cache_entry.TokensSec1 == 0) {
              /* V40: clear an empty IX pending-GETS window even when the
               * saved requester is a real L1.  v37-v39 kept reissuing repair
               * GETS forever for 0x12adb80 with:
               *   pending=L1Cache-2 reqmask=1 valid=0 T0=0 T1=0
               * The Directory repair path was either not observed by this L2
               * or did not return before the next retry.  The safest recovery
               * is to drop the empty IX transient and replay the same L1 GETS
               * from NP/I as a fresh miss, instead of retaining a poisoned
               * pending window indefinitely.
               */
              DPRINTF(RubySlicc,
                      "AMTC_L2_IX_L1_GETS_EMPTY_FORCE_RESTART_V40 addr=%#x req=%s retry=%d pending_req=%s reqmask=%d valid=%d T0=%d T1=%d acc=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.PendingL1Requestor,
                      cache_entry.PendingReqMask,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1, cache_entry.AccumulationPending);
              trigger(Event:L1_GETS_Force_Restart, in_msg.addr, cache_entry);
            } else if (cache_entry.CacheState == State:IX &&
                       in_msg.RetryNum >= 64 &&
                       cache_entry.PendingL1Valid &&
                       machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:Directory &&
                       cache_entry.ValidSectors == 0 &&
                       cache_entry.TokensSec0 <= 1 &&
                       cache_entry.TokensSec1 <= 1) {
              DPRINTF(RubySlicc,
                      "AMTC_L2_IX_DIR_STALE_PENDING_CLEAR_TRIGGER_V15 addr=%#x req=%s retry=%d pending_req=%s reqmask=%d valid=%d T0=%d T1=%d acc=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.PendingL1Requestor,
                      cache_entry.PendingReqMask,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1, cache_entry.AccumulationPending);
              trigger(Event:L1_GETS_Force_Restart, in_msg.addr, cache_entry);
            } else {
              trigger(Event:L1_GETS, in_msg.addr, cache_entry);
            }
          } else if (in_msg.Type == CoherenceRequestType:GETX) {
            if (cache_entry.CacheState == State:IX &&
                in_msg.RetryNum >= 8 &&
                cache_entry.PendingL1Valid &&
                cache_entry.PendingIsGetX &&
                cache_entry.PendingRetrySent &&
                machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                cache_entry.ValidSectors == 0 &&
                cache_entry.TokensSec0 == 0 &&
                cache_entry.TokensSec1 == 0 &&
                ((cache_entry.PendingReqMask == 1 &&
                  cache_entry.PendingRequesterHeldTokensSec0 > 0) ||
                 (cache_entry.PendingReqMask == 2 &&
                  cache_entry.PendingRequesterHeldTokensSec1 > 0) ||
                 (cache_entry.PendingReqMask == 3 &&
                  cache_entry.PendingRequesterHeldTokensSec0 > 0 &&
                  cache_entry.PendingRequesterHeldTokensSec1 > 0))) {
              /* V47: v46 was useful but too broad: it fired even when
               * PendingRequesterHeldTokensSec0/1 were both zero.  Only use
               * this synthetic owner-grant escape when the saved L1 GETX
               * actually holds the requested sector token(s).
               *
               * v45 moved the run past the stale GETS poison, but the
               * rep=1 AQL fetch then spends long periods in an IX GETX retry
               * window such as:
               *   type=Write retry=18..64 valid=0 T0=0 T1=0 held0=1 held1=1
               * The older bring-up force grant only fired at retry 64, so each
               * such store burned 64 guarded-resend cycles before making
               * progress.  Fire the same existing local owner-grant escape much
               * earlier, only for the narrow empty-IX pending-L1-GETX signature
               * with held tokens covering PendingReqMask.
               */
              DPRINTF(RubySlicc,
                      "AMTC_L2_IX_GETX_FORCE_LOCAL_GRANT_TRIGGER_V47 addr=%#x req=%s retry=%d valid=%d T0=%d T1=%d held0=%d held1=%d pending=%d sent=%d reqmask=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1,
                      cache_entry.PendingRequesterHeldTokensSec0,
                      cache_entry.PendingRequesterHeldTokensSec1,
                      cache_entry.PendingL1Valid,
                      cache_entry.PendingRetrySent, cache_entry.PendingReqMask);
              trigger(Event:L1_GETX_Force_Local_Grant, in_msg.addr, cache_entry);
            } else if (cache_entry.CacheState == State:IX &&
                       in_msg.RetryNum >= 512 &&
                       cache_entry.PendingL1Valid &&
                       cache_entry.PendingIsGetX &&
                       cache_entry.PendingRetrySent &&
                       machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                       cache_entry.ValidSectors == 0 &&
                       cache_entry.TokensSec0 <= 1 &&
                       cache_entry.TokensSec1 <= 1 &&
                       cache_entry.PendingRequesterHeldTokensSec0 == 0 &&
                       cache_entry.PendingRequesterHeldTokensSec1 == 0) {
              /* V51 diagnostic escape: v50 proved the forced L2->L1 owner-data path
               * can move the earlier zero-token stuck line.  The next stuck
               * line (0x1081400) has the same pending GETX shape but carries
               * residual one-token crumbs in L2 (T0=1/T1=1), so the exact
               * zero-token v50 guard intentionally does not fire.  Treat
               * <=1 token/sector as poisoned residual metadata for this
               * bring-up diagnostic and force the same late local owner grant.
               * This is not the final coherence rule; it is to verify forward
               * progress past residual-token IX GETX poison.
               */
              DPRINTF(RubySlicc,
                      "AMTC_L2_IX_RESIDUAL_GETX_EMERG_LOCAL_GRANT_V51 addr=%#x req=%s retry=%d valid=%d T0=%d T1=%d held0=%d held1=%d pending=%d sent=%d reqmask=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1,
                      cache_entry.PendingRequesterHeldTokensSec0,
                      cache_entry.PendingRequesterHeldTokensSec1,
                      cache_entry.PendingL1Valid,
                      cache_entry.PendingRetrySent, cache_entry.PendingReqMask);
              trigger(Event:L1_GETX_Force_Local_Grant, in_msg.addr, cache_entry);
            } else if (cache_entry.CacheState == State:IX &&
                       in_msg.RetryNum >= 8 &&
                       cache_entry.PendingL1Valid &&
                       cache_entry.PendingIsGetX &&
                       cache_entry.PendingRetrySent &&
                       machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
                       cache_entry.ValidSectors == 0 &&
                       cache_entry.TokensSec0 == 0 &&
                       cache_entry.TokensSec1 == 0 &&
                       cache_entry.PendingRequesterHeldTokensSec0 == 0 &&
                       cache_entry.PendingRequesterHeldTokensSec1 == 0) {
              /* V49: V48 proved that clearing/restarting IX simply re-enters the
               * same exact-home Directory send path, but Directory still never
               * logs REQ_RAW_IN for the failing occurrence.  Do not clear the
               * pending L1 state.  Instead keep IX/pending intact and send an
               * explicit owner-pull GETX repair as a Directory broadcast.  This
               * is a safe forward-progress probe because it does not fabricate
               * tokens; it only asks the true home/any reachable Directory to
               * repair the empty pending GETX through memory/owner state.
               */
              DPRINTF(RubySlicc,
                      "AMTC_L2_IX_EMPTY_GETX_DIR_BCAST_TRIGGER_V49 addr=%#x req=%s retry=%d valid=%d T0=%d T1=%d held0=%d held1=%d pending=%d sent=%d reqmask=%d\n",
                      in_msg.addr, in_msg.Requestor, in_msg.RetryNum,
                      cache_entry.ValidSectors, cache_entry.TokensSec0,
                      cache_entry.TokensSec1,
                      cache_entry.PendingRequesterHeldTokensSec0,
                      cache_entry.PendingRequesterHeldTokensSec1,
                      cache_entry.PendingL1Valid,
                      cache_entry.PendingRetrySent, cache_entry.PendingReqMask);
              trigger(Event:L1_GETX_Force_Dir_Bcast_Retry, in_msg.addr, cache_entry);
            } else {
              trigger(Event:L1_GETX, in_msg.addr, cache_entry);
            }
          } else {
            error("Unexpected message");
          }

        } else if (L2cache.cacheAvail(in_msg.addr)) {
          if (in_msg.Type == CoherenceRequestType:GETS) {
            if (in_msg.is_owner_pull &&
                machineIDToMachineType(in_msg.Requestor) == MachineType:Directory) {
              trigger(Event:Dir_Owner_GETS, in_msg.addr, cache_entry);
            } else {
              trigger(Event:L1_GETS, in_msg.addr, cache_entry);
            }
          } else if (in_msg.Type == CoherenceRequestType:GETX) {
            trigger(Event:L1_GETX, in_msg.addr, cache_entry);
          } else {
            error("Unexpected message");
          }

        } else {
          Addr victim := L2cache.cacheProbe(in_msg.addr);
          Entry victim_entry := getCacheEntry(victim);

          if (amtc_l2StateIsTransient(victim_entry.CacheState)) {
            DPRINTF(RubySlicc,
                    "AMTC_L2_REPL_VICTIM_TRANSIENT_FORCE_NOW reqaddr=%#x victim=%#x vstate=%s type=%s retry=%d\n",
                    in_msg.addr,
                    victim,
                    victim_entry.CacheState,
                    in_msg.Type,
                    in_msg.RetryNum);

            /*
             * Closure policy:
             * If the set is full and cacheProbe selects a transient victim,
             * do not wait behind the transient forever.  Force-drop the victim
             * and leave the current L1 request queued so the next arbitration
             * can allocate this request when cacheAvail() becomes true.
             */
            trigger(Event:L2_Replacement_Transient_Force,
                    victim,
                    getCacheEntry(victim));
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_NEED_REPLACEMENT reqaddr=%#x victim=%#x type=%s\n",
                    in_msg.addr,
                    victim,
                    in_msg.Type);

            trigger(Event:L2_Replacement, victim, getCacheEntry(victim));
          }
        }
      }
    }
  }

  // Response Network
    in_port(responseNetwork_in, ResponseMsg, responseToL2Cache) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg) {
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);

        // PURE TYPE-BASED TRIGGERING: No token counting here!
        if (in_msg.Type == CoherenceResponseType:ACK ||
            in_msg.Type == CoherenceResponseType:ACK_OWNER) {
            trigger(Event:Ack, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
            trigger(Event:Data_Owner, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:DATA_SHARED) {
            trigger(Event:Data_Shared, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:WB_TOKENS ||
                   in_msg.Type == CoherenceResponseType:WB_OWNED ||
                   in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {

            if (L2cache.cacheAvail(in_msg.addr) || is_valid(cache_entry)) {
                if (in_msg.Type == CoherenceResponseType:WB_TOKENS) {
                    trigger(Event:Writeback_Tokens, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {
                    trigger(Event:Writeback_Shared_Data, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_OWNED) {
                    trigger(Event:Writeback_Owned, in_msg.addr, cache_entry);
                }
            } else {
                Addr victim := L2cache.cacheProbe(in_msg.addr);
                Entry victim_entry := getCacheEntry(victim);

                if (amtc_l2StateIsTransient(victim_entry.CacheState)) {
                    DPRINTF(RubySlicc,
                            "AMTC_L2_WB_REPL_TRANSIENT_FORCE_NOW wbaddr=%#x victim=%#x vstate=%s type=%s\n",
                            in_msg.addr,
                            victim,
                            victim_entry.CacheState,
                            in_msg.Type);

                    trigger(Event:L2_Replacement_Transient_Force,
                            victim,
                            getCacheEntry(victim));
                } else {
                    DPRINTF(RubySlicc,
                            "AMTC_L2_WB_NEED_REPLACEMENT wbaddr=%#x victim=%#x type=%s\n",
                            in_msg.addr,
                            victim,
                            in_msg.Type);

                    trigger(Event:L2_Replacement, victim, getCacheEntry(victim));
                }
            }

        } else if (in_msg.Type == CoherenceResponseType:INV) {
            trigger(Event:L1_INV, in_msg.addr, cache_entry);

        } else {
            error("Unexpected message");
        }
      }
    }
  }

  in_port(triggerQueue_in, TriggerMsg, triggerQueue) {
    if (triggerQueue_in.isReady(clockEdge())) {
      peek(triggerQueue_in, TriggerMsg) {
        // Trigger the internal event (e.g., L2_Accumulation_Done)
        trigger(in_msg.Type, in_msg.addr, getCacheEntry(in_msg.addr));
      }
    }
  }


  // ACTIONS

  action(a_broadcastLocalRequest, "a",
       desc="Send request only to directory") {

    peek(L1requestNetwork_in, RequestMsg) {

        int out_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                           in_msg.sector_id);
        if (out_mask == 0) {
          out_mask := amtc_normalizeMask(in_msg.sector_mask,
                                         in_msg.sector_id);
        }
        if (out_mask == 0) {
          out_mask := amtc_fullMask();
        }
        if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
          out_mask := amtc_fullMask();
        }
        int out_sid := in_msg.sector_id;
        if (out_mask == amtc_fullMask()) {
          out_sid := 0;
        }

        enqueue(globalRequestNetwork_out,
                RequestMsg,
                l2_request_latency) {

           out_msg.addr := in_msg.addr;
           out_msg.Type := in_msg.Type;
           /*
            * Audit88: L2 is the proxy for an L1 miss while it is entering
            * IS/IX and has recorded PendingL1Requestor.  The directory must
            * reply to this L2, not directly to the original L1, otherwise the
            * L2 can remain in IS forever while the L1 keeps timing out.  The
            * observed failure was addr=0xc801c0:
            *   L2 I -> IS emits AMTC_L2_DIR_ONLY
            *   no Data_Shared returns to L2
            *   IS + L1_GETS retries only print FORWARD_PRIMARY_REPAIR
            *   L1Cache-2 stays IS_WAIT_ALL until Sequencer deadlock.
            */
           out_msg.Requestor := machineID;
           out_msg.RetryNum := in_msg.RetryNum;

           // =====================================================
           // TEMP FIX:
           // Disable recursive L2 broadcasts
           // =====================================================

           /*
            * Audit92: During GPU bring-up one L2 IS miss showed
            * AMTC_L2_DIR_ONLY_PROXY_V9 but no matching AMTC_DIR_REQ_RAW_IN
            * at the directory for addr=0x10f26c0.  For the bring-up build,
            * broadcast proxy directory requests to all Directory controllers
            * instead of relying on a possibly stale/hashed MachineID.  On a
            * single-directory system this is equivalent; on multi-directory
            * systems this should later be tightened back to exact mapping.
            */
           /*
            * V30 CPU performance path:
            * CPU L1 misses have a deterministic home directory and should not
            * use the GPU bring-up broadcast path.  Keep broadcast only for
            * GPU/sync/bypass/atomic/signal traffic where the safer broad route
            * is still useful for TCP/TCC/SQC bring-up.
            */
           if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache &&
               in_msg.is_gpu == false &&
               in_msg.is_sync == false &&
               in_msg.is_bypass == false &&
               in_msg.is_atomic == false &&
               in_msg.is_signal == false) {
             out_msg.Destination.add(mapAddressToMachine(address,
                                                         MachineType:Directory));
             DPRINTF(RubySlicc,
                     "AMTC_L2_DIR_PROXY_HOME_V30 addr=%#x orig=%s proxy=%s type=%s retry=%d ownerpull=%d mask=%d\n",
                     address, in_msg.Requestor, machineID, out_msg.Type,
                     out_msg.RetryNum, out_msg.is_owner_pull, out_mask);
           } else {
             out_msg.Destination.broadcast(MachineType:Directory);
             DPRINTF(RubySlicc,
                     "AMTC_L2_DIR_PROXY_BCAST_V10 addr=%#x orig=%s proxy=%s type=%s retry=%d ownerpull=%d mask=%d\n",
                     address, in_msg.Requestor, machineID, out_msg.Type,
                     out_msg.RetryNum, out_msg.is_owner_pull, out_mask);
           }

           out_msg.sector_id := out_sid;

           out_msg.sector_mask := out_mask;

           out_msg.requested_sector_mask := out_mask;

           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;

           out_msg.MessageSize :=
               MessageSizeType:Request_Control;

           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;

           // Never propagate stale owner pulls
           out_msg.is_owner_pull := in_msg.is_owner_pull;

           DPRINTF(RubySlicc,
                   "AMTC_L2_DIR_ONLY addr=%#x mask=%d\n",
                   address,
                   out_msg.sector_mask);
           DPRINTF(RubySlicc,
                   "AMTC_L2_DIR_ONLY_PROXY_V9 addr=%#x orig=%s proxy=%s retry=%d ownerpull=%d mask=%d\n",
                   address,
                   in_msg.Requestor,
                   machineID,
                   out_msg.RetryNum,
                   out_msg.is_owner_pull,
                   out_msg.sector_mask);
        }
    }
}


  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.TokensSec0 := in_msg.TokensSec0;
        out_msg.TokensSec1 := in_msg.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.sector_id := in_msg.sector_id;
        out_msg.sector_mask := in_msg.sector_mask;
        out_msg.token_sector_mask := in_msg.token_sector_mask;
        out_msg.requested_sector_mask := in_msg.requested_sector_mask;
        out_msg.Dirty := in_msg.Dirty;
      }
    }
  }

  action(c_cleanReplacement, "c", desc="Issue clean writeback") {
    assert(is_valid(cache_entry));
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
                out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;

        // SECTOR AWARE: token writeback metadata must describe the
        // sectors that actually carry tokens, not the sectors that happen
        // to contain valid data.  Replacement may hold tokens for a sector
        // whose data is not valid locally.
        int token_mask := 0;
        if (cache_entry.TokensSec0 > 0) {
          token_mask := amtc_unionMasks(token_mask, 1);
        }
        if (cache_entry.TokensSec1 > 0) {
          token_mask := amtc_unionMasks(token_mask, 2);
        }
        if (token_mask == 0) {
          token_mask := amtc_fullMask();
        }

        out_msg.sector_id := amtc_primarySectorFromMask(token_mask);
        out_msg.sector_mask := token_mask;
        out_msg.valid_sector_mask := 0; // Just an ACK, no valid data payload
        out_msg.token_sector_mask := token_mask;
        out_msg.requested_sector_mask := token_mask;

        // Maintain the tiny 8-byte control size
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
    }
  }

action(cc_dirtyReplacement, "\c", desc="Issue dirty writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
              out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;

      // SECTOR AWARE: data payload mask and token payload mask are
      // different concepts.  A dirty sector writeback may carry data only
      // for Dirty/Valid sectors, while still returning tokens for both
      // sectors.  Directory classification must see all returned tokens.
      int wb_mask := cache_entry.ValidSectors;
      if (wb_mask == 0) {
        wb_mask := amtc_fullMask();
      }
      int token_mask := 0;
      if (cache_entry.TokensSec0 > 0) {
        token_mask := amtc_unionMasks(token_mask, 1);
      }
      if (cache_entry.TokensSec1 > 0) {
        token_mask := amtc_unionMasks(token_mask, 2);
      }
      if (token_mask == 0) {
        token_mask := wb_mask;
      }

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.valid_sector_mask := wb_mask;
      out_msg.token_sector_mask := token_mask;
      out_msg.requested_sector_mask := wb_mask;

      if (cache_entry.Dirty) {
        // THE FIX: Use WB_OWNED instead of DATA_OWNER
        out_msg.Type := CoherenceResponseType:WB_OWNED;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
      } else {
        // THE FIX: Use WB_TOKENS instead of ACK_OWNER
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(cl2_checkL2Accumulation, "cl2", desc="Check if L2 line is whole") {
    // Audit84: use the active pending L1 request mask while IX is serving a
    // blocked L1 GETX/GETS. RequestedSectorMask may contain stale/merged
    // sectors from earlier retries and can prevent a ready pending requester
    // from receiving L2_Accumulation_Done. This caused addr=0x675c0 to loop
    // with PendingReqMask=1, ValidSectors=1, T0=512, but no send to L1.
    int need_mask := cache_entry.RequestedSectorMask;
    if (cache_entry.PendingL1Valid) {
      need_mask := cache_entry.PendingReqMask;
    }
    if (need_mask == 0) {
      need_mask := amtc_fullMask();
    }

    // Audit85: IX completion for a pending sub-line GETX must be checked
    // against the pending request mask, not against the full cache line.  The
    // previous amtc_L2_hasAllTokens() required both 32B sectors to hold all
    // tokens.  That can strand a valid sector-1-only write miss forever, e.g.
    // addr=0x19c4c00 with PendingReqMask=2, because L2 may correctly hold all
    // sector-1 tokens while sector-0 tokens are absent/irrelevant.
    int tokens_per_sector := max_tokens() / 2;
    int held_t0 := 0;
    int held_t1 := 0;
    if (cache_entry.PendingL1Valid && cache_entry.PendingIsGetX) {
      held_t0 := cache_entry.PendingRequesterHeldTokensSec0;
      held_t1 := cache_entry.PendingRequesterHeldTokensSec1;
      if (held_t0 < 0) { held_t0 := 0; }
      if (held_t1 < 0) { held_t1 := 0; }
      if (held_t0 > tokens_per_sector) { held_t0 := tokens_per_sector; }
      if (held_t1 > tokens_per_sector) { held_t1 := tokens_per_sector; }
    }

    int eff_t0 := cache_entry.TokensSec0 + held_t0;
    int eff_t1 := cache_entry.TokensSec1 + held_t1;

    bool has_tokens := true;
    if (amtc_maskHasSector(need_mask, 0)) {
      if (eff_t0 < tokens_per_sector) {
        has_tokens := false;
      }
    }
    if (amtc_maskHasSector(need_mask, 1)) {
      if (eff_t1 < tokens_per_sector) {
        has_tokens := false;
      }
    }

    bool has_data := (cache_entry.ValidSectors != 0) &&
                     amtc_maskContainsAll(cache_entry.ValidSectors, need_mask);

    bool pending_l1_ok_v33 := false;
    if (cache_entry.PendingL1Valid &&
        machineIDToMachineType(cache_entry.PendingL1Requestor) == MachineType:L1Cache &&
        cache_entry.PendingReqMask != 0) {
      pending_l1_ok_v33 := true;
    }

    if (!cache_entry.AccumulationPending &&
        getState(cache_entry, address) != State:M) { // STRICT GUARD
        /* V38: GETS completion is shared-data completion, not owner-token
         * accumulation.  For a pending GETS waiter, one shared token plus valid
         * data for each requested sector is enough to complete the L1 read.
         * The old generic accumulation check required max_tokens()/2 tokens
         * and therefore kept reissuing Directory repair DATA_SHARED hundreds of
         * times.  When the line finally approached the owner-token threshold,
         * the IX L2_Accumulation_Done path used the GETX completion action and
         * attempted to transition to NP while still holding sector-1 tokens,
         * triggering the line-476 NP token assert.
         */
        bool pending_gets_ready_v38 := false;
        if (pending_l1_ok_v33 && !cache_entry.PendingIsGetX && has_data) {
          pending_gets_ready_v38 := true;
          if (amtc_maskHasSector(need_mask, 0)) {
            if (cache_entry.TokensSec0 <= 0) {
              pending_gets_ready_v38 := false;
            }
          }
          if (amtc_maskHasSector(need_mask, 1)) {
            if (cache_entry.TokensSec1 <= 0) {
              pending_gets_ready_v38 := false;
            }
          }
        }

        if (pending_gets_ready_v38) {
          cache_entry.AccumulationPending := true;
          DPRINTF(RubySlicc,
                  "AMTC_L2_GETS_ACC_TRIGGER_V38 addr=%#x state=%s need=%d pending=%d req=%s reqmask=%d valid=%d T0=%d T1=%d\n",
                  address, getState(cache_entry, address), need_mask,
                  cache_entry.PendingL1Valid, cache_entry.PendingL1Requestor,
                  cache_entry.PendingReqMask, cache_entry.ValidSectors,
                  cache_entry.TokensSec0, cache_entry.TokensSec1);
          enqueue(triggerQueue_out, TriggerMsg, 1) {
              out_msg.addr := address;
              out_msg.Type := Event:L2_Gets_Accumulation_Done;
          }
        } else if (has_tokens && has_data) {
          if (pending_l1_ok_v33) {
            cache_entry.AccumulationPending := true;
            DPRINTF(RubySlicc,
                    "AMTC_L2_ACC_TRIGGER_V33 addr=%#x state=%s need=%d pending=%d req=%s reqmask=%d valid=%d T0=%d T1=%d\n",
                    address, getState(cache_entry, address), need_mask,
                    cache_entry.PendingL1Valid, cache_entry.PendingL1Requestor,
                    cache_entry.PendingReqMask, cache_entry.ValidSectors,
                    cache_entry.TokensSec0, cache_entry.TokensSec1);
              enqueue(triggerQueue_out, TriggerMsg, 1) {
                  out_msg.addr := address;
                  out_msg.Type := Event:L2_Accumulation_Done;
              }
          } else {
            DPRINTF(RubySlicc,
                    "AMTC_L2_ACC_SKIP_NO_VALID_L1_PENDING_V33 addr=%#x state=%s need=%d pending=%d req=%s reqmask=%d valid=%d T0=%d T1=%d has_tokens=%d has_data=%d\n",
                    address, getState(cache_entry, address), need_mask,
                    cache_entry.PendingL1Valid, cache_entry.PendingL1Requestor,
                    cache_entry.PendingReqMask, cache_entry.ValidSectors,
                    cache_entry.TokensSec0, cache_entry.TokensSec1,
                    has_tokens, has_data);
          }
        }
    } else {
        if ((has_tokens && has_data || has_data) && getState(cache_entry, address) == State:IX) {
          DPRINTF(RubySlicc,
                  "AMTC_L2_ACC_READY_BUT_GATED addr=%#x pending_flag=%d need=%d valid=%d reqmask=%d pendmask=%d T0=%d T1=%d\n",
                  address, cache_entry.AccumulationPending, need_mask,
                  cache_entry.ValidSectors, cache_entry.RequestedSectorMask,
                  cache_entry.PendingReqMask, cache_entry.TokensSec0,
                  cache_entry.TokensSec1);
        }
    }
    DPRINTF(RubySlicc,
        "AMTC_L2_GETX_EFFECTIVE_CHECK addr=%#x req=%s reqmask=%d valid=%d L2T0=%d L2T1=%d held0=%d held1=%d eff0=%d eff1=%d\n",
        address,
        cache_entry.PendingL1Requestor,
        cache_entry.PendingReqMask,
        cache_entry.ValidSectors,
        cache_entry.TokensSec0,
        cache_entry.TokensSec1,
        cache_entry.PendingRequesterHeldTokensSec0,
        cache_entry.PendingRequesterHeldTokensSec1,
        eff_t0,
        eff_t1);
  }

  action(d_sendDataWithTokens, "d", desc="Send data and a token from cache to requestor") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      // 1. Determine which sectors the requestor actually wants AND we hold
      int req_mask := in_msg.sector_mask;
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      // 2. Pre-calculate how many tokens to send for each sector
      int owner_limit := N_tokens + (max_tokens() / 2);
      int send_t0 := 0;
      int send_t1 := 0;

      if (amtc_maskHasSector(send_mask, 0)) {
        if (cache_entry.TokensSec0 > owner_limit) {
          send_t0 := N_tokens;
        } else {
          send_t0 := 1;
        }
      }

      if (amtc_maskHasSector(send_mask, 1)) {
        if (cache_entry.TokensSec1 > owner_limit) {
          send_t1 := N_tokens;
        } else {
          send_t1 := 1;
        }
      }

      // 3. Enqueue the tailored, sector-aware response
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        // PHASE 2: Attach the split tokens
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        // PHASE 1: Sector Aware Data Copy (Only send valid bytes)
        if (amtc_maskHasSector(send_mask, 0)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(send_mask, 1)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        // Metadata tracking
        out_msg.valid_sector_mask := send_mask;
        out_msg.token_sector_mask := send_mask;
        out_msg.Dirty := false;

        // PHASE 1: Dynamic Message Size! (Cuts bandwidth by 50% for half-line fetches)
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
      }

      // 4. Safely deduct the sent tokens from our cache entry
      cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;
    }
  }

  action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        assert(cache_entry.TokensSec0 >= 1);
        assert(cache_entry.TokensSec1 >= 1);
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.valid_sector_mask := cache_entry.ValidSectors;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(h_updateFilterFromL1HintOrWB, "h", desc="update filter from received writeback") {
    peek(responseNetwork_in, ResponseMsg) {
      removeSharer(in_msg.addr, machineIDToNodeID(in_msg.Sender));
    }
  }


  action(jwb_forwardWriteThroughToLocalSharers, "jwb", desc="Broadcast GPU/TCP WB_SHARED_DATA as GETX invalidation to local CPU L1 sharers") {
    peek(responseNetwork_in, ResponseMsg) {
      int req_mask := in_msg.requested_sector_mask;
      if (req_mask == 0) {
        req_mask := in_msg.valid_sector_mask;
      }
      if (req_mask == 0) {
        req_mask := in_msg.sector_mask;
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }
      req_mask := amtc_sanitizeMask(req_mask);

      if (sharersExist(address)) {
        enqueue(localRequestNetwork_out, RequestMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceRequestType:GETX;
          out_msg.Requestor := machineID;

          // Same broadcast style as j_forwardTransientRequestToLocalSharers:
          // fan out to all local L1s; non-holders should ignore/pop.
          out_msg.Destination.broadcast(MachineType:L1Cache);
          out_msg.isLocal := false;
          out_msg.RetryNum := 0;
          out_msg.MessageSize := MessageSizeType:Broadcast_Control;

          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;

          out_msg.is_gpu := true;
          out_msg.is_sync := false;
          out_msg.is_bypass := false;
          out_msg.is_atomic := false;
          out_msg.is_signal := false;
          out_msg.merged_req := false;
          out_msg.is_owner_pull := false;
          out_msg.isGLCSet := in_msg.isGLCSet;
          out_msg.isSLCSet := in_msg.isSLCSet;
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_WB_SHARED_INVALIDATE_L1 addr=%#x mask=%d\n",
                address, req_mask);
      } else {
        DPRINTF(RubySlicc,
                "AMTC_L2_WB_SHARED_NO_LOCAL_SHARERS addr=%#x mask=%d\n",
                address, req_mask);
      }
    }
  }

  action(j_forwardTransientRequestToLocalSharers, "j", desc="Forward external transient request to local sharers") {
    peek(requestNetwork_in, RequestMsg) {
      if (filtering_enabled && in_msg.RetryNum == 0 && sharersExist(in_msg.addr) == false) {
        //profile_filter_action(1);
        DPRINTF(RubySlicc, "filtered message, Retry Num: %d\n",
                in_msg.RetryNum);
      }
      else {
        enqueue(localRequestNetwork_out, RequestMsg, l2_response_latency ) {
           out_msg.addr := in_msg.addr;
           out_msg.Requestor := in_msg.Requestor;

           //
           // Currently assuming only one chip so all L1s are local
           //
           //out_msg.Destination := getLocalL1IDs(machineID);
           out_msg.Destination.broadcast(MachineType:L1Cache);
           out_msg.Destination.remove(in_msg.Requestor);

           out_msg.Type := in_msg.Type;
           out_msg.isLocal := false;

           // AMTC audit53: preserve sector metadata when forwarding a
           // transient request to local L1 sharers.  Without this, the L1
           // donor sees a full/default request and may send a response whose
           // token_sector_mask/requested_sector_mask does not match the
           // waiting requester TBE.  The requester then remains in SM/IM
           // even though a sharer donated the missing token.
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.sector_id := in_msg.sector_id;
           out_msg.sector_mask := in_msg.sector_mask;
           out_msg.requested_sector_mask := in_msg.requested_sector_mask;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := in_msg.is_owner_pull;

           out_msg.MessageSize := MessageSizeType:Broadcast_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
        }
        //profile_filter_action(0);
      }
    }
  }


  action(savePendingL1Request, "splr",
         desc="Save original L1 requester/mask while L2 waits for Directory") {
    peek(L1requestNetwork_in, RequestMsg) {
      int req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                         in_msg.sector_id);
      if (req_mask == 0) {
        req_mask := amtc_normalizeMask(in_msg.sector_mask,
                                       in_msg.sector_id);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      /*
       * V32 resilience: PendingL1Requestor must always name a real L1/TCP
       * requester.  Directory owner-pull/control traffic can also appear on
       * this network in AMTC bring-up paths; saving Directory-0 here poisons
       * the IX pending window and later GETS retries merge into a stale GETX
       * repair loop.
       */
      if (machineIDToMachineType(in_msg.Requestor) != MachineType:L1Cache) {
        DPRINTF(RubySlicc,
                "AMTC_L2_SKIP_SAVE_NON_L1_PENDING_V32 addr=%#x req=%s type=%s mask=%d retry=%d ownerpull=%d oldvalid=%d oldreq=%s oldmask=%d oldgetx=%d\n",
                address, in_msg.Requestor, in_msg.Type, req_mask,
                in_msg.RetryNum, in_msg.is_owner_pull,
                cache_entry.PendingL1Valid, cache_entry.PendingL1Requestor,
                cache_entry.PendingReqMask, cache_entry.PendingIsGetX);
      } else {
        /*
         * V23 CPU fast path: CPU L1 requests should be tracked as full-line
         * requests.  AMTC's 32B sector tracking is useful for GPU/accelerator
         * traffic, but CPU instruction/data caches normally consume 64B lines.
         * Keeping CPU misses as single-sector requests creates two independent
         * IS windows and many timeout/V22 local-fill recoveries.
         */
        req_mask := amtc_fullMask();

        cache_entry.PendingL1Valid := true;
        cache_entry.PendingL1Requestor := in_msg.Requestor;
        cache_entry.PendingReqMask := req_mask;
        cache_entry.PendingSectorId := in_msg.sector_id;
        cache_entry.PendingIsGetX := false;
        cache_entry.PendingRequesterHeldTokensSec0 := 0;
        cache_entry.PendingRequesterHeldTokensSec1 := 0;
        cache_entry.PendingRetrySent := false;
        cache_entry.PendingRetryNumSent := 0;
        // Audit83: a previous L2_Accumulation_Done trigger may leave this flag
        // set on an NP-but-tag-present entry.  A new pending L1 request must be
        // allowed to schedule its own accumulation trigger.
        cache_entry.AccumulationPending := false;
        cache_entry.PendingL1SecondValid := false;
        cache_entry.PendingL1SecondReqMask := 0;
        cache_entry.PendingL1SecondSectorId := 0;
        cache_entry.PendingL1SecondRetrySent := false;
        cache_entry.PendingL1SecondRetryNumSent := 0;
        cache_entry.PendingL1ThirdValid := false;
        cache_entry.PendingL1ThirdReqMask := 0;
        cache_entry.PendingL1ThirdSectorId := 0;
        cache_entry.PendingL1ThirdRetrySent := false;
        cache_entry.PendingL1ThirdRetryNumSent := 0;
        cache_entry.PendingL1FourthValid := false;
        cache_entry.PendingL1FourthReqMask := 0;
        cache_entry.PendingL1FourthSectorId := 0;
        cache_entry.PendingL1FourthRetrySent := false;
        cache_entry.PendingL1FourthRetryNumSent := 0;
        if (in_msg.Type == CoherenceRequestType:GETX) {
          cache_entry.PendingIsGetX := true;
          if (amtc_maskHasSector(req_mask, 0)) {
            cache_entry.PendingRequesterHeldTokensSec0 := in_msg.requester_held_tokens_sec0;
          }
          if (amtc_maskHasSector(req_mask, 1)) {
            cache_entry.PendingRequesterHeldTokensSec1 := in_msg.requester_held_tokens_sec1;
          }
          int tokens_per_sector := max_tokens() / 2;
          if (cache_entry.PendingRequesterHeldTokensSec0 < 0) {
            cache_entry.PendingRequesterHeldTokensSec0 := 0;
          }
          if (cache_entry.PendingRequesterHeldTokensSec1 < 0) {
            cache_entry.PendingRequesterHeldTokensSec1 := 0;
          }
          if (cache_entry.PendingRequesterHeldTokensSec0 > tokens_per_sector) {
            cache_entry.PendingRequesterHeldTokensSec0 := tokens_per_sector;
          }
          if (cache_entry.PendingRequesterHeldTokensSec1 > tokens_per_sector) {
            cache_entry.PendingRequesterHeldTokensSec1 := tokens_per_sector;
          }
        }

        DPRINTF(RubySlicc,
                "AMTC_L2_SAVE_PENDING_L1_V32 addr=%#x req=%s reqmask=%d is_getx=%d held0=%d held1=%d retry=%d ownerpull=%d\n",
                address, cache_entry.PendingL1Requestor, cache_entry.PendingReqMask,
                cache_entry.PendingIsGetX,
                cache_entry.PendingRequesterHeldTokensSec0,
                cache_entry.PendingRequesterHeldTokensSec1,
                in_msg.RetryNum, in_msg.is_owner_pull);
      }
    }
  }


  action(markPendingDirRequestSent, "mpds",
         desc="Mark initial L2->Directory request for saved L1 miss as sent") {
    if (cache_entry.PendingL1Valid) {
      peek(L1requestNetwork_in, RequestMsg) {
        cache_entry.PendingRetrySent := true;
        cache_entry.PendingRetryNumSent := in_msg.RetryNum;
        DPRINTF(RubySlicc,
                "AMTC_L2_PENDING_DIR_REQ_SENT_V19 addr=%#x req=%s reqmask=%d retry=%d type=%s state=%s\n",
                address, cache_entry.PendingL1Requestor,
                cache_entry.PendingReqMask, in_msg.RetryNum,
                in_msg.Type, cache_entry.CacheState);
      }
    }
  }

  action(sendDataToDirectoryOwnerPullFromL1Req, "sddp",
         desc="Reply data to Directory owner-pull using local L2 data") {
    assert(is_valid(cache_entry));
    peek(L1requestNetwork_in, RequestMsg) {
      int req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                         in_msg.sector_id);
      if (req_mask == 0) {
        req_mask := amtc_normalizeMask(in_msg.sector_mask,
                                       in_msg.sector_id);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := 0;
        out_msg.requested_sector_mask := req_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_DIR_OWNER_PULL_DATA addr=%#x req=%s state=%s mask=%d valid=%d t0=%d t1=%d\n",
              address, in_msg.Requestor, cache_entry.CacheState, req_mask,
              cache_entry.ValidSectors, cache_entry.TokensSec0,
              cache_entry.TokensSec1);
    }
  }

  action(sendStaleOwnerAckToDirectoryFromL1Req, "sdoa",
         desc="Reply ACK_OWNER(0) to Directory owner-pull when L2 is stale/transient") {
    peek(L1requestNetwork_in, RequestMsg) {
      int req_mask := amtc_normalizeMask(in_msg.requested_sector_mask,
                                         in_msg.sector_id);
      if (req_mask == 0) {
        req_mask := amtc_normalizeMask(in_msg.sector_mask,
                                       in_msg.sector_id);
      }
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.Dirty := false;
        out_msg.TokensSec0 := 0;
        out_msg.TokensSec1 := 0;
        out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
        out_msg.sector_mask := req_mask;
        out_msg.valid_sector_mask := 0;
        out_msg.token_sector_mask := 0;
        out_msg.requested_sector_mask := req_mask;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }

      // v58: Keep this action protocol-only.  v57 removed CacheState from the
      // print, but gem5 still crashed while formatting the replacement DPRINTF
      // arguments in this stale/transient path.  Avoid all formatted MachineID,
      // bool, enum, and cache-entry diagnostic arguments here.
      //
      // The ACK_OWNER(0) response above is the important behavior; diagnostics
      // for this path should be added from the caller side only after the run is
      // stable.
    }
  }

  action(clearPendingL1Request, "cplr",
         desc="Clear saved pending L1 requester metadata") {
    DPRINTF(RubySlicc,
            "AMTC_L2_CLEAR_PENDING_L1 addr=%#x valid=%d req=%s reqmask=%d is_getx=%d\n",
            address, cache_entry.PendingL1Valid, cache_entry.PendingL1Requestor,
            cache_entry.PendingReqMask, cache_entry.PendingIsGetX);
    cache_entry.PendingL1Valid := false;
    cache_entry.PendingReqMask := 0;
    cache_entry.PendingSectorId := 0;
    cache_entry.PendingIsGetX := false;
    cache_entry.PendingRequesterHeldTokensSec0 := 0;
    cache_entry.PendingRequesterHeldTokensSec1 := 0;
    cache_entry.PendingRetrySent := false;
    cache_entry.PendingRetryNumSent := 0;
    // Clear the one-shot accumulation trigger flag when the pending window is
    // closed.  Otherwise a later NP->IX request for the same still-present tag
    // can have all tokens/data but never enqueue L2_Accumulation_Done.
    cache_entry.AccumulationPending := false;
    cache_entry.PendingL1SecondValid := false;
    cache_entry.PendingL1SecondReqMask := 0;
    cache_entry.PendingL1SecondSectorId := 0;
    cache_entry.PendingL1SecondRetrySent := false;
    cache_entry.PendingL1SecondRetryNumSent := 0;
    cache_entry.PendingL1ThirdValid := false;
    cache_entry.PendingL1ThirdReqMask := 0;
    cache_entry.PendingL1ThirdSectorId := 0;
    cache_entry.PendingL1ThirdRetrySent := false;
    cache_entry.PendingL1ThirdRetryNumSent := 0;
    cache_entry.PendingL1FourthValid := false;
    cache_entry.PendingL1FourthReqMask := 0;
    cache_entry.PendingL1FourthSectorId := 0;
    cache_entry.PendingL1FourthRetrySent := false;
    cache_entry.PendingL1FourthRetryNumSent := 0;
  }

  action(sendPendingGetsDataToL1, "spgd",
         desc="Send DATA_SHARED to saved pending L1 requester") {
    assert(is_valid(cache_entry));

    /* V44: v43 may manually satisfy the pending L1 before enqueueing
     * L2_Gets_Accumulation_Done only to stabilize IX -> S.  The older primary
     * send helper asserted PendingL1Valid even though the secondary/third/fourth
     * helpers are already guarded.  Make the primary helper guarded too, so the
     * stabilization trigger can reuse the normal IX -> S transition without
     * sending a duplicate response or crashing.
     */
    if (!cache_entry.PendingL1Valid) {
      DPRINTF(RubySlicc,
              "AMTC_L2_SEND_PENDING_GETS_DATA_SKIP_V44 addr=%#x valid=%d T0=%d T1=%d pending=%d reqmask=%d\n",
              address, cache_entry.ValidSectors, cache_entry.TokensSec0,
              cache_entry.TokensSec1, cache_entry.PendingL1Valid,
              cache_entry.PendingReqMask);
    } else {
      int req_mask := amtc_sanitizeMask(cache_entry.PendingReqMask);
      if (req_mask == 0) {
        req_mask := amtc_fullMask();
      }

      int send_t0 := 0;
      int send_t1 := 0;
      int token_mask := 0;

      if (amtc_maskHasSector(req_mask, 0)) {
        send_t0 := 1;
        token_mask := amtc_unionMasks(token_mask, 1);
      }
      if (amtc_maskHasSector(req_mask, 1)) {
        send_t1 := 1;
        token_mask := amtc_unionMasks(token_mask, 2);
      }

      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(cache_entry.PendingL1Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;
        out_msg.sector_id := cache_entry.PendingSectorId;
        out_msg.sector_mask := req_mask;
        out_msg.valid_sector_mask := req_mask;
        out_msg.token_sector_mask := token_mask;
        out_msg.requested_sector_mask := req_mask;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(req_mask);
      }

      if (send_t0 > 0) {
        if (cache_entry.TokensSec0 > 0) {
          cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
        } else {
          DPRINTF(RubySlicc,
                  "AMTC_L2_PENDING_GETS_FORCE_TOKEN addr=%#x sec=0 reqmask=%d\n",
                  address, req_mask);
        }
      }
      if (send_t1 > 0) {
        if (cache_entry.TokensSec1 > 0) {
          cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;
        } else {
          DPRINTF(RubySlicc,
                  "AMTC_L2_PENDING_GETS_FORCE_TOKEN addr=%#x sec=1 reqmask=%d\n",
                  address, req_mask);
        }
      }

      DPRINTF(RubySlicc,
              "AMTC_L2_SEND_PENDING_GETS_DATA addr=%#x req=%s reqmask=%d send0=%d send1=%d rem0=%d rem1=%d\n",
              address, cache_entry.PendingL1Requestor, req_mask, send_t0, send_t1,
              cache_entry.TokensSec0, cache_entry.TokensSec1);
    }
  }

