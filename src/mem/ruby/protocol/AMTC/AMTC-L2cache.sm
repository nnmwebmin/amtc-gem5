      DPRINTF(RubySlicc,
              "AMTC_L2_SEND_SECOND_GETS_DATA addr=%#x second=%s reqmask=%d send0=%d send1=%d rem0=%d rem1=%d\n",
              address, cache_entry.PendingL1SecondRequestor, req_mask,
              send_t0, send_t1, cache_entry.TokensSec0, cache_entry.TokensSec1);
