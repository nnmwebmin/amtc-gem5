machine(MachineType:L2Cache, "Token protocol")
 : CacheMemory * L2cache;
   int N_tokens;
   Cycles l2_request_latency := 5;
   Cycles l2_response_latency := 5;
   bool filtering_enabled := "True";

   // L2 BANK QUEUES
   // From local bank of L2 cache TO the network

   // this L2 bank -> a local L1 || mod-directory
   MessageBuffer * responseFromL2Cache, network="To", virtual_network="4",
        vnet_type="response";
   // this L2 bank -> mod-directory
   MessageBuffer * GlobalRequestFromL2Cache, network="To", virtual_network="2",
        vnet_type="request";
   // this L2 bank -> a local L1
   MessageBuffer * L1RequestFromL2Cache, network="To", virtual_network="1",
        vnet_type="request";

   // FROM the network to this local bank of L2 cache
   // a local L1 || mod-directory -> this L2 bank
   MessageBuffer * responseToL2Cache, network="From", virtual_network="4",
        vnet_type="response";
   // mod-directory -> this L2 bank
   MessageBuffer * GlobalRequestToL2Cache, network="From", virtual_network="2",
        vnet_type="request";
   // a local L1 -> this L2 bank
   MessageBuffer * L1RequestToL2Cache, network="From", virtual_network="1",
        vnet_type="request";

   // Internal loopback for accumulation triggers
   MessageBuffer * triggerQueue;

{
  // STATES
  state_declaration(State, desc="L2 Cache states", default="L2Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, desc="Not Present";
    I, AccessPermission:Invalid, desc="Idle";
    S, AccessPermission:Read_Only, desc="Shared, not present in any local L1s";
    O, AccessPermission:Read_Only, desc="Owned, not present in any L1s";
    M, AccessPermission:Read_Write, desc="Modified, not present in any L1s";

    SX, AccessPermission:Busy, desc="Shared, waiting for L2 accumulation";
    OX, AccessPermission:Busy, desc="Owned, waiting for L2 accumulation";
    MX, AccessPermission:Busy, desc="Modified, waiting for L2 accumulation";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {

    // Requests
    L1_GETS,             desc="local L1 GETS request";
    L1_GETX,             desc="local L1 GETX request";
    L1_INV,              desc="L1 no longer has tokens";
    Transient_GETX,      desc="A GetX from another processor";
    Transient_GETS,      desc="A GetS from another processor";

    // events initiated by this L2
    L2_Replacement,     desc="L2 Replacement", format="!r";

    // Responses
    Writeback_Tokens,               desc="Received a writeback from L1 with only tokens (no data)";
    Writeback_Shared_Data,               desc="Received a writeback from L1 that includes clean data";
    Writeback_Owned,                desc="Received a writeback from L1";

    Data_Shared,             desc="Received a data message, we are now a sharer";
    Data_Owner,              desc="Received a data message, we are now the owner";
    Ack,                     desc="Received an ack message";

    // Internal Triggers:
    L2_Accumulation_Done, desc="L2 now has all required tokens/sectors";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,        desc="cache state";
    bool Dirty,              desc="Is the data dirty (different than memory)?";
    int ValidSectors, default="0", desc="AMTC valid sectors in this L2 line";
    int DirtySectors, default="0", desc="AMTC dirty sectors in this L2 line";
    int TokenSectorMask, default="0", desc="AMTC sectors for which L2 token state is meaningful";
    int RequestedSectorMask, default="0", desc="AMTC last/merged requested sector mask seen by L2";
    DataBlock DataBlk,       desc="data for the block";
    int TokensSec0, default="0", desc="AMTC token count for sector 0";
    int TokensSec1, default="0", desc="AMTC token count for sector 1";

    bool AccumulationPending, default="false";
  }

  structure(DirEntry, desc="...", interface="AbstractCacheEntry", main="false") {
    Set Sharers,            desc="Set of the internal processors that want the block in shared state";
    bool exclusive, default="false", desc="if local exclusive is likely";
  }

  structure(PerfectCacheMemory, external="yes") {
    void allocate(Addr);
    void deallocate(Addr);
    DirEntry lookup(Addr);
    bool isTagPresent(Addr);
  }

  structure(TriggerMsg, interface="Message") {
    Addr addr,             desc="Address for this trigger";
    Event Type,            desc="Type of event to trigger";

    // Required functional boilerplate for SLICC
    bool functionalWrite(Packet *pkt) {
        return false;
    }
    bool functionalRead(Packet *pkt) {
        return false;
    }
  }

  PerfectCacheMemory localDirectory, template="<L2Cache_DirEntry>";

  Tick clockEdge();
  void set_cache_entry(AbstractCacheEntry b);
  void unset_cache_entry();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  // -------------------------------------------------------------------------
  // AMTC compact sector helpers.
  // Physical Ruby coherence block remains 64B. Logical sharing is represented
  // as 2 x 32B sectors: sector 0 = bytes 0..31, sector 1 = bytes 32..63.
  // Full-line mask is 3. Old full-line mask values such as 15 are sanitized
  // to 3 so untrimmed controllers cannot accidentally re-enable 4 sectors.
  // -------------------------------------------------------------------------
  int amtc_maskFromSector(int sid) {
    if (sid == 0) {
      return 1;
    }
    return 2;
  }

  int amtc_fullMask() {
    return 3;
  }

  int amtc_sanitizeMask(int mask) {
    int result := 0;
    if ((mask % 2) == 1) {
      result := result + 1;
    }
    if (((mask / 2) % 2) == 1) {
      result := result + 2;
    }
    if (result == 0 && mask != 0) {
      result := 3;
    }
    return result;
  }

  bool amtc_maskHasSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0) {
      return ((clean % 2) == 1);
    }
    return (((clean / 2) % 2) == 1);
  }

  int amtc_addSectorToMask(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (amtc_maskHasSector(clean, sid)) {
      return clean;
    }
    return clean + amtc_maskFromSector(sid);
  }

  int amtc_intersectMasks(int a, int b) {
    int result := 0;
    if (amtc_maskHasSector(a, 0) && amtc_maskHasSector(b, 0)) {
      result := result + 1;
    }
    if (amtc_maskHasSector(a, 1) && amtc_maskHasSector(b, 1)) {
      result := result + 2;
    }
    return result;
  }

  int amtc_unionMasks(int a, int b) {
    int result := amtc_sanitizeMask(a);
    if (amtc_maskHasSector(b, 0)) {
      result := amtc_addSectorToMask(result, 0);
    }
    if (amtc_maskHasSector(b, 1)) {
      result := amtc_addSectorToMask(result, 1);
    }
    return amtc_sanitizeMask(result);
  }

  bool amtc_maskContainsAll(int have_mask, int need_mask) {
    int have := amtc_sanitizeMask(have_mask);
    int need := amtc_sanitizeMask(need_mask);
    if (amtc_maskHasSector(need, 0) && !amtc_maskHasSector(have, 0)) {
      return false;
    }
    if (amtc_maskHasSector(need, 1) && !amtc_maskHasSector(have, 1)) {
      return false;
    }
    return true;
  }

  int amtc_primarySectorFromMask(int mask) {
    if (amtc_maskHasSector(mask, 0)) {
      return 0;
    }
    return 1;
  }

  int amtc_normalizeMask(int mask, int sid) {
    if (mask != 0) {
      return amtc_sanitizeMask(mask);
    }
    return amtc_maskFromSector(sid);
  }

  int amtc_sectorFromAddr(Addr addr) {
    return ((addressToInt(addr) / 32) % 2);
  }

  int amtc_singleSectorMaskFromAddr(Addr addr) {
    return amtc_maskFromSector(amtc_sectorFromAddr(addr));
  }

  int amtc_countSectors(int mask) {
    int count := 0;
    if (amtc_maskHasSector(mask, 0)) {
      count := count + 1;
    }
    if (amtc_maskHasSector(mask, 1)) {
      count := count + 1;
    }
    return count;
  }

  int amtc_expectedTokensForMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 0) {
      active := 2;
    }
    return (max_tokens() / 2) * active;
  }

  int amtc_clearSector(int mask, int sid) {
    int clean := amtc_sanitizeMask(mask);
    if (sid == 0 && amtc_maskHasSector(clean, 0)) {
      return clean - 1;
    }
    if (sid == 1 && amtc_maskHasSector(clean, 1)) {
      return clean - 2;
    }
    return clean;
  }

  int amtc_subtractMask(int base, int remove) {
    int result := amtc_sanitizeMask(base);
    if (amtc_maskHasSector(remove, 0)) {
      result := amtc_clearSector(result, 0);
    }
    if (amtc_maskHasSector(remove, 1)) {
      result := amtc_clearSector(result, 1);
    }
    return result;
  }

  MessageSizeType amtc_getSizeFromDirtyMask(int mask) {
    int active := amtc_countSectors(mask);
    if (active == 1) {
      return MessageSizeType:Response_Sector2_Data;
    }
    return MessageSizeType:Response_Data;
  }

  Entry getCacheEntry(Addr address), return_by_pointer="yes" {
    Entry cache_entry := static_cast(Entry, "pointer", L2cache.lookup(address));
    return cache_entry;
  }

  DirEntry getDirEntry(Addr address), return_by_pointer="yes" {
    return localDirectory.lookup(address);
  }

  void functionalRead(Addr addr, Packet *pkt) {
    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;
    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  int getTokensForMask(Entry cache_entry, int mask) {
    int total := 0;

    if (is_valid(cache_entry)) {

        if (amtc_maskHasSector(mask, 0)) {
            total := total + cache_entry.TokensSec0;
        }

        if (amtc_maskHasSector(mask, 1)) {
            total := total + cache_entry.TokensSec1;
        }
    }

    return total;
}

  State getState(Entry cache_entry, Addr addr) {
    if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    } else {
      return State:NP;
    }
  }

  void setState(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {

      // Basic sanity checks: No sector can have negative tokens
      assert(cache_entry.TokensSec0 >= 0);
      assert(cache_entry.TokensSec1 >= 0);

      // Ensure no transition sets state==I during a GETX upgrade path.
      if (cache_entry.CacheState == State:SX || cache_entry.CacheState == State:OX || cache_entry.CacheState == State:MX) {
        assert(state != State:I);
      }

      // In AMTC, the whole line's max_tokens() is divided equally among sectors
      int tokens_per_sector := max_tokens() / 2;

      // =========================================================
      // NP & Locked States: Zero local token ownership allowed
      // =========================================================
      if (state == State:NP) {
        assert(cache_entry.TokensSec0 == 0);
        assert(cache_entry.TokensSec1 == 0);
      }

      // =========================================================
      // Modified State: Must hold ALL tokens for valid sectors
      // =========================================================
      if (state == State:M) {
        assert(cache_entry.ValidSectors != 0); // Must have at least one valid sector!

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 == tokens_per_sector);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 == tokens_per_sector);
        }
      }

      // =========================================================
      // Shared & Owned States: Must hold > 0 tokens for valid sectors
      // =========================================================
      if (state == State:S || state == State:O) {
        assert(cache_entry.ValidSectors != 0);

        if (amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          assert(cache_entry.TokensSec0 > 0);
        }
        if (amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          assert(cache_entry.TokensSec1 > 0);
        }
      }

      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      return L2Cache_State_to_permission(cache_entry.CacheState);
    }

    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L2Cache_State_to_permission(state));
    }
  }

  void removeSharer(Addr addr, NodeID id) {

    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.Sharers.remove(id);
      if (dir_entry.Sharers.count() == 0) {
        localDirectory.deallocate(addr);
      }
    }
  }

  bool sharersExist(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.Sharers.count() > 0) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  bool exclusiveExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      if (dir_entry.exclusive) {
        return true;
      }
      else {
        return false;
      }
    }
    else {
      return false;
    }
  }

  // assumes that caller will check to make sure tag is present
  Set getSharers(Addr addr) {
    DirEntry dir_entry := getDirEntry(addr);
    return dir_entry.Sharers;
  }

  void setNewWriter(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.clear();
    dir_entry.Sharers.add(id);
    dir_entry.exclusive := true;
  }

  void addNewSharer(Addr addr, NodeID id) {
    if (localDirectory.isTagPresent(addr) == false) {
      localDirectory.allocate(addr);
    }
    DirEntry dir_entry := getDirEntry(addr);
    dir_entry.Sharers.add(id);
    // dir_entry.exclusive := false;
  }

  void clearExclusiveBitIfExists(Addr addr) {
    if (localDirectory.isTagPresent(addr)) {
      DirEntry dir_entry := getDirEntry(addr);
      dir_entry.exclusive := false;
    }
  }

  bool amtc_L2_hasAllTokens(Entry cache_entry) {
    int tokens_per_sector := max_tokens() / 2;
    if (amtc_maskHasSector(cache_entry.ValidSectors, 0) && cache_entry.TokensSec0 < tokens_per_sector) {
        return false;
    }
    if (amtc_maskHasSector(cache_entry.ValidSectors, 1) && cache_entry.TokensSec1 < tokens_per_sector) {
        return false;
    }
    return true;
  }

  void amtc_assertTokenBounds(int tokens) {
    assert(tokens >= 0);
    assert(tokens <= (max_tokens() / 2));
  }

  // ** OUT_PORTS **
  out_port(globalRequestNetwork_out, RequestMsg, GlobalRequestFromL2Cache);
  out_port(localRequestNetwork_out, RequestMsg, L1RequestFromL2Cache);
  out_port(responseNetwork_out, ResponseMsg, responseFromL2Cache);
  out_port(triggerQueue_out, TriggerMsg, triggerQueue);



  // ** IN_PORTS **
  // Request Network
  in_port(requestNetwork_in, RequestMsg, GlobalRequestToL2Cache) {
    if (requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        if (in_msg.Type == CoherenceRequestType:GETX) {
            trigger(Event:Transient_GETX, in_msg.addr, cache_entry);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
            trigger(Event:Transient_GETS, in_msg.addr, cache_entry);
        } else {
          error("Unexpected message");
        }
      }
    }
  }

  in_port(L1requestNetwork_in, RequestMsg, L1RequestToL2Cache) {
    if (L1requestNetwork_in.isReady(clockEdge())) {
      peek(L1requestNetwork_in, RequestMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);
        State current_state := getState(cache_entry, in_msg.addr);

        // --- DOMAIN-AWARE FILTERING ---
        // Use machineIDToMachineType to extract the enum for comparison
        bool from_gpu := (machineIDToMachineType(in_msg.Requestor) == MachineType:TCC ||
                  machineIDToMachineType(in_msg.Requestor) == MachineType:TCP);

        // If the request is from the GPU domain but the L2 is in an Invalid state,
        // it means the CPU domain does not share this line. Drop it.
        if (from_gpu && current_state == State:I) {
            L1requestNetwork_in.dequeue(clockEdge());
        }
        // --- END FILTERING ---
        else {
            if (in_msg.Type == CoherenceRequestType:GETX) {
                trigger(Event:L1_GETX, in_msg.addr, cache_entry);
            } else if (in_msg.Type == CoherenceRequestType:GETS) {
                trigger(Event:L1_GETS, in_msg.addr, cache_entry);
            } else {
                error("Unexpected message");
            }
        }
      }
    }
  }


  // Response Network
    in_port(responseNetwork_in, ResponseMsg, responseToL2Cache) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg) {
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);

        // PURE TYPE-BASED TRIGGERING: No token counting here!
        if (in_msg.Type == CoherenceResponseType:ACK) {
            trigger(Event:Ack, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:DATA_OWNER) {
            trigger(Event:Data_Owner, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:DATA_SHARED) {
            trigger(Event:Data_Shared, in_msg.addr, cache_entry);

        } else if (in_msg.Type == CoherenceResponseType:WB_TOKENS ||
                   in_msg.Type == CoherenceResponseType:WB_OWNED ||
                   in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {

            if (L2cache.cacheAvail(in_msg.addr) || is_valid(cache_entry)) {
                if (in_msg.Type == CoherenceResponseType:WB_TOKENS) {
                    trigger(Event:Writeback_Tokens, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_SHARED_DATA) {
                    trigger(Event:Writeback_Shared_Data, in_msg.addr, cache_entry);
                } else if (in_msg.Type == CoherenceResponseType:WB_OWNED) {
                    trigger(Event:Writeback_Owned, in_msg.addr, cache_entry);
                }
            } else {
                Addr victim := L2cache.cacheProbe(in_msg.addr);
                trigger(Event:L2_Replacement, victim, getCacheEntry(victim));
            }

        } else if (in_msg.Type == CoherenceResponseType:INV) {
            trigger(Event:L1_INV, in_msg.addr, cache_entry);

        } else {
            error("Unexpected message");
        }
      }
    }
  }

  in_port(triggerQueue_in, TriggerMsg, triggerQueue) {
    if (triggerQueue_in.isReady(clockEdge())) {
      peek(triggerQueue_in, TriggerMsg) {
        // Trigger the internal event (e.g., L2_Accumulation_Done)
        trigger(in_msg.Type, in_msg.addr, getCacheEntry(in_msg.addr));
      }
    }
  }


  // ACTIONS

  action(a_broadcastLocalRequest, "a",
       desc="Send request only to directory") {

    peek(L1requestNetwork_in, RequestMsg) {

        enqueue(globalRequestNetwork_out,
                RequestMsg,
                l2_request_latency) {

           out_msg.addr := in_msg.addr;
           out_msg.Type := in_msg.Type;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;

           // =====================================================
           // TEMP FIX:
           // Disable recursive L2 broadcasts
           // =====================================================

           out_msg.Destination.add(
               mapAddressToMachine(address,
                                   MachineType:Directory));

           out_msg.sector_id :=
               in_msg.sector_id;

           out_msg.sector_mask :=
               amtc_normalizeMask(
                   in_msg.sector_mask,
                   in_msg.sector_id);

           out_msg.requested_sector_mask :=
               amtc_normalizeMask(
                   in_msg.requested_sector_mask,
                   in_msg.sector_id);

           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;

           out_msg.MessageSize :=
               MessageSizeType:Request_Control;

           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;

           // Never propagate stale owner pulls
           out_msg.is_owner_pull := in_msg.is_owner_pull;

           DPRINTF(RubySlicc,
                   "AMTC_L2_DIR_ONLY addr=%#x mask=%d\n",
                   address,
                   out_msg.sector_mask);
        }
    }
}


  action(bb_bounceResponse, "\b", desc="Bounce tokens and data to memory") {
    peek(responseNetwork_in, ResponseMsg) {
      // FIXME, should use a 3rd vnet
      enqueue(responseNetwork_out, ResponseMsg, 1) {
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.TokensSec0 := in_msg.TokensSec0;
        out_msg.TokensSec1 := in_msg.TokensSec1;
        out_msg.MessageSize := in_msg.MessageSize;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.valid_sector_mask := in_msg.valid_sector_mask;
        out_msg.Dirty := in_msg.Dirty;
      }
    }
  }

  action(c_cleanReplacement, "c", desc="Issue clean writeback") {
    assert(is_valid(cache_entry));
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
                out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;

        // SECTOR AWARE: Pass the metadata up to the directory
        int wb_mask := cache_entry.ValidSectors;
        if (wb_mask == 0) {
          wb_mask := amtc_fullMask();
        }

        out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
        out_msg.sector_mask := wb_mask;
        out_msg.valid_sector_mask := 0; // Just an ACK, no valid data payload
        out_msg.token_sector_mask := wb_mask;
        out_msg.requested_sector_mask := wb_mask;

        // Maintain the tiny 8-byte control size
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
    }
  }

action(cc_dirtyReplacement, "\c", desc="Issue dirty writeback") {
    assert(is_valid(cache_entry));
    enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
              out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;

      // SECTOR AWARE: Calculate the minimal required payload
      int wb_mask := cache_entry.ValidSectors;
      if (wb_mask == 0) {
        wb_mask := amtc_fullMask();
      }

      out_msg.sector_id := amtc_primarySectorFromMask(wb_mask);
      out_msg.sector_mask := wb_mask;
      out_msg.valid_sector_mask := wb_mask;
      out_msg.token_sector_mask := wb_mask;
      out_msg.requested_sector_mask := wb_mask;

      if (cache_entry.Dirty) {
        // THE FIX: Use WB_OWNED instead of DATA_OWNER
        out_msg.Type := CoherenceResponseType:WB_OWNED;
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(wb_mask);
      } else {
        // THE FIX: Use WB_TOKENS instead of ACK_OWNER
        out_msg.Type := CoherenceResponseType:WB_TOKENS;
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(cl2_checkL2Accumulation, "cl2", desc="Check if L2 line is whole") {
    if (!cache_entry.AccumulationPending &&
        getState(cache_entry, address) != State:M) { // STRICT GUARD
        bool has_tokens := amtc_L2_hasAllTokens(cache_entry);
        bool has_data := (cache_entry.ValidSectors != 0) &&
                         amtc_maskContainsAll(cache_entry.ValidSectors, cache_entry.RequestedSectorMask);

        if (has_tokens && has_data) {
          cache_entry.AccumulationPending := true;
            enqueue(triggerQueue_out, TriggerMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := Event:L2_Accumulation_Done;
            }
        }
    }
  }

  action(d_sendDataWithTokens, "d", desc="Send data and a token from cache to requestor") {
    peek(requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));

      // 1. Determine which sectors the requestor actually wants AND we hold
      int req_mask := in_msg.sector_mask;
      if (req_mask == 0) { req_mask := amtc_fullMask(); }
      int send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      // 2. Pre-calculate how many tokens to send for each sector
      int owner_limit := N_tokens + (max_tokens() / 2);
      int send_t0 := 0;
      int send_t1 := 0;

      if (amtc_maskHasSector(send_mask, 0)) {
        if (cache_entry.TokensSec0 > owner_limit) {
          send_t0 := N_tokens;
        } else {
          send_t0 := 1;
        }
      }

      if (amtc_maskHasSector(send_mask, 1)) {
        if (cache_entry.TokensSec1 > owner_limit) {
          send_t1 := N_tokens;
        } else {
          send_t1 := 1;
        }
      }

      // 3. Enqueue the tailored, sector-aware response
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_SHARED;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);

        // PHASE 2: Attach the split tokens
        out_msg.TokensSec0 := send_t0;
        out_msg.TokensSec1 := send_t1;

        // PHASE 1: Sector Aware Data Copy (Only send valid bytes)
        if (amtc_maskHasSector(send_mask, 0)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
        }
        if (amtc_maskHasSector(send_mask, 1)) {
          out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
        }

        // Metadata tracking
        out_msg.valid_sector_mask := send_mask;
        out_msg.token_sector_mask := send_mask;
        out_msg.Dirty := false;

        // PHASE 1: Dynamic Message Size! (Cuts bandwidth by 50% for half-line fetches)
        out_msg.MessageSize := amtc_getSizeFromDirtyMask(send_mask);
      }

      // 4. Safely deduct the sent tokens from our cache entry
      cache_entry.TokensSec0 := cache_entry.TokensSec0 - send_t0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 - send_t1;
    }
  }

  action(dd_sendDataWithAllTokens, "\d", desc="Send data and all tokens from cache to requestor") {
    assert(is_valid(cache_entry));
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_OWNER;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        assert(cache_entry.TokensSec0 >= 1);
        assert(cache_entry.TokensSec1 >= 1);
        out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.valid_sector_mask := cache_entry.ValidSectors;
      }
    }
    cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
  }

  action(h_updateFilterFromL1HintOrWB, "h", desc="update filter from received writeback") {
    peek(responseNetwork_in, ResponseMsg) {
      removeSharer(in_msg.addr, machineIDToNodeID(in_msg.Sender));
    }
  }

  action(j_forwardTransientRequestToLocalSharers, "j", desc="Forward external transient request to local sharers") {
    peek(requestNetwork_in, RequestMsg) {
      if (filtering_enabled && in_msg.RetryNum == 0 && sharersExist(in_msg.addr) == false) {
        //profile_filter_action(1);
        DPRINTF(RubySlicc, "filtered message, Retry Num: %d\n",
                in_msg.RetryNum);
      }
      else {
        enqueue(localRequestNetwork_out, RequestMsg, l2_response_latency ) {
           out_msg.addr := in_msg.addr;
           out_msg.Requestor := in_msg.Requestor;

           //
           // Currently assuming only one chip so all L1s are local
           //
           //out_msg.Destination := getLocalL1IDs(machineID);
           out_msg.Destination.broadcast(MachineType:L1Cache);
           out_msg.Destination.remove(in_msg.Requestor);

           out_msg.Type := in_msg.Type;
           out_msg.isLocal := false;
           out_msg.MessageSize := MessageSizeType:Broadcast_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
        }
        //profile_filter_action(0);
      }
    }
  }

  action(k_dataFromL2CacheToL1Requestor, "k", desc="Send data and a token from cache to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      int req_mask := in_msg.requested_sector_mask;
      int safe_send_mask := amtc_intersectMasks(cache_entry.ValidSectors, req_mask);

      bool can_give_t0 := (cache_entry.TokensSec0 > 1);
      bool can_give_t1 := (cache_entry.TokensSec1 > 1);

      // 1. Send Data + Tokens for sectors we physically have
      if (safe_send_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := safe_send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);

          if (can_give_t0 && amtc_maskHasSector(safe_send_mask, 0)) {
              out_msg.TokensSec0 := 1;
              cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
          } else { out_msg.TokensSec0 := 0; }

          if (can_give_t1 && amtc_maskHasSector(safe_send_mask, 1)) {
              out_msg.TokensSec1 := 1;
              cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
          } else { out_msg.TokensSec1 := 0; }
        }
      }

      // ===================================================================
      // CRITICAL FIX: The Orphan Token Release
      // If we hold tokens for the requested sectors, but lack the data,
      // we MUST send the tokens via an ACK so they aren't trapped in the L2!
      // ===================================================================
      int token_only_mask := amtc_subtractMask(req_mask, safe_send_mask);
      int send_ack_t0 := 0;
      int send_ack_t1 := 0;
      int actual_ack_mask := 0;

      if (amtc_maskHasSector(token_only_mask, 0) && can_give_t0) {
          send_ack_t0 := 1;
          cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
          actual_ack_mask := amtc_unionMasks(actual_ack_mask, 1);
      }
      if (amtc_maskHasSector(token_only_mask, 1) && can_give_t1) {
          send_ack_t1 := 1;
          cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
          actual_ack_mask := amtc_unionMasks(actual_ack_mask, 2);
      }

      if (actual_ack_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_ack_t0;
          out_msg.TokensSec1 := send_ack_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(actual_ack_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0; // No data!
          out_msg.token_sector_mask := actual_ack_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }

      // 3. Forward to Directory if anything is still physically missing
      bool starved_data := (safe_send_mask != req_mask);
      bool starved_t0 := amtc_maskHasSector(req_mask, 0) && !can_give_t0;
      bool starved_t1 := amtc_maskHasSector(req_mask, 1) && !can_give_t1;

      if (starved_data || starved_t0 || starved_t1) {
        int missing_mask := amtc_subtractMask(req_mask, safe_send_mask);
        if (missing_mask == 0) { missing_mask := req_mask; }

        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.RetryNum := in_msg.RetryNum;
          out_msg.Destination.broadcast(MachineType:L2Cache);
          out_msg.Destination.remove(machineID);
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
          out_msg.sector_mask := missing_mask;
          out_msg.requested_sector_mask := missing_mask;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.AccessMode := in_msg.AccessMode;
          out_msg.Prefetch := in_msg.Prefetch;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.merged_req := in_msg.merged_req;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
        }
      }
    }
  }

  action(k_dataOwnerFromL2CacheToL1Requestor, "\k", desc="Send data and tokens from L2 cache to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }

    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    amtc_assertTokenBounds(send_t0);
    amtc_assertTokenBounds(send_t1);

    // PHASE 2 ASSERT: We must be sending tokens for at least one sector!
    assert(send_t0 > 0 || send_t1 > 0);

      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int safe_send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      if (safe_send_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := safe_send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
        }
      } else {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Destination.broadcast(MachineType:L2Cache);
           out_msg.Destination.remove(machineID);
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
        }
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := address;
           out_msg.Type := CoherenceRequestType:GETS;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
           out_msg.sector_mask := req_mask;
           out_msg.requested_sector_mask := req_mask;
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := false ;
        }
      }
    }
  }

  action(k_dataAndAllTokensFromL2CacheToL1Requestor, "\kk", desc="Send requested sector data and all tokens from L2 to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);

      // 1. Calculate tokens to send (Give up EVERYTHING we have for the requested sectors)
      int send_t0 := 0;
      int send_t1 := 0;

      if (amtc_maskHasSector(req_mask, 0)) {
          send_t0 := cache_entry.TokensSec0;
          cache_entry.TokensSec0 := 0; // Give them all up!
      }
      if (amtc_maskHasSector(req_mask, 1)) {
          send_t1 := cache_entry.TokensSec1;
          cache_entry.TokensSec1 := 0; // Give them all up!
      }

      int safe_send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      if (safe_send_mask != 0) {
        // We have SOME data to send
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          if (amtc_maskHasSector(safe_send_mask, 0)) {
              out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(safe_send_mask, 1)) {
              out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
          }

          out_msg.Dirty := cache_entry.Dirty;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.merged_resp := false;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);
        }
      } else {
        // We have NO data, just tokens
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }

      // ===================================================================
      // CRITICAL FIX: ALWAYS fetch physically missing bytes from the Directory!
      // Even if we sent partial data above, we still need the rest of the line.
      // ===================================================================
      if (safe_send_mask != req_mask) {
        int missing_mask := amtc_subtractMask(req_mask, safe_send_mask);
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := address;
           out_msg.Type := CoherenceRequestType:GETS;
           out_msg.Requestor := in_msg.Requestor; // The Directory will reply directly to the L1!
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
           out_msg.sector_mask := missing_mask;
           out_msg.requested_sector_mask := missing_mask;
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := false;
        }
      }

      // Update local metadata
      cache_entry.TokenSectorMask := amtc_subtractMask(cache_entry.TokenSectorMask, req_mask);
    }
  }

  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(n_popResponseQueue, "n", desc="Pop response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(o_popL1RequestQueue, "o", desc="Pop L1 request queue.") {
    L1requestNetwork_in.dequeue(clockEdge());
  }


  action(q_updateTokensFromResponse, "q", desc="Update token count based on incoming response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // Route tokens to specific sectors
      cache_entry.TokensSec0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 + in_msg.TokensSec1;
      // Protect
      amtc_assertTokenBounds(cache_entry.TokensSec0);
      amtc_assertTokenBounds(cache_entry.TokensSec1);

      cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, in_msg.valid_sector_mask);

      if ((in_msg.Type == CoherenceResponseType:DATA_OWNER ||
           in_msg.Type == CoherenceResponseType:WB_OWNED) && in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }
    }
  }

  action(r_markNewSharer, "r", desc="Mark the new local sharer from local request message") {
    peek(L1requestNetwork_in, RequestMsg) {
      if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
        if (in_msg.Type == CoherenceRequestType:GETX) {
          setNewWriter(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          addNewSharer(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        }
      }
    }
  }

  action(r_clearExclusive, "\rrr", desc="clear exclusive bit") {
    clearExclusiveBitIfExists(address);
  }

  action(r_setMRU, "\rr", desc="manually set the MRU bit for cache line" ) {
    peek(L1requestNetwork_in, RequestMsg) {
      if ((machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) &&
          (is_valid(cache_entry))) {
        L2cache.setMRU(address);
      }
    }
  }

  action(rm_updateRequestedMask, "rm", desc="Update requested sector mask from L1 request") {
    peek(L1requestNetwork_in, RequestMsg) {
      if (is_valid(cache_entry)) {
        cache_entry.RequestedSectorMask := amtc_unionMasks(cache_entry.RequestedSectorMask, in_msg.requested_sector_mask);
      }
    }
  }

  action(rc_clearRequestedMask, "rc", desc="Clear requested sector mask upon M promotion") {
    if (is_valid(cache_entry)) {
      cache_entry.RequestedSectorMask := 0;
    }
  }

action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // AMTC Metadata: Dynamically flag which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry data
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(tt_sendLocalAckWithCollectedTokens, "tt", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(L1requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // AMTC Metadata: Dynamically flag which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry data
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(t_popTriggerQueue, "tq", desc="Pop trigger queue") {
    triggerQueue_in.dequeue(clockEdge());
  }

  action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := in_msg.valid_sector_mask;

      // ===================================================================
      // L2 Refined Late Data Shield
      // ===================================================================
      int tokens_per_sector := max_tokens() / 2;

      if (amtc_maskHasSector(copy_mask, 0) &&
          cache_entry.TokensSec0 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          copy_mask := amtc_clearSector(copy_mask, 0);
      }

      if (amtc_maskHasSector(copy_mask, 1) &&
          cache_entry.TokensSec1 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          copy_mask := amtc_clearSector(copy_mask, 1);
      }

      if (copy_mask != 0) {
          if (amtc_maskHasSector(copy_mask, 0)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(copy_mask, 1)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, copy_mask);
          }
      }
    }
  }

  action(vv_allocateL2CacheBlock, "\v", desc="Set L2 cache tag equal to tag of block B.") {
    set_cache_entry(L2cache.allocate(address, new Entry));
  }

  action(rr_deallocateL2CacheBlock, "\r", desc="Deallocate L2 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    L2cache.deallocate(address);
    unset_cache_entry();
  }

  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    L2cache.profileDemandMiss();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    L2cache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      if (in_msg.Type != CoherenceResponseType:ACK &&
          in_msg.Type != CoherenceResponseType:WB_TOKENS) {
        assert(is_valid(cache_entry));
        //assert(cache_entry.DataBlk == in_msg.DataBlk);
      }
    }
  }

  action(z_resetAccumulationFlag, "z", desc="Reset the accumulation trigger flag") {
    if (is_valid(cache_entry)) {
      cache_entry.AccumulationPending := false;
    }
  }


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  transition({NP, I, S, O, M}, L1_INV) {

    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  // Transitions from NP

  transition(NP, {Transient_GETX, Transient_GETS}) {
    // forward message to local sharers
    r_clearExclusive;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }


  transition(NP,  {L1_GETS, L1_GETX}) {
    a_broadcastLocalRequest;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(NP, {Ack, Data_Shared, Data_Owner}) {
    bb_bounceResponse;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Shared_Data, S) {
    vv_allocateL2CacheBlock;
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Tokens, I) {
    vv_allocateL2CacheBlock;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Owned, O) {
    vv_allocateL2CacheBlock;
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  // Transitions from Idle

  transition(I, {L1_GETS }) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;  // send any tokens we have collected
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(I, L1_GETX) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens; // send any tokens we have collected
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(I, L2_Replacement) {
    c_cleanReplacement; // Only needed in some cases
    rr_deallocateL2CacheBlock;
  }

  transition(I, {Transient_GETX, Transient_GETS}) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(I, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(I, Data_Shared, S) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(I, Writeback_Shared_Data, S) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(I, Writeback_Tokens) {
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(I, Data_Owner, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition(I, Writeback_Owned, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  // Transitions from Shared

  transition(S, L2_Replacement, I) {
    c_cleanReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(S, Transient_GETX, I) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(S, {Transient_GETS}) {
    j_forwardTransientRequestToLocalSharers;
    r_clearExclusive;
    m_popRequestQueue;
  }

  transition(S, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Tokens) {
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, Writeback_Shared_Data) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }


  transition(S, Data_Owner, O) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Owned, O) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, {Data_Shared}) {
    q_updateTokensFromResponse; // Updates cache_entry.TokensSec0/1
    u_writeDataToCache;         // Updates cache_entry.ValidSectors [cite: 378]
    cl2_checkL2Accumulation;    // Fires trigger if entry is now complete
    n_popResponseQueue;
  }

  transition(S, L1_GETX, I) {
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }


  transition(S, L1_GETS) {
    k_dataFromL2CacheToL1Requestor;
    rm_updateRequestedMask;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }


  // Transitions from Owned

  transition(O, L2_Replacement, I) {
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(O, Transient_GETX, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(O, Transient_GETS) {
    // send multiple tokens
    r_clearExclusive;
    d_sendDataWithTokens;
    m_popRequestQueue;
  }

  transition(O, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(O, {Data_Shared, Data_Owner}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    u_writeDataToCache;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }


  transition(O, {Writeback_Tokens, Writeback_Shared_Data}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(O, L1_GETS) {
    z_resetAccumulationFlag;
    rm_updateRequestedMask;
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }


  transition(O, L1_GETX, I) {
    z_resetAccumulationFlag;
    rm_updateRequestedMask;
    a_broadcastLocalRequest;
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  // Transitions from M

  transition(M, L2_Replacement, I) {
    z_resetAccumulationFlag;
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  // MRM_DEBUG:  Give up all tokens even for GETS? ???
  transition(M, {Transient_GETX, Transient_GETS}, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  transition(M, L1_GETS, O) {
    z_resetAccumulationFlag;
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(M, L1_GETX, I) {
    z_resetAccumulationFlag;
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition({S, O, SX, OX, MX}, L2_Accumulation_Done, M) {
    z_resetAccumulationFlag;
    rc_clearRequestedMask;
    t_popTriggerQueue;
  }

  // Late-arriving tokens after the first partial response are merged
  transition({SX, OX, MX}, Ack) {
    q_updateTokensFromResponse;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, {Data_Shared, Data_Owner}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    u_writeDataToCache;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  transition({SX, OX, MX}, {Writeback_Tokens, Writeback_Shared_Data, Writeback_Owned}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    u_writeDataToCache;
    h_updateFilterFromL1HintOrWB;
    cl2_checkL2Accumulation;
    n_popResponseQueue;
  }

  // -------------------------------------------------------------------------
  // TRANSIENT ACCUMULATION SHIELD
  // Ignore retries and new requests while we are busy accumulating.
  // The L1 caches will naturally time out and retry again later!
  // -------------------------------------------------------------------------

  transition({SX, OX, MX}, {L1_GETX, L1_GETS}) {
    o_popL1RequestQueue;
  }

  transition({SX, OX, MX}, {Transient_GETX, Transient_GETS}) {
    m_popRequestQueue;
  }
}
