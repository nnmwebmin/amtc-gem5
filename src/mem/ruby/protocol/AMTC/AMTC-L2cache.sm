  action(h_updateFilterFromL1HintOrWB, "h", desc="update filter from received writeback") {
    peek(responseNetwork_in, ResponseMsg) {
      removeSharer(in_msg.addr, machineIDToNodeID(in_msg.Sender));
    }
  }

  action(j_forwardTransientRequestToLocalSharers, "j", desc="Forward external transient request to local sharers") {
    peek(requestNetwork_in, RequestMsg) {
      if (filtering_enabled && in_msg.RetryNum == 0 && sharersExist(in_msg.addr) == false) {
        //profile_filter_action(1);
        DPRINTF(RubySlicc, "filtered message, Retry Num: %d\n",
                in_msg.RetryNum);
      }
      else {
        enqueue(localRequestNetwork_out, RequestMsg, l2_response_latency ) {
           out_msg.addr := in_msg.addr;
           out_msg.Requestor := in_msg.Requestor;

           //
           // Currently assuming only one chip so all L1s are local
           //
           //out_msg.Destination := getLocalL1IDs(machineID);
           out_msg.Destination.broadcast(MachineType:L1Cache);
           out_msg.Destination.remove(in_msg.Requestor);

           out_msg.Type := in_msg.Type;
           out_msg.isLocal := false;
           out_msg.MessageSize := MessageSizeType:Broadcast_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
        }
        //profile_filter_action(0);
      }
    }
  }

  action(k_dataFromL2CacheToL1Requestor, "k", desc="Send data and a token from cache to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      int req_mask := in_msg.requested_sector_mask;
      int safe_send_mask := amtc_intersectMasks(cache_entry.ValidSectors, req_mask);

      bool can_give_t0 := (cache_entry.TokensSec0 > 1);
      bool can_give_t1 := (cache_entry.TokensSec1 > 1);

      // 1. Send Data + Tokens for sectors we physically have
      if (safe_send_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_SHARED;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := false;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := safe_send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);

          if (can_give_t0 && amtc_maskHasSector(safe_send_mask, 0)) {
              out_msg.TokensSec0 := 1;
              cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
          } else { out_msg.TokensSec0 := 0; }

          if (can_give_t1 && amtc_maskHasSector(safe_send_mask, 1)) {
              out_msg.TokensSec1 := 1;
              cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
          } else { out_msg.TokensSec1 := 0; }
        }
      }

      // ===================================================================
      // CRITICAL FIX: The Orphan Token Release
      // If we hold tokens for the requested sectors, but lack the data,
      // we MUST send the tokens via an ACK so they aren't trapped in the L2!
      // ===================================================================
      int token_only_mask := amtc_subtractMask(req_mask, safe_send_mask);
      int send_ack_t0 := 0;
      int send_ack_t1 := 0;
      int actual_ack_mask := 0;

      if (amtc_maskHasSector(token_only_mask, 0) && can_give_t0) {
          send_ack_t0 := 1;
          cache_entry.TokensSec0 := cache_entry.TokensSec0 - 1;
          actual_ack_mask := amtc_unionMasks(actual_ack_mask, 1);
      }
      if (amtc_maskHasSector(token_only_mask, 1) && can_give_t1) {
          send_ack_t1 := 1;
          cache_entry.TokensSec1 := cache_entry.TokensSec1 - 1;
          actual_ack_mask := amtc_unionMasks(actual_ack_mask, 2);
      }

      if (actual_ack_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.TokensSec0 := send_ack_t0;
          out_msg.TokensSec1 := send_ack_t1;
          out_msg.sector_id := amtc_primarySectorFromMask(actual_ack_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0; // No data!
          out_msg.token_sector_mask := actual_ack_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }

      // 3. Forward to Directory if anything is still physically missing
      bool starved_data := (safe_send_mask != req_mask);
      bool starved_t0 := amtc_maskHasSector(req_mask, 0) && !can_give_t0;
      bool starved_t1 := amtc_maskHasSector(req_mask, 1) && !can_give_t1;

      if (starved_data || starved_t0 || starved_t1) {
        int missing_mask := amtc_subtractMask(req_mask, safe_send_mask);
        if (missing_mask == 0) { missing_mask := req_mask; }

        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
          out_msg.addr := address;
          out_msg.Type := in_msg.Type;
          out_msg.Requestor := in_msg.Requestor;
          out_msg.RetryNum := in_msg.RetryNum;
          out_msg.Destination.broadcast(MachineType:L2Cache);
          out_msg.Destination.remove(machineID);
          out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.sector_id := amtc_primarySectorFromMask(missing_mask);
          out_msg.sector_mask := missing_mask;
          out_msg.requested_sector_mask := missing_mask;
          out_msg.MessageSize := MessageSizeType:Request_Control;
          out_msg.AccessMode := in_msg.AccessMode;
          out_msg.Prefetch := in_msg.Prefetch;
          out_msg.is_gpu := in_msg.is_gpu;
          out_msg.is_sync := in_msg.is_sync;
          out_msg.is_bypass := in_msg.is_bypass;
          out_msg.is_atomic := in_msg.is_atomic;
          out_msg.is_signal := in_msg.is_signal;
          out_msg.merged_req := in_msg.merged_req;
          out_msg.is_owner_pull := in_msg.is_owner_pull;
        }
      }
    }
  }

  action(k_dataOwnerFromL2CacheToL1Requestor, "\k", desc="Send data and tokens from L2 cache to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
    int send_t0 := 0;
    int send_t1 := 0;
    int send_mask := 0;

    // Evaluate Sector 0
    if (cache_entry.TokensSec0 > 1) {
        send_t0 := cache_entry.TokensSec0 - 1;
        cache_entry.TokensSec0 := 1;
        send_mask := amtc_unionMasks(send_mask, 1);
    }

    // Evaluate Sector 1
    if (cache_entry.TokensSec1 > 1) {
        send_t1 := cache_entry.TokensSec1 - 1;
        cache_entry.TokensSec1 := 1;
        send_mask := amtc_unionMasks(send_mask, 2);
    }

    // PHASE 2 ASSERT: We must be sending tokens for at least one sector!
    assert(send_t0 > 0 || send_t1 > 0);

      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);
      int safe_send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      if (safe_send_mask != 0) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := safe_send_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);
                  out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        }
      } else {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Destination.broadcast(MachineType:L2Cache);
           out_msg.Destination.remove(machineID);
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
          out_msg.Destination.add(in_msg.Requestor);
          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
                  out_msg.TokensSec0 := cache_entry.TokensSec0;
        out_msg.TokensSec1 := cache_entry.TokensSec1;
        }
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := address;
           out_msg.Type := CoherenceRequestType:GETS;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
           out_msg.sector_mask := req_mask;
           out_msg.requested_sector_mask := req_mask;
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := true;
        }
      }
      cache_entry.TokensSec0 := 0;
      cache_entry.TokensSec1 := 0;
    }
  }

  action(k_dataAndAllTokensFromL2CacheToL1Requestor, "\kk", desc="Send requested sector data and all tokens from L2 to L1 requestor") {
    peek(L1requestNetwork_in, RequestMsg) {
      assert(is_valid(cache_entry));
      int req_mask := amtc_normalizeMask(in_msg.sector_mask, in_msg.sector_id);

      // 1. Calculate tokens to send (Give up EVERYTHING we have for the requested sectors)
      int send_t0 := 0;
      int send_t1 := 0;

      if (amtc_maskHasSector(req_mask, 0)) {
          send_t0 := cache_entry.TokensSec0;
          cache_entry.TokensSec0 := 0; // Give them all up!
      }
      if (amtc_maskHasSector(req_mask, 1)) {
          send_t1 := cache_entry.TokensSec1;
          cache_entry.TokensSec1 := 0; // Give them all up!
      }

      int safe_send_mask := amtc_intersectMasks(req_mask, cache_entry.ValidSectors);

      if (safe_send_mask != 0) {
        // We have data to send
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:DATA_OWNER;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          // Attach the split tokens
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          // PHASE 1: Sector Aware Data Copy
          if (amtc_maskHasSector(safe_send_mask, 0)) {
              out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(safe_send_mask, 1)) {
              out_msg.DataBlk.copyPartial(cache_entry.DataBlk, 32, 32);
          }

          out_msg.Dirty := cache_entry.Dirty;
          out_msg.sector_id := amtc_primarySectorFromMask(safe_send_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := safe_send_mask;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.merged_resp := false;
          out_msg.MessageSize := amtc_getSizeFromDirtyMask(safe_send_mask);
        }
      } else {
        // Heterogeneous Miss: We have tokens, but no data!
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          // Attach the split tokens
          out_msg.TokensSec0 := send_t0;
          out_msg.TokensSec1 := send_t1;

          out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
          out_msg.sector_mask := req_mask;
          out_msg.valid_sector_mask := 0;
          out_msg.token_sector_mask := req_mask;
          out_msg.requested_sector_mask := req_mask;
          out_msg.MessageSize := MessageSizeType:Response_Control;
          out_msg.Destination.broadcast(MachineType:L2Cache);
           out_msg.Destination.remove(machineID);
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        }
        // Force the Directory to fetch the missing physical bytes
        enqueue(globalRequestNetwork_out, RequestMsg, l2_request_latency) {
           out_msg.addr := address;
           out_msg.Type := CoherenceRequestType:GETS;
           out_msg.Requestor := in_msg.Requestor;
           out_msg.RetryNum := in_msg.RetryNum;
           out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
           out_msg.sector_id := amtc_primarySectorFromMask(req_mask);
           out_msg.sector_mask := req_mask;
           out_msg.requested_sector_mask := req_mask;
           out_msg.MessageSize := MessageSizeType:Request_Control;
           out_msg.AccessMode := in_msg.AccessMode;
           out_msg.Prefetch := in_msg.Prefetch;
           out_msg.is_gpu := in_msg.is_gpu;
           out_msg.is_sync := in_msg.is_sync;
           out_msg.is_bypass := in_msg.is_bypass;
           out_msg.is_atomic := in_msg.is_atomic;
           out_msg.is_signal := in_msg.is_signal;
           out_msg.merged_req := in_msg.merged_req;
           out_msg.is_owner_pull := true;
        }
      }

      // Update local metadata
      cache_entry.TokenSectorMask := amtc_subtractMask(cache_entry.TokenSectorMask, req_mask);
    }
  }

  action(l_popPersistentQueue, "l", desc="Pop persistent queue.") {
    persistentNetwork_in.dequeue(clockEdge());
  }

  action(m_popRequestQueue, "m", desc="Pop request queue.") {
    requestNetwork_in.dequeue(clockEdge());
  }

  action(n_popResponseQueue, "n", desc="Pop response queue") {
    responseNetwork_in.dequeue(clockEdge());
  }

  action(o_popL1RequestQueue, "o", desc="Pop L1 request queue.") {
    L1requestNetwork_in.dequeue(clockEdge());
  }


  action(q_updateTokensFromResponse, "q", desc="Update token count based on incoming response") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // Route tokens to specific sectors
      cache_entry.TokensSec0 := cache_entry.TokensSec0 + in_msg.TokensSec0;
      cache_entry.TokensSec1 := cache_entry.TokensSec1 + in_msg.TokensSec1;

      cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, in_msg.valid_sector_mask);

      if ((in_msg.Type == CoherenceResponseType:DATA_OWNER ||
           in_msg.Type == CoherenceResponseType:WB_OWNED) && in_msg.Dirty) {
        cache_entry.Dirty := true;
        cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, in_msg.valid_sector_mask);
      }
    }
  }

  action(r_markNewSharer, "r", desc="Mark the new local sharer from local request message") {
    peek(L1requestNetwork_in, RequestMsg) {
      if (machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) {
        if (in_msg.Type == CoherenceRequestType:GETX) {
          setNewWriter(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          addNewSharer(in_msg.addr, machineIDToNodeID(in_msg.Requestor));
        }
      }
    }
  }

  action(r_clearExclusive, "\rrr", desc="clear exclusive bit") {
    clearExclusiveBitIfExists(address);
  }

  action(r_setMRU, "\rr", desc="manually set the MRU bit for cache line" ) {
    peek(L1requestNetwork_in, RequestMsg) {
      if ((machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache) &&
          (is_valid(cache_entry))) {
        L2cache.setMRU(address);
      }
    }
  }

action(t_sendAckWithCollectedTokens, "t", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // AMTC Metadata: Dynamically flag which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry data
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(tt_sendLocalAckWithCollectedTokens, "tt", desc="Send ack with the tokens we've collected thus far.") {
    assert(is_valid(cache_entry));

    // PHASE 2 FIX: Check if we have tokens for ANY sector
    if (cache_entry.TokensSec0 > 0 || cache_entry.TokensSec1 > 0) {
      peek(L1requestNetwork_in, RequestMsg) {
        enqueue(responseNetwork_out, ResponseMsg, l2_response_latency) {
          out_msg.addr := address;
          out_msg.Type := CoherenceResponseType:ACK;
          out_msg.Sender := machineID;
          out_msg.Destination.add(in_msg.Requestor);

          out_msg.TokensSec0 := cache_entry.TokensSec0;
          out_msg.TokensSec1 := cache_entry.TokensSec1;

          // AMTC Metadata: Dynamically flag which sectors these tokens belong to
          int t_mask := 0;
          if (cache_entry.TokensSec0 > 0) { t_mask := amtc_unionMasks(t_mask, 1); }
          if (cache_entry.TokensSec1 > 0) { t_mask := amtc_unionMasks(t_mask, 2); }

          out_msg.token_sector_mask := t_mask;
          out_msg.valid_sector_mask := 0; // ACKs never carry data
          out_msg.MessageSize := MessageSizeType:Response_Control;
        }
      }
    }

    // Safely clear local tokens
    cache_entry.TokensSec0 := 0;
    cache_entry.TokensSec1 := 0;
  }

  action(u_writeDataToCache, "u", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      int copy_mask := in_msg.valid_sector_mask;

      // ===================================================================
      // L2 Refined Late Data Shield
      // ===================================================================
      int tokens_per_sector := max_tokens() / 2;

      if (amtc_maskHasSector(copy_mask, 0) &&
          cache_entry.TokensSec0 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 0)) {
          copy_mask := amtc_clearSector(copy_mask, 0);
      }

      if (amtc_maskHasSector(copy_mask, 1) &&
          cache_entry.TokensSec1 == tokens_per_sector &&
          amtc_maskHasSector(cache_entry.ValidSectors, 1)) {
          copy_mask := amtc_clearSector(copy_mask, 1);
      }

      if (copy_mask != 0) {
          if (amtc_maskHasSector(copy_mask, 0)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 0, 32);
          }
          if (amtc_maskHasSector(copy_mask, 1)) {
            cache_entry.DataBlk.copyPartial(in_msg.DataBlk, 32, 32);
          }

          cache_entry.ValidSectors := amtc_unionMasks(cache_entry.ValidSectors, copy_mask);

          if (in_msg.Dirty) {
            cache_entry.Dirty := true;
            cache_entry.DirtySectors := amtc_unionMasks(cache_entry.DirtySectors, copy_mask);
          }
      }
    }
  }

  action(vv_allocateL2CacheBlock, "\v", desc="Set L2 cache tag equal to tag of block B.") {
    set_cache_entry(L2cache.allocate(address, new Entry));
  }

  action(rr_deallocateL2CacheBlock, "\r", desc="Deallocate L2 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    L2cache.deallocate(address);
    unset_cache_entry();
  }

  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    L2cache.profileDemandMiss();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    L2cache.profileDemandHit();
  }

  action(w_assertIncomingDataAndCacheDataMatch, "w", desc="Assert that the incoming data and the data in the cache match") {
    peek(responseNetwork_in, ResponseMsg) {
      if (in_msg.Type != CoherenceResponseType:ACK &&
          in_msg.Type != CoherenceResponseType:WB_TOKENS) {
        assert(is_valid(cache_entry));
        //assert(cache_entry.DataBlk == in_msg.DataBlk);
      }
    }
  }


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  transition({NP, I, S, O, M, I_L, S_L}, L1_INV) {

    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition({NP, I, S, O, M}, Own_Lock_or_Unlock) {
    l_popPersistentQueue;
  }


  // Transitions from NP

  transition(NP, {Transient_GETX, Transient_GETS}) {
    // forward message to local sharers
    r_clearExclusive;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }


  transition(NP,  {L1_GETS, L1_GETX}) {
    a_broadcastLocalRequest;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(NP, {Ack, Data_Shared, Data_Owner, Data_All_Tokens}) {
    bb_bounceResponse;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Shared_Data, S) {
    vv_allocateL2CacheBlock;
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Tokens, I) {
    vv_allocateL2CacheBlock;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(NP, Writeback_All_Tokens, M) {
    vv_allocateL2CacheBlock;
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(NP, Writeback_Owned, O) {
    vv_allocateL2CacheBlock;
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }


  transition(NP,
             {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token},
             I_L) {
    l_popPersistentQueue;
  }

  // Transitions from Idle

  transition(I, {L1_GETS, L1_GETS_Last_Token}) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;  // send any tokens we have collected
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(I, L1_GETX) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens; // send any tokens we have collected
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(I, L2_Replacement) {
    c_cleanReplacement; // Only needed in some cases
    rr_deallocateL2CacheBlock;
  }

  transition(I, {Transient_GETX, Transient_GETS, Transient_GETS_Last_Token}) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(I,
             {Persistent_GETX, Persistent_GETS, Persistent_GETS_Last_Token},
             I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }


  transition(I, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(I, Data_Shared, S) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(I, Writeback_Shared_Data, S) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(I, Writeback_Tokens) {
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(I, Data_Owner, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(I, Writeback_Owned, O) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(I, Data_All_Tokens, M) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }


  transition(I, Writeback_All_Tokens, M) {
    u_writeDataToCache;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  // Transitions from Shared

  transition(S, L2_Replacement, I) {
    c_cleanReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(S, Transient_GETX, I) {
    r_clearExclusive;
    t_sendAckWithCollectedTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(S, {Transient_GETS, Transient_GETS_Last_Token}) {
    j_forwardTransientRequestToLocalSharers;
    r_clearExclusive;
    m_popRequestQueue;
  }

  transition(S, Persistent_GETX, I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }


  transition(S, {Persistent_GETS, Persistent_GETS_Last_Token}, S_L) {
    f_sendAckWithAllButOneTokens;
    l_popPersistentQueue;
  }


  transition(S, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Tokens) {
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, Writeback_Shared_Data) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }


  transition(S, Data_Owner, O) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_Owned, O) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, Data_All_Tokens, M) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(S, Writeback_All_Tokens,  M) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S, L1_GETX, I) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }


  transition(S, L1_GETS) {
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(S, L1_GETS_Last_Token, I) {

    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  // Transitions from Owned

  transition(O, L2_Replacement, I) {
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(O, Transient_GETX, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    j_forwardTransientRequestToLocalSharers;
    m_popRequestQueue;
  }

  transition(O, Persistent_GETX, I_L) {
    ee_sendDataWithAllTokens;
    l_popPersistentQueue;
  }

  transition(O, Persistent_GETS, S_L) {
    ff_sendDataWithAllButOneTokens;
    l_popPersistentQueue;
  }

  transition(O, Persistent_GETS_Last_Token, I_L) {
    fa_sendDataWithAllTokens;
    l_popPersistentQueue;
  }

  transition(O, Transient_GETS) {
    // send multiple tokens
    r_clearExclusive;
    d_sendDataWithTokens;
    m_popRequestQueue;
  }

  transition(O, Transient_GETS_Last_Token) {
    // WAIT FOR IT TO GO PERSISTENT
    r_clearExclusive;
    m_popRequestQueue;
  }

  transition(O, Ack) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(O, Ack_All_Tokens, M) {
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(O, Data_Shared) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }


  transition(O, {Writeback_Tokens, Writeback_Shared_Data}) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(O, Data_All_Tokens, M) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    n_popResponseQueue;
  }

  transition(O, Writeback_All_Tokens, M) {
    w_assertIncomingDataAndCacheDataMatch;
    q_updateTokensFromResponse;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(O, L1_GETS) {
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(O, L1_GETS_Last_Token, I) {
    k_dataOwnerFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(O, L1_GETX, I) {
    a_broadcastLocalRequest;
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  // Transitions from M

  transition(M, L2_Replacement, I) {
    cc_dirtyReplacement;
    rr_deallocateL2CacheBlock;
  }

  // MRM_DEBUG:  Give up all tokens even for GETS? ???
  transition(M, {Transient_GETX, Transient_GETS}, I) {
    r_clearExclusive;
    dd_sendDataWithAllTokens;
    m_popRequestQueue;
  }

  transition(M, {Persistent_GETS, Persistent_GETX}, I_L) {
    ee_sendDataWithAllTokens;
    l_popPersistentQueue;
  }


  transition(M, L1_GETS, O) {
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(M, L1_GETX, I) {
    k_dataAndAllTokensFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }


  //Transitions from locked states

  transition({I_L, S_L}, Ack) {
    gg_bounceResponseToStarver;
    n_popResponseQueue;
  }

  transition({I_L, S_L}, {Data_Shared, Data_Owner, Data_All_Tokens}) {
    gg_bounceResponseToStarver;
    n_popResponseQueue;
  }

  transition({I_L, S_L}, {Writeback_Tokens, Writeback_Shared_Data}) {
    gg_bounceWBSharedToStarver;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition({I_L, S_L}, {Writeback_Owned, Writeback_All_Tokens}) {
    gg_bounceWBOwnedToStarver;
    h_updateFilterFromL1HintOrWB;
    n_popResponseQueue;
  }

  transition(S_L, L2_Replacement, I) {
    c_cleanReplacement;
    rr_deallocateL2CacheBlock;
  }

  transition(I_L, L2_Replacement, I) {
    rr_deallocateL2CacheBlock;
  }

  transition(I_L, Own_Lock_or_Unlock, I) {
    l_popPersistentQueue;
  }

  transition(S_L, Own_Lock_or_Unlock, S) {
    l_popPersistentQueue;
  }

  transition({I_L, S_L}, {Transient_GETS_Last_Token, Transient_GETS, Transient_GETX}) {
    r_clearExclusive;
    m_popRequestQueue;
  }

  transition(I_L, {L1_GETX, L1_GETS}) {
    a_broadcastLocalRequest;
    r_markNewSharer;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(S_L, L1_GETX, I_L) {
    a_broadcastLocalRequest;
    tt_sendLocalAckWithCollectedTokens;
    r_markNewSharer;
    r_setMRU;
    uu_profileMiss;
    o_popL1RequestQueue;
  }

  transition(S_L, L1_GETS) {
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(S_L, L1_GETS_Last_Token, I_L) {
    k_dataFromL2CacheToL1Requestor;
    r_markNewSharer;
    r_setMRU;
    uu_profileHit;
    o_popL1RequestQueue;
  }

  transition(S_L, Persistent_GETX, I_L) {
    e_sendAckWithCollectedTokens;
    l_popPersistentQueue;
  }

  transition(S_L, {Persistent_GETS, Persistent_GETS_Last_Token}) {
    l_popPersistentQueue;
  }

  transition(I_L, {Persistent_GETX, Persistent_GETS}) {
    l_popPersistentQueue;
  }
}
