// CoherenceRequestType
enumeration(CoherenceRequestType, desc="...") {
  GETX,      desc="Get eXclusive";
  GETS,      desc="Get Shared";
  InvCache,  desc="Invalidate TCC cache entry from TCP";

  // GPU atomic requests. Keep the return/no-return distinction because
  // GPUCoalescer requires the original value for ATOMIC_RETURN operations
  // such as atomicAdd() and atomicMax().
  AtomicReturn,   desc="GPU atomic operation returning the original value";
  AtomicNoReturn, desc="GPU atomic operation without a return value";
}

// PersistentType
enumeration(PersistentRequestType, desc="...") {
  GETX_PERSISTENT,  desc="...";
  GETS_PERSISTENT,  desc="...";
  DEACTIVATE_PERSISTENT,desc="...";
}

// CoherenceResponseType
enumeration(CoherenceResponseType, desc="...") {
  DATA_OWNER,  desc="Data";
  ACK_OWNER,  desc="data-less owner token";
  DATA_SHARED, desc="Data";
  ACK,         desc="ACKnowledgment";
  InvL2Resp,   desc="L2 invalidate completed";
  WB_TOKENS,   desc="L1 to L2 writeback";
  WB_SHARED_DATA,   desc="L1 to L2 writeback with data";
  WB_OWNED,    desc="L1 to L2 writeback with data";
  INV,         desc="L1 informing L2 of loss of all tokens";
}

// PersistentMsg
structure(PersistentMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  PersistentRequestType Type,  desc="Type of starvation request";
  MachineID Requestor,            desc="Node who initiated the request";
  NetDest Destination,             desc="Destination set";
  MessageSizeType MessageSize, desc="size category of the message";
  RubyAccessMode AccessMode,    desc="user/supervisor access type";
  PrefetchBit Prefetch,         desc="Is this a prefetch request";

  // AMTC arbitration metadata for the trimmed prototype. The physical Ruby
  // coherence block remains 64B. A mask value of 1 selects bytes 0..31,
  // 2 selects bytes 32..63, and 3 selects the full 64B block.
  int sector_mask, default="3", desc="AMTC 2-sector mask under arbitration; default full 64B line";
  int requested_sector_mask, default="3", desc="AMTC original requested 2-sector mask";
  bool is_gpu, default="false", desc="Request originated from a GPU-side controller";
  bool is_sync, default="false", desc="Synchronization/fence/signal request requiring coherent treatment";

  bool functionalRead(Packet *pkt) {
    // No data in persistent messages
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // No data in persistent messages
    return false;
  }
}


// RequestMsg
structure(RequestMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  CoherenceRequestType Type,   desc="Type of request (GetS, GetX, PutX, etc)";
  MachineID Requestor,            desc="Node who initiated the request";
  NetDest Destination,             desc="Multicast destination mask";
  bool isLocal,                    desc="Is this request from a local L1";
  int RetryNum,                    desc="retry sequence number";
  MessageSizeType MessageSize, desc="size category of the message";
  RubyAccessMode AccessMode,    desc="user/supervisor access type";
  PrefetchBit Prefetch,         desc="Is this a prefetch request";

  /*
   * GPU atomic transport.
   *
   * Do not collapse AtomicReturn into GETX. Parallel GPU code may depend
   * on the returned pre-RMW value.
   */
  WriteMask writeMask,              desc="GPU atomic/write operation mask";
  uint64_t instSeqNum, default="0", desc="Originating GPU instruction sequence number";

  // AMTC request-intent fields for 64B block / 2 x 32B logical sectors.
  // Requests state what the requester wants; validity and token ownership
  // are carried by responses, not requests.
  int sector_id, default="0", desc="AMTC primary sector id within a 64B Ruby line";
  int sector_mask, default="3", desc="AMTC requested 2-sector mask; default full 64B line";
  int requested_sector_mask, default="3", desc="AMTC original request mask, preserved across retries/merges";
  bool is_gpu, default="false", desc="Request originated from a GPU-side controller";
  bool is_sync, default="false", desc="Synchronization/fence/signal request requiring coherent treatment";
  bool is_bypass, default="false", desc="GPU payload request allowed to bypass token coherence";
  bool is_atomic, default="false", desc="Atomic request requiring coherent handling";
  bool is_signal, default="false", desc="HSA/doorbell signal request";
  bool merged_req, default="false", desc="Request represents a merged sector mask";
  bool is_owner_pull, default="false", desc="True if the Owner is pulling missing sector data";

  // AMTC GETX upgrade credit: tokens already retained by the requester.
  // These are metadata credits only; they must not be added to L2 token storage.
  int requester_held_tokens_sec0, default="0", desc="Requester-held token credit for sector 0";
  int requester_held_tokens_sec1, default="0", desc="Requester-held token credit for sector 1";

  bool functionalRead(Packet *pkt) {
    // No data in request messages
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // No data in request messages
    return false;
  }
   //these re status fields for GPU
  bool isGLCSet, default="false", desc="Bypass L1 Cache";
  bool isSLCSet, default="false", desc="Bypass L2 Cache";
}


// ResponseMsg
structure(ResponseMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  CoherenceResponseType Type,  desc="Type of response (Ack, Data, etc)";
  MachineID Sender,               desc="Node who sent the data";
  NetDest Destination,             desc="Node to whom the data is sent";
  //int Tokens,                  desc="Number of tokens being transfered for this line";
  int TokensSec0, default="0", desc="AMTC tokens for sector 0";
  int TokensSec1, default="0", desc="AMTC tokens for sector 1";
  DataBlock DataBlk,           desc="data for the cache line";
  bool Dirty,                  desc="Is the data dirty (different than memory)?";
  MessageSizeType MessageSize, desc="size category of the message";

  // AMTC response-completion fields for the trimmed 2-sector model. Responses
  // describe what was supplied: data validity and token coverage.
  int sector_id, default="0", desc="AMTC primary response sector id";
  int sector_mask, default="3", desc="AMTC response 2-sector mask; default full 64B line";
  int valid_sector_mask, default="3", desc="AMTC data-valid 32B sectors contained in this response";
  int token_sector_mask, default="3", desc="AMTC sectors covered by the transferred tokens";
  int requested_sector_mask, default="3", desc="Optional echo of the requester mask for debugging/validation";
  bool merged_resp, default="false", desc="Response satisfies a merged sector request";

  bool functionalRead(Packet *pkt) {
    // No check being carried out on the message type. Would be added later.
    return testAndRead(addr, DataBlk, pkt);
  }

  bool functionalWrite(Packet *pkt) {
    // No check required since all messages are written.
    return testAndWrite(addr, DataBlk, pkt);
  }

  //these re status fields for GPU
  bool isGLCSet, default="false", desc="Bypass L1 Cache";
  bool isSLCSet, default="false", desc="Bypass L2 Cache";
}


enumeration(DMARequestType, desc="...", default="DMARequestType_NULL") {
  READ,          desc="Memory Read";
  WRITE,         desc="Memory Write";
  NULL,          desc="Invalid";
}

enumeration(DMAResponseType, desc="...", default="DMAResponseType_NULL") {
  DATA,          desc="DATA read";
  ACK,           desc="ACK write";
  NULL,          desc="Invalid";
}

structure(DMARequestMsg, desc="...", interface="Message") {
  DMARequestType Type,       desc="Request type (read/write)";
  Addr PhysicalAddress,   desc="Physical address for this request";
  Addr LineAddress,       desc="Line address for this request";
  MachineID Requestor,            desc="Node who initiated the request";
  NetDest Destination,       desc="Destination";
  DataBlock DataBlk,         desc="DataBlk attached to this request";
  int Len,                   desc="The length of the request";
  MessageSizeType MessageSize, desc="size category of the message";

  // AMTC DMA request mask fields. DMA defaults to full-line coherence for now.
  int sector_id, default="0", desc="AMTC DMA primary sector id";
  int sector_mask, default="3", desc="AMTC DMA requested 2-sector mask";
  int requested_sector_mask, default="3", desc="AMTC DMA preserved request mask";
  bool is_gpu, default="false", desc="DMA request originated from GPU-side agent";
  bool is_sync, default="false", desc="DMA request needs coherent synchronization semantics";
  bool is_bypass, default="false", desc="DMA request may bypass token path";
  bool is_atomic, default="false", desc="DMA atomic-like request";
  bool is_signal, default="false", desc="DMA signal/doorbell-like request";

  bool functionalRead(Packet *pkt) {
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    return testAndWrite(LineAddress, DataBlk, pkt);
  }
}

structure(DMAResponseMsg, desc="...", interface="Message") {
  DMAResponseType Type,      desc="Response type (DATA/ACK)";
  Addr PhysicalAddress,   desc="Physical address for this request";
  Addr LineAddress,       desc="Line address for this request";
  NetDest Destination,       desc="Destination";
  DataBlock DataBlk,         desc="DataBlk attached to this request";
  MessageSizeType MessageSize, desc="size category of the message";

  // AMTC DMA response mask fields. Responses describe valid/token coverage.
  int sector_id, default="0", desc="AMTC DMA response primary sector id";
  int sector_mask, default="3", desc="AMTC DMA response 2-sector mask";
  int valid_sector_mask, default="3", desc="AMTC DMA valid 32B sectors";
  int token_sector_mask, default="3", desc="AMTC DMA token-covered sectors";

  bool functionalRead(Packet *pkt) {
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    return testAndWrite(LineAddress, DataBlk, pkt);
  }
}
